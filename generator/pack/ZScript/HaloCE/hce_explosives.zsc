// Enemy explosives with nerfable blasts.
// HDE's grenades, rockets, fuel rods, needles and Plasma Caster shots hard-code their explosion damage. These
// subclasses are what the enemies fire and throw instead: each blast is multiplied by the shot's
// DamageMultiply, which HaloDoom_EnemyBase.HCE_ScaleShot sets from hce_nerf_projectiles x hce_enemydamage (and the variant's
// damage modifier). DamageMultiply only acts when the actor itself is the damage source, which these never are,
// so the engine doesn't apply it a second time. Visuals and sounds are HDE's own.

// ---------------------------------------------------------------- bullets / plasma / needles / spikes
// HDE recomputes a projectile's damage from its default when it hits (AdjustRangeDamage), which would undo the
// nerf HCE_ScaleShot applied when it was fired: every enemy projectile class re-applies it right there.
mixin class HCE_NerfMixin
{
	// HDE's range falloff rebuilds truedamage from the unscaled default once a shot is past its falloff range, so the
	// enemy damage scale goes back on it then. Inside that range HDE leaves the value alone, and it was scaled when
	// fired (HCE_ScaleProjectile): scaling it again there used to apply the nerf twice (0.16x for 0.4), and small
	// rounds such as Spiker spikes rounded down to no damage at all.
	override void AdjustRangeDamage()
	{
		double before = truedamage;
		super.AdjustRangeDamage();
		if(range_max > 0 && !bDESTROYED && DamageMultiply > 0 && truedamage != before) truedamage *= DamageMultiply;
	}
}

// ---------------------------------------------------------------- grenades
class HCE_FragGrenade : FragGrenade_Proj
{
	States
	{
	Detonate:
		TNT1 A 1
		{
			if(waterlevel > 0 || HitWater(CurSector, pos)) A_StartSound("Halo/Grenade/Frag/ExplodeWater");
			else A_StartSound("Halo/Grenade/Frag/Explode");
			let e = Spawn("FragGrenadeExplosion", pos);
			if(e) { e.target = target; e.SetDamage(max(1, int(e.Damage * DamageMultiply))); }
		}
		Stop;
	}
}

class HCE_PlasmaGrenade : PlasmaGrenade_Proj
{
	override void DoExplode()
	{
		// stuck to the player, a Covenant plasma grenade kills, as in Halo
		if(hitactor && hitactor.player && hitactor.health > 0 && !(target && target.player))
			hitactor.DamageMobj(self, target, max(1000, hitactor.health * 10), 'Explosive', DMG_NO_ARMOR | DMG_THRUSTLESS);
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e) { e.target = target; e.explosionDmg *= DamageMultiply; }
	}
}

// ---------------------------------------------------------------- Plasma Caster (White Hunter, Engineer)
class HCE_PlasmaCasterScaled : PlasmaCasterProj
{
	override void DoExplode()
	{
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e) { e.target = target; e.explosionDmg *= DamageMultiply; }
		Spawn("PlasmaSplashSpawner", pos);
	}
}

class HCE_PlasmaCasterMiniScaled : PlasmaCasterMiniProj
{
	override void DoExplode()
	{
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e)
		{
			e.target = target;
			e.explosionRadius = 64;
			e.explosionDmg = 100 * DamageMultiply;
			e.A_SetScale(0.35);
		}
	}
}

class HCE_PlasmaCasterClusterScaled : PlasmaCasterClusterProj
{
	override void DoExplode()
	{
		Spawn("PlasmaSplashSpawner", pos);
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e) { e.target = target; e.explosionDmg *= DamageMultiply; }
		for(int i = 0; i < 2; i++)
		{
			let m = Spawn("HCE_PlasmaCasterMiniScaled", pos);
			if(!m) continue;
			m.target = target;
			m.DamageMultiply = DamageMultiply;
			m.vel = HaloMath.VecFromAngles(angle + 180 + frandom[CasterCluster](-60, 60), 0, 8);
			m.vel.z = frandom[CasterCluster](5, 10);
		}
	}
}

// ---------------------------------------------------------------- rocket
class HCE_RocketScaled : HaloRocketProj
{
	mixin HCE_NerfMixin;
	States
	{
	Crash:
	XDeath:
	Death:
		MODL A 1
		{
			A_StopSound(CHAN_BODY);
			A_StartSound("Halo/Weapons/RocketLauncher/Explode", CHAN_AUTO, CHANF_OVERLAP, attenuation:0.1);
			let e = Spawn("HaloRocketExplosion", pos);
			if(e) { e.target = target; e.SetDamage(max(1, int(e.Damage * DamageMultiply))); }
		}
		Stop;
	}
}

// ---------------------------------------------------------------- fuel rod
class HCE_FuelRodExplosion : Fuelrod_Explosion
{
	double hce_scale;
	Default { Fuelrod_Explosion.SetupSmoke 1.0, 120; }
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 1
		{
			double m = hce_scale > 0 ? hce_scale : 1.0;
			let splash = Spawn("LargeSplashSpawner", pos);
			if(splash) splash.A_SetScale(splash.Scale.X * 2.0);
			A_Explode(max(1, int(128 * m)), 256);
			A_StartSound("Halo/Weapons/Fuelrod/Explosion", flags:CHANF_OVERLAP, attenuation:0.1);
			let toxic = HCE_FuelRodDamager(Spawn("HCE_FuelRodDamager", (pos.xy, pos.z + 10)));
			if(toxic)
			{
				// the toxic cloud keeps HDE's 4 a pulse but pulses less often: damage over time follows the nerf
				toxic.target = target;
				toxic.SetDamage(max(1, int(4 * smokeDmg + 0.5)));
				toxic.hce_step = max(2, int(2 / max(0.05, m) + 0.5));
			}
			HaloMath.SpawnFX("Fuelrod_Smoke", (pos.xy, pos.z), angle, random[FuelrodRNG](4, 12), smokeDist, 60);
			let sparks = Spawn("ImpactSparks", pos);
			if(sparks) sparks.A_SetScale(0.25, 0.25);
		}
		SX04 A 1
		{
			let flare = Spawn("TankRocket_Flare", (pos.xy, pos.z + 30));
			if(flare)
			{
				flare.A_SetScale(0.25, 0.25);
				if(fillcolor) { flare.A_SetRenderStyle(1.0, STYLE_AddShaded); flare.SetShade(fillcolor); }
			}
		}
		SX04 BCDEFGHIJKLMNOPQ 1 Bright;
		Stop;
	}
}

class HCE_FuelRodDamager : Fuelrod_Damager
{
	int hce_step;
	States
	{
	Spawn:
		TNT1 A 1
		{
			if(hce_step < 2) hce_step = 2;
			if(!(GetAge() % hce_step))
				HaloMath.ExplodeEx(self, Damage, Radius, thrustMod:0, damageType:"ToxicPlasma", selfDamage:0.20);
		}
		TNT1 A 0 A_JumpIf(GetAge() > 170, "Null");
		Loop;
	}
}

class HCE_FuelRodScaled : FuelrodPlasma
{
	Default { WraithPlasma.ExplosionType "HCE_FuelRodExplosion"; }
	override void DoExplosion()
	{
		A_StopSound(CHAN_BODY);
		vector3 fxoffs = HaloMath.V3Offset(angle, pitch, roll, -30, 0, 10, 1.);
		vector3 fxpos = level.vec3offset(pos, fxoffs);
		let expl = Spawn(explosionActor, fxpos);
		if(expl)
		{
			UpdateFXColor(expl, effectShade);
			expl.A_SetScale(expl.default.Scale.X * Scale.X, expl.default.Scale.Y * Scale.Y);
			expl.target = target;
			let fe = HCE_FuelRodExplosion(expl);
			if(fe) fe.hce_scale = DamageMultiply;
		}
		for(int i = 0; i < random[VehpartFX](20, 30); i++)
		{
			double sa = frandom[VehpartFX](0, 180), sd = frandom[VehpartFX](-30, 30);
			vector3 dir = (cos(angle + sa) * sd, sin(angle + sa) * sd, frandom[VehpartFX](-30, 30));
			let fx = Spawn("WraithPlasma_FlyingPlasma", level.vec3offset(fxpos, dir));
			if(fx)
			{
				UpdateFXColor(fx, effectShade);
				double va = frandom[VehpartFX](-180, 180);
				fx.vel = (cos(va), sin(va), sin(frandom[VehpartFX](-45, 45))) * 15;
				fx.Scale.X *= Scale.X; fx.Scale.Y *= Scale.Y;
			}
		}
	}
}

// ---------------------------------------------------------------- needles (supercombine blast)
class HCE_NeedleScaled : HaloNeedler_Proj
{
	mixin HCE_NerfMixin;
	States
	{
	Death.Explode:
		TRAC A 1
		{
			if(force_explosion || ((needlecount && needlecount.CountNeedles() >= explodecount) && !doexplode && hitactor))
			{
				vector3 explodePos = hitactor ? hitactor.pos + (0, 0, hitactor.height * 0.5) : pos;
				double hitHeight = hitactor ? hitactor.height * 0.5 : height * 0.5;
				Spawn("NeedleExplosion_Flare", explodePos);
				Spawn("NeedleExplosion", explodePos);
				A_StartSound("Halo/Weapons/Needler/SuperCombine", flags:CHANF_OVERLAP);
				for(int i = 0; i < 100; i++)
				{
					double ang = frandom[NeedleDeath](0, 360), pit = frandom[NeedleDeath](-45, 45);
					vector3 rdir = (cos(ang), sin(ang), -sin(pit)) * frandom[NeedleDeath](20, 35);
					A_SpawnParticle("Purple", SPF_FULLBRIGHT, 20, 10.0, ang, 0, 0, hitHeight, rdir.x, rdir.y, rdir.z, 0, 0, 0,
						frandom[NeedleDeath](0.5, 1.0), 0.0125);
				}
				if(needlecount) needlecount.ExplodeNeedles();
				if(hitactor) hitactor.DamageMobJ(self, self.target, shatterdmg * explodecount, "Explosive", 0, angle);
				A_Explode(max(1, int(128 * DamageMultiply)), 200, 0);
				OnSuperCombine(hitactor);
			}
			if(hitactor) hitactor.DamageMobJ(self, self.target, shatterdmg, "Explosive", 0, angle);
			if(needlecount) needlecount.RemoveNeedle(self);
			Spawn("NeedleMiniExplosion", pos);
			for(int i = 0; i < 10; i++)
				A_SpawnParticle("Purple", SPF_FULLBRIGHT | SPF_RELVEL, 35, 5, angle + frandom[NeedleDeath](-90, 90),
					frandom[NeedleDeath](-20, 20), frandom[NeedleDeath](-20, 20), frandom[NeedleDeath](-10, 10),
					10, 10, frandom[NeedleDeath](-8, 8), 0, 0, -0.1, 1.0, 0.14, 0.15);
		}
		TNT1 A 35;
		Stop;
	}
}
