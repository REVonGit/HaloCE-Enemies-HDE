// Enemy explosives with nerfable blasts.
// HDE's grenades, rockets, fuel rods, needles and Plasma Caster shots hard-code their explosion damage. These
// subclasses are what the enemies fire and throw instead: each blast is multiplied by the shot's
// DamageMultiply, which HaloDoom_EnemyBase.HCE_ScaleShot sets from hce_nerf_projectiles x hce_enemydamage (and the variant's
// damage modifier). DamageMultiply only acts when the actor itself is the damage source, which these never are,
// so the engine doesn't apply it a second time. Visuals and sounds are HDE's own.

// ---------------------------------------------------------------- bullets / plasma / needles / spikes
// HDE recomputes a projectile's damage from its default when it hits (AdjustRangeDamage), which would undo the
// nerf HCE_ScaleShot applied when it was fired: every enemy projectile class re-applies it right there.
mixin class HCE_NerfMixin
{
	// HDE's range falloff rebuilds truedamage from the unscaled default once a shot is past its falloff range, so the
	// enemy damage scale goes back on it then. Inside that range HDE leaves the value alone, and it was scaled when
	// fired (HCE_ScaleProjectile): scaling it again there used to apply the nerf twice (0.16x for 0.4), and small
	// rounds such as Spiker spikes rounded down to no damage at all.
	override void AdjustRangeDamage()
	{
		double before = truedamage;
		super.AdjustRangeDamage();
		if(range_max > 0 && !bDESTROYED && DamageMultiply > 0 && truedamage != before) truedamage *= DamageMultiply;
	}
}

// ---------------------------------------------------------------- plasma bolts, lighter
// HDE's plasma bolts are made for the player's gun: each one carries a crackle of lightning (TESLightningEffect, a
// particle actor every tic or two), throws four lightning arcs every four tics (each arc a chain of 20-70 small
// actors) and four more when it hits, and trails a smoke actor every tic. A squad of Covenant opening fire at once
// put two thousand effect actors in the level within a second, which is the hitch when many of them notice you.
// The enemies' bolts keep HDE's look (the glowing cores, the shading, the particles, the smoke) with a fraction of
// the actors: no attached crackle, one coarser arc in flight and two on impact, only near a player, smoke every
// third tic.
mixin class HCE_LitePlasma
{
	// the bolt's look at launch: HDE's two glowing cores, a random roll, its colour and a point light; the crackle
	// actor HaloPlasma_Proj would attach is left out
	override void PostBeginPlay()
	{
		HaloBullet.PostBeginPlay();                  // HaloPlasma_Proj's, without the attached lightning crackle
		HaloPlasma_ProjCore.SpawnCore(self, coreColorOne, scaleMod: 1.0);
		HaloPlasma_ProjCore.SpawnCore(self, coreColorTwo, scaleMod: 0.70);
		A_SetRoll(frandom[PlasmaRollRNG](-180, 180));
		SetShade(col);
		A_AttachLight('glow', DynamicLight.PointLight, col, 40, 0);   // Halo CE's bolts light the walls they pass
	}
	// HDE's lightning arcs, cut down: none unless a player is within 1200 units; one arc in flight, two on impact,
	// three for a charged shot's hit (amt > 4), each a coarser chain than HDE's
	override void A_DoLightning(class<LightningBiri> type, double amt)
	{
		bool near = false;
		for(int i = 0; i < MAXPLAYERS && !near; i++)
			if(playeringame[i] && players[i].mo && Distance3D(players[i].mo) < 1200) near = true;
		if(!near) return;
		int n = amt > 4 ? 3 : bMISSILE ? 1 : 2;      // in flight, on impact, a charged shot's hit
		for(int i = 0; i < n; i++)
		{
			vector2 view = (angle + frandom[PlasmaProjRNG](-60, 60) + 180, pitch + frandom[PlasmaProjRNG](-35, 35));
			vector3 rp = (frandom[PlasmaProjRNG](-1, 1), frandom[PlasmaProjRNG](-1, 1), frandom[PlasmaProjRNG](-1, 1)) * frandom[PlasmaProjRNG](-5, 5);
			// 3-unit links (HDE's: 1.5): half the segment actors, each twice as long; at this size the arc looks the same
			BiriBiri.DoLightning(level.Vec3Offset(pos, rp), view, type: type, dist: frandom[PlasmaProjRNG](10, 30), 3.0, 20.0, 10.0, 30, 0);
		}
	}
}
// the plain plasma pistol and plasma rifle bolts: smoke every third tic (the Pulse Carbine and the charged shot keep
// their own Tick, which does more than smoke)
mixin class HCE_LitePlasmaSmoke
{
	// HaloBullet's tick plus the halo glow every other tic and the smoke every third (HDE's: every tic)
	override void Tick()
	{
		HaloBullet.Tick();
		// the glow round the bolt (Halo CE's plasma is a bright ball in a soft halo of its colour), trailing a little
		if(!bDESTROYED && bMISSILE && !(GetAge() % 2))
		{
			HaloDoom_EnemyBase.HCE_Glow(self, col, 3, 30, alpha: 0.5, grow: -3);
			HaloDoom_EnemyBase.HCE_Glow(self, col, 6, 18, -vel * 0.5, vel * 0.1, 0.45, -2.5);
		}
		if(!bDESTROYED && !(GetAge() % 3)) HCE_SmokePuff();
	}
	// HDE's plasma smoke (PlasmaSmoke: one of its smoke sprites, added, rolling, growing a little, drifting after the
	// bolt) as a particle in the bolt's colour: the same puff without an actor thinking for its 40 tics. HDE's eases in
	// to 0.7 and fades out; the particle (drawn a little larger: a particle's sprite reads smaller and dimmer) starts at full and fades over the same life. No smoke sprite: HDE's actor.
	void HCE_SmokePuff()
	{
		TextureID tx = TexMan.CheckForTexture(String.Format("SMKE%c0", 68 + random[PlasmaSmoke](0, 8)), TexMan.Type_Any);
		if(!tx.IsValid())
		{
			let smk = Spawn(smokeType, level.Vec3Offset(pos, vel));
			if(smk) smk.vel = vel * 0.1;
			return;
		}
		double sz = 56 * 0.42 * frandom[PlasmaSmoke](0.75, 1.5);
		// HDE's smoke colours (its PlasmaSmoke_Green / _Blue translations), brighter than the bolt's own shade
		Color sc = smokeType is 'PlasmaSmoke_Blue' ? Color(81, 77, 250) : smokeType is 'PlasmaSmoke_Green' ? Color(81, 250, 77) : col;
		A_SpawnParticleEx(sc, tx, STYLE_Add, SPF_FULLBRIGHT | SPF_ROLL, 40, sz, 0, vel.x, vel.y, vel.z,
			vel.x * 0.03, vel.y * 0.03, vel.z * 0.03, 0, 0, 0, 1.0, -1, sz * 0.1 / 40,
			frandom[PlasmaSmoke](-180, 180), frandom[PlasmaSmoke](-0.5, 0.5));
	}
}

// ---------------------------------------------------------------- grenades
// the frag: the blast's damage times DamageMultiply (HDE's FragGrenadeExplosion is spawned with it scaled)
class HCE_FragGrenade : FragGrenade_Proj
{
	States
	{
	Detonate:
		TNT1 A 1
		{
			if(waterlevel > 0 || HitWater(CurSector, pos)) A_StartSound("Halo/Grenade/Frag/ExplodeWater");
			else A_StartSound("Halo/Grenade/Frag/Explode");
			let e = Spawn("FragGrenadeExplosion", pos);
			if(e) { e.target = target; e.SetDamage(max(1, int(e.Damage * DamageMultiply))); }
		}
		Stop;
	}
}

// the plasma grenade: a scaled blast, and a kill on a player it is stuck to
class HCE_PlasmaGrenade : PlasmaGrenade_Proj
{
	// the blast, scaled by DamageMultiply; first, a stuck player (not one the player stuck himself) takes 10x his
	// health, no armour, no thrust
	override void DoExplode()
	{
		// stuck to the player, a Covenant plasma grenade kills, as in Halo
		if(hitactor && hitactor.player && hitactor.health > 0 && !(target && target.player))
			hitactor.DamageMobj(self, target, max(1000, hitactor.health * 10), 'Explosive', DMG_NO_ARMOR | DMG_THRUSTLESS);
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e) { e.target = target; e.explosionDmg *= DamageMultiply; }
	}
}

// ---------------------------------------------------------------- Plasma Caster (White Hunter, Engineer)
// the Plasma Caster's shot: HDE's blast and splash, the damage scaled
class HCE_PlasmaCasterScaled : PlasmaCasterProj
{
	// a plasma-grenade blast at the impact, scaled
	override void DoExplode()
	{
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e) { e.target = target; e.explosionDmg *= DamageMultiply; }
		Spawn("PlasmaSplashSpawner", pos);
	}
}

// one bomblet of the cluster shot: a small (64-radius, 100 x DamageMultiply) blast
class HCE_PlasmaCasterMiniScaled : PlasmaCasterMiniProj
{
	// a small blast; to change the bomblets' punch, edit the radius and damage here
	override void DoExplode()
	{
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e)
		{
			e.target = target;
			e.explosionRadius = 64;
			e.explosionDmg = 100 * DamageMultiply;
			e.A_SetScale(0.35);
		}
	}
}

// the Plasma Caster's charged shot: a scaled blast that throws two scaled bomblets back the way it came
class HCE_PlasmaCasterClusterScaled : PlasmaCasterClusterProj
{
	// the blast, then two HCE_PlasmaCasterMiniScaled lobbed back within 60 degrees, carrying the same DamageMultiply
	override void DoExplode()
	{
		Spawn("PlasmaSplashSpawner", pos);
		let e = PlasmaGrenadeExplosion(Spawn("PlasmaGrenadeExplosion", pos));
		if(e) { e.target = target; e.explosionDmg *= DamageMultiply; }
		for(int i = 0; i < 2; i++)
		{
			let m = Spawn("HCE_PlasmaCasterMiniScaled", pos);
			if(!m) continue;
			m.target = target;
			m.DamageMultiply = DamageMultiply;
			m.vel = HaloMath.VecFromAngles(angle + 180 + frandom[CasterCluster](-60, 60), 0, 8);
			m.vel.z = frandom[CasterCluster](5, 10);
		}
	}
}

// ---------------------------------------------------------------- rocket
// the rocket (Marines, Flood with launchers): HDE's rocket with the blast's damage scaled
class HCE_RocketScaled : HaloRocketProj
{
	mixin HCE_NerfMixin;
	States
	{
	Crash:
	XDeath:
	Death:
		MODL A 1
		{
			A_StopSound(CHAN_BODY);
			A_StartSound("Halo/Weapons/RocketLauncher/Explode", CHAN_AUTO, CHANF_OVERLAP, attenuation:0.1);
			let e = Spawn("HaloRocketExplosion", pos);
			if(e) { e.target = target; e.SetDamage(max(1, int(e.Damage * DamageMultiply))); }
		}
		Stop;
	}
}

// ---------------------------------------------------------------- fuel rod
// the fuel rod's blast: 128 x hce_scale over 256 units (HDE's numbers), its splash, its toxic cloud (HCE_FuelRodDamager,
// pulsing less often the lower the scale) and HDE's smoke, sparks and flare. hce_scale is set by HCE_FuelRodScaled.
class HCE_FuelRodExplosion : Fuelrod_Explosion
{
	double hce_scale;
	Default { Fuelrod_Explosion.SetupSmoke 1.0, 120; }
	States
	{
	Spawn:
		TNT1 A 0;
		TNT1 A 1
		{
			double m = hce_scale > 0 ? hce_scale : 1.0;
			let splash = Spawn("LargeSplashSpawner", pos);
			if(splash) splash.A_SetScale(splash.Scale.X * 2.0);
			A_Explode(max(1, int(128 * m)), 256);
			A_StartSound("Halo/Weapons/Fuelrod/Explosion", flags:CHANF_OVERLAP, attenuation:0.1);
			let toxic = HCE_FuelRodDamager(Spawn("HCE_FuelRodDamager", (pos.xy, pos.z + 10)));
			if(toxic)
			{
				// the toxic cloud keeps HDE's 4 a pulse but pulses less often: damage over time follows the nerf
				toxic.target = target;
				toxic.SetDamage(max(1, int(4 * smokeDmg + 0.5)));
				toxic.hce_step = max(2, int(2 / max(0.05, m) + 0.5));
			}
			HaloMath.SpawnFX("Fuelrod_Smoke", (pos.xy, pos.z), angle, random[FuelrodRNG](4, 12), smokeDist, 60);
			let sparks = Spawn("ImpactSparks", pos);
			if(sparks) sparks.A_SetScale(0.25, 0.25);
		}
		SX04 A 1
		{
			let flare = Spawn("TankRocket_Flare", (pos.xy, pos.z + 30));
			if(flare)
			{
				flare.A_SetScale(0.25, 0.25);
				if(fillcolor) { flare.A_SetRenderStyle(1.0, STYLE_AddShaded); flare.SetShade(fillcolor); }
			}
		}
		SX04 BCDEFGHIJKLMNOPQ 1 Bright;
		Stop;
	}
}

// the toxic cloud after a fuel rod blast: HDE's damager, but one pulse every hce_step tics (HDE: every 2) for 170 tics
class HCE_FuelRodDamager : Fuelrod_Damager
{
	int hce_step;
	States
	{
	Spawn:
		TNT1 A 1
		{
			if(hce_step < 2) hce_step = 2;
			if(!(GetAge() % hce_step))
				HaloMath.ExplodeEx(self, Damage, Radius, thrustMod:0, damageType:"ToxicPlasma", selfDamage:0.20);
		}
		TNT1 A 0 A_JumpIf(GetAge() > 170, "Null");
		Loop;
	}
}

// the fuel rod shot: HDE's, with the blast swapped for HCE_FuelRodExplosion and the scale handed to it
class HCE_FuelRodScaled : FuelrodPlasma
{
	Default { WraithPlasma.ExplosionType "HCE_FuelRodExplosion"; }
	// HDE's FuelrodPlasma.DoExplosion, copied so the explosion gets hce_scale = DamageMultiply: the blast just behind
	// the point of impact, coloured and scaled like the shot, then 20-30 flying plasma blobs
	override void DoExplosion()
	{
		A_StopSound(CHAN_BODY);
		vector3 fxoffs = HaloMath.V3Offset(angle, pitch, roll, -30, 0, 10, 1.);
		vector3 fxpos = level.vec3offset(pos, fxoffs);
		let expl = Spawn(explosionActor, fxpos);
		if(expl)
		{
			UpdateFXColor(expl, effectShade);
			expl.A_SetScale(expl.default.Scale.X * Scale.X, expl.default.Scale.Y * Scale.Y);
			expl.target = target;
			let fe = HCE_FuelRodExplosion(expl);
			if(fe) fe.hce_scale = DamageMultiply;
		}
		for(int i = 0; i < random[VehpartFX](20, 30); i++)
		{
			double sa = frandom[VehpartFX](0, 180), sd = frandom[VehpartFX](-30, 30);
			vector3 dir = (cos(angle + sa) * sd, sin(angle + sa) * sd, frandom[VehpartFX](-30, 30));
			let fx = Spawn("WraithPlasma_FlyingPlasma", level.vec3offset(fxpos, dir));
			if(fx)
			{
				UpdateFXColor(fx, effectShade);
				double va = frandom[VehpartFX](-180, 180);
				fx.vel = (cos(va), sin(va), sin(frandom[VehpartFX](-45, 45))) * 15;
				fx.Scale.X *= Scale.X; fx.Scale.Y *= Scale.Y;
			}
		}
	}
}

// ---------------------------------------------------------------- needles (supercombine blast)
// the needle: HDE's, with the supercombine's area blast scaled (the per-needle shatter damage on the victim is HDE's own)
class HCE_NeedleScaled : HaloNeedler_Proj
{
	mixin HCE_NerfMixin;
	States
	{
	Death.Explode:
		TRAC A 1
		{
			if(force_explosion || ((needlecount && needlecount.CountNeedles() >= explodecount) && !doexplode && hitactor))
			{
				vector3 explodePos = hitactor ? hitactor.pos + (0, 0, hitactor.height * 0.5) : pos;
				double hitHeight = hitactor ? hitactor.height * 0.5 : height * 0.5;
				Spawn("NeedleExplosion_Flare", explodePos);
				Spawn("NeedleExplosion", explodePos);
				A_StartSound("Halo/Weapons/Needler/SuperCombine", flags:CHANF_OVERLAP);
				for(int i = 0; i < 100; i++)
				{
					double ang = frandom[NeedleDeath](0, 360), pit = frandom[NeedleDeath](-45, 45);
					vector3 rdir = (cos(ang), sin(ang), -sin(pit)) * frandom[NeedleDeath](20, 35);
					A_SpawnParticle("Purple", SPF_FULLBRIGHT, 20, 10.0, ang, 0, 0, hitHeight, rdir.x, rdir.y, rdir.z, 0, 0, 0,
						frandom[NeedleDeath](0.5, 1.0), 0.0125);
				}
				if(needlecount) needlecount.ExplodeNeedles();
				if(hitactor) hitactor.DamageMobJ(self, self.target, shatterdmg * explodecount, "Explosive", 0, angle);
				A_Explode(max(1, int(128 * DamageMultiply)), 200, 0);
				OnSuperCombine(hitactor);
			}
			if(hitactor) hitactor.DamageMobJ(self, self.target, shatterdmg, "Explosive", 0, angle);
			if(needlecount) needlecount.RemoveNeedle(self);
			Spawn("NeedleMiniExplosion", pos);
			for(int i = 0; i < 10; i++)
				A_SpawnParticle("Purple", SPF_FULLBRIGHT | SPF_RELVEL, 35, 5, angle + frandom[NeedleDeath](-90, 90),
					frandom[NeedleDeath](-20, 20), frandom[NeedleDeath](-20, 20), frandom[NeedleDeath](-10, 10),
					10, 10, frandom[NeedleDeath](-8, 8), 0, 0, -0.1, 1.0, 0.14, 0.15);
		}
		TNT1 A 35;
		Stop;
	}
}
