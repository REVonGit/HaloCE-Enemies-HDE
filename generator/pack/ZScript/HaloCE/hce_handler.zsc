// Halo CE enemies replace Doom's monsters (always, unless the CVar hce_keepdoommonsters is set).
// Doom's marines are always replaced by Halo Marines, and any allied (friendly) monster becomes a Marine.
//
// The enemies ship as separate faction packs (Covenant, Flood, Sentinels, Marines) on top of this core.
// Picks from a faction that isn't loaded are skipped, so the remaining classes share its weight; a Doom
// monster whose whole list is missing stays a Doom monster.
//
// Each Doom monster draws from a weighted mix of Halo CE enemies (closest role first); the mix shifts
// toward stronger ranks with the skill level (easy = skills 1-2, normal = 3, hard = 4-5): "Class*weight ...".
class HCE_ReplaceHandler : EventHandler
{
	// Weighted picks, most likely first. Each Doom monster draws from several Halo types so encounters
	// stay mixed; higher skills shift the weights toward the stronger ranks.
	//
	// The table is flat, four strings per row (CheckReplacement walks it in steps of 4):
	//   "DoomClass", "<easy list>", "<normal list>", "<hard list>"
	// The three lists are the skill tiers of SkillTier(): easy = ITYTD and HNTR, normal = HMP, hard = UV and Nightmare.
	// Each list is "Class*weight Class*weight ...", separated by spaces: the class name of a Halo enemy and its
	// relative weight (any whole number; "*weight" left off counts as 1). PickWeighted draws one entry with chance
	// weight / sum of the weights of the entries still in play, so "A*3 B*1" is A three times out of four. An entry
	// whose class isn't loaded (its faction pack is missing), a Flood class before the Flood is out, a Sentinel class
	// with hce_sentinelallies on, or a class whose gun the hce_presets weapon preset leaves out, is dropped from the
	// draw and the others share its weight; a list left with nothing keeps the Doom monster (or falls back through
	// PRE_FLOOD / ALLY_FALLBACK).
	// To make a Doom monster turn into something else, edit its three lists; to replace a Doom monster that isn't here
	// (or a mod's monster), add a row of four strings; a new enemy class only needs adding to a list. The lists are
	// what the generated enemy classes are called (hce_enemies.zsc), so a typo there silently drops the entry.
	static const String RULES[] =
	{
		// Doom monster      easy | normal | hard
		// Zombieman: Grunts (Minor/Major), then Minor Jackals, rarely a Minor Elite
		"ZombieMan",
			"HCE_GruntMinorPlasmaPistol*6 HCE_GruntMinorNeedler*3 HCE_GruntMajorPlasmaPistol*2 HCE_GruntMajorNeedler*1 HCE_JackalMinorPlasmaPistol*2 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMinorPlasmaPistol*5 HCE_GruntMinorNeedler*3 HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*2 HCE_JackalMinorPlasmaPistol*3 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMinorPlasmaPistol*4 HCE_GruntMinorNeedler*3 HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_EliteMinorPlasmaRifle*2",
		// Shotgun Guy: Major Grunts, then Jackals (Minor/Major), then Elites (Minor/Major) and Draeth Minors
		"ShotgunGuy",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_JackalMajorNeedler*1 HCE_EliteMinorPlasmaRifle*1 HCE_DraethMinorPlasmaRifle*1",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_JackalMajorNeedler*2 HCE_EliteMinorPlasmaRifle*2 HCE_EliteMinorNeedler*1 HCE_EliteMajorPlasmaRifle*1 HCE_DraethMinorPlasmaRifle*1 HCE_DraethMinorNeedler*1",
			"HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_JackalMajorNeedler*3 HCE_EliteMinorPlasmaRifle*2 HCE_EliteMinorNeedler*1 HCE_EliteMajorPlasmaRifle*1 HCE_EliteMajorNeedler*1 HCE_DraethMinorPlasmaRifle*1 HCE_DraethMinorNeedler*1",
		// Chaingunner (sustained fire): Major Jackals (needler), Spec-Ops needler Grunts, Ultra Jackals and helmeted Halo 2 Majors (plasma rifle), needler Elites
		"ChaingunGuy",
			"HCE_JackalMajorNeedler*5 HCE_GruntSpecopsNeedler*2 HCE_JackalUltraPlasmaRifle*1 HCE_JackalMajorHelmetPlasmaRifle*1 HCE_EliteMinorNeedler*1",
			"HCE_JackalMajorNeedler*4 HCE_JackalUltraPlasmaRifle*2 HCE_JackalMajorHelmetPlasmaRifle*1 HCE_GruntSpecopsNeedler*2 HCE_EliteMinorNeedler*2 HCE_EliteMinorPlasmaRifleRanged*1",
			"HCE_JackalMajorNeedler*3 HCE_JackalUltraPlasmaRifle*3 HCE_JackalMajorHelmetPlasmaRifle*2 HCE_GruntSpecopsNeedler*2 HCE_EliteMinorNeedler*2 HCE_EliteMajorNeedler*1",
		// Imp (the everyday enemy): Major Grunts, Minor needler Grunts, Jackals, a few Minor Elites
		"DoomImp",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMinorNeedler*3 HCE_GruntMajorNeedler*2 HCE_JackalMinorPlasmaPistol*2 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMajorNeedler*3 HCE_GruntMinorNeedler*2 HCE_JackalMinorPlasmaPistol*2 HCE_JackalMajorNeedler*1 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*3 HCE_GruntSpecopsNeedler*2 HCE_JackalMinorPlasmaPistol*2 HCE_JackalMajorNeedler*2 HCE_EliteMinorPlasmaRifle*2",
		// Pinky (melee charger): unarmed Flood combat forms (Ruby's Rebalance's Marine, Armored Marine and shielded Elite
		// hosts among them), a few with shotguns, and the sword Flood Elite Commander on hard
		"Demon",
			"HCE_FloodcombatHumanUnarmed*4 HCE_FloodcombatEliteUnarmed*3 HCE_FloodcombatHumanUnarmoredUnarmed*2 HCE_FloodcombatHumanArmoredUnarmed*1 HCE_FloodcombatHumanShotgun*1",
			"HCE_FloodcombatHumanUnarmed*3 HCE_FloodcombatEliteUnarmed*3 HCE_FloodcombatHumanUnarmoredUnarmed*2 HCE_FloodcombatHumanArmoredUnarmed*2 HCE_FloodcombatEliteMinorUnarmed*1 HCE_FloodcombatHumanShotgun*1 HCE_FloodcombatEliteShotgun*1",
			"HCE_FloodcombatEliteUnarmed*3 HCE_FloodcombatHumanUnarmed*2 HCE_FloodcombatHumanArmoredUnarmed*2 HCE_FloodcombatEliteMinorUnarmed*2 HCE_FloodcombatEliteMajorUnarmed*1 HCE_FloodcombatEliteShotgun*2 HCE_FloodcombatHumanShotgun*1 HCE_FloodcombatEliteCommanderEnergySword*1",
		// Spectre (invisible): Stealth Elites, stealth Flood Elites, sword-wielding Stealth Majors, cloaked Draeth Commanders
		"Spectre",
			"HCE_StealthElitePlasmaRifle*5 HCE_FloodcombatEliteStealthUnarmed*2 HCE_StealthEliteMajorPlasmaRifle*1 HCE_DraethCommanderBeamRifleCamo*1",
			"HCE_StealthElitePlasmaRifle*4 HCE_StealthEliteMajorPlasmaRifle*2 HCE_FloodcombatEliteStealthUnarmed*2 HCE_StealthEliteMajorEnergySword*1 HCE_DraethCommanderBeamRifleCamo*1",
			"HCE_StealthElitePlasmaRifle*3 HCE_StealthEliteMajorPlasmaRifle*3 HCE_StealthEliteMajorEnergySword*2 HCE_FloodcombatEliteStealthUnarmed*2 HCE_DraethCommanderBeamRifleCamo*1 HCE_DraethCommanderPlasmaCasterCamo*1",
		// Lost Soul (flying kamikaze): the Covenant's Geists (Mercury Rising's little strafing drones) most of all, Halo 2's
		// Constructors (darting, welding drones) and infection forms, now and then the XAM Flood Grunt (it bursts into more of
		// them); before the Flood is out, the Geists and Constructors alone
		"LostSoul",         "HCE_Geist*14 HCE_SentinelConstructor*8 HCE_FloodInfection*6 HCE_FloodGrunt*1", "HCE_Geist*14 HCE_SentinelConstructor*7 HCE_FloodInfection*5 HCE_FloodGrunt*1 HCE_SentinelInterceptor*1 HCE_SentinelScout*1", "HCE_Geist*14 HCE_SentinelConstructor*6 HCE_FloodInfection*4 HCE_FloodGrunt*1 HCE_SentinelInterceptor*2 HCE_SentinelScout*2",
		// Cacodemon (tough flyer): Sentinels of every kind (Galap's and Mercury Rising's among them: the lighter ones early, the Soldiers,
		// Dragoons and the Brute Sentinel on the harder skills)
		"Cacodemon",
			"HCE_Sentinel*4 HCE_SentinelDefensive*2 HCE_SentinelShielded*1 HCE_SentinelProtector*1 HCE_SentinelGold*1 HCE_SentinelInterceptor*1 HCE_SentinelCrawler*1 HCE_SentinelScout*1 HCE_SentinelCanoneer*1 HCE_SentinelArtillery*1",
			"HCE_Sentinel*3 HCE_SentinelShielded*2 HCE_SentinelDefensive*2 HCE_SentinelMajor*1 HCE_SentinelEliminator*1 HCE_SentinelEnforcer*1 HCE_SentinelWarden*1 HCE_SentinelLancer*1 HCE_SentinelGoldShielded*1 HCE_SentinelMarauder*1 HCE_SentinelOnyx*1 HCE_SentinelProtector*1 HCE_SentinelCrawler*1 HCE_SentinelScout*1 HCE_SentinelCanoneer*1 HCE_SentinelArtillery*1 HCE_SentinelCompiler*1 HCE_SentinelOmega*1",
			"HCE_SentinelShielded*3 HCE_SentinelMajor*2 HCE_SentinelShieldedMajor*2 HCE_SentinelEliminator*2 HCE_SentinelEnforcer*2 HCE_Sentinel*1 HCE_SentinelSoldier*1 HCE_SentinelDragoon*1 HCE_SentinelGoldShieldedMajor*1 HCE_SentinelOnyx*1 HCE_SentinelWarden*1 HCE_SentinelLancer*1 HCE_SentinelCanoneer*1 HCE_SentinelArtillery*1 HCE_SentinelCompiler*1 HCE_SentinelOmega*1 HCE_SentinelBrute*1",
		// Hell Knight: Minor Elites, then Ultra Jackals, fuel-rod Spec-Ops Grunts, Major and Heavy Elites; and Sentinel
