// Halo CE enemies replace Doom's monsters (always, unless the CVar hce_keepdoommonsters is set).
// Doom's marines are always replaced by Halo Marines, and any allied (friendly) monster becomes a Marine.
//
// The enemies ship as separate faction packs (Covenant, Flood, Sentinels, Marines) on top of this core.
// Picks from a faction that isn't loaded are skipped, so the remaining classes share its weight; a Doom
// monster whose whole list is missing stays a Doom monster.
//
// Each Doom monster draws from a weighted mix of Halo CE enemies (closest role first); the mix shifts
// toward stronger ranks with the skill level (easy = skills 1-2, normal = 3, hard = 4-5): "Class*weight ...".
class HCE_ReplaceHandler : EventHandler
{
	// Weighted picks, most likely first. Each Doom monster draws from several Halo types so encounters
	// stay mixed; higher skills shift the weights toward the stronger ranks.
	static const String RULES[] =
	{
		// Doom monster      easy | normal | hard
		// Zombieman: Grunts (Minor/Major), then Minor Jackals, rarely a Minor Elite
		"ZombieMan",
			"HCE_GruntMinorPlasmaPistol*6 HCE_GruntMinorNeedler*3 HCE_GruntMajorPlasmaPistol*2 HCE_GruntMajorNeedler*1 HCE_JackalMinorPlasmaPistol*2 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMinorPlasmaPistol*5 HCE_GruntMinorNeedler*3 HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*2 HCE_JackalMinorPlasmaPistol*3 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMinorPlasmaPistol*4 HCE_GruntMinorNeedler*3 HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_EliteMinorPlasmaRifle*2",
		// Shotgun Guy: Major Grunts, then Jackals (Minor/Major), then Elites (Minor/Major)
		"ShotgunGuy",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_JackalMajorNeedler*1 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_JackalMajorNeedler*2 HCE_EliteMinorPlasmaRifle*2 HCE_EliteMinorNeedler*1 HCE_EliteMajorPlasmaRifle*1",
			"HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*3 HCE_JackalMinorPlasmaPistol*3 HCE_JackalMajorNeedler*3 HCE_EliteMinorPlasmaRifle*2 HCE_EliteMinorNeedler*1 HCE_EliteMajorPlasmaRifle*1 HCE_EliteMajorNeedler*1",
		// Chaingunner (sustained fire): Major Jackals (needler), Spec-Ops needler Grunts, Ultra Jackals (plasma rifle), needler Elites
		"ChaingunGuy",
			"HCE_JackalMajorNeedler*5 HCE_GruntSpecopsNeedler*2 HCE_JackalUltraPlasmaRifle*1 HCE_EliteMinorNeedler*1",
			"HCE_JackalMajorNeedler*4 HCE_JackalUltraPlasmaRifle*2 HCE_GruntSpecopsNeedler*2 HCE_EliteMinorNeedler*2 HCE_EliteMinorPlasmaRifleRanged*1",
			"HCE_JackalMajorNeedler*3 HCE_JackalUltraPlasmaRifle*3 HCE_GruntSpecopsNeedler*2 HCE_EliteMinorNeedler*2 HCE_EliteMajorNeedler*1",
		// Imp (the everyday enemy): Major Grunts, Minor needler Grunts, Jackals, a few Minor Elites
		"DoomImp",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMinorNeedler*3 HCE_GruntMajorNeedler*2 HCE_JackalMinorPlasmaPistol*2 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMajorPlasmaPistol*4 HCE_GruntMajorNeedler*3 HCE_GruntMinorNeedler*2 HCE_JackalMinorPlasmaPistol*2 HCE_JackalMajorNeedler*1 HCE_EliteMinorPlasmaRifle*1",
			"HCE_GruntMajorPlasmaPistol*3 HCE_GruntMajorNeedler*3 HCE_GruntSpecopsNeedler*2 HCE_JackalMinorPlasmaPistol*2 HCE_JackalMajorNeedler*2 HCE_EliteMinorPlasmaRifle*2",
		// Pinky (melee charger): unarmed Flood combat forms, a few with shotguns
		"Demon",
			"HCE_FloodcombatHumanUnarmed*5 HCE_FloodcombatEliteUnarmed*3 HCE_FloodcombatHumanShotgun*1",
			"HCE_FloodcombatHumanUnarmed*4 HCE_FloodcombatEliteUnarmed*4 HCE_FloodcombatHumanShotgun*1 HCE_FloodcombatEliteShotgun*1",
			"HCE_FloodcombatEliteUnarmed*4 HCE_FloodcombatHumanUnarmed*3 HCE_FloodcombatEliteShotgun*2 HCE_FloodcombatHumanShotgun*1",
		// Spectre (invisible): Stealth Elites, stealth Flood Elites, sword-wielding Stealth Majors
		"Spectre",
			"HCE_StealthElitePlasmaRifle*5 HCE_FloodcombatEliteStealthUnarmed*2 HCE_StealthEliteMajorPlasmaRifle*1",
			"HCE_StealthElitePlasmaRifle*4 HCE_StealthEliteMajorPlasmaRifle*2 HCE_FloodcombatEliteStealthUnarmed*2 HCE_StealthEliteMajorEnergySword*1",
			"HCE_StealthElitePlasmaRifle*3 HCE_StealthEliteMajorPlasmaRifle*3 HCE_StealthEliteMajorEnergySword*2 HCE_FloodcombatEliteStealthUnarmed*2",
		// Lost Soul (flying kamikaze): infection forms
		"LostSoul",         "HCE_FloodInfection*1", "HCE_FloodInfection*1", "HCE_FloodInfection*1",
