	// Doom's scripted marines -> Halo Marines, always (matched to their weapon)
	// Pairs: "Doom class", "Halo Marine class"; checked before RULES and not subject to hce_keepdoommonsters
	static const String MARINES[] =
	{
		"ScriptedMarine", "HCE_MarineAssaultRifle",
		"MarineFist", "HCE_MarineAssaultRifle",
		"MarinePistol", "HCE_MarineAssaultRifle",
		"MarineBerserk", "HCE_MarineArmoredAssaultRifle",
		"MarineChainsaw", "HCE_MarineArmoredAssaultRifle",
		"MarineShotgun", "HCE_MarineShotgun",
		"MarineSSG", "HCE_MarineArmoredShotgunMajor",
		"MarineChaingun", "HCE_MarineAssaultRifleMajor",
		"MarineRocket", "HCE_MarineArmoredAssaultRifleMajor",
		"MarinePlasma", "HCE_MarinePlasmaRifle",
