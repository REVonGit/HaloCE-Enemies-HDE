			"HCE_BossArachnotronEliteSpecopsPlasmaRifle*1 HCE_BossArachnotronEliteSpecopsNeedler*1",
		// Pain Elemental (spits Lost Souls): Flood Carrier
		"PainElemental",    "HCE_Floodcarrier*1", "HCE_Floodcarrier*1", "HCE_Floodcarrier*1",
		// Revenant (homing rockets): Spec-Ops Grunts and Spec-Ops Elites (homing needles)
		"Revenant",
			"HCE_GruntSpecopsFuelRod*3 HCE_GruntSpecopsNeedler*2 HCE_EliteSpecopsNeedler*2 HCE_EliteSpecopsPlasmaRifle*1",
			"HCE_GruntSpecopsFuelRod*3 HCE_EliteSpecopsNeedler*3 HCE_GruntSpecopsNeedler*1 HCE_EliteSpecopsPlasmaRifle*1",
			"HCE_EliteSpecopsNeedler*3 HCE_GruntSpecopsFuelRod*2 HCE_EliteSpecopsPlasmaRifle*2 HCE_GruntSpecopsNeedler*1",
		// Mancubus (fire-spewing artillery, MAP07 boss): Hunter pairs - blue, Red (flamethrower), White (plasma caster)
		"Fatso",
			"HCE_BossFatsoHunter*3 HCE_BossFatsoHunterRed*2 HCE_BossFatsoHunterWhite*1",
			"HCE_BossFatsoHunter*2 HCE_BossFatsoHunterRed*2 HCE_BossFatsoHunterWhite*2",
			"HCE_BossFatsoHunterRed*2 HCE_BossFatsoHunterWhite*2 HCE_BossFatsoHunter*2",
		// Arch-Vile: Elite Commanders with swords, then plasma-rifle Commanders and sword Stealth Majors
		"Archvile",
			"HCE_EliteCommanderEnergySword*3 HCE_EliteCommanderPlasmaRifle*1",
			"HCE_EliteCommanderEnergySword*3 HCE_EliteCommanderPlasmaRifle*2 HCE_StealthEliteMajorEnergySword*1",
			"HCE_EliteCommanderEnergySword*2 HCE_EliteCommanderPlasmaRifle*2 HCE_StealthEliteMajorEnergySword*2",
		// Cyberdemon: Hunter pairs - Major (2x health), White and Red (3x health)
		"Cyberdemon",
			"HCE_BossCyberdemonHunterMajor*2 HCE_BossCyberdemonHunterWhite*2 HCE_BossCyberdemonHunterRed*1",
			"HCE_BossCyberdemonHunterMajor*2 HCE_BossCyberdemonHunterWhite*2 HCE_BossCyberdemonHunterRed*1",
			"HCE_BossCyberdemonHunterMajor*1 HCE_BossCyberdemonHunterWhite*2 HCE_BossCyberdemonHunterRed*2",
		// Spider Mastermind: Elite Commander (4x health)
		"SpiderMastermind", "HCE_BossSpiderEliteCommanderPlasmaRifle*1", "HCE_BossSpiderEliteCommanderPlasmaRifle*1", "HCE_BossSpiderEliteCommanderPlasmaRifle*1",
		// Wolfenstein SS (secret levels): armed human Flood forms
		"WolfensteinSS",
			"HCE_FloodcombatHumanAssaultRifle*3 HCE_FloodcombatHumanPistol*3 HCE_FloodcombatHumanPlasmaPistol*1",
			"HCE_FloodcombatHumanAssaultRifle*3 HCE_FloodcombatHumanPistol*2 HCE_FloodcombatHumanShotgun*1 HCE_FloodcombatHumanNeedler*1",
			"HCE_FloodcombatHumanAssaultRifle*3 HCE_FloodcombatHumanShotgun*2 HCE_FloodcombatHumanNeedler*1 HCE_FloodcombatHumanRocketLauncher*1"
