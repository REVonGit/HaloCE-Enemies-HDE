	// opt-out (new name on purpose: a saved "hce_replacemonsters=false" from older builds must not disable it)
	static bool KeepDoomMonsters()
	{
		CVar cv = CVar.FindCVar("hce_keepdoommonsters");
		return cv && cv.GetBool();
	}

	// the Flood's arrival (hce_floodlevel): the level a map counts as (MAPxx -> xx, ExMy -> (x - 1) * 9 + y, otherwise
	// its level number), and whether the Flood is out yet on this one
	static int LevelIndex()
	{
		String m = level.mapname.MakeUpper();
		if(m.Left(3) == "MAP") { int n = m.Mid(3).ToInt(); if(n > 0) return n; }
		if(m.Length() == 4 && m.Left(1) == "E" && m.Mid(2, 1) == "M") return (m.Mid(1, 1).ToInt() - 1) * 9 + m.Mid(3, 1).ToInt();
		return max(1, level.levelnum);
	}

	// the level the Flood first appears on (hce_floodlevel, at least 1; 1 without the CVar: the Flood from the start)
	static int FloodLevel()
	{
		CVar cv = CVar.FindCVar("hce_floodlevel");
		return cv ? max(1, cv.GetInt()) : 1;
	}

	// true once this map's level index has reached the Flood's level: Flood entries in RULES are in play
	static bool FloodOut() { return LevelIndex() >= FloodLevel(); }

	// before the Flood is out, the Doom monsters only the Flood stood in for draw from another monster's list instead
	// Pairs: "Doom monster", "the Doom monster whose RULES row it borrows". Used only when its own row gave nothing.
	static const String PRE_FLOOD[] =
	{
		"Demon", "DoomImp", "LostSoul", "Cacodemon", "PainElemental", "Cacodemon", "WolfensteinSS", "ShotgunGuy"   // (Lost Souls: the Geists and Constructors cover them when loaded)
	};

	// with the Sentinels allied (hce_sentinelallies), the monsters only Sentinels stood in for take another row's
	// Pairs like PRE_FLOOD: "Doom monster", "the Doom monster whose RULES row it borrows"
	static const String ALLY_FALLBACK[] =
	{
		"Cacodemon", "HellKnight", "LostSoul", "DoomImp", "PainElemental", "HellKnight"
	};

	// which of the three RULES lists the current skill uses: 0 easy (ITYTD, HNTR), 1 normal (HMP), 2 hard (UV, NM).
	// A mod with more skills than five falls in the hard tier.
	static int SkillTier()
	{
		int sk = G_SkillPropertyInt(SKILLP_ACSReturn);   // 0 = ITYTD ... 4 = Nightmare
		return sk <= 1 ? 0 : (sk == 2 ? 1 : 2);
	}

	// draws one class from a "Class*weight ..." list (the RULES format), or null when nothing in it can be used.
	// Skips classes that aren't loaded, Flood classes before the Flood is out and Sentinel classes with the Sentinels
	// allied. The first pass also skips enemies whose weapons the hce_presets preset doesn't allow; if that empties
	// the list the second pass takes them anyway.
	static class<Actor> PickWeighted(String picks)
	{
		Array<String> opts; picks.Split(opts, " ", TOK_SKIPEMPTY);
		Array<String> names; Array<int> weights; int total = 0;
		bool flood = FloodOut();
		CVar sa = CVar.FindCVar("hce_sentinelallies");
		bool allies = sa && sa.GetBool();
		// HaloDoom Evolved's weapon preset (hce_presets): enemies whose gun it doesn't spawn are left out, unless that
		// would leave none (then the whole list stays, and HaloDoom_EnemyBase.HCE_PresetArm re-arms what it can)
		for(int pass = 0; pass < 2 && total <= 0; pass++)
		{
			for(int i = 0; i < opts.Size(); i++)
			{
				Array<String> nw; opts[i].Split(nw, "*");
				class<Actor> c = nw[0];
				if(!c) continue;                                  // its faction pack isn't loaded
				if(!flood && nw[0].IndexOf("Flood") >= 0) continue;   // the Flood isn't out yet on this level
				if(allies && nw[0].IndexOf("Sentinel") >= 0) continue;   // Sentinels on the player's side don't stand in for monsters
				if(pass == 0)
				{
					class<HaloDoom_EnemyBase> ec = (class<HaloDoom_EnemyBase>)(c);
					if(ec && !(HaloDoom_EnemyBase.HCE_PresetAllows(GetDefaultByType(ec).hce_dropWeapon)
					        && HaloDoom_EnemyBase.HCE_PresetAllows(GetDefaultByType(ec).hce_armWeapon))) continue;
				}
				int w = nw.Size() > 1 ? nw[1].ToInt() : 1;
				names.Push(nw[0]); weights.Push(w); total += w;
			}
		}
		if(total <= 0) return null;
		int r = random[HCERep](1, total);
		for(int i = 0; i < names.Size(); i++)
		{
			r -= weights[i];
			if(r <= 0) return (class<Actor>)(names[i]);
		}
		return null;
	}

	HCE_VariantBook variants;           // the HCEVARS variant definitions loaded (hce_variants.zsc)

	// the variant a Doom monster becomes, if one claims it this time (each takes its chance in number order)
	HCE_VariantDef VariantFor(Name doom)
	{
		for(int n = 0; n < 32; n++)
		{
			let d = variants.defs[n];
			if(!d) continue;
			for(int r = 0; r < d.claims.Size(); r++)
				if(d.claims[r] == doom && random[HCEVariant](1, 100) <= d.chance[r]) return d;
		}
		return null;
	}

	// the HCEVARS lumps are parsed once, when the handler comes up
	override void OnRegister()
	{
		variants = HCE_VariantBook.Read();
	}

	// the replacement itself, in this order: Doom's marines always become Halo Marines (MARINES); then, unless
	// hce_keepdoommonsters is on, an HCEVARS variant that claims the monster (VariantFor), else a weighted draw from
	// its RULES row for the skill tier, falling back through PRE_FLOOD and ALLY_FALLBACK when the row gives nothing.
	// Leaving e.Replacement alone keeps the Doom monster. Another mod's replacement already made final is respected.
	override void CheckReplacement(ReplaceEvent e)
	{
		if(e.IsFinal || !e.Replacee) return;
		Name rn = e.Replacee.GetClassName();
		// a gun HaloDoom Evolved put in for the map's Doom weapon or ammo (its handler runs before this one): human guns
		// more often than its own mix gives (HCE_HDEPickupResolver.WorldWeapon, hce_humanweapons)
		if(e.Replacement)
		{
			let r = HaloDoom_EnemyBase.HCE_SharedResolver();
			Name wn = e.Replacement.GetClassName();
			Name nn = r ? r.WorldWeapon(rn, wn) : wn;
			class<Actor> nc = nn;
			if(nn != wn && nc) { e.Replacement = nc; return; }
		}
		for(int i = 0; i < MARINES.Size(); i += 2)
		{
			if(rn == MARINES[i])
			{
				class<Actor> rc = MARINES[i + 1];
				if(rc) e.Replacement = rc;
				return;
			}
		}
		if(KeepDoomMonsters()) return;
		// HCEVARS variants that claim this Doom monster (hce_variants.zsc)
		if(!variants) variants = HCE_VariantBook.Read();
		let vd = VariantFor(rn);
		if(vd)
		{
			class<Actor> vc = String.Format("HCE_Variant%d", vd.num);
			if(vc) { e.Replacement = vc; return; }
		}
		for(int i = 0; i < RULES.Size(); i += 4)
		{
			if(rn != RULES[i]) continue;
			class<Actor> rc = PickWeighted(RULES[i + 1 + SkillTier()]);
			if(!rc && !FloodOut())
				for(int k = 0; k < PRE_FLOOD.Size(); k += 2)
					if(rn == PRE_FLOOD[k])
						for(int j = 0; j < RULES.Size(); j += 4)
							if(RULES[j] == PRE_FLOOD[k + 1]) { rc = PickWeighted(RULES[j + 1 + SkillTier()]); break; }
			// a row of Sentinels only, with the Sentinels on the player's side: another row's enemies stand in
			if(!rc)
				for(int k = 0; k < ALLY_FALLBACK.Size(); k += 2)
					if(rn == ALLY_FALLBACK[k])
						for(int j = 0; j < RULES.Size(); j += 4)
							if(RULES[j] == ALLY_FALLBACK[k + 1]) { rc = PickWeighted(RULES[j + 1 + SkillTier()]); break; }
			if(rc) e.Replacement = rc;
			return;
		}
	}

	// the reverse lookup: tells the engine which Doom boss a stand-in counts as (BOSSES), so A_BossDeath's map
	// specials fire when it dies
	override void CheckReplacee(ReplacedEvent e)
	{
		if(!e.Replacement) return;
		Name rn = e.Replacement.GetClassName();
		for(int i = 0; i < BOSSES.Size(); i += 2)
		{
			if(rn != BOSSES[i]) continue;
			class<Actor> dc = BOSSES[i + 1];
			if(dc) e.Replacee = dc;
			return;
		}
	}

	// ------------------------------------------------------------------
	// allied monsters become Marines; Hunters spawn as bonded pairs
	// ------------------------------------------------------------------
	Array<HaloDoom_EnemyBase> toMarine;

	// one console line if any Doom monster on the map didn't get replaced, and why
	void ReportUnreplaced()
	{
		int n = 0;
		ThinkerIterator it = ThinkerIterator.Create("Actor");
		Actor a;
		while(a = Actor(it.Next()))
		{
			if(!a.bISMONSTER || a is "HaloDoom_EnemyBase") continue;
			Name cn = a.GetClassName();
			for(int i = 0; i < RULES.Size(); i += 4)
				if(cn == RULES[i] && PickWeighted(RULES[i + 1 + SkillTier()])) { n++; break; }   // only if a pack could have

		}
		if(n == 0) return;
		if(KeepDoomMonsters()) console.printf("\cdHalo CE enemies:\c- %d Doom monsters kept (hce_keepdoommonsters is on).", n);
		else console.printf("\cgHalo CE enemies:\c- %d Doom monsters were not replaced. Another mod's replacement may be loaded after this one.", n);
	}

	// every Halo enemy as it spawns: a friendly one that isn't human is queued to be swapped for a Marine (WorldTick);
	// a hostile pair-bonding one (Hunters) gets a brother, now at map load or next tic later on (hce_hunterpairs)
	override void WorldThingSpawned(WorldEvent e)
	{
		let h = HaloDoom_EnemyBase(e.Thing);
		if(!h || !h.hce_enabled) return;
		if(h.bFRIENDLY && h.hce_team != HCE_TEAM_HUMAN)
		{
			Name mn = 'HCE_MarineAssaultRifle';             // looked up at run time: the Marines pack is optional
			if((class<Actor>)(mn)) toMarine.Push(h);
			return;
		}
		if(!h.bHCE_PairBond || h.bFRIENDLY) return;
		CVar cv = CVar.FindCVar("hce_hunterpairs");
		if(!cv || !cv.GetBool()) return;
		// one that turns up later (a spawner, a replaced monster, a summon) is looked at next tic, once whatever
		// spawned it alongside has spawned too: only a Hunter still on its own gets a brother
		if(level.maptime > 1) { lateHunters.Push(h); return; }
		let it = BlockThingsIterator.Create(h, 256);
		while(it.Next()) if(it.thing != h && it.thing.GetClass() == h.GetClass()) return;
		SpawnBrother(h);
	}

	Array<HaloDoom_EnemyBase> lateHunters;

	// the Hunters that spawned after map load, one tic on: each still without a mate and with no free Hunter of its
	// team within 512 units gets a brother spawned beside it
	void PairLateHunters()
	{
		for(int i = 0; i < lateHunters.Size(); i++)
		{
			let h = lateHunters[i];
			if(!h || h.health <= 0 || h.hce_bondMate) continue;
			if(h.hce_dummy) continue;                          // a display dummy (punkassbitches, scenes) stands alone
			bool mate = false;
			let it = BlockThingsIterator.Create(h, 512);
			while(it.Next())
			{
				let e = HaloDoom_EnemyBase(it.thing);
				if(e && e != h && e.bHCE_PairBond && !e.hce_bondMate && e.health > 0 && e.hce_team == h.hce_team && e.bFRIENDLY == h.bFRIENDLY) { mate = true; break; }
			}
			if(!mate) SpawnBrother(h);
		}
		lateHunters.Clear();
	}

	// a bonded brother beside it (bond rage), at the first spot around it with room
	void SpawnBrother(HaloDoom_EnemyBase h)
	{
		for(int a = 0; a < 360; a += 45)
		{
			vector3 p = h.Vec3Angle(h.radius * 3, h.angle + 90 + a);
			let b = Actor.Spawn(h.GetClass(), p, NO_REPLACE);
			if(b && b.TestMobjLocation())
			{
				b.angle = h.angle;
				let hb = HaloDoom_EnemyBase(b);                    // bonded brothers (bond rage)
				if(hb)
				{
					hb.hce_bondMate = h; h.hce_bondMate = hb; hb.hce_bondLooked = true; h.hce_bondLooked = true;
					hb.hce_dummy = h.hce_dummy; hb.hce_standStill = h.hce_standStill; hb.hce_noMove = h.hce_noMove;   // a dummy's brother is one too
				}
				return;
			}
			if(b) { b.ClearCounters(); b.Destroy(); }     // a spot with no room: not left in the map's kill count
		}
	}

	// ------------------------------------------------------------------
	// Garbage collector (Options > Halo CE Performance: hce_cleanup). Every three seconds: the oldest enemy bodies past
	// hce_maxcorpses, severed limbs past hce_maxgibs and Halo gore floor splats past hce_maxgore fade out and are
	// removed, never one a player can see (a few at a time, so nothing pops). Off by default.
	// ------------------------------------------------------------------
	// a limit CVar's value, or def when the CVar is missing (a negative limit turns that kind of cleanup off)
	static int CleanupLimit(String cvn, int def)
	{
		CVar cv = CVar.FindCVar(cvn);
		return cv ? cv.GetInt() : def;
	}

	// could any player see it go: within 384 units, or within 3072 and in line of sight
	static bool PlayerSees(Actor a)
	{
		for(int i = 0; i < MAXPLAYERS; i++)
		{
			if(!playeringame[i] || !players[i].mo) continue;
			let p = players[i].mo;
			if(p.Distance3D(a) < 384) return true;               // close by: seen or about to be
			if(p.Distance3D(a) < 3072 && p.CheckSight(a, SF_IGNOREVISIBILITY)) return true;
		}
		return false;
	}

	// fade out over half a second, then gone
	static void FadeAway(Actor a)
	{
		if(!a) return;
		let f = new("HCE_FadeAway");
		f.who = a; f.step = max(0.04, a.alpha / 12.0);
		a.bNOINTERACTION = true;
	}

	// one sweep: at most 12 removals, bodies past hce_maxcorpses first (oldest by hce_diedAt), then limbs and gore
	// splats past their limits (oldest by age), skipping anything a player can see. To collect another kind of
	// actor, add it to the kinds / limits / defs arrays below.
	void Cleanup()
	{
		CVar on = CVar.FindCVar("hce_cleanup");
		if(!on || !on.GetBool()) return;
		int budget = 12;                                          // removals a sweep at most
		// bodies, oldest first
		int maxc = CleanupLimit("hce_maxcorpses", 48);
		if(maxc >= 0)
		{
			Array<HaloDoom_EnemyBase> dead;
			let it = ThinkerIterator.Create("HaloDoom_EnemyBase");
			HaloDoom_EnemyBase e;
			while(e = HaloDoom_EnemyBase(it.Next())) if(e.health <= 0 && !e.bNOINTERACTION) dead.Push(e);
			int extra = dead.Size() - maxc;
			while(extra > 0 && budget > 0 && dead.Size())
			{
				int oi = 0;
				for(int i = 1; i < dead.Size(); i++) if(dead[i].hce_diedAt < dead[oi].hce_diedAt) oi = i;
				let o = dead[oi]; dead.Delete(oi);
				if(PlayerSees(o)) continue;
				FadeAway(o); extra--; budget--;
			}
		}
		// severed limbs and Halo gore splats, oldest (longest-lived) first
		static const String kinds[] = { "HCE_LimbGib", "HCE_GoreFloorSplat" };
		static const String limits[] = { "hce_maxgibs", "hce_maxgore" };
		static const int defs[] = { 32, 64 };
		for(int k = 0; k < kinds.Size() && budget > 0; k++)
		{
			int lim = CleanupLimit(limits[k], defs[k]);
			class<Actor> kc = kinds[k];
			if(lim < 0 || !kc) continue;
			Array<Actor> all;
			let it = ThinkerIterator.Create(kc);
			Actor a;
			while(a = Actor(it.Next())) if(!a.bNOINTERACTION || k == 1) all.Push(a);
			int extra = all.Size() - lim;
			while(extra > 0 && budget > 0 && all.Size())
			{
				int oi = 0;
				for(int i = 1; i < all.Size(); i++) if(all[i].GetAge() > all[oi].GetAge()) oi = i;
				let o = all[oi]; all.Delete(oi);
				if(PlayerSees(o)) continue;
				FadeAway(o); extra--; budget--;
			}
		}
	}

	// per tic: the cleanup sweep every 105 tics, late Hunter pairing, the start-of-map console report (tic 2), and the
	// Marine swap for queued friendly monsters: a Marine sized to the monster's health (<= 50 rifleman, <= 100
	// armoured, else armoured Major) takes its place, TID, special, args and ambush flag, and the monster is removed
	// without counting as a kill
	override void WorldTick()
	{
		if(level.maptime % 105 == 52) Cleanup();
		if(lateHunters.Size()) PairLateHunters();
		if(level.maptime == 2)
		{
			ReportUnreplaced();
			if(variants && variants.count) console.printf("\cdHalo CE enemies:\c- %d variants from HCEVARS.", variants.count);
		}
		for(int i = 0; i < toMarine.Size(); i++)
		{
			let h = toMarine[i];
			if(!h || h.health <= 0) continue;
			int hp = h.SpawnHealth();
			Name mc = hp <= 50 ? 'HCE_MarineAssaultRifle' : (hp <= 100 ? 'HCE_MarineArmoredAssaultRifle' : 'HCE_MarineArmoredAssaultRifleMajor');
			let m = Actor.Spawn(mc, h.pos, NO_REPLACE);
			if(!m) continue;
			m.angle = h.angle;
			m.ChangeTid(h.tid);
			m.special = h.special;
			for(int k = 0; k < 5; k++) m.args[k] = h.args[k];
			m.bAMBUSH = h.bAMBUSH;
			h.ChangeTid(0);
			h.ClearCounters();
			h.Destroy();
		}
		toMarine.Clear();
	}
}

// Console command "punkassbitches" (KEYCONF alias for "netevent hce_spawnall"): spawns one of every Halo CE enemy
// class that's loaded (every pack and add-on), side by side in lines in front of the player, facing them.
// "reclaimer" ("netevent hce_spawnsentinels") with only the Sentinels (every Sentinel-team class: the Halo CE and Halo 2
// Sentinels, Enforcers, Constructors, Knights).
// "helljumpers" ("netevent hce_spawnodsts") with only the ODSTs (the ODST rifle and shotgun troopers and Fire Team Raven).
// "leatherneck" ("netevent hce_spawnmarines") does the same with only the Marines (every human-team class: both
// bodies, every gun, Sergeant Johnson), pinned to their spots; "leatherneck2" ("netevent hce_spawnmarines2") spawns the
// same Marines free to move: they join the squad, follow and take orders like any other.
// Except leatherneck2's, they are display dummies with no AI (HCE_DummyTick): they stand still in their idle animation,
// never fight or move, and are there to look at and to test the gore on. Marines come out as allies, as they always do. Blocked spots are retried further ahead, then behind the
// player, then anywhere free nearby.
class HCE_SpawnAllHandler : EventHandler
{
	// "netevent hce_squad <order>" (the Halo CE Squad keys) to the Marines following the player within 1536 units:
	//   0 follow me, 1 hold here, 2 regroup on me, 3 hold fire, 4 open fire, 5 focus fire on the enemy in the
	//   crosshair, 6 suppress (it, or whatever they're fighting), 7 medic (the nearest corpsman patches up the Marine
	//   in the crosshair),
	//   8 weapon (the nearest one that can use it fetches the gun in the crosshair), 9 press that button (the nearest
	//   one goes and uses the switch in the crosshair), 10 reload (everyone tops up his magazine), 11 stack up (on
	//   the door in the crosshair, waiting for the player to go in: HCE_Breach), 12 take position (where the
	//   crosshair points; a lift: onto its floor), 13 frag and clear (stack up, open the door, a grenade in, then in)
	// One of the Marines answers, a moment later (HaloDoom_EnemyBase.HCE_AckLater): whoever was given the job, or one
	// picked at random.
	// The Master Chief says the order (HCE/Chief/*: the Marines pack's sounds); nothing is printed.
	// the Marine each player has in the crosshair (the name / health overlay; the medic order), and when they last did
	HaloDoom_EnemyBase looked[MAXPLAYERS];
	int lookedTic[MAXPLAYERS];

	// the live, friendly, human-team Halo enemy under the player's crosshair within 2048 units, or null
	static HaloDoom_EnemyBase LookedAtMarine(PlayerPawn pl)
	{
		if(!pl || !pl.player) return null;
		FLineTraceData d;
		pl.LineTrace(pl.angle, 2048, pl.pitch, 0, pl.player.viewheight, data: d);
		let m = HaloDoom_EnemyBase(d.HitActor);
		if(!m || !m.hce_enabled || m.health <= 0 || m.hce_team != HCE_TEAM_HUMAN || !m.bFRIENDLY) return null;
		return m;
	}

	// keeps looked[] up to date: a Marine stays "looked at" for 12 tics after the crosshair leaves him, so the overlay
	// can fade rather than blink
	override void WorldTick()
	{
		for(int i = 0; i < MAXPLAYERS; i++)
		{
			if(!playeringame[i] || !players[i].mo) { looked[i] = null; continue; }
			let m = LookedAtMarine(players[i].mo);
			if(m) { looked[i] = m; lookedTic[i] = level.maptime; }
			else if(looked[i] && (looked[i].health <= 0 || level.maptime - lookedTic[i] > 12)) looked[i] = null;
		}
	}

	// over the Marine in the crosshair: his rank and name, and Halo CE's health bar (HaloDoom Evolved's CE HUD art)
	override void RenderOverlay(RenderEvent e)
	{
		let m = looked[consoleplayer];
		if(!m || m.health <= 0 || automapactive) return;
		let wheel = HCE_SquadWheel(EventHandler.Find("HCE_SquadWheel"));
		if(wheel && wheel.wOpen) return;                  // the order wheel is up: it has the middle of the view
		double fade = clamp(1.0 - (level.maptime - lookedTic[consoleplayer] - 4) / 8.0, 0, 1);
		if(fade <= 0) return;
		vector3 head = m.pos + (0, 0, m.height + 2);      // just over the head
		vector3 d = level.Vec3Diff(e.ViewPos, head);
		double ca = cos(e.ViewAngle), sa = sin(e.ViewAngle), cp = cos(e.ViewPitch), sp = sin(e.ViewPitch);
		double fwd = d.x * ca + d.y * sa, left = -d.x * sa + d.y * ca;
		double depth = fwd * cp - d.z * sp, up = fwd * sp + d.z * cp;
		if(depth < 8) return;
		int w = Screen.GetWidth(), h = Screen.GetHeight();
		double fov = players[consoleplayer].FOV;
		double focal = (h * 0.5) / (tan(fov * 0.5) * 0.75);     // the FOV is 4:3's horizontal one
		double sx = w * 0.5 - left / depth * focal;
		double sy = h * 0.5 - up / depth * focal * level.pixelstretch;
		double sc = max(1.0, h / 540.0);
		// the health bar: nine segments, red when low (CE_HB1..9)
		double frac = clamp(m.health / double(max(1, m.SpawnHealth())), 0, 1);
		int bars = clamp(int(ceil(frac * 9)), 1, 9);
		TextureID tex = TexMan.CheckForTexture(String.Format("graphics/hce/healthbar/ce_hb%d.png", bars), TexMan.Type_Any);
		double bw = 168 * 0.55 * sc, bh = 26 * 0.55 * sc;
		if(tex.IsValid())
			Screen.DrawTexture(tex, false, sx - bw * 0.5, sy - bh, DTA_DestWidthF, bw, DTA_DestHeightF, bh, DTA_Alpha, 0.9 * fade);
		// the name above it (HaloDoom Evolved's HUD font, HaloFont, when it's loaded)
		double fk;
		Font f = HCE_SquadWheel.UIFont(fk);
		String n = m.hce_rankName;
		double ts = sc * fk;
		Screen.DrawText(f, Font.CR_LIGHTBLUE, sx - f.StringWidth(n) * ts * 0.5, sy - bh - f.GetHeight() * ts - 2 * sc, n,
			DTA_ScaleX, ts, DTA_ScaleY, ts, DTA_Alpha, fade);
	}

	// carries out "netevent hce_squad <order>" for the player who sent it (the order numbers are listed at the top of
	// the class): gathers the squad within 1536 units, plays the Chief's line, then hands the order on. 0-2 go to
	// every Marine (HCE_Order), 3-6 are fire orders with the aimed-at actor (HCE_FireOrder), 7 sends the nearest free
	// medic to the Marine in the crosshair, 8 sends the nearest Marine that can use it to the gun near the crosshair,
	// 9 sends the nearest Marine to the use-switch the crosshair is on or near. To add an order, extend the line[]
	// sounds here, the clamp, and HCE_SquadWheel's ORDER / LABEL.
	void SquadOrder(ConsoleEvent e)
	{
		if(e.Player < 0 || e.Player >= MAXPLAYERS || !playeringame[e.Player] || !players[e.Player].mo) return;
		let pl = players[e.Player].mo;
		int o = clamp(e.Args[0], 0, 13);
		static const String line[] = { "HCE/Chief/FollowMe", "HCE/Chief/HoldPosition", "HCE/Chief/Regroup", "HCE/Chief/HoldFire", "HCE/Chief/OpenFire",
			"HCE/Chief/Focus", "HCE/Chief/Suppress", "HCE/Chief/Medic", "HCE/Chief/Weapon", "HCE/Chief/PressButton",
			"HCE/Chief/Reload", "HCE/Chief/StackUp", "HCE/Chief/TakePosition", "HCE/Chief/FragClear" };
		Array<HaloDoom_EnemyBase> squad;
		let it = ThinkerIterator.Create("HaloDoom_EnemyBase");
		HaloDoom_EnemyBase m;
		while(m = HaloDoom_EnemyBase(it.Next()))
			if(m.hce_enabled && m.health > 0 && m.HCE_InSquad() && !m.hce_betrayed && m.Distance3D(pl) <= 1536) squad.Push(m);
		for(int i = 0; i < squad.Size(); i++) squad[i].hce_orderPlayer = pl;     // the player who gave the order leads them (co-op)
		// on a channel of its own: the player's pain and landing grunts (CHAN_VOICE) don't cut the order off
		// "medic" with his own feet in the crosshair (looking down 50 degrees or more at no Marine): the Chief is
		// calling the corpsman for himself, in the takes that fit that (HCE/Chief/MedicSelf, split_factions.py)
		bool ownAid = o == 7 && pl.pitch >= 50 && !LookedAtMarine(pl);
		if(ownAid) pl.A_StartSound("HCE/Chief/MedicSelf", 47, CHANF_DEFAULT, 1.0, ATTN_NONE);
		else if(line[o].Length() > 0) pl.A_StartSound(line[o], 47, CHANF_DEFAULT, 1.0, ATTN_NONE);
		if(o == 10)
		{
			for(int i = 0; i < squad.Size(); i++) squad[i].HCE_ReloadOrder();
			AckRandom(squad); return;
		}
		if(o == 12) { HaloDoom_EnemyBase.HCE_TakePosition(squad, pl); AckRandom(squad); return; }
		if(o == 11 || o == 13) { if(HCE_Breach.Start(squad, pl, o == 13)) AckRandom(squad); return; }
		if(o <= 2)
		{
			for(int i = 0; i < squad.Size(); i++) squad[i].HCE_Order(o);
			if(o == 1) HaloDoom_EnemyBase.HCE_Perimeter(squad);       // hold: an all-round defence
			AckRandom(squad); return;
		}
		if(o <= 6)
		{
			Actor aimed = pl.AimTarget();
			for(int i = 0; i < squad.Size(); i++) squad[i].HCE_FireOrder(o, aimed);
			AckRandom(squad);
			return;
		}
		if(o == 9)
		{
			// the switch in the crosshair: a line with a use special
			FLineTraceData d;
			pl.LineTrace(pl.angle, 1536, pl.pitch, TRF_THRUACTORS, pl.player.viewheight, data: d);
			Line sw = null; int side = 0;
			if(d.HitType == TRACE_HitWall && d.HitLine && d.HitLine.special && (d.HitLine.activation & (SPAC_Use | SPAC_UseThrough)))
			{ sw = d.HitLine; side = d.LineSide; }
			else
			{
				// not quite on it: the switch nearest where the crosshair landed, within 96 units
				double bd = 96;
				for(int i = 0; i < level.Lines.Size(); i++)
				{
					Line l = level.Lines[i];
					if(!l.special || !(l.activation & (SPAC_Use | SPAC_UseThrough)) || l.locknumber) continue;
					double dd = (HaloDoom_EnemyBase.HCE_LinePoint(l, d.HitLocation.xy) - d.HitLocation.xy).Length();
					if(dd < bd) { bd = dd; sw = l; side = level.PointOnLineSide(pl.pos.xy, l); }
				}
			}
			if(!sw) return;
			HaloDoom_EnemyBase best = null;
			for(int i = 0; i < squad.Size(); i++) if(!best || squad[i].Distance2D(pl) < best.Distance2D(pl)) best = squad[i];
			if(best) best.HCE_ButtonOrder(sw, side, (HaloDoom_EnemyBase.HCE_LinePoint(sw, pl.pos.xy), pl.pos.z));
			return;
		}
		// the one closest to the player (the medic) or to the gun (the weapon)
		if(o == 7)
		{
			Actor hurt = LookedAtMarine(pl);
			if(!hurt && ownAid) hurt = pl;                                // the Chief himself
			if(!hurt) return;
			let hm = HaloDoom_EnemyBase(hurt);
			// a corpsman in the crosshair patches himself up (corpsmen out of biofoam can't patch anyone)
			if(hm && hm.hce_isMedic && !hm.hce_medicFor && hm.HCE_MedicCharges() > 0) { hm.HCE_MedicOrder(hm); return; }
			HaloDoom_EnemyBase best = null;
			for(int i = 0; i < squad.Size(); i++)
				if(squad[i].hce_isMedic && squad[i].HCE_MedicCharges() > 0 && squad[i] != hurt && !squad[i].hce_medicFor && (!best || squad[i].Distance3D(hurt) < best.Distance3D(hurt))) best = squad[i];
			if(best) best.HCE_MedicOrder(hurt);
			return;
		}
		if(squad.Size() == 0) return;
		FLineTraceData d;
		pl.LineTrace(pl.angle, 1536, pl.pitch, TRF_THRUACTORS, pl.player.viewheight, data: d);
		vector3 at = d.HitLocation;
		Actor gun = null; double gd = 72;
		let bi = BlockThingsIterator.CreateFromPos(at.x, at.y, at.z, 0, 72, false);
		while(bi.Next())
		{
			let t = bi.thing;
			if(!t || squad[0].HCE_GroundWeaponClass(t) == 'None') continue;
			double dd = (t.pos.xy - at.xy).Length();
			if(dd < gd) { gd = dd; gun = t; }
		}
		if(!gun) return;
		// nearest first
		for(int i = 1; i < squad.Size(); i++)
		{
			let k = squad[i]; int j = i - 1;
			while(j >= 0 && squad[j].Distance3D(gun) > k.Distance3D(gun)) { squad[j + 1] = squad[j]; j--; }
			squad[j + 1] = k;
		}
		for(int i = 0; i < squad.Size(); i++) if(squad[i].HCE_WeaponOrder(gun)) return;
	}

	// one Marine of the squad, picked at random, answers the order after a moment
	static void AckRandom(Array<HaloDoom_EnemyBase> squad)
	{
		if(squad.Size() == 0) return;
		squad[random(0, squad.Size() - 1)].HCE_AckLater();
	}

	// the net events: hce_squad goes to SquadOrder; the five spawn-all commands (see the class header) build the
	// line-up: every concrete HaloDoom_EnemyBase class that fits the command, sorted by name, one per look, laid out
	// in rows of up to 640 units across in front of the player, each spawned as a display dummy (or a free Marine for
	// leatherneck2). To change what a command includes, edit the name filters in the first loop.
	override void NetworkProcess(ConsoleEvent e)
	{
		if(e.Name == "hce_squad") { SquadOrder(e); return; }
		if(e.Name != "hce_spawnall" && e.Name != "hce_spawnmarines" && e.Name != "hce_spawnmarines2" && e.Name != "hce_spawnodsts"
			&& e.Name != "hce_spawnsentinels") return;
		bool sentinels = e.Name == "hce_spawnsentinels";          // reclaimer: only the Sentinels
		bool odsts = e.Name == "hce_spawnodsts";                  // helljumpers: only the ODSTs
		bool free = e.Name == "hce_spawnmarines2";                // leatherneck2: the Marines, free to move
		bool marines = odsts || free || e.Name == "hce_spawnmarines";
		String cmd = sentinels ? "reclaimer" : odsts ? "helljumpers" : free ? "leatherneck2" : marines ? "leatherneck" : "punkassbitches";
		if(e.Player < 0 || e.Player >= MAXPLAYERS || !playeringame[e.Player] || !players[e.Player].mo) return;
		let pl = players[e.Player].mo;
		// every concrete enemy class, sorted by name so ranks and weapons of a species stand together
		Array<String> names;
		for(int i = 0; i < AllActorClasses.Size(); i++)
		{
			class<Actor> c = AllActorClasses[i];
			if(!c || c.IsAbstract() || !(c is "HaloDoom_EnemyBase")) continue;
			String n = c.GetClassName();
			if(n.Length() < 4 || n.Mid(n.Length() - 4) == "Base") continue;
			if(marines)
			{
				let d = HaloDoom_EnemyBase(GetDefaultByType(c));
				if(!d || d.hce_team != HCE_TEAM_HUMAN) continue;
				if(odsts && n.IndexOf("Odst") < 0) continue;
			}
			if(sentinels && n.IndexOf("Sentinel") < 0) continue;     // reclaimer: every Sentinel, the allied ones too
			if(marines && n.IndexOf("Sentinel") >= 0) continue;      // (Galap's allied Sentinels are on the human team)
			names.Push(n);
		}
		for(int i = 1; i < names.Size(); i++)
		{
			String k = names[i]; int j = i - 1;
			while(j >= 0 && names[j] > k) { names[j + 1] = names[j]; j--; }
			names[j + 1] = k;
		}
		// a class with several looks (the Chieftain's sets) stands in the line once per look
		Array<int> looks;
		for(int i = 0; i < names.Size(); i++)
		{
			let d = HaloDoom_EnemyBase(GetDefaultByType((class<Actor>)(names[i])));
			int n = d ? max(1, d.HCE_LineupLooks()) : 1;
			if(n == 1) { looks.Push(-1); continue; }
			looks.Push(0);
			for(int k = 1; k < n; k++) { names.Insert(i + 1, names[i]); looks.Insert(i + 1, k); i++; }
		}
		if(names.Size() == 0) { Console.Printf("%s: no Halo CE %s loaded", cmd, sentinels ? "Sentinels" : odsts ? "ODSTs" : marines ? "Marines" : "enemies"); return; }
		// lines across the player's view, starting 160 units ahead: each enemy its own width apart, a new line
		// every 640 units of width (128 further on), so they fit an ordinary room
		vector2 fwd = Actor.AngleToVector(pl.angle, 1), across = Actor.AngleToVector(pl.angle - 90, 1);
		Array<int> rowOf; Array<double> offOf; Array<double> rowWidth;
		double cur = 0; int row = 0;
		for(int i = 0; i < names.Size(); i++)
		{
			double w = GetDefaultByType((class<Actor>)(names[i])).radius * 2 + 24;
			if(cur + w > 640 && cur > 0) { rowWidth.Push(cur); row++; cur = 0; }
			rowOf.Push(row); offOf.Push(cur + w / 2); cur += w;
		}
		rowWidth.Push(cur);
		int made = 0, blocked = 0;
		for(int i = 0; i < names.Size(); i++)
		{
			class<Actor> c = (class<Actor>)(names[i]);
			double at = offOf[i] - rowWidth[rowOf[i]] / 2;
			Actor mo = null;
			for(int tryStep = 0; tryStep < 40 && !mo; tryStep++)
			{
				// a little further on if the spot is blocked, then the same line behind the player; failing that
				// (a wall in the way), any free spot within 1024 units
				double ahead = (160 + 128 * rowOf[i] + 48 * (tryStep % 4)) * (tryStep < 4 ? 1 : -1);
				vector3 spot = (pl.pos.x + fwd.x * ahead + across.x * at, pl.pos.y + fwd.y * ahead + across.y * at, pl.pos.z);
				if(tryStep >= 8)
				{
					vector2 r = Actor.AngleToVector(frandom[HCESpawnAll](0, 360), frandom[HCESpawnAll](96, 1024));
					spot = (pl.pos.x + r.x, pl.pos.y + r.y, pl.pos.z);
				}
				if(!level.IsPointInLevel(spot)) continue;
				mo = Actor.Spawn(c, spot, NO_REPLACE);
				if(!mo) continue;
				mo.SetZ(mo.floorz);
				if(!mo.TestMobjLocation() || mo.ceilingz - mo.floorz < mo.height) { mo.ClearCounters(); mo.Destroy(); mo = null; }
			}
			if(!mo) { blocked++; continue; }
			mo.angle = mo.AngleTo(pl);
			let en = HaloDoom_EnemyBase(mo);
			// no idle patrols: they hold their place in the line (leatherneck2's Marines move as they please)
			// display dummies, no AI: they stand in the line to be looked at and shot (leatherneck2's Marines are the
			// real thing, free to move, follow and take orders)
			if(en) { en.hce_standStill = !free; en.hce_noMove = !free; en.hce_dummy = !free; en.hce_lineupLook = looks[i] + 1; }
			made++;
		}
		Console.Printf("%s: %d %s spawned%s", cmd, made, odsts ? "ODSTs" : marines ? "Marines" : "enemies", blocked ? String.Format(", %d had no room", blocked) : "");
	}
}

// The Master Chief's order wheel. Hold the "Squad: order wheel" key (+hce_wheel), point the mouse at an order and let
// go to give it (or click; right-click or Escape puts it away; 1-7 pick one straight off). Every squad order is on
// it, on two pages of seven (Movement, Combat): the mouse wheel turns the page while it is up, and it opens on the
// page last used. All but follow, hold, regroup and weapon also have keys of their own (Options > Customize Controls >
// Halo CE Squad). While it is
// up the mouse moves the pointer, not the view, and the fire button gives the order instead of shooting.
class HCE_SquadWheel : EventHandler
{
	ui bool wOpen;
	ui double wx, wy;          // the pointer, from the wheel's centre (mouse units, +y up)
	ui int wSel;               // the slice under it, -1: none (the middle)
	ui int wPage;              // the page showing (kept from one opening to the next)
	const SLICES = 7;          // orders on a page
	const PAGES = 2;
	const REACH = 240.0;       // how far the pointer goes
	const DEAD = 48.0;         // the middle: nothing picked

	// page by page, clockwise from the top: the squad order (HCE_SpawnAllHandler.SquadOrder) and its name; the pages' names
	static const int ORDER[] = { 0, 2, 1, 12, 11, 13, 9,          4, 3, 5, 6, 10, 7, 8 };
	static const String LABEL[] = { "Follow", "Regroup", "Hold", "Take position", "Stack up", "Frag and clear", "Button",
		"Open fire", "Hold fire", "Focus", "Suppress", "Reload", "Medic", "Weapon" };
	static const String PAGE[] = { "Movement", "Combat" };

	// the wheel's own (local, ui-side) events from the +hce_wheel key: hce_wheel_open on press, hce_wheel_close on
	// release (gives whatever is under the pointer), hce_wheel_pick <slice> from the console
	override void ConsoleProcess(ConsoleEvent e)
	{
		if(e.Name == "hce_wheel_open")
		{
			if(gamestate != GS_LEVEL || menuactive != Menu.Off || !players[consoleplayer].mo || players[consoleplayer].health <= 0) return;
			wOpen = true; wx = wy = 0; wSel = -1;
		}
		else if(e.Name == "hce_wheel_close") { if(wOpen) Give(); }
		else if(e.Name == "hce_wheel_pick")                       // console / tests: the order's place across the pages
		{
			int k = clamp(e.Args[0], 0, SLICES * PAGES - 1);
			wOpen = true; wPage = k / SLICES; wSel = k % SLICES; Give();
		}
		else if(e.Name == "hce_wheel_page" && wOpen) wPage = (wPage + 1) % PAGES;
	}

	// the Marine add-on's text font: HaloDoom Evolved's HUD font (HaloFont) where it's loaded, else NewSmallFont.
	// k: the scale that draws it at NewSmallFont's size (HaloFont's line is mostly padding)
	static clearscope Font UIFont(out double k)
	{
		Font h = Font.GetFont('HaloFont');
		if(!h) { k = 1; return NewSmallFont; }
		k = 1.6 * NewSmallFont.GetHeight() / max(1, h.GetHeight());
		return h;
	}

	// closes the wheel and, if a slice is picked, sends its order as the hce_squad net event (play side)
	ui void Give()
	{
		wOpen = false;
		if(wSel >= 0 && wSel < SLICES)
		{
			EventHandler.SendNetworkEvent("hce_squad", ORDER[wPage * SLICES + wSel]);
		}
	}

	// clamps the pointer to REACH and works out the slice under it (wSel), -1 inside the DEAD zone; slice 0 is centred
	// on straight up and they go clockwise
	ui void Point()
	{
		double r = sqrt(wx * wx + wy * wy);
		if(r > REACH) { wx *= REACH / r; wy *= REACH / r; r = REACH; }
		if(r < DEAD) { wSel = -1; return; }
		double a = atan2(wx, wy);                                  // degrees clockwise from straight up
		wSel = int(((a + 360 + 180.0 / SLICES) % 360) / (360.0 / SLICES)) % SLICES;
	}

	// while the wheel is up it eats the mouse (moves the pointer), left click (give), right click / Escape (put away)
	// and the 1-0 keys (pick that slice); everything else goes through to the game
	override bool InputProcess(InputEvent e)
	{
		if(!wOpen) return false;
		if(e.Type == InputEvent.Type_Mouse) { wx += e.MouseX; wy += e.MouseY; Point(); return true; }
		if(e.Type == InputEvent.Type_KeyDown)
		{
			if(e.KeyScan == InputEvent.Key_Mouse1) { Give(); return true; }
			if(e.KeyScan == InputEvent.Key_Mouse2 || e.KeyScan == InputEvent.Key_Escape) { wOpen = false; return true; }
			// the mouse wheel: the other page
			if(e.KeyScan == InputEvent.Key_MWheelUp) { wPage = (wPage + PAGES - 1) % PAGES; return true; }
			if(e.KeyScan == InputEvent.Key_MWheelDown) { wPage = (wPage + 1) % PAGES; return true; }
			if(e.KeyScan >= 2 && e.KeyScan < 2 + SLICES) { wSel = e.KeyScan - 2; Give(); return true; }     // the 1-7 keys
		}
		return false;
	}

	// the wheel drops on its own when the level ends, a menu opens or the player dies
	override void UiTick()
	{
		if(wOpen && (gamestate != GS_LEVEL || menuactive != Menu.Off || !players[consoleplayer].mo || players[consoleplayer].health <= 0)) wOpen = false;
	}

	// drawn small and faint over the middle of the view: a thin ring, the order under the pointer lit on it and its
	// name on a soft tab, the others' names dimmed, and a dot for the pointer
	override void RenderOverlay(RenderEvent e)
	{
		if(!wOpen) return;
		int w = Screen.GetWidth(), h = Screen.GetHeight();
		double cx = w / 2.0, cy = h / 2.0, sc = h / 1080.0;
		double rRing = 120 * sc, rLab = 168 * sc;
		Color ring = Color(255, 120, 190, 255), lit = Color(255, 190, 230, 255), tab = Color(255, 20, 60, 110);
		double slice = 360.0 / SLICES;
		// the ring: faint, with the slice under the pointer drawn bright and thicker
		int seg = 6;
		for(int i = 0; i < SLICES; i++)
		{
			bool on = i == wSel;
			double a0 = i * slice - slice / 2 + 2, a1 = i * slice + slice / 2 - 2;    // a small gap between slices
			for(int k = 0; k < seg; k++)
			{
				double b0 = a0 + (a1 - a0) * k / seg, b1 = a0 + (a1 - a0) * (k + 1) / seg;
				Screen.DrawThickLine(int(cx + sin(b0) * rRing), int(cy - cos(b0) * rRing), int(cx + sin(b1) * rRing), int(cy - cos(b1) * rRing),
					(on ? 4.0 : 1.5) * sc, on ? lit : ring, on ? 230 : 90);
			}
		}
		double fk;
		Font f = UIFont(fk);
		double ts = 1.5 * sc * fk;
		for(int i = 0; i < SLICES; i++)
		{
			// on a wide ellipse round the ring, each name set off from it on its own side (the left ones end at
			// their point, the right ones start there, the top and bottom ones centred), so none crowd the next
			double a = i * slice, sa = sin(a), ca = cos(a);
			double x = cx + sa * rLab * 1.35, y = cy - ca * rLab * 1.05;
			String t = LABEL[wPage * SLICES + i];
			double tw = f.StringWidth(t) * ts, th = f.GetHeight() * ts;
			double lx = abs(sa) < 0.2 ? x - tw / 2 : sa > 0 ? x - tw * 0.15 : x - tw * 0.85;
			bool on = i == wSel;
			if(on) Screen.Dim(tab, 0.55, int(lx - 8 * sc), int(y - th / 2 - 3 * sc), int(tw + 16 * sc), int(th + 6 * sc));
			Screen.DrawText(f, on ? Font.CR_WHITE : Font.CR_LIGHTBLUE, lx, y - th / 2, t,
				DTA_ScaleX, ts, DTA_ScaleY, ts, DTA_Alpha, on ? 1.0 : 0.6);
		}
		// the page in the middle, with a dot for each page (the one showing lit) and the hint to turn it
		{
			String pn = PAGE[wPage];
			double ps = 1.2 * sc * fk, pw = f.StringWidth(pn) * ps, ph = f.GetHeight() * ps;
			Screen.DrawText(f, Font.CR_WHITE, cx - pw / 2, cy - rRing * 0.42 - ph / 2, pn, DTA_ScaleX, ps, DTA_ScaleY, ps, DTA_Alpha, 0.85);
			for(int k = 0; k < PAGES; k++)
			{
				double dx = cx + (k - (PAGES - 1) / 2.0) * 14 * sc, dy = cy + rRing * 0.42, dr = 3 * sc;
				Screen.Dim(k == wPage ? lit : ring, k == wPage ? 0.9 : 0.4, int(dx - dr), int(dy - dr), int(dr * 2 + 1), int(dr * 2 + 1));
			}
			String hint = "Mouse wheel: next page";
			// as big as fits across the ring at that height (with a margin), never bigger than the page's name
			double hy = rRing * 0.42 + 8 * sc, hs = 0.9 * sc * fk;
			double hh = f.GetHeight() * hs, room = 2 * sqrt(max(0, (rRing - 10 * sc) ** 2 - (hy + hh) ** 2));
			hs = min(hs, room / max(1, f.StringWidth(hint)));
			double hw = f.StringWidth(hint) * hs;
			Screen.DrawText(f, Font.CR_LIGHTBLUE, cx - hw / 2, cy + hy, hint, DTA_ScaleX, hs, DTA_ScaleY, hs, DTA_Alpha, 0.8);
		}
		// the pointer: a dot inside the ring
		double pr = min(sqrt(wx * wx + wy * wy) / REACH, 1.0) * (rRing - 14 * sc);
		double pa = atan2(wx, wy);
		double px = cx + sin(pa) * pr, py = cy - cos(pa) * pr, ds = 3 * sc;
		Screen.Dim(wSel >= 0 ? lit : ring, 0.85, int(px - ds), int(py - ds), int(ds * 2 + 1), int(ds * 2 + 1));
	}
}

// the garbage collector's fade (HCE_ReplaceHandler.Cleanup): translucent, then removed
class HCE_FadeAway : Thinker
{
	Actor who;
	double step;
	// takes step off the actor's alpha each tic; at 0 the actor goes (and never counts as a kill or item), then so
	// does the thinker
	override void Tick()
	{
		if(!who) { Destroy(); return; }
		double a = who.alpha - step;
		if(a > 0.899 && a < 1.0) a = 0.899;   // straight under the derez band (alpha just under 1: hce_derez.fp)
		if(a <= 0) { who.ClearCounters(); who.Destroy(); Destroy(); return; }
		who.A_SetRenderStyle(a, STYLE_Translucent);
	}
}

// ---------------------------------------------------------------------------
// Encounters: on maps not made for these packs, a Marine fire team turns up fighting a group of the Covenant or the
// Flood somewhere along the way, so a player can come upon a firefight already going. At a map's start a few groups of
// hostile Halo enemies (two or more together, well away from the players' start, out of secret and damaging sectors)
// get a fire team of 3 to 5 Marines placed in the open a few hundred units off, in sight of them (never in a small room
// with enemies in it: RoomFits). Their fight is held
// until a player comes (HaloDoom_EnemyBase.HCE_EncounterScale: AI hits do little while the players are far, and leave
// everyone at 40% health), so it is still going when one arrives, and heard from afar. The Marines left standing join
// the player's squad when he reaches them: once their foes are down (a "thanks"), or straight away if he walks right up.
// hce_encounters: how many a map can have (0: none); hce_encounterchance: the chance of each. Needs the Marines pack.
// ---------------------------------------------------------------------------
// one staged firefight: where the foes stood (site), the Marines and foes in it, and whether the player has reached it
class HCE_Encounter
{
	vector3 site;
	Array<HaloDoom_EnemyBase> marines, foes;
	bool joined;
}

// sets the encounters up at map load (WorldLoaded / Place) and watches for a player reaching one (WorldTick)
class HCE_Encounters : EventHandler
{
	Array<HCE_Encounter> enc;

	// the fire team's make-up: mostly riflemen, a heavier gun or two, now and then a field medic (looked up at run time; missing ones are skipped)
	// Each man is one draw from this list, so a class listed twice turns up twice as often; add or repeat entries to
	// change the mix. A class that isn't loaded falls back to the rifleman.
	static const Name TEAM[] = { 'HCE_MarineAssaultRifle', 'HCE_MarineAssaultRifle', 'HCE_MarineAssaultRifle', 'HCE_MarineAssaultRifleMajor',
		'HCE_MarineBattleRifle', 'HCE_MarineShotgun', 'HCE_MarineSmg', 'HCE_MarineArmoredAssaultRifle', 'HCE_MarineMedicAssaultRifle',
		'HCE_MarineSniper', 'HCE_MarineRocketLauncher', 'HCE_MarineFieldMedicMagnum' };

	// no encounter in a secret sector, a damaging one, or one under 72 units tall at its centre
	static bool BadSector(Sector s) { return !s || s.IsSecret() || s.damageamount > 0 || s.ceilingplane.ZatPoint(s.centerspot) - s.floorplane.ZatPoint(s.centerspot) < 72; }

	// Rooms: the map's sectors joined across every two-sided line a Marine could walk through at the map's start (an
	// opening 56 tall or more, a step of 24 or less, not a line that blocks walkers: a shut door parts two rooms), each
	// with its floor area and the hostile monsters standing in it. A fire team isn't placed in a room smaller than
	// SMALL_ROOM (in square map units) with an enemy in it (a cramped dead end like a key alcove holds them in a
	// slaughter); an empty small room is fine.
	const SMALL_ROOM = 640.0 * 512.0;
	Array<int> roomOf;                  // per sector: its room
	Array<double> roomArea;             // per room: its floor area
	Array<int> roomFoes;                // per room: the hostile monsters in it
	static double SectorArea(Sector s)
	{
		double a = 0;
		for(int i = 0; i < s.Lines.Size(); i++)
		{
			Line l = s.Lines[i];
			double c = l.v1.p.x * l.v2.p.y - l.v2.p.x * l.v1.p.y;
			if(l.frontsector == s) a += c;
			if(l.backsector == s) a -= c;
		}
		return abs(a) / 2;
	}
	static bool Walkable(Line l)
	{
		if(!l.backsector || l.frontsector == l.backsector) return l.backsector != null;
		if(l.flags & (Line.ML_BLOCKING | Line.ML_BLOCKEVERYTHING | Line.ML_BLOCKMONSTERS)) return false;
		vector2 m = l.v1.p + l.delta / 2;
		double f1 = l.frontsector.floorplane.ZatPoint(m), f2 = l.backsector.floorplane.ZatPoint(m);
		double top = min(l.frontsector.ceilingplane.ZatPoint(m), l.backsector.ceilingplane.ZatPoint(m));
		return abs(f1 - f2) <= 24 && top - max(f1, f2) >= 56;
	}
	void FindRooms()
	{
		roomOf.Clear(); roomArea.Clear(); roomFoes.Clear();
		for(int i = 0; i < level.Sectors.Size(); i++) roomOf.Push(-1);
		Array<int> q;
		for(int s0 = 0; s0 < level.Sectors.Size(); s0++)
		{
			if(roomOf[s0] >= 0) continue;
			int r = roomArea.Size();
			roomArea.Push(0); roomFoes.Push(0);
			roomOf[s0] = r; q.Clear(); q.Push(s0);
			while(q.Size())
			{
				Sector s = level.Sectors[q[q.Size() - 1]];
				q.Pop();
				roomArea[r] += SectorArea(s);
				for(int i = 0; i < s.Lines.Size(); i++)
				{
					Line l = s.Lines[i];
					if(!Walkable(l)) continue;
					Sector o = l.frontsector == s ? l.backsector : l.frontsector;
					if(roomOf[o.Index()] >= 0) continue;
					roomOf[o.Index()] = r; q.Push(o.Index());
				}
			}
		}
		let it = ThinkerIterator.Create("Actor");
		Actor a;
		while(a = Actor(it.Next()))
			if(a.bISMONSTER && !a.bFRIENDLY && a.health > 0 && a.CurSector && !(a is "HaloDoom_EnemyBase" && HaloDoom_EnemyBase(a).hce_team == HCE_TEAM_HUMAN))
				roomFoes[roomOf[a.CurSector.Index()]]++;
	}
	// may a Marine of the fire team stand in this sector's room?
	bool RoomFits(Sector s)
	{
		if(!s || roomOf.Size() != level.Sectors.Size()) return true;
		int r = roomOf[s.Index()];
		return roomArea[r] >= SMALL_ROOM || roomFoes[r] == 0;
	}

	// the distance from p to the closest player in the game (1e9 with none)
	static double NearestPlayer(vector3 p)
	{
		double d = 1e9;
		for(int i = 0; i < MAXPLAYERS; i++)
			if(playeringame[i] && players[i].mo) d = min(d, (players[i].mo.pos - p).Length());
		return d;
	}

	// at a fresh map start (not a save, a reopen or deathmatch): rolls hce_encounterchance once per hce_encounters
	// slot, then looks for groups of two or more hostile Covenant / Flood within 512 units of each other, at least
	// 2048 from every player and 1536 from other encounters, and places a fire team by each (Place) until the count
	// is met. "HCEENC n" on the console (no notify) is for the tests.
	override void WorldLoaded(WorldEvent e)
	{
		if(e.IsSaveGame || e.IsReopen || deathmatch) return;
		int want = CVar.FindCVar("hce_encounters") ? CVar.FindCVar("hce_encounters").GetInt() : 0;
		double chance = CVar.FindCVar("hce_encounterchance") ? CVar.FindCVar("hce_encounterchance").GetFloat() : 0;
		Name first = 'HCE_MarineAssaultRifle';
		if(want <= 0 || !(class<Actor>)(first)) return;          // no Marines pack: nothing to do
		int n = 0;
		for(int i = 0; i < want; i++) if(frandom[HCEEnc](0, 1) < chance) n++;
		if(n == 0) return;
		// the hostile Halo enemies, in a random order
		Array<HaloDoom_EnemyBase> cand;
		let it = ThinkerIterator.Create("HaloDoom_EnemyBase");
		HaloDoom_EnemyBase h;
		while(h = HaloDoom_EnemyBase(it.Next()))
		{
			if(!h.hce_enabled || h.bFRIENDLY || h.health <= 0 || h.hce_dummy || h.bDORMANT) continue;
			if(h.hce_team != HCE_TEAM_COVENANT && h.hce_team != HCE_TEAM_FLOOD) continue;
			if(BadSector(h.CurSector) || NearestPlayer(h.pos) < 2048) continue;   // well off: the fight held at a twentieth
			cand.Push(h);
		}
		for(int i = cand.Size() - 1; i > 0; i--) { int j = random[HCEEnc](0, i); let t = cand[i]; cand[i] = cand[j]; cand[j] = t; }
		FindRooms();
		for(int i = 0; i < cand.Size() && enc.Size() < n; i++)
		{
			let c = cand[i];
			bool far = true;
			for(int k = 0; k < enc.Size(); k++) if((enc[k].site - c.pos).Length() < 1536) far = false;   // encounters well apart
			if(!far) continue;
			Array<HaloDoom_EnemyBase> foes;
			for(int k = 0; k < cand.Size(); k++)
				if(cand[k].Distance3D(c) < 512 && cand[k].hce_team == c.hce_team && abs(cand[k].pos.z - c.pos.z) < 96) foes.Push(cand[k]);
			if(foes.Size() < 2) continue;
			let en = Place(c, foes);
			if(en) enc.Push(en);
		}
		if(enc.Size()) Console.PrintfEx(PRINT_NONOTIFY, "HCEENC %d encounter%s", enc.Size(), enc.Size() == 1 ? "" : "s");
	}

	// a fire team in the open a few hundred units from c, in its sight, on about its level
	HCE_Encounter Place(HaloDoom_EnemyBase c, Array<HaloDoom_EnemyBase> foes)
	{
		for(int tryN = 0; tryN < 32; tryN++)
		{
			double a = frandom[HCEEnc](0, 360), d = frandom[HCEEnc](300, 640);
			FLineTraceData lt;
			c.LineTrace(a, d + 64, 0, TRF_THRUACTORS, c.height * 0.6, 0, 0, lt);
			if(lt.HitType != TRACE_HitNone) d = min(d, lt.Distance - 64);
			if(d < 256) continue;
			vector2 xy = c.pos.xy + Actor.AngleToVector(a, d);
			Sector s = level.PointInSector(xy);
			if(BadSector(s) || !RoomFits(s)) continue;
			double z = s.floorplane.ZatPoint(xy);
			if(abs(z - c.pos.z) > 64 || NearestPlayer((xy, z)) < 1792) continue;
			// the men side by side across the line to the foe, 44 apart
			let en = new("HCE_Encounter");
			en.site = c.pos;
			int men = random[HCEEnc](3, 5);
			vector2 side = Actor.AngleToVector(a + 90, 44);
			for(int m = 0; m < men; m++)
			{
				Name cn = TEAM[random[HCEEnc](0, TEAM.Size() - 1)];
				class<Actor> mc = (class<Actor>)(cn);
				if(!mc) { Name fb = 'HCE_MarineAssaultRifle'; mc = (class<Actor>)(fb); }
				vector2 p = xy + side * (m - (men - 1) * 0.5);
				Sector ps = level.PointInSector(p);
				if(BadSector(ps) || !RoomFits(ps)) continue;
				let mo = HaloDoom_EnemyBase(Actor.Spawn(mc, (p, ps.floorplane.ZatPoint(p)), ALLOW_REPLACE));
				if(!mo) continue;
				if(!mo.TestMobjLocation() || !mo.CheckSight(c)) { mo.ClearCounters(); mo.Destroy(); continue; }
				mo.angle = mo.AngleTo(c);
				mo.bHCE_FollowPlayer = false;                 // holding here, fighting, till the player comes
				mo.hce_encounter = true;
				en.marines.Push(mo);
			}
			if(en.marines.Size() < 3)
			{
				for(int m = 0; m < en.marines.Size(); m++) if(en.marines[m]) en.marines[m].Destroy();
				continue;
			}
			for(int k = 0; k < foes.Size(); k++) { foes[k].hce_encounter = true; en.foes.Push(foes[k]); }
			return en;
		}
		return null;
	}

	// every 17 tics, for each encounter not yet joined: once a live player is close to a surviving Marine (256, or in
	// sight within 512, or 640 with the foes down), the fight becomes an ordinary one, the Marines fall in behind that
	// player, and one of them says thanks (foes down) or calls him over
	override void WorldTick()
	{
		if(level.maptime % 17) return;
		for(int i = 0; i < enc.Size(); i++)
		{
			let en = enc[i];
			if(en.joined) continue;
			// the Marines still standing, the foes still fighting near the site
			Array<HaloDoom_EnemyBase> men;
			for(int k = 0; k < en.marines.Size(); k++) if(en.marines[k] && en.marines[k].health > 0 && !en.marines[k].hce_betrayed) men.Push(en.marines[k]);
			if(!men.Size()) { en.joined = true; continue; }
			// foes still in the fight: alive, near, and after someone (one asleep or wandered off doesn't hold them back)
			int foes = 0;
			for(int k = 0; k < en.foes.Size(); k++)
			{
				let f = en.foes[k];
				if(f && f.health > 0 && f.target && f.target.health > 0 && f.Distance3D(men[0]) < 1536) foes++;
			}
			// the player who reached them: in sight of one of them within 512 (640 once the foes are down), or right beside one (256)
			PlayerPawn who = null;
			for(int p = 0; p < MAXPLAYERS && !who; p++)
			{
				if(!playeringame[p] || !players[p].mo || players[p].mo.health <= 0) continue;
				let pm = players[p].mo;
				for(int k = 0; k < men.Size(); k++)
				{
					double d = men[k].Distance3D(pm);
					if(d < 256 || (d < 512 && men[k].CheckSight(pm)) || (foes == 0 && d < 640 && men[k].CheckSight(pm))) { who = pm; break; }
				}
			}
			if(!who) continue;
			en.joined = true;
			for(int k = 0; k < en.foes.Size(); k++) if(en.foes[k]) en.foes[k].hce_encounter = false;   // an ordinary fight from here
			for(int k = 0; k < men.Size(); k++)
			{
				men[k].hce_encounter = false;
				men[k].bHCE_FollowPlayer = true;
				men[k].hce_orderPlayer = who;
				men[k].hce_squadOrder = HaloDoom_EnemyBase.HCE_ORDER_FOLLOW;
			}
			men[random[HCEEnc](0, men.Size() - 1)].HCE_Say(foes == 0 ? 'Thanks' : 'JoinMe', 1.0, 35 * 3, true);
		}
	}
}
