		Stop;
		Raise:
			TROO ML 8;
			TROO KJI 6;
		Goto See;
	}
}
*/

// Live missiles, for the AI's dodging: projectiles aren't in the blockmap, so a BlockThingsIterator can't find
// them. Registered by the core / bundle MAPINFO.
class HCE_MissileTracker : EventHandler
{
	Array<Actor> missiles;
	override void WorldThingSpawned(WorldEvent e)
	{
		if(e.Thing && e.Thing.bMISSILE) missiles.Push(e.Thing);
	}
	override void WorldTick()
	{
		if(level.maptime % 35) return;
		for(int i = missiles.Size() - 1; i >= 0; i--)
			if(!missiles[i] || !missiles[i].bMISSILE) missiles.Delete(i);
	}
}
