	{
		Info.DamageTaken:
			TNT1 A 0 A_JumpIf(A_CheckDamageInfo("HaloShotgun_Bullet", false) && A_GetDamageTaken(killed:true), "Death.Shotgun");
 			TNT1 A 0 A_ResumePrevious();
		goto See;
	
		Spawn:
			TROO AB 10 A_Look;
