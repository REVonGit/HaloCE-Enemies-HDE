	Property HCE_Drops : hce_dropWeapon, hce_dropGrenade;
	Property HCE_Kamikaze : hce_kamiChance;
	Property HCE_Jump : hce_jumpHeight;

	flagdef HCE_Surprise : hce_bflags, 0;
	flagdef HCE_Panics : hce_bflags, 1;
	flagdef HCE_Berserks : hce_bflags, 2;
	flagdef HCE_SeeksCover : hce_bflags, 3;
	flagdef HCE_Evades : hce_bflags, 4;
	flagdef HCE_ThrowsGrenades : hce_bflags, 5;
	flagdef HCE_AlwaysBerserk : hce_bflags, 6;
	flagdef HCE_Flying : hce_bflags, 7;
	flagdef HCE_Swarm : hce_bflags, 8;
	flagdef HCE_Leaps : hce_bflags, 9;
	flagdef HCE_Resurrects : hce_bflags, 10;
	flagdef HCE_FrontArmor : hce_bflags, 11;
	flagdef HCE_PairBond : hce_bflags, 12;
	flagdef HCE_Leader : hce_bflags, 13;
	flagdef HCE_ActiveCamo : hce_bflags, 14;
	flagdef HCE_Explodes : hce_bflags, 15;
	flagdef HCE_Beam : hce_bflags, 16;
	flagdef HCE_FollowPlayer : hce_bflags, 17;
	flagdef HCE_FrontShield : hce_bflags, 18;
	flagdef HCE_Lobbed : hce_bflags, 19;       // weapon lobs gravity projectiles on a ballistic arc
	flagdef HCE_ShieldStun : hce_bflags, 20;   // Elites: a hard-ping stun when the energy shield pops

	// ------------------------------------------------------------------
	// Animation table -- overridden by each generated character class
	// ------------------------------------------------------------------
	virtual Name HCE_AnimName(int kind) { return 'None'; }
	virtual int  HCE_AnimTics(Name anim) { return 30; }   // length in Doom tics
	virtual vector3 HCE_AnimMove(Name anim) { return (0, 0, 0); }   // how far a hoist / vault carries the body (forward, left, up)

	bool HCE_HasAnim(int kind) { return HCE_AnimName(kind) != 'None'; }

	// force: only locked one-shots (throw, dive, flinch...) and deaths may replace a locked animation
	// out of a fight (no target, ten seconds after the last): Halo 2's low ready (low_ready_anims.py)
	bool HCE_Relaxed() { return !target && level.maptime > hce_combatUntil && !hce_berserk && hce_lowWalkSpeed > 0; }

	void HCE_Play(int kind, bool loop = true, bool restart = false, int blend = 4, bool force = false)
	{
		if(!bDECOUPLEDANIMATIONS) return;
		if((kind == HCE_A_IDLE || (kind == HCE_A_MOVE_F && hce_moveSpeed <= hce_lowWalkSpeed * 1.05)) && HCE_Relaxed())
		{
			int low = kind == HCE_A_IDLE ? HCE_A_LOW_IDLE : HCE_A_LOW_MOVE;
			if(HCE_AnimName(low) != 'None') kind = low;
		}
		if(hce_animLock > 0 && !force) return;
		kind = HCE_GuardKind(kind);
		if(!restart && loop && kind == hce_curAnimKind && hce_curAnim != 'None') return;
		Name n = HCE_AnimName(kind);
		if(n == 'None')
		{
			// sensible fallbacks
			if(kind == HCE_A_ALERT || kind == HCE_A_CROUCH_IDLE || kind == HCE_A_FIRE) n = HCE_AnimName(HCE_A_IDLE);
			else if(kind >= HCE_A_MOVE_B && kind <= HCE_A_MOVE_R || kind == HCE_A_CROUCH_MOVE || kind == HCE_A_FLEE) n = HCE_AnimName(HCE_A_MOVE_F);
			else if(kind >= HCE_A_DIE_F && kind <= HCE_A_DIE_AIR) n = HCE_AnimName(HCE_A_DIE_F);
			if(n == 'None') return;
		}
		hce_curAnimKind = kind;
		hce_curAnim = n;
		hce_animStartTic = level.maptime; hce_curLoop = loop;
		HCE_ApplyAnim(n, hce_noBlend ? 0 : blend, loop);
		hce_noBlend = false;
		HCE_CrouchHitbox(n);
	}
	int hce_animStartTic;

	// a guard stance (GUARD_*: the Ultra Zealot's shield held out) for characters that have one, taken up in cover and
	// for two seconds after a ranged hit (a bullet or bolt, not a blade, a blast or fire)
	int hce_guardUntil;
	bool HCE_Guarding() { return hce_action == HCE_ACT_COVER || level.maptime < hce_guardUntil; }
	int HCE_GuardKind(int kind)
	{
		if(health <= 0 || !HCE_Guarding()) return kind;
		int g = -1;
		switch(kind)
		{
		case HCE_A_IDLE: case HCE_A_ALERT: g = HCE_A_GUARD_IDLE; break;
		case HCE_A_MOVE_F: g = HCE_A_GUARD_MOVE_F; break;
		case HCE_A_MOVE_B: g = HCE_A_GUARD_MOVE_B; break;
		case HCE_A_MOVE_L: g = HCE_A_GUARD_MOVE_L; break;
		case HCE_A_MOVE_R: g = HCE_A_GUARD_MOVE_R; break;
		case HCE_A_CROUCH_IDLE: g = HCE_A_GUARD_CROUCH_IDLE; break;
		case HCE_A_CROUCH_MOVE: g = HCE_A_GUARD_CROUCH_MOVE; break;
		}
		return g >= 0 && HCE_AnimName(g) != 'None' ? g : kind;
	}

	// crouched (any 'crouch ...' animation), the body is a smaller target: its hitbox drops to the crouch's height
	// (about 60% of standing), and comes back up when it stands, if there is headroom
	bool hce_crouchBox;
	void HCE_CrouchHitbox(Name anim)
	{
		if(health <= 0 || hce_corpseInit) return;
		String a = anim;
		bool c = a.Left(7) == "crouch ";
		if(c == hce_crouchBox) return;
		double h = c ? default.height * 0.62 : default.height;
		if(!c && ceilingz - pos.z < h) return;                    // no room to stand yet: stays low
		A_SetSize(-1, h);
		hce_crouchBox = c;
	}
	bool hce_curLoop;
	// A_ChangeModel (blood, a severed limb) restarts the model's animation: packs pick it up where it was
	virtual void HCE_ResumeAnim() {}

	// Model animation backend. SetAnimation needs ZScript 4.12+, and this file must
	// also compile inside HDE Local_DEV (version 4.10.0), so subclasses in a newer
	// unit (the Halo CE pack's HCE_<Character>Base classes) implement it.
	virtual void HCE_ApplyAnim(Name n, int blend, bool loop) {}

	// play a one-shot animation and lock the AI for its length
	int HCE_PlayLocked(int kind, double fraction = 1.0)
	{
		Name n = HCE_AnimName(kind);
		if(n == 'None') return 0;
		HCE_Play(kind, false, true, 4, true);
		hce_animLock = max(1, int(HCE_AnimTics(n) * fraction));
		hce_lockPing = 0;
		return hce_animLock;
	}

	// ------------------------------------------------------------------
	// Setup
	// ------------------------------------------------------------------
	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		if(!hce_enabled) return;
		static const int prefs[] = { HCE_WK_CLOSE, HCE_WK_MID, HCE_WK_LONG };
		hce_weaponPref = prefs[random(0, 2)];             // a regular Marine's liking: close, mid or long range
		if(hce_team == HCE_TEAM_HUMAN && hce_rankName.Length() == 0) HCE_RollName();
		curChaseAngle = angle;
		hce_strafeDir = random(0, 1) ? 1 : -1;
		hce_grenadeTics = int(hce_grenadeDelay * 35 * frandom(0.5, 1.0));
		// toughness nerf (hce_nerf_health / hce_nerf_shields): StartHealth keeps SpawnHealth()-based
		// thresholds (berserk, panic, hard kills) in proportion
		// Halo difficulty (HCE_Diff): enemies' and allies' own vitality and shields, as Halo CE scales them
		double hs = (bFRIENDLY ? 1.0 : HCE_HealthScale()) * HCE_D(HCE_D_VITALITY);
		if(hs != 1.0)
		{
			StartHealth = max(1, int(GetDefaultByType(GetClass()).health * hs));
			health = SpawnHealth();
		}
		hce_shieldMax *= (bFRIENDLY ? 1.0 : HCE_ShieldScale()) * HCE_D(HCE_D_SHIELD);
		if(hce_shieldMax > 0 && !bHCE_FrontShield)
		{
			A_SetupShield(hce_shieldMax, max(1, hce_shieldStun) * 35, max(1, int(max(1, hce_shieldRecharge) * 35 / max(0.1, HCE_D(HCE_D_RECHARGE)))),
				"Shield/Explode", "", "Shield/Regenerate", "HCE_Shield");
		}
		if(bHCE_FrontShield)
		{
			hce_frontShieldMax = hce_frontShieldHP = max(40 * (bFRIENDLY ? 1.0 : HCE_ShieldScale()) * HCE_D(HCE_D_SHIELD), hce_shieldMax);
			// the shield is its own entity on the wrist (HCE_JackalShield in the core pack, found by name
			// because the core compiles after this file); without it the old front-arc absorb applies
			Name sn = 'HCE_JackalShield';
			class<Actor> sc = (class<Actor>)(sn);
			if(sc)
			{
				let sa = Spawn(sc, pos, NO_REPLACE);
				if(sa) { sa.master = self; hce_shieldActor = sa; }
			}
		}
		if(bHCE_ActiveCamo)
		{
			A_SetRenderStyle(0.12, STYLE_Translucent);
		}
		if(bHCE_Flying)
		{
			bNOGRAVITY = true; bFLOAT = true;
		}
		// infection forms: each one a little faster or slower by difficulty (Halo CE's random speed increase)
		if(hce_type == 10 && hce_team == HCE_TEAM_FLOOD)
		{
			double sp = max(0.3, 1 + HCE_D(HCE_D_INFECTION) * frandom(0, 1));
			hce_runSpeed *= sp; hce_walkSpeed *= sp;
		}
		// jump height: about three quarters of the body, Hunters only a low hop, flyers never
		if(hce_jumpHeight == 0)
			hce_jumpHeight = bHCE_Flying ? -1 : bHCE_FrontArmor ? 32 : clamp(height * 0.75, 24, 56);
		if(hce_voiceSet.Length() > 0)
		{
			Array<String> vs; hce_voiceSet.Split(vs, ",", TOK_SKIPEMPTY);
			if(vs.Size() > 0) hce_voice = vs[random(0, vs.Size() - 1)];
		}
		hce_tauntTics = level.maptime + random(35 * 4, 35 * 10);
		hce_home = pos;
		hce_patrolTics = level.maptime + random(35, 35 * 6);
		// sleeping Grunts (Halo CE): deaf (ambush) Grunts always nap, others now and then at map start
		if(hce_type == 2 && !bFRIENDLY && HCE_HasAnim(HCE_A_SLEEP) && level.maptime < 5
			&& (bAMBUSH || frandom(0, 1) < HCE_CVarF('hce_sleepinggrunts', 0.3)))
			hce_sleeping = true;
		Name shn = HCE_ShellClass();                   // the energy-shield flare shell (pack code)
		if(hce_shieldMax > 0 && !bHCE_FrontShield && shn != 'None')
		{
			class<Actor> shc = (class<Actor>)(shn);
			if(shc) { hce_shellActor = Spawn(shc, pos, NO_REPLACE); if(hce_shellActor) hce_shellActor.master = self; }
		}
		HCE_Play(hce_sleeping ? HCE_A_SLEEP : HCE_A_IDLE);
	}

	// ------------------------------------------------------------------
	// Squads (Halo encounters): Grunts and Jackals attach to the nearest Elite or Brute leader (up to six to
	// a leader). They take a station around it, walk with it on patrol, share what it sees (a squad that
	// spots you wakes and turns as one), stay within reach of it in a fight, and stay with it instead of
	// hunting you on their own. A leader's death still breaks them (panic).
	// ------------------------------------------------------------------
	HaloDoom_EnemyBase hce_squadLead;
	int    hce_squadCount, hce_squadCheck, hce_squadNotified;
	double hce_slotAng, hce_slotDist;

	bool HCE_IsFollowerType()
	{
		return !bHCE_Leader && (hce_type == 1 || hce_type == 2) && !bFRIENDLY && hce_team == HCE_TEAM_COVENANT && !bHCE_Flying;
	}

	HaloDoom_EnemyBase HCE_SquadLeader()
	{
		if(hce_squadLead && (hce_squadLead.health <= 0 || hce_squadLead.bFRIENDLY != bFRIENDLY)) hce_squadLead = null;
		if(hce_squadLead || !HCE_IsFollowerType() || level.maptime < hce_squadCheck) return hce_squadLead;
		hce_squadCheck = level.maptime + 35 * 3;
		CVar cv = CVar.FindCVar("hce_squads");
		if(cv && !cv.GetBool()) return null;
		HaloDoom_EnemyBase best = null; double bd = 768;
		let it = BlockThingsIterator.Create(self, 768);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(!e || !e.hce_enabled || !e.bHCE_Leader || e.health <= 0 || e.hce_team != hce_team || e.bFRIENDLY || e.hce_squadCount >= 9) continue;
			double d = Distance3D(e);
			if(d < bd && CheckSight(e, SF_IGNOREVISIBILITY)) { bd = d; best = e; }
		}
		if(!best) return null;
		hce_squadLead = best;
		static const double SA[] = { 150, -150, 115, -115, 175, -175, 135, -135, 160 };
		static const double SD[] = { 72, 72, 104, 104, 130, 130, 160, 160, 185 };
		int n = best.hce_squadCount++ % 9;          // a leader and up to nine: the Mongol arban of ten
		hce_slotAng = SA[n]; hce_slotDist = SD[n] + best.radius;
		return best;
	}

	// squad-wide alert: the leader and every member that has no target turn on it (sleepers wake a moment later)
	void HCE_AlertSquad(Actor t)
	{
		HaloDoom_EnemyBase L = bHCE_Leader ? self : HCE_SquadLeader();
		if(!L || !t) return;
		let it = BlockThingsIterator.Create(L, 1024);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(!e || e == self || e.health <= 0 || e.target) continue;
			if(e != L && e.hce_squadLead != L) continue;
			e.hce_squadNotified = level.maptime;
			if(e.hce_sleeping) { e.hce_wakeAt = level.maptime + random(10, 45); continue; }
			e.target = t; e.hce_lastKnown = t.pos;
			e.hce_combatUntil = level.maptime + 35 * 10;      // full awareness: it knows where to look
			e.HCE_OnAcquire();
			if(e.InStateSequence(e.CurState, e.ResolveState("Spawn"))) { e.hce_action = HCE_ACT_FIGHT; e.SetStateLabel("See"); }
		}
	}

	// walk to its station on the leader; true while moving
	bool HCE_KeepStation(HaloDoom_EnemyBase L, bool combat)
	{
		vector2 slot = L.pos.xy + AngleToVector(L.angle + hce_slotAng, hce_slotDist);
		vector2 dv = slot - pos.xy;
		double d = dv.Length();
		bool leaderMoving = L.hce_patrolState == 1 || L.hce_moveSpeed > 0.5;
		if(d < 36 || (d < 150 && !leaderMoving && !combat)) { HCE_Brake(); return false; }
		double a = atan2(dv.y, dv.x);
		HCE_Move(HCE_PickHeading(a, a), d > 200 || combat ? hce_runSpeed * 0.85 : max(hce_walkSpeed, L.hce_walkSpeed));
		if(target) HCE_FaceTarget(); else A_SetAngle(angle + clamp(DeltaAngle(angle, hce_moveAngle), -hce_turnRate, hce_turnRate), SPF_INTERPOLATE);
		HCE_PickMoveAnim();
		return true;
	}

	// ------------------------------------------------------------------
	// Idle movement: squad members keep station; leaders and loners patrol -- along a Doom PatrolPoint route
	// if the map gives them one (Thing_SetGoal / the thing's goal), otherwise short walks around where they
	// spawned with pauses in between. Mapper-placed deaf (ambush) monsters stand guard instead.
	// ------------------------------------------------------------------
	vector3 hce_home, hce_patrolTo;
	int     hce_patrolState, hce_patrolTics;
	bool    hce_standStill;                 // no idle walking at all, patrols or squad stations (punkassbitches spawns)
	bool    hce_noMove, hce_anchored;       // leatherneck spawns: no movement at all, held on hce_anchor
	vector2 hce_anchor;
	int     hce_lineupLook;                 // punkassbitches: 1 + which of the class's looks to wear (0: roll as usual)
	virtual int HCE_LineupLooks() { return 1; }   // how many looks the class has for punkassbitches to line up (one of each)

	bool HCE_IdleMove()
	{
		if(bHCE_Flying || bHCE_FollowPlayer || hce_action == HCE_ACT_FEED || bDORMANT || hce_standStill) return false;
		let L = HCE_SquadLeader();
		if(L) return HCE_KeepStation(L, false);
		CVar cv = CVar.FindCVar("hce_patrols");
		if((cv && !cv.GetBool()) || bAMBUSH) return false;
		return HCE_PatrolTick();
	}

	bool HCE_PatrolTick()
	{
		if(hce_patrolState == 0)
		{
			if(level.maptime < hce_patrolTics) { HCE_Brake(); return false; }
			bool ok = false;
			if(goal && goal is "PatrolPoint") { hce_patrolTo = goal.pos; ok = true; }
			else
			{
				for(int i = 0; i < 6 && !ok; i++)
				{
					double a = frandom(0, 360), dist = frandom(96, 288);
					vector3 p = hce_home + (AngleToVector(a, dist), 0);
					vector2 dv = p.xy - pos.xy;
					double dd = dv.Length();
					if(dd < 48) continue;
					if(HCE_Clearance(atan2(dv.y, dv.x), dd + radius) >= dd) { hce_patrolTo = p; ok = true; }
				}
			}
			if(!ok) { hce_patrolTics = level.maptime + 35 * 3; return false; }
			hce_patrolState = 1;
			hce_patrolTics = level.maptime + 35 * 10;          // give up on a point it can't reach
		}
		vector2 dv = hce_patrolTo.xy - pos.xy;
		if(dv.Length() < 20 || level.maptime > hce_patrolTics)
		{
			hce_patrolState = 0;
			hce_patrolTics = level.maptime + int(35 * frandom(3, 8));
			if(goal && goal is "PatrolPoint")
			{
				if(goal.args[1] > 0) hce_patrolTics = level.maptime + goal.args[1] * 35;
				let ai = level.CreateActorIterator(goal.args[0], "PatrolPoint");
				Actor nx = goal.args[0] ? ai.Next() : null;
				goal = nx;
			}
			HCE_Brake();
			return false;
		}
		double a = atan2(dv.y, dv.x);
		if(!HCE_Move(a, hce_walkSpeed)) { hce_patrolTics = 0; }
		A_SetAngle(angle + clamp(DeltaAngle(angle, hce_moveAngle), -hce_turnRate * 0.6, hce_turnRate * 0.6), SPF_INTERPOLATE);
		HCE_PickMoveAnim();
		return true;
	}

	// ------------------------------------------------------------------
	// Sleeping Grunts (Halo CE): curled up in the asleep idle, deaf to distant fighting. They wake when hurt,
	// when an enemy comes within 96 units, when gunfire goes off close by (320 units; never for a deaf one),
	// or a moment after their squad spots something -- startled (surprise animation) and fully alert.
	// ------------------------------------------------------------------
	bool hce_sleeping;
	int  hce_wakeAt;

	void HCE_SleepTick()
	{
		HCE_Play(HCE_A_SLEEP);
		if(hce_wakeAt > 0 && level.maptime >= hce_wakeAt) { HCE_Wake(true); return; }
		if(++hce_scanTimer < 10) return;
		hce_scanTimer = 0;
		for(int i = 0; i < MAXPLAYERS; i++)
		{
			if(!playeringame[i] || !players[i].mo) continue;
			let p = players[i].mo;
			if(HCE_IsEnemy(p) && !(p.player.cheats & CF_NOTARGET) && Distance3D(p) < 96) { target = p; HCE_Wake(true); return; }
		}
		let st = CurSector.SoundTarget;
		if(!bAMBUSH && st && HCE_IsEnemy(st) && Distance3D(st) < 320) { target = st; HCE_Wake(true); return; }
		// a fight breaking out next to it (allies shouting, shooting, dying) rouses it within a second or two
		if(hce_wakeAt > 0 || (hce_scanTimer2 = (hce_scanTimer2 + 1) % 3) != 0) return;
		let it = BlockThingsIterator.Create(self, bAMBUSH ? 256 : 400);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(!e || e == self || !e.hce_enabled || e.hce_team != hce_team || e.hce_sleeping) continue;
			if(Distance3D(e) > (bAMBUSH ? 256 : 400)) continue;
			if((e.health <= 0 || (e.target && e.HCE_Alerted())) && CheckSight(e, SF_IGNOREVISIBILITY))
			{
				hce_wakeAt = level.maptime + random(15, 60);
				return;
			}
		}
	}
	int hce_scanTimer2;

	void HCE_Wake(bool startled)
	{
		if(!hce_sleeping) return;
		hce_sleeping = false; hce_wakeAt = 0;
		hce_surprised = true;
		hce_combatUntil = level.maptime + 35 * 8;
		if(!target) HCE_ScanTargets();
		if(startled && HCE_HasAnim(HCE_A_SURPRISE_F)) HCE_PlayLocked(HCE_A_SURPRISE_F, 0.9);
		HCE_Say(target ? 'Alert' : 'Panic', 1.0, 35, true);
		if(target)
		{
			hce_lastKnown = target.pos;
			hce_action = HCE_ACT_FIGHT;
			if(InStateSequence(CurState, ResolveState("Spawn"))) SetStateLabel("See");
		}
	}

	// the energy-shield flare: a copy of the model that glows when the shield takes a hit (pack code)
	Actor hce_shellActor;
	Actor hce_holoActor;                 // a companion drawn on the same skeleton (the Brute Captain's hologram flag)
	// sniper glint: a purple star flashing at the rifle while the enemy takes aim (beam rifles), so the player
	// sees the shot coming. rel = the muzzle relative to the actor; t = tics into the aim.
	void HCE_SniperGlint(vector3 rel, int t)
	{
		double pulse = 0.75 + 0.25 * sin(t * 40.0);
		A_SpawnParticle("B040FF", SPF_FULLBRIGHT, 2, 16 * pulse, 0, rel.x, rel.y, rel.z, 0, 0, 0, 0, 0, 0, 0.75);
		A_SpawnParticle("FFE0FF", SPF_FULLBRIGHT, 2, 6 * pulse, 0, rel.x, rel.y, rel.z);
		// the streaks of the star, across the line of sight
		vector2 side = AngleToVector(angle + 90, 1);
		for(int i = 1; i <= 3; i++)
		{
			double o = i * 5 * pulse;
			A_SpawnParticle("D070FF", SPF_FULLBRIGHT, 2, 4 - i, 0, rel.x + side.x * o, rel.y + side.y * o, rel.z, 0, 0, 0, 0, 0, 0, 0.8);
			A_SpawnParticle("D070FF", SPF_FULLBRIGHT, 2, 4 - i, 0, rel.x - side.x * o, rel.y - side.y * o, rel.z, 0, 0, 0, 0, 0, 0, 0.8);
			A_SpawnParticle("D070FF", SPF_FULLBRIGHT, 2, 4 - i, 0, rel.x, rel.y, rel.z + o, 0, 0, 0, 0, 0, 0, 0.8);
			A_SpawnParticle("D070FF", SPF_FULLBRIGHT, 2, 4 - i, 0, rel.x, rel.y, rel.z - o, 0, 0, 0, 0, 0, 0, 0.8);
		}
	}
	// energy-shield colour for hit flashes (Elites blue; packs override: Brutes gold...)
	virtual color HCE_ShieldColor() { return Color(255, 127, 178, 255); }
	// the Jackal arm shield (pack code): the node it rides, the gun hand that pokes past it, the surface it's drawn on
	virtual Name HCE_ShieldBone() { return 'frame shield'; }
	virtual Name HCE_GunHandBone() { return 'bip01 r hand'; }
	virtual int HCE_ShieldSurface() { return 5; }
	virtual Name HCE_ShellClass() { return 'None'; }

	// ------------------------------------------------------------------
	// Teams
	// ------------------------------------------------------------------
	static int HCE_TeamOf(Actor a)
	{
		if(!a) return HCE_TEAM_NEUTRAL;
		let e = HaloDoom_EnemyBase(a);
		if(e && e.hce_enabled) return e.hce_team;
		if(a.player || a.bFRIENDLY) return HCE_TEAM_HUMAN;
		if(a.bISMONSTER) return HCE_TEAM_NEUTRAL;
		return HCE_TEAM_NEUTRAL;
	}

	virtual bool HCE_IsEnemy(Actor other)
	{
		if(!other || other == self || other.health <= 0 || !other.bSHOOTABLE || other.bNONSHOOTABLE) return false;
		if(hce_betrayed && other == hce_betrayed) return true;
		int t = HCE_TeamOf(other);
		if(t == HCE_TEAM_NEUTRAL)
		{
			// plain Doom monsters: humans fight them, everyone else ignores them
			return hce_team == HCE_TEAM_HUMAN && other.bISMONSTER && !other.bFRIENDLY;
		}
		if(t == hce_team) return false;
		if(hce_team == HCE_TEAM_SENTINEL && t == HCE_TEAM_COVENANT) return false;
		if(hce_team == HCE_TEAM_COVENANT && t == HCE_TEAM_SENTINEL) return false;
		return true;
	}

	bool HCE_SightOf(Actor other, double fov)
	{
		if(!other) return false;
		double d = Distance3D(other);
		if(d > hce_visionDist) return false;
		if(fov < 360)
		{
			double rel = abs(DeltaAngle(angle, AngleTo(other)));
			if(rel > fov * 0.5) return false;
		}
		return CheckSight(other, SF_IGNOREVISIBILITY | SF_IGNOREWATERBOUNDARY);
	}

	// periodic target selection (players, marines, rival factions)
	// after a fight an actor stays alert (full awareness) for 10 seconds
	int hce_combatUntil, hce_flipTics;
	bool HCE_Alerted() { return target != null || level.maptime < hce_combatUntil; }

	void HCE_ScanTargets()
	{
		if(hce_focusTarget && (hce_focusTarget.health <= 0 || !HCE_IsEnemy(hce_focusTarget))) hce_focusTarget = null;
		if(hce_focusTarget) { if(target != hce_focusTarget) { bool fresh = !target; target = hce_focusTarget; hce_lastKnown = target.pos; if(fresh) HCE_OnAcquire(); } return; }
		Actor best = null; double bestScore = 1e9;
		if(target && target.health > 0 && HCE_IsEnemy(target))
		{
			best = target; bestScore = Distance3D(target) * (hce_canSee ? 0.6 : 1.0);
		}
		for(int i = 0; i < MAXPLAYERS; i++)
		{
			if(!playeringame[i] || !players[i].mo) continue;
			let p = players[i].mo;
			if(!HCE_IsEnemy(p) || (p.player.cheats & CF_NOTARGET)) continue;
			double d = Distance3D(p);
			if(d < bestScore && HCE_SightOf(p, HCE_Alerted() ? 360 : hce_visionFOV)) { best = p; bestScore = d; }
		}
		let it = BlockThingsIterator.Create(self, min(hce_visionDist, 2048));
		while(it.Next())
		{
			let o = it.thing;
			if(!o.bISMONSTER || !HCE_IsEnemy(o)) continue;
			double d = Distance3D(o) * 1.15;
			if(d < bestScore && HCE_SightOf(o, HCE_Alerted() ? 360 : hce_visionFOV)) { best = o; bestScore = d; }
		}
		if(best && best != target)
		{
			bool fresh = target == null;
			target = best;
			hce_lastKnown = best.pos;
			if(fresh) HCE_OnAcquire();
		}
	}

	virtual void HCE_OnAcquire()
	{
		if(hce_sleeping) HCE_Wake(false);
		if(target && hce_squadNotified != level.maptime) HCE_AlertSquad(target);
		hce_burstTics = 0; hce_shotsLeft = 0; hce_chargeTics = 0;
		// reaction time before the first burst (Halo first_burst_delay, at least ~0.4 s)
		hce_sepTics = max(4, int((max(hce_firstBurstDelay, 0.4) * 35 + random(0, 10)) * HCE_D(HCE_D_NEW_TARGET)));
		HCE_Say('Alert', 0.7, 35 * 3);
		hce_grenadeTics = max(hce_grenadeTics, int(35 * frandom(3, 6) * HCE_GrenadeScale()));
		if(bHCE_Surprise && !hce_surprised && target && Distance3D(target) < hce_surpriseDist)
		{
			hce_surprised = true;
			bool behind = abs(DeltaAngle(angle, AngleTo(target))) > 90;
			A_SetAngle(AngleTo(target));
			HCE_PlayLocked(behind ? HCE_A_SURPRISE_B : HCE_A_SURPRISE_F, 0.8);
			if(bHCE_Panics && random(0, 2) == 0) HCE_StartPanic();
		}
		else if(HCE_HasAnim(HCE_A_WARN) && random(0, 3) == 0)
		{
			A_SetAngle(AngleTo(target));
			HCE_PlayLocked(HCE_A_WARN, 0.6);
		}
		if(bHCE_AlwaysBerserk) HCE_GoBerserk(false);
	}

	// ------------------------------------------------------------------
	// Spawn / look state helper: Halo perception before combat
	// ------------------------------------------------------------------
	void HCE_Look()
	{
		// a corpse knocked back into its live states (HDE's grenades put whatever they stick to or hit into Pain):
		// back to lying dead, never a walking corpse
		if(health <= 0 && hce_corpseInit) { SetStateLabel('Dead'); return; }
		if(hce_burnDying) { HCE_BurnPanicTick(); return; }
		if(hce_bleedOut > 0 && HCE_BleedOutTick()) return;
		if(hce_animLock > 0) { hce_animLock--; HCE_LockedTick(); return; }
		if(hce_sleeping) { HCE_SleepTick(); return; }
		if(HCE_GrenadeCheck() || hce_nadeRunTics > 0) { SetStateLabel("See"); return; }
		if(!HCE_IdleMove()) HCE_Play(HCE_A_IDLE);
		if(bHCE_Flying) HCE_Hover();
		if(HCE_SeekCorpse()) { SetStateLabel("See"); return; }
		if(!hce_bondLooked) HCE_BondLink();
		if(HCE_IdleReload()) return;
		if(hce_scavOff == 0) hce_scavOff = random(1, 35);
		if((level.maptime + hce_scavOff) % 35 == 0) { HCE_ScavengeScan(); if(hce_scavItem) { SetStateLabel("See"); return; } }
		if(++hce_scanTimer < 8) return;
		hce_scanTimer = 0;
		HCE_ScanTargets();
		// hearing: Doom's sound propagation (sector soundtarget)
		// hearing: Doom's sound propagation, but like Doom a deaf (ambush) actor only wakes on sight, and the
		// range is capped (hce_hearing) so one gunshot doesn't pull in every squad on the map
		if(!target && !bAMBUSH && CurSector.SoundTarget && HCE_IsEnemy(CurSector.SoundTarget)
			&& Distance3D(CurSector.SoundTarget) < min(hce_hearingDist, HCE_CVarF('hce_hearing', 1024)))
		{
			if(!CheckSight(CurSector.SoundTarget)) HCE_Say('HeardGunfire', 1.0, 35 * 3);   // gunfire heard, nobody seen yet
			target = CurSector.SoundTarget;
			hce_lastKnown = target.pos;
			HCE_OnAcquire();
		}
		if(bHCE_FollowPlayer && !target)
		{
			hce_action = HCE_ACT_FOLLOW;
			SetStateLabel("See");
			return;
		}
		if(target)
		{
			hce_action = HCE_ACT_FIGHT;
			SetStateLabel("See");
		}
	}

	// ------------------------------------------------------------------
	// Main think (See state, every tic)
	// ------------------------------------------------------------------
	void HCE_Think()
	{
		// a corpse knocked back into its live states (HDE's grenades put whatever they stick to or hit into Pain):
		// back to lying dead, never a walking corpse
		if(health <= 0 && hce_corpseInit) { SetStateLabel('Dead'); return; }
		if(hce_burnDying) { HCE_BurnPanicTick(); return; }
		if(hce_bleedOut > 0 && HCE_BleedOutTick()) return;
		if(hce_recentDamageTics > 0 && --hce_recentDamageTics == 0) hce_recentDamage = 0;
		HCE_SquadTick();
		if(hce_heat > 0 && hce_shotsLeft <= 0) hce_heat = max(0, hce_heat - 0.003);     // plasma cools between bursts (a full gun in ~10 s)
		if(bHCE_FrontShield) HCE_UpdateFrontShield();
		if(bHCE_ActiveCamo && alpha < 0.12) A_SetRenderStyle(min(0.12, alpha + 0.01), STYLE_Translucent);
		else if(bHCE_ActiveCamo && alpha > 0.12) A_SetRenderStyle(max(0.12, alpha - 0.02), STYLE_Translucent);

		if(bHCE_Flying) HCE_Hover();
		if(hce_animLock > 0)
		{
			hce_animLock--;
			HCE_LockedTick();
			return;
		}
		if(hce_leapState > 0) { HCE_LeapTick(); return; }
		if(hce_jumpState > 0) { HCE_JumpTick(); return; }
		if(hce_action != HCE_ACT_KAMIKAZE && HCE_GrenadeCheck()) return;
		if(hce_nadeRunTics > 0) { HCE_NadeRunTick(); return; }
		if(!hce_bondLooked) HCE_BondLink();
		if(hce_button && HCE_ButtonTick()) return;
		if(hce_medicFor && HCE_MedicTick()) return;
		if(hce_scavItem && HCE_ScavengeTick()) return;
		if(hce_scavOff == 0) hce_scavOff = random(1, 35);
		if((level.maptime + hce_scavOff) % 35 == 0) HCE_ScavengeScan();

		if(++hce_scanTimer >= 10) { hce_scanTimer = 0; HCE_ScanTargets(); }

		if(target && (target.health <= 0 || !HCE_IsEnemy(target)))
		{
			if(target.health <= 0) HCE_Say(target.player ? 'KillPlayer' : 'Taunt', target.player || HCE_IsJohnson() ? 0.9 : 0.35, 35 * 2);
			HCE_StopFireLoop();
			target = null;
			HCE_ScanTargets();   // next enemy in view, any direction
			if(target) return;
			if(HCE_HasAnim(HCE_A_CELEBRATE) && random(0, 3) == 0) { HCE_PlayLocked(HCE_A_CELEBRATE); return; }
		}

		if(!target)
		{
			hce_cvState = 0;
			if(hce_kamiNades.Size() > 0) HCE_KamikazeBoom(false);   // lost the target mid-run: the grenades go off where it stands
			if(hce_action == HCE_ACT_FEED) { HCE_Feed(); return; }
			if(HCE_SeekCorpse()) return;
			if(HCE_IdleReload()) return;
			if(bHCE_FollowPlayer) { HCE_Follow(); return; }
			hce_action = HCE_ACT_IDLE;
			HCE_Brake();
			SetStateLabel("Spawn");
			return;
		}

		if(hce_squadOrder == HCE_ORDER_REGROUP && HCE_InSquad() && HCE_RegroupTick()) return;
		hce_combatUntil = level.maptime + 35 * 10;
		hce_canSee = HCE_SightOf(target, 360);
		if(hce_canSee) { hce_lastSeen = level.maptime; hce_lastKnown = target.pos; }

		HCE_Emotions();
		if(hce_cvState > 0 && hce_action != HCE_ACT_FIGHT && hce_action != HCE_ACT_COVER) hce_cvState = 0;

		switch(hce_action)
		{
		case HCE_ACT_FLEE:   HCE_Flee(); break;
		case HCE_ACT_COVER:  HCE_Cover(); break;
		case HCE_ACT_CHARGE: HCE_Charge(); break;
		case HCE_ACT_FEED:   HCE_Feed(); break;
		case HCE_ACT_KAMIKAZE: HCE_KamikazeTick(); return;
		default:             HCE_Fight(); break;
		}
	}

	// ------------------------------------------------------------------
	// Emotions: panic, berserk, cover (actor_action_handle_*)
	// ------------------------------------------------------------------
	virtual void HCE_Emotions()
	{
		double vit = health / double(max(1, SpawnHealth()));
		// berserking_from_damage
		if(bHCE_Berserks && !hce_berserk && hce_recentDamage > hce_berserkAmount && vit < hce_berserkThreshold)
			HCE_GoBerserk(true);
		// berserking_from_proximity
		if(bHCE_Berserks && !hce_berserk && hce_proximityBerserk > 0 && hce_canSee && Distance3D(target) < hce_proximityBerserk)
			HCE_GoBerserk(false);
		// panic_from_damage
		if(bHCE_Panics && hce_action != HCE_ACT_FLEE && hce_panicDamage > 0 && hce_recentDamage > hce_panicDamage)
		{
			hce_recentDamage = 0;
			HCE_StartPanic();
		}
		// active cover seeking (shield fraction <= hide)
		if(bHCE_SeeksCover && !hce_berserk && hce_action == HCE_ACT_FIGHT && hce_shieldMax > 0)
		{
			let sh = ShieldProcessor(FindInventory("ShieldProcessor", true));
			if(sh && sh.shields <= sh.maxShields * hce_shieldHide)
			{
				hce_action = HCE_ACT_COVER;
				hce_coverTics = 35 * 3;
			}
		}
		if(bHCE_Evades && hce_evadeTics <= 0 && hce_action != HCE_ACT_KAMIKAZE) HCE_TryEvade();
		if(hce_evadeTics > 0) hce_evadeTics--;
	}

	void HCE_GoBerserk(bool roar)
	{
		if(hce_action == HCE_ACT_KAMIKAZE) return;
		hce_berserk = true;
		hce_action = HCE_ACT_CHARGE;
		HCE_Say('Berserk', roar ? 1.0 : 0.6, 35 * 2, roar);
		if(roar && HCE_HasAnim(HCE_A_BERSERK)) HCE_PlayLocked(HCE_A_BERSERK);
	}

	// ------------------------------------------------------------------
	// Hunter bond rage. Hunters fight in bonded pairs (the brother spawned with it, or the nearest unpaired Hunter
	// once they meet). When one dies the other, wherever it is, roars and goes into a rage for the rest of its
	// life: berserk (it charges, never takes cover or backs off), a third faster, its cannon pauses cut to 60%, its
	// shield-arm smashes half as hard again, and it goes after whoever killed its brother.
	// ------------------------------------------------------------------
	Actor hce_bondMate;
	bool hce_raging, hce_bondLooked;

	void HCE_BondLink()
	{
		hce_bondLooked = true;
		if(!bHCE_PairBond || hce_bondMate) return;
		HaloDoom_EnemyBase best = null; double bd = 512;
		let it = BlockThingsIterator.Create(self, 512);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(!e || e == self || !e.bHCE_PairBond || e.hce_bondMate || e.health <= 0 || e.hce_team != hce_team || e.bFRIENDLY != bFRIENDLY) continue;
			double d = Distance3D(e);
			if(d < bd) { bd = d; best = e; }
		}
		if(best) { hce_bondMate = best; best.hce_bondMate = self; best.hce_bondLooked = true; }
	}

	void HCE_BondRage(HaloDoom_EnemyBase fallen)
	{
		if(hce_raging || health <= 0) return;
		hce_raging = true;
		Actor killer = fallen ? fallen.hce_lastHurter : null;
		if(killer && killer.health > 0 && HCE_IsEnemy(killer)) { target = killer; hce_lastKnown = killer.pos; }
		hce_runSpeed *= 1.33; hce_walkSpeed *= 1.33;
		hce_patPauseMin *= 0.6; hce_patPauseMax *= 0.6;
		hce_meleeDamage *= 1.5;
		hce_berserk = false;                                  // always the roar
		HCE_GoBerserk(true);
		if(InStateSequence(CurState, ResolveState("Spawn"))) SetStateLabel("See");
	}

	void HCE_StartPanic()
	{
		if(hce_action == HCE_ACT_KAMIKAZE) return;
		if(hce_action != HCE_ACT_FLEE) HCE_Say('Panic', 0.9, 35 * 2, true);
		hce_action = HCE_ACT_FLEE;
		HCE_StopFireLoop();
		hce_shotsLeft = 0; hce_chargeTics = 0;
		hce_panicTics = int(35 * frandom(max(1.5, hce_cowerMin), max(3.0, hce_cowerMax)));
	}

	// a leader (elite) died nearby -> grunts/jackals roll panic_chance_leader_type_killed
	// Brutality: when the last Elite / Brute standing over a squad dies, its squad can't regroup under anyone for a
	// while, and the more brutal the death the longer: 3 s, plus 2.5 s per point of HCE_DeathBrutality (torn apart 6,
	// burned alive 3, beheaded 3, an arm 1...; a rocket gib is about 18 s, a clean body shot 3-5 s). Panicky
	// members (Grunts, Jackals) are likelier to panic, and panic for longer, the more brutal it was.
	static void HCE_LeaderDied(Actor leader)
	{
		let L = HaloDoom_EnemyBase(leader);
		if(!L) return;
		int b = L.bHCE_Leader ? L.hce_brutalityFinal : 0;
		bool last = L.bHCE_Leader;
		let it = BlockThingsIterator.Create(leader, 900);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(e && e != leader && e.hce_enabled && e.health > 0 && e.bHCE_Leader && e.hce_team == L.hce_team && !e.bFRIENDLY) { last = false; break; }
		}
		int regroup = last ? int(35 * (3 + 2.5 * b)) : 0;
		it = BlockThingsIterator.Create(leader, 768);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(!e || !e.hce_enabled || e.health <= 0 || e == leader || e.hce_team != L.hce_team) continue;
			e.HCE_Say('LeaderDead', 0.8, 35 * 3);
			if(e.hce_kamiChance > 0 && frandom(0, 1) < 0.3 && e.HCE_StartKamikaze()) continue;
			if(regroup > 0 && (e.hce_squadLead == L || e.HCE_IsFollowerType()))
			{
				e.hce_squadLead = null;
				e.hce_squadCheck = level.maptime + regroup;       // no new leader until the squad pulls itself together
			}
			if(e.bHCE_Panics && frandom(0, 1) < min(0.95, max(0.35, e.hce_panicLeaderChance) + 0.08 * b))
			{
				e.HCE_StartPanic();
				if(regroup > 0) e.hce_panicTics = max(e.hce_panicTics, min(regroup, 35 * 12));
			}
			if(e.bHCE_PairBond && !e.hce_bondMate && e.GetClass() == leader.GetClass()) e.HCE_BondRage(L);   // an unpaired brother nearby
		}
	}

	// ------------------------------------------------------------------
	// Fight: firing positions inside combat range, strafing, bursts
	// ------------------------------------------------------------------
	virtual void HCE_Fight()
	{
		double d = Distance2D(target);
		double want = (hce_rangeMin + hce_rangeMax) * 0.5;
		double moveA = angle; double spd = 0;
		HCE_FaceTarget();
		HCE_TauntTick();

		// lost line of sight: a strafe that broke it is undone first, then go find a firing position
		if(!hce_canSee && hce_cvState == 0 && hce_strafeDir != 0 && level.maptime - hce_lastSeen < 3 && hce_flipTics < level.maptime)
		{
			hce_strafeDir = -hce_strafeDir; hce_strafeTics = random(20, 40); hce_flipTics = level.maptime + 35;
		}
		if(!hce_canSee && hce_cvState == 0 && level.maptime - hce_lastSeen > 25)
		{
			if(HCE_TryFlush()) return;
			// a squad member stays with its leader instead of hunting on its own
			let L = HCE_SquadLeader();
			if(L && L.health > 0) { if(!HCE_KeepStation(L, true)) HCE_Hold(); return; }
			// pursue / search: walk to last known position with Doom pathing -- only a few at a time
			if(HCE_MayPursue()) HCE_Pursue(); else HCE_Hold();
			return;
		}
		hce_pursuing = false;

		if(HCE_InMeleeRange(d) && HCE_TryMelee()) return;
		if(bHCE_Leaps && HCE_TryLeap(d)) return;

		double toT = AngleTo(target);
		if(d > hce_rangeMax) { moveA = toT; spd = hce_runSpeed; }
		else if(d < hce_rangeMin * 0.5 && hce_rangeMin > 0)
		{
			// too close: give ground diagonally, only where there is room behind
			moveA = toT + 180 + 45 * (hce_strafeDir != 0 ? hce_strafeDir : 1);
			spd = hce_walkSpeed;
		}
		else
		{
			// strafe along the firing position band (Halo picks new firing positions every few seconds)
			if(--hce_strafeTics <= 0)
			{
				hce_strafeTics = random(25, 80);
				hce_strafeDir = random(0, 3) == 0 ? 0 : (random(0, 1) ? 1 : -1);
			}
			if(hce_strafeDir != 0)
			{
				// drift slightly toward the target while strafing so nobody ends up pinned to the far wall
				double drift = d > (hce_rangeMin + hce_rangeMax) * 0.5 ? 20 : 0;
				moveA = toT + (90 - drift) * hce_strafeDir;
				spd = hce_walkSpeed * 0.8;
			}
		}
		// squad: Grunts and Jackals keep within reach of their Elite / Brute leader
		let L = HCE_SquadLeader();
		if(L && L.health > 0 && !hce_berserk)
		{
			double dl = Distance2D(L);
			if(dl > 420) { moveA = AngleTo(L); spd = hce_runSpeed; }
			else if(dl > 280 && spd > 0 && abs(DeltaAngle(moveA, AngleTo(L))) > 90) moveA = AngleTo(L) + 60 * (hce_strafeDir != 0 ? hce_strafeDir : 1);
		}
		bool fire = true;
		bool docMove = HCE_Doctrine(d, toT, moveA, spd, fire) && spd > 0;       // squad tactics (UNSC fire teams, Covenant lance)
		if(HCE_CoverTick(d, toT, docMove, moveA, spd, fire) == 2) return;      // cover: a corner or low wall to fight from
		if(hce_ffStepTics > 0) { hce_ffStepTics--; moveA = hce_ffStepAng; spd = hce_runSpeed * 0.7; }   // clearing a friend out of the line of fire
		if(spd > 0) moveA = HCE_PickHeading(moveA, toT);
		HCE_Move(moveA, spd);
		if(fire) HCE_UpdateFiring(d);
		if(hce_kamiChance > 0 && level.maptime % 35 == 0 && frandom(0, 1) < hce_kamiChance * (health < SpawnHealth() / 2 ? 3 : 1)
			&& HCE_StartKamikaze()) return;
		if(bHCE_ThrowsGrenades) HCE_TryGrenade(d);
		HCE_PickMoveAnim();
	}

	virtual void HCE_Pursue()
	{
		if(bHCE_Flying)
		{
			HCE_Move(AngleTo(target), hce_walkSpeed);
			HCE_PickMoveAnim();
			return;
		}
		if(level.maptime % 6 == 0 && hce_lastKnown.z > pos.z + MaxStepHeight)
		{
			double toward = atan2(hce_lastKnown.y - pos.y, hce_lastKnown.x - pos.x);
			if(HCE_TryJump(toward, false)) return;
		}
		double sp = speed;
		speed = max(1, hce_runSpeed);
		A_Chase(null, null, CHF_NOPLAYACTIVE | CHF_NODIRECTIONTURN);
		speed = sp;
		hce_moveSpeed = hce_runSpeed;
		hce_moveAngle = movedir * 45.;
		HCE_Play(HCE_A_MOVE_F);
		if(level.maptime - hce_lastSeen > 35 * 20) target = null;   // give up the search
	}

	// ------------------------------------------------------------------
	// Pursuit cap: only hce_maxpursuers enemies of a team chase one target they can't see at a time (within
	// 2048 units); the rest hold where they are, facing where it was last seen, until it shows up. Without it
	// every squad that heard the fight converged at once, three encounters' worth of enemies in one room.
	// ------------------------------------------------------------------
	bool hce_pursuing;
	int  hce_pursueCheck;

	bool HCE_MayPursue()
	{
		if(hce_pursuing) return true;
		if(level.maptime < hce_pursueCheck) return false;
		hce_pursueCheck = level.maptime + 35;
		int cap = int(HCE_CVarF('hce_maxpursuers', 4));
		if(cap <= 0) { hce_pursuing = true; return true; }
		int n = 0;
		let it = BlockThingsIterator.Create(self, 2048);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(e && e != self && e.hce_enabled && e.health > 0 && e.hce_pursuing && e.target == target && e.hce_team == hce_team) n++;
		}
		hce_pursuing = n < cap;
		return hce_pursuing;
	}

	void HCE_Hold()
	{
		HCE_Brake();
		double want = atan2(hce_lastKnown.y - pos.y, hce_lastKnown.x - pos.x);
		A_SetAngle(angle + clamp(DeltaAngle(angle, want), -hce_turnRate, hce_turnRate), SPF_INTERPOLATE);
		HCE_PickMoveAnim();
		if(level.maptime - hce_lastSeen > 35 * 25) { target = null; hce_pursuing = false; }   // forget it
	}

	virtual void HCE_Charge()
	{
		double d = Distance2D(target);
		HCE_FaceTarget(2.0);
		if(HCE_InMeleeRange(d) && HCE_TryMelee()) return;
		if(bHCE_Leaps && HCE_TryLeap(d)) return;
		if(!hce_canSee) { if(HCE_MayPursue()) HCE_Pursue(); else HCE_Hold(); return; }
		HCE_Move(AngleTo(target), hce_runSpeed * 1.15);
		if(hce_projectile != 'None' && d < hce_maxRange * 0.5) HCE_UpdateFiring(d);
		HCE_PickMoveAnim();
		if(bHCE_Explodes && d < radius + target.radius + 24) HCE_Detonate();
	}

	virtual void HCE_Flee()
	{
		if(--hce_panicTics <= 0) { hce_action = HCE_ACT_FIGHT; HCE_Say('Regroup', 0.5, 35 * 2); return; }
		if(random(0, 50) == 0) HCE_Say('Flee', 1.0, 35 * 2);
		HCE_Move(HCE_PickHeading(AngleTo(target) + 180 + frandom(-30, 30), AngleTo(target)), hce_runSpeed);
		A_SetAngle(hce_moveAngle, SPF_INTERPOLATE);
		HCE_Play(HCE_HasAnim(HCE_A_FLEE) ? HCE_A_FLEE : HCE_A_MOVE_F);
	}

	virtual void HCE_Cover()
	{
		let sh = ShieldProcessor(FindInventory("ShieldProcessor", true));
		bool recovered = !sh || sh.shields >= sh.maxShields * hce_shieldEmerge;
		// a real corner or low wall near, if there is one (Halo 2's cover), else the old sidestep
		if(target && (hce_cvState > 0 || (level.maptime >= hce_cvNext && HCE_CoverCapable() && HCE_FindCover(384))))
		{
			if(hce_cvState == 0) HCE_CvBegin();
			double moveA = angle, spd = 0; bool fire = true;
			double d = Distance2D(target), toT = AngleTo(target);
			int cv = HCE_CoverTick(d, toT, false, moveA, spd, fire);
			if(cv == 1)
			{
				HCE_FaceTarget();
				HCE_Move(HCE_PickHeading(moveA, toT), spd);
				if(fire) HCE_UpdateFiring(d);
				HCE_PickMoveAnim();
			}
			if(recovered && hce_cvState >= HCE_CV_HIDE) hce_action = HCE_ACT_FIGHT;    // back to the fight from the same spot
			if(cv != 0) return;
		}
		else if(target && hce_cvState == 0) hce_cvNext = max(hce_cvNext, level.maptime + 35 * 2);
		if(--hce_coverTics <= 0 && recovered) { hce_action = HCE_ACT_FIGHT; return; }
		if(hce_canSee)
		{
			// sidestep out of the line of fire toward whichever side has room
			double toT = AngleTo(target);
			if(hce_strafeDir == 0 || HCE_Clearance(toT + 90 * hce_strafeDir, 160) < 96)
				hce_strafeDir = HCE_Clearance(toT + 90, 256) >= HCE_Clearance(toT - 90, 256) ? 1 : -1;
			HCE_Move(HCE_PickHeading(toT + 120 * hce_strafeDir, toT), hce_runSpeed);
			HCE_FaceTarget();
			HCE_UpdateFiring(Distance2D(target));
		}
		else
		{
			HCE_Brake();
			hce_crouch = HCE_HasAnim(HCE_A_CROUCH_IDLE);
			if(recovered) hce_coverTics = min(hce_coverTics, 10);
		}
		HCE_PickMoveAnim();
	}

	// ------------------------------------------------------------------
	// Cover (Halo 2's corner cover). Under fire, or now and then of its own accord, a unit that can use cover looks
	// for a spot near it that hides it from its target: a wall that blocks the line of sight at head height with a
	// corner it can lean out past (Marines, Elites and Brutes, with Halo 2's corner animations: cover_anims.py), or
	// a low wall it can crouch behind and shoot over (anyone with a crouch). It runs there, shooting, steps in
	// beside the corner and waits pressed to the wall, then leans out to shoot for a couple of seconds and back in
	// again. It leaves when the spot stops hiding it (flanked), when its target comes too close or stays out of
	// sight, or after 10-16 s. Shields recharge while it hides; an Elite whose shields are down (HCE_ACT_COVER)
	// stays hidden until they are back. On harder difficulties it hides for less time between peeks.
	// Spots are found by sampling round the unit with line traces (no precomputed graph, so it works on any map and
	// against a moving target); two units never take the same spot. hce_cover turns it off.
	// ------------------------------------------------------------------
	const HCE_CV_GO = 1;
	const HCE_CV_HIDE = 2;
	const HCE_CV_OPEN = 3;
	int hce_cvState, hce_cvSide, hce_cvUntil, hce_cvPhase, hce_cvNext, hce_cvArrive, hce_cvCheck;
	bool hce_cvLow;
	vector3 hce_cvSpot;

	bool HCE_CoverCapable()
	{
		if(bHCE_Flying || bHCE_FrontArmor || bHCE_Explodes || bHCE_AlwaysBerserk || hce_berserk) return false;
		if(hce_team != HCE_TEAM_HUMAN && hce_team != HCE_TEAM_COVENANT) return false;          // not the Flood or Sentinels
		if(bHCE_FrontShield && hce_frontShieldHP > 0) return false;                             // a Jackal's shield is its cover
		if(hce_projectile == 'None' && !bHCE_Beam) return false;                                // swords and hammers close in
		if(!HCE_HasAnim(HCE_A_COVER_L_IDLE) && !HCE_HasAnim(HCE_A_CROUCH_IDLE)) return false;
		return HCE_CVarF('hce_cover', 1) > 0;
	}

	// Halo 2's corner_cover_left set hides the body to the left of the corner and leans out to the right (measured from
	// its root: cover_anims.py), so a corner open to the right (side 1) takes the left set
	int HCE_CvKind(int off) { return (hce_cvSide > 0 ? HCE_A_COVER_L_ENTER : HCE_A_COVER_R_ENTER) + off; }

	// the spot it steps out to when it leans out past the corner: far enough that its line of sight (and fire) clears
	// the wall, since the lean itself is only the animation
	vector2 HCE_CvPeekPos() { return hce_cvSpot.xy + AngleToVector(AngleTo(target) - 90 * hce_cvSide, radius * 2 + 12); }

	// a short slide (the step out to the corner and back), spread over a locked animation
	vector3 hce_peekFrom, hce_peekTo;
	int hce_peekTics, hce_peekDur;
	void HCE_PeekSlide(vector3 to, int tics)
	{
		hce_peekFrom = pos; hce_peekTo = to; hce_peekDur = hce_peekTics = max(1, tics);
	}
	void HCE_PeekSlideTick()
	{
		double t = 1.0 - (--hce_peekTics) / double(hce_peekDur);
		vector3 p = hce_peekFrom + (hce_peekTo - hce_peekFrom) * (t * t * (3 - 2 * t));
		if(hce_peekTics <= 0 || CheckPosition(p.xy)) SetOrigin((p.xy, pos.z), true);
		else hce_peekTics = 0;          // something stepped into the way: stop where it is
	}

	// something solid between two points (within maxd of the first, if given)
	bool HCE_SightBlocked(vector3 from, vector3 to, double maxd = 0)
	{
		vector3 d = to - from;
		double l = d.Length();
		if(l < 2) return false;
		FLineTraceData tr;
		if(!LineTrace(atan2(d.y, d.x), l - 2, -atan2(d.z, d.xy.Length()), TRF_THRUACTORS | TRF_THRUHITSCAN | TRF_ABSPOSITION,
			from.z, from.x, from.y, tr)) return false;
		return maxd <= 0 || tr.Distance <= maxd;
	}

	// what a spot gives against a threat: 0 nothing, 1 a wall with a corner to lean out past (side: 1 right, -1 left),
	// 2 a low wall close in front to crouch behind with a clear view over it standing
	int HCE_CoverAt(vector2 p, double pz, Actor threat, bool corner, bool low, out int side)
	{
		side = 0;
		vector3 t = threat.pos + (0, 0, threat.height * 0.75);
		vector3 head = (p, pz + height * 0.85);
		double toT = atan2(t.y - p.y, t.x - p.x);
		if(HCE_SightBlocked(head, t, 128))
		{
			if(!corner) return 0;
			double off = radius * 2 + 12;
			int first = random(0, 1) ? 1 : -1;
			for(int i = 0; i < 2; i++)
			{
				int sd = i == 0 ? first : -first;
				vector2 q = p + AngleToVector(toT - 90 * sd, off);
				if(HCE_SightBlocked((p, pz + height * 0.5), (q, pz + height * 0.5))) continue;    // a wall that side
				if(!HCE_SightBlocked((q, pz + height * 0.85), t)) { side = sd; return 1; }
			}
			return 0;
		}
		if(low && HCE_SightBlocked((p, pz + height * 0.4), t, 96)) return 2;
		return 0;
	}

	bool HCE_SpotFree(vector2 p)
	{
		if(!CheckPosition(p)) return false;
		let it = BlockThingsIterator.CreateFromPos(p.x, p.y, pos.z, height, 448, false);
		while(it.Next())
		{
			let o = HaloDoom_EnemyBase(it.thing);
			if(o && o != self && o.health > 0 && o.hce_cvState > 0 && (o.hce_cvSpot.xy - p).Length() < radius + o.radius + 16) return false;
		}
		return true;
	}

	// the nearest spot within maxR that hides it from its target and keeps it in the fight
	bool HCE_FindCover(double maxR)
	{
		if(!target) return false;
		bool corner = HCE_HasAnim(HCE_A_COVER_L_IDLE) && HCE_HasAnim(HCE_A_COVER_R_IDLE);
		bool low = HCE_HasAnim(HCE_A_CROUCH_IDLE);
		double dT = Distance2D(target);
		static const double rads[] = { 64, 128, 192, 256, 320, 384 };
		for(int r = 0; r < 6 && rads[r] <= maxR; r++)
		{
			int n = r < 2 ? 8 : 12;
			double a0 = frandom(0, 360);
			for(int i = 0; i < n; i++)
			{
				vector2 p = pos.xy + AngleToVector(a0 + i * 360.0 / n, rads[r]);
				double dp = (target.pos.xy - p).Length();
				if(dp < max(hce_rangeMin * 0.7, 128) || dp > max(max(hce_rangeMax, 256), dT) * 1.1) continue;
				double pz = GetZAt(p.x, p.y, 0, GZF_ABSOLUTEPOS);
				if(!level.IsPointInLevel((p, pz + 1)) || abs(pz - pos.z) > MaxStepHeight * 2) continue;
				if(GetZAt(p.x, p.y, 0, GZF_ABSOLUTEPOS | GZF_CEILING) - pz < height + 4) continue;
				if(HCE_SightBlocked(pos + (0, 0, MaxStepHeight + 4), (p, pz + MaxStepHeight + 4))) continue;   // no straight way there
				int side;
				int k = HCE_CoverAt(p, pz, target, corner, low, side);
				if(k == 0 || !HCE_SpotFree(p)) continue;
				hce_cvSpot = (p, pz); hce_cvSide = side; hce_cvLow = k == 2;
				return true;
			}
		}
		return false;
	}

	bool HCE_AimedAt()
	{
		return target && target.player && abs(DeltaAngle(target.angle, target.AngleTo(self))) < 12;
	}

	bool HCE_ShieldsBack()
	{
		let sh = ShieldProcessor(FindInventory("ShieldProcessor", true));
		return !sh || sh.shields >= sh.maxShields * hce_shieldEmerge;
	}

	int HCE_CvHideTics() { return max(15, int(35 * frandom(0.9, 2.2) * HCE_D(HCE_D_BURST_SEP))); }

	void HCE_CvBegin()
	{
		hce_cvState = HCE_CV_GO;
		hce_cvArrive = level.maptime + 35 * 5;
		hce_cvUntil = level.maptime + random(35 * 10, 35 * 16);
	}

	void HCE_LeaveCover()
	{
		if(hce_cvState >= HCE_CV_HIDE && !hce_cvLow && hce_animLock <= 0 && health > 0) HCE_PlayLocked(HCE_CvKind(5), 0.7);
		hce_cvState = 0;
		hce_cvNext = level.maptime + random(35 * 3, 35 * 6);
	}

	// 0: not in cover (fight as usual); 1: on the way (moveA / spd / fire set for the caller); 2: in cover, all handled
	int HCE_CoverTick(double d, double toT, bool busy, out double moveA, out double spd, out bool fire)
	{
		if(hce_cvState == 0)
		{
			if(busy || level.maptime < hce_cvNext || !hce_canSee || !HCE_CoverCapable()) return 0;
			hce_cvNext = level.maptime + random(30, 45);
			if(d < max(hce_rangeMin * 0.7, 128)) return 0;
			// under fire (hurt lately, or the player aiming its way), or a third of the looks on its own account
			if(hce_recentDamageTics <= 0 && !HCE_AimedAt() && random(0, 2) != 0) return 0;
			bool tied = HCE_InSquad() || (HCE_SquadLeader() != null);
			if(!HCE_FindCover(tied ? 192 : 320)) { hce_cvNext = level.maptime + 35 * 3; return 0; }
			HCE_CvBegin();
		}
		if(!target || hce_berserk || d < max(hce_rangeMin * 0.5, 96) || level.maptime > hce_cvUntil
			|| level.maptime - hce_lastSeen > 35 * 4)
		{
			HCE_LeaveCover();
			return 0;
		}
		if(hce_cvState == HCE_CV_GO)
		{
			vector2 dv = hce_cvSpot.xy - pos.xy;
			double l = dv.Length();
			if(l > 12)
			{
				if(level.maptime > hce_cvArrive) { HCE_LeaveCover(); return 0; }
				moveA = atan2(dv.y, dv.x);
				spd = min(l > 96 ? hce_runSpeed : hce_walkSpeed, l);
				fire = hce_canSee;
				return 1;
			}
			HCE_Brake();
			A_SetAngle(toT, SPF_INTERPOLATE);
			hce_cvState = HCE_CV_HIDE;
			hce_cvPhase = level.maptime + HCE_CvHideTics();
			hce_cvCheck = level.maptime + 15;
			HCE_StopFireLoop(); hce_shotsLeft = 0; hce_burstTics = 0;
			if(!hce_cvLow) hce_cvPhase += HCE_PlayLocked(HCE_CvKind(0));
			return 2;
		}
		// in cover: still on the spot (a grenade dodge may have moved it), and the spot still hiding it
		vector2 anchor = hce_cvState == HCE_CV_OPEN && !hce_cvLow ? HCE_CvPeekPos() : hce_cvSpot.xy;
		if(hce_peekTics <= 0 && (anchor - pos.xy).Length() > 40) { hce_cvState = HCE_CV_GO; hce_cvArrive = level.maptime + 35 * 3; return 0; }
		if(level.maptime >= hce_cvCheck)
		{
			hce_cvCheck = level.maptime + 15;
			int sd;
			int k = HCE_CoverAt(hce_cvSpot.xy, hce_cvSpot.z, target, !hce_cvLow, hce_cvLow, sd);
			if(k == 0) { HCE_Say('Flee', 0.15, 35 * 4); HCE_LeaveCover(); return 0; }   // flanked
			if(k == 1 && hce_cvState == HCE_CV_HIDE && sd != hce_cvSide && hce_animLock <= 0) hce_cvSide = sd;
		}
		HCE_Brake();
		HCE_FaceTarget();
		spd = 0;
		if(hce_cvState == HCE_CV_HIDE)
		{
			if(hce_shotsLeft > 0 || hce_burstTics > 0) { HCE_StopFireLoop(); hce_shotsLeft = 0; hce_burstTics = 0; }
			HCE_Play(hce_cvLow ? HCE_A_CROUCH_IDLE : HCE_CvKind(1));
			hce_crouch = hce_cvLow;
			bool recovering = hce_action == HCE_ACT_COVER && !HCE_ShieldsBack();
			if(level.maptime >= hce_cvPhase && !recovering)
			{
				hce_cvState = HCE_CV_OPEN;
				hce_cvPhase = level.maptime + random(55, 110);
				hce_crouch = false;
				if(!hce_cvLow)
				{
					int lt = HCE_PlayLocked(HCE_CvKind(2));
					hce_cvPhase += lt;
					vector2 pp = HCE_CvPeekPos();
					if(CheckPosition(pp)) HCE_PeekSlide((pp, pos.z), lt);
				}
				else HCE_Play(HCE_A_ALERT);
			}
			return 2;
		}
		// leaning out past the corner, or standing up over the low wall: shoot
		HCE_Play(hce_cvLow ? HCE_A_ALERT : HCE_CvKind(3));
		HCE_UpdateFiring(d);
		if(bHCE_ThrowsGrenades) HCE_TryGrenade(d);
		if(level.maptime >= hce_cvPhase && hce_shotsLeft <= 0 && hce_chargeTics <= 0)
		{
			hce_cvState = HCE_CV_HIDE;
			hce_cvPhase = level.maptime + HCE_CvHideTics();
			HCE_StopFireLoop();
			if(!hce_cvLow)
			{
				int lt = HCE_PlayLocked(HCE_CvKind(4));
				hce_cvPhase += lt;
				HCE_PeekSlide(hce_cvSpot, lt);
			}
		}
		return 2;
	}

	// ------------------------------------------------------------------
	// Movement
	// ------------------------------------------------------------------
	void HCE_FaceTarget(double mul = 1.0)
	{
		if(!target) return;
		double want = AngleTo(target);
		double d = DeltaAngle(angle, want);
		double rate = hce_turnRate * mul;
		A_SetAngle(angle + clamp(d, -rate, rate), SPF_INTERPOLATE);
		double dz = (target.pos.z + target.height * 0.5) - (pos.z + height * 0.6);
		A_SetPitch(-atan2(dz, max(1, Distance2D(target))), SPF_INTERPOLATE);
	}

	void HCE_Brake()
	{
		vel.xy *= 0.6;
		hce_moveSpeed = 0;
	}

	// distance to the nearest wall along a heading (at chest height, or just above the tallest ledge it
	// can jump onto, so a jumpable step doesn't count as a wall)
	double HCE_Clearance(double ang, double maxd)
	{
		FLineTraceData tr;
		double z = hce_jumpHeight > 0 ? min(height - 4, max(height * 0.5, hce_jumpHeight + 4)) : height * 0.5;
		if(LineTrace(ang, maxd, 0, TRF_THRUACTORS | TRF_THRUHITSCAN, z, data: tr))
			return tr.Distance;
		return maxd;
	}

	// pick a heading near 'want' that has room ahead; headings that keep
	// the target in view (not straight away from it) are preferred
	double hce_headCache, hce_headWant;
	int    hce_headTics;
	double HCE_PickHeading(double want, double toTarget)
	{
		if(hce_unstickTics > 0) return hce_unstickAngle;
		if(hce_headTics > level.maptime && abs(DeltaAngle(want, hce_headWant)) < 25) return hce_headCache;
		static const double offs[] = { 0, 25, -25, 50, -50, 80, -80, 115, -115 };
		double best = want, bestScore = -1e9;
		double need = radius + 40;
		for(int i = 0; i < offs.Size(); i++)
		{
			double a = want + offs[i];
			double c = HCE_Clearance(a, 256);
			if(c < need) continue;
			double score = cos(offs[i]) * 1.2 + min(c, 256) / 256.0
			             - max(0, cos(DeltaAngle(a, toTarget + 180))) * 0.35;   // backing straight off is the last resort
			if(score > bestScore) { bestScore = score; best = a; }
		}
		if(bestScore < -1e8) best = toTarget + 90 * (hce_strafeDir != 0 ? hce_strafeDir : 1);
		// keep off the walls: nudge away from a wall close beside the chosen heading
		double wl = HCE_Clearance(best + 90, 96), wr = HCE_Clearance(best - 90, 96);
		if(wl < radius + 32 && wl < wr) best -= 30;
		else if(wr < radius + 32 && wr < wl) best += 30;
		hce_headCache = best; hce_headWant = want; hce_headTics = level.maptime + 6;
		return best;
	}

	// stuck: barely moved for half a second while trying to -> head for open space
	vector2 hce_stuckPos;
	int     hce_stuckTics, hce_unstickTics;
	double  hce_unstickAngle;
	void HCE_StuckCheck(double spd)
	{
		if(hce_unstickTics > 0) { hce_unstickTics--; return; }
		if(spd <= 0.5) { hce_stuckTics = 0; hce_stuckPos = pos.xy; return; }
		if(++hce_stuckTics < 18) return;
		hce_stuckTics = 0;
		bool stuck = (pos.xy - hce_stuckPos).Length() < spd * 4;
		hce_stuckPos = pos.xy;
		if(!stuck) return;
		double toT = target ? AngleTo(target) : angle;
		double best = toT, bc = -1;
		for(int i = 0; i < 8; i++)
		{
			double a = toT + 45 * i;
			double c = HCE_Clearance(a, 384) + (i == 0 ? 64 : 0);
			if(c > bc) { bc = c; best = a; }
		}
		hce_unstickAngle = best;
		hce_unstickTics = 25;
		hce_strafeDir = -hce_strafeDir;
	}

	// steering: try the wanted heading, then fan out
	bool HCE_Move(double ang, double spd)
	{
		if(hce_noMove) { hce_moveSpeed = 0; HCE_Brake(); return false; }
		if(spd > 0 && spd <= hce_walkSpeed * 1.01 && HCE_Relaxed()) spd = hce_lowWalkSpeed;     // an unhurried low-ready walk
		HCE_StuckCheck(spd);
		if(hce_unstickTics > 0) ang = hce_unstickAngle;
		hce_moveAngle = ang;
		hce_moveSpeed = spd;
		if(spd <= 0) { HCE_Brake(); return false; }
		if(hce_wounded) spd = min(spd, max(hce_walkSpeed * 0.6, hce_runSpeed * 0.45));   // a wounded Marine limps
		bool leash = hce_squadOrder == HCE_ORDER_HOLD && HCE_InSquad();
		double held = leash ? (pos.xy - hce_holdPos.xy).Length() : 0;
		static const double fan[] = { 0, 30, -30, 60, -60, 90, -90, 135, -135 };
		for(int i = 0; i < fan.Size(); i++)
		{
			double a = ang + fan[i];
			vector2 step = AngleToVector(a, spd);
			vector2 np = pos.xy + step;
			if(leash)                                    // holding a spot: no further than 192 units from it
			{
				double nd = (np - hce_holdPos.xy).Length();
				if(nd > 192 && nd > held) continue;
			}
			if(TryMove(np, 0))
			{
				hce_moveAngle = a;
				vel.xy = (0, 0);
				return true;
			}
			if(i == 0 && HCE_TryJump(a, true)) { hce_moveAngle = a; return true; }
			if(i == 0 && HCE_TryDrop(a, spd)) { hce_moveAngle = a; return true; }
		}
		HCE_Brake();
		return false;
	}

	// ------------------------------------------------------------------
	// Jumping: a ledge or a low obstacle (crate, barrel) straight ahead that is
	// too tall to step onto but within hce_jumpHeight is hopped onto / over:
	// airborne animation in the air, landing animation on touchdown.
	// ------------------------------------------------------------------
	// ------------------------------------------------------------------
	// Halo 2's hoist and vault (cover_anims.py): a ledge about as high as the hoist climbs is climbed instead of
	// jumped (Elites and Brutes climb ledges higher than they can jump), and a low wall or crate with floor beyond it
	// is vaulted. The animation carries the body; the actor stays where it started (rising by whatever the ledge is
	// taller than the animation) and is put where the body ended up when it finishes.
	// ------------------------------------------------------------------
	vector3 hce_climbFrom, hce_climbTo;
	int hce_climbTics, hce_climbDur;
	double hce_climbExtra;
	bool hce_noBlend;

	bool HCE_TryClimb(double ang, double rise, double top, bool overThing, Actor bm)
	{
		if(hce_team != HCE_TEAM_HUMAN && hce_team != HCE_TEAM_COVENANT) return false;
		vector2 dir = AngleToVector(ang, 1);
		double fwdMin = radius * 2 + 12 + (overThing && bm ? bm.radius * 2 : 0);
		vector2 far = pos.xy + dir * fwdMin;
		double fzFar = GetZAt(far.x, far.y, 0, GZF_ABSOLUTEPOS);
		if(abs(fzFar - pos.z) > MaxStepHeight && rise <= height * 0.6)
		{
			// a low wall crossed at a slant: floor again a little further on is a vault, not a climb onto the wall
			vector2 far2 = far + dir * 48;
			double fz2 = GetZAt(far2.x, far2.y, 0, GZF_ABSOLUTEPOS);
			if(abs(fz2 - pos.z) <= MaxStepHeight) { far = far2; fzFar = fz2; fwdMin += 48; }
		}
		bool vault;
		if(abs(fzFar - pos.z) <= MaxStepHeight && rise <= height * 0.6) vault = true;      // over and back down
		else if(!overThing && abs(fzFar - top) <= MaxStepHeight) vault = false;           // up onto a ledge
		else return false;
		int kind = vault ? HCE_A_VAULT : HCE_A_HOIST;
		Name n = HCE_AnimName(kind);
		if(n == 'None') return false;
		vector3 mv = HCE_AnimMove(n);
		if(mv.x <= 4) return false;
		if(!vault && (mv.z < 8 || rise < mv.z * 0.75 || rise > mv.z * 1.25)) return false;
		double fwd = max(mv.x, fwdMin);
		vector2 land = pos.xy + dir * fwd;
		double lz = GetZAt(land.x, land.y, 0, GZF_ABSOLUTEPOS);
		if(abs(lz - (vault ? pos.z : top)) > MaxStepHeight) return false;
		if(GetZAt(land.x, land.y, 0, GZF_ABSOLUTEPOS | GZF_CEILING) - lz < height + 2) return false;
		FLineTraceData tr;
		if(LineTrace(ang, fwd + radius, 0, TRF_THRUACTORS | TRF_THRUHITSCAN, rise + 8, data: tr)) return false;            // a wall above it
		if(LineTrace(ang, fwd + radius, 0, TRF_THRUACTORS | TRF_THRUHITSCAN, rise + height * 0.8, data: tr)) return false; // no room for the body
		let it = BlockThingsIterator.CreateFromPos(land.x, land.y, lz, height, radius + 64, false);
		while(it.Next())
		{
			let o = it.thing;
			if(o == self || o == bm || !o.bSOLID || o.health <= 0 && o.bISMONSTER) continue;
			if((o.pos.xy - land).Length() < radius + o.radius && o.pos.z < lz + height && o.pos.z + o.height > lz) return false;
		}
		A_SetAngle(ang);
		HCE_StopFireLoop();
		hce_climbFrom = pos;
		hce_climbTo = (land, lz);
		hce_climbExtra = vault ? 0 : max(0, (lz - pos.z) - mv.z);
		vel = (0, 0, 0);
		bNOGRAVITY = true;
		hce_climbDur = max(1, HCE_PlayLocked(kind));
		hce_climbTics = hce_climbDur;
		hce_jumpCooldown = level.maptime + 20;
		return true;
	}

	void HCE_ClimbTick()
	{
		vel = (0, 0, 0);
		double t = 1.0 - (hce_climbTics - 1) / double(hce_climbDur);
		SetZ(hce_climbFrom.z + hce_climbExtra * t * t * (3 - 2 * t));
		if(--hce_climbTics <= 0) HCE_EndClimb(true);
	}

	void HCE_EndClimb(bool arrive)
	{
		hce_climbTics = 0;
		bNOGRAVITY = default.bNOGRAVITY;
		if(!arrive) return;
		SetOrigin(hce_climbTo, false);
		hce_animLock = 0;
		hce_noBlend = true;                      // the body is already where the animation left it
		hce_stuckTics = 0; hce_unstickTics = 0; hce_stuckPos = pos.xy;
	}

	bool HCE_TryJump(double ang, bool useBlocker)
	{
		if(hce_jumpHeight <= 0 || bHCE_Flying || health <= 0 || hce_animLock > 0 || hce_jumpState > 0) return false;
		if(level.maptime < hce_jumpCooldown || pos.z > floorz + 2 || waterlevel >= 2) return false;
		CVar cv = CVar.FindCVar("hce_jumping");
		if(cv && !cv.GetBool()) return false;
		vector2 dir = AngleToVector(ang, 1);
		double reach = radius + 10;
		vector2 p = pos.xy + dir * reach;
		double fz = GetZAt(p.x, p.y, 0, GZF_ABSOLUTEPOS);
		double cz = GetZAt(p.x, p.y, 0, GZF_ABSOLUTEPOS | GZF_CEILING);
		double top = fz;
		bool overThing = false;
		let bm = useBlocker ? BlockingMobj : null;
		if(bm && bm != target && !bm.bISMONSTER && !bm.player && bm.bSOLID)     // a crate, barrel or lamp
		{
			double t = bm.pos.z + bm.height;
			if(t > top) { top = t; overThing = true; }
		}
		double rise = top - pos.z;
		if(rise > MaxStepHeight && HCE_TryClimb(ang, rise, top, overThing, bm)) return true;
		if(rise <= MaxStepHeight || rise > hce_jumpHeight) return false;
		if(cz - top < height + 2 || ceilingz - pos.z < rise + height + 4) return false;   // no headroom
		// somewhere to land: past a ledge the ground must stay up (not a thin wall or a railing);
		// over a thing it may be back at our own height
		vector2 p2 = pos.xy + dir * (radius * 2 + 20);
		double fz2 = GetZAt(p2.x, p2.y, 0, GZF_ABSOLUTEPOS);
		if(!overThing && fz2 < top - MaxStepHeight) return false;
		FLineTraceData tr;
		if(LineTrace(ang, radius * 2 + 24, 0, TRF_THRUACTORS | TRF_THRUHITSCAN, rise + 8, data: tr)) return false;   // wall above it
		double g = max(0.1, GetGravity());
		double vz = sqrt(2 * g * (rise + 12));
		double t = vz / g * 1.6;                               // until it is over the edge and coming down
		double vh = clamp((reach + radius + (overThing ? bm.radius * 2 : 8)) / t, 2.5, max(4, hce_runSpeed * 1.3));
		hce_jumpVel = dir * vh;
		vel = (hce_jumpVel, vz);
		hce_jumpState = 1; hce_jumpTics = 0; hce_jumpCooldown = level.maptime + 20;
		HCE_StopFireLoop();
		int k = HCE_HasAnim(HCE_A_AIRBORNE) ? HCE_A_AIRBORNE : HCE_HasAnim(HCE_A_LEAP_AIR) ? HCE_A_LEAP_AIR : HCE_A_MOVE_F;
		HCE_Play(k, true, true, 3, true);
		return true;
	}

	// Dropping off a ledge: Marines and the Covenant step off a drop that is too deep to walk down when where they're
	// going (their target, the spot they last saw it, or the player they follow) is down there, as long as the drop
	// is safe for them (up to two and a half times their height) and doesn't land in a damaging floor. Halo's AI does
	// the same with its 'safe to jump down' hint. They fall in the airborne animation and land in the landing one.
	double HCE_SafeDrop() { return height * 2.5; }

	bool HCE_TryDrop(double ang, double spd)
	{
		if(bHCE_Flying || health <= 0 || hce_animLock > 0 || hce_jumpState > 0 || pos.z > floorz + 2 || waterlevel >= 2) return false;
		if(hce_team != HCE_TEAM_HUMAN && hce_team != HCE_TEAM_COVENANT) return false;
		double goalZ;
		if(target && hce_canSee) goalZ = target.pos.z;
		else if(target) goalZ = hce_lastKnown.z;
		else if(HCE_InSquad() && players[consoleplayer].mo) goalZ = players[consoleplayer].mo.pos.z;
		else return false;
		if(goalZ > pos.z - MaxStepHeight) return false;                      // nothing to go down for
		vector2 dir = AngleToVector(ang, 1);
		vector2 p = pos.xy + dir * (radius + max(spd, 4) + 4);
		double fz = GetZAt(p.x, p.y, 0, GZF_ABSOLUTEPOS);
		double drop = pos.z - fz;
		if(drop <= MaxStepHeight || drop > HCE_SafeDrop()) return false;
		let sec = level.PointInSector(p);
		if(sec && sec.damageamount > 0) return false;                        // lava, slime
		if(!TryMove(pos.xy + dir * max(spd, 4), 1)) return false;
		hce_jumpVel = dir * clamp(spd, 2.5, max(4, hce_runSpeed));
		vel = (hce_jumpVel, 0);
		hce_jumpState = 1; hce_jumpTics = 0; hce_jumpCooldown = level.maptime + 20;
		HCE_StopFireLoop();
		int k = HCE_HasAnim(HCE_A_AIRBORNE) ? HCE_A_AIRBORNE : HCE_HasAnim(HCE_A_LEAP_AIR) ? HCE_A_LEAP_AIR : HCE_A_MOVE_F;
		HCE_Play(k, true, true, 3, true);
		return true;
	}

	void HCE_JumpTick()
	{
		hce_jumpTics++;
		if(hce_jumpTics < 25 && vel.z > -3) vel.xy = hce_jumpVel;   // keep driving forward until it is over the edge
		if(target) HCE_FaceTarget(0.5);
		bool grounded = pos.z <= floorz + 0.5 && vel.z <= 0;
		if((grounded && hce_jumpTics > 2) || hce_jumpTics > 70)
		{
			hce_jumpState = 0;
			vel.xy *= 0.3;
			hce_stuckTics = 0; hce_unstickTics = 0; hce_stuckPos = pos.xy;
			if(HCE_HasAnim(HCE_A_LAND)) HCE_PlayLocked(HCE_A_LAND, 0.35);
		}
	}

	void HCE_PickMoveAnim()
	{
		if(hce_moveSpeed <= 0.1)
		{
			if(hce_crouch) HCE_Play(HCE_A_CROUCH_IDLE);
			else if(hce_curAnimKind != HCE_A_FIRE || !hce_canSee) HCE_Play(target ? HCE_A_ALERT : HCE_A_IDLE);
			return;
		}
		hce_crouch = false;
		double rel = DeltaAngle(angle, hce_moveAngle);
		int k = HCE_A_MOVE_F;
		if(rel > 45 && rel < 135) k = HCE_A_MOVE_L;
		else if(rel < -45 && rel > -135) k = HCE_A_MOVE_R;
		else if(abs(rel) >= 135) k = HCE_A_MOVE_B;
		if(!HCE_HasAnim(k)) k = HCE_A_MOVE_F;
		HCE_Play(k);
	}

	void HCE_Hover()
	{
		double want = max(floorz + hce_flyHeight, min(ceilingz - height - 8, (target ? target.pos.z + target.height * 0.6 : pos.z)));
		vel.z = clamp((want - pos.z) * 0.08, -3, 3) + sin(level.maptime * 6) * 0.15;
	}

	// ------------------------------------------------------------------
	// The player's squad: Marines following the player take orders (follow / hold here / regroup on me, from the
	// "Halo CE Squad" keys), scold friendly fire and turn on a player who keeps shooting them (hce_betrayal),
	// forgiving them 30 s after the last hit; badly hurt they limp and call for help; the last Marine standing
	// with the player far off cowers; and Sergeant Johnson steadies the Marines around him.
	// ------------------------------------------------------------------
	const HCE_ORDER_FOLLOW = 0;
	const HCE_ORDER_HOLD = 1;
	const HCE_ORDER_REGROUP = 2;
	int hce_squadOrder;
	vector3 hce_holdPos;
	int hce_regroupUntil;
	Actor hce_betrayed;                  // the player this Marine turned on
	int hce_betrayUntil;
	int hce_ffHits, hce_ffUntil;
	double hce_ffDamage;
	Actor hce_lastHurter;
	bool hce_wounded, hce_inspired, hce_squadDeathDone;
	int hce_squadScanTics, hce_cowerCooldown;

	bool hce_holdFire;                   // "hold fire": no shots or grenades until "open fire"
	Actor hce_focusTarget;               // "focus": the enemy the player pointed out
	int hce_suppressUntil;               // "suppress": long bursts, short pauses until then
	Actor hce_medicFor;                  // "medic": the player this Marine is running to patch up
	int hce_medicTics, hce_medicPhase;

	bool HCE_InSquad() { return bHCE_FollowPlayer && hce_team == HCE_TEAM_HUMAN; }

	// answering an order: "Yes sir" once the Chief has said it (1.6 to 2.3 s later), not on top of his line
	int hce_ackAt;
	void HCE_AckLater() { hce_ackAt = level.maptime + random(55, 80); }

	// "press that button": walk to the switch the player pointed at and use it
	Line hce_button; int hce_buttonSide, hce_buttonTics; vector3 hce_buttonAt;
	void HCE_ButtonOrder(Line l, int side, vector3 at)
	{
		if(!HCE_InSquad() || health <= 0 || hce_betrayed) return;
		hce_button = l; hce_buttonSide = side; hce_buttonAt = at; hce_buttonTics = 35 * 10;
		hce_scavItem = null; hce_medicFor = null;
		HCE_AckLater();
		if(InStateSequence(CurState, ResolveState("Spawn"))) SetStateLabel("See");
	}

	bool HCE_ButtonTick()
	{
		if(!hce_button || health <= 0 || --hce_buttonTics <= 0) { hce_button = null; return false; }
		vector2 dv = hce_buttonAt.xy - pos.xy;
		if(dv.Length() > radius + 24)
		{
			HCE_StopFireLoop(); hce_shotsLeft = 0;
			HCE_Move(atan2(dv.y, dv.x), hce_runSpeed);
			A_SetAngle(hce_moveAngle, SPF_INTERPOLATE);
			HCE_PickMoveAnim();
			return true;
		}
		HCE_Brake();
		A_SetAngle(atan2(dv.y, dv.x), SPF_INTERPOLATE);
		hce_button.Activate(self, hce_buttonSide, SPAC_Use);
		hce_button = null;
		HCE_Play(HCE_A_IDLE, true, true);
		return true;
	}

	// ------------------------------------------------------------------
	// A Marine's rank and name, shown over him while the player has him in the crosshair (HCE_SpawnAllHandler's
	// overlay, with Halo CE's health bar). Rolled at spawn from the lists below; Johnson and Stacker have their own.
	// ------------------------------------------------------------------
	String hce_rankName;

	virtual void HCE_RollName()
	{
		static const String first[] = { "George", "James", "Michael", "Robert", "David", "William", "Richard", "Joseph",
			"Thomas", "Charles", "Daniel", "Matthew", "Anthony", "Mark", "Paul", "Steven", "Andrew", "Kenneth", "Joshua",
			"Kevin", "Brian", "Edward", "Ronald", "Timothy", "Jason", "Jeffrey", "Ryan", "Jacob", "Gary", "Nicholas",
			"Eric", "Jonathan", "Stephen", "Larry", "Justin", "Scott", "Brandon", "Benjamin", "Samuel", "Gregory",
			"Frank", "Raymond", "Patrick", "Jack", "Dennis", "Jerry", "Tyler", "Aaron", "Jose", "Adam", "Henry",
			"Nathan", "Douglas", "Zachary", "Peter", "Kyle", "Walter", "Ethan", "Jeremy", "Harold", "Carl", "Keith",
			"Roger", "Gerald", "Christian", "Terry", "Sean", "Arthur", "Austin", "Noah", "Lawrence", "Jesse", "Dylan",
			"Bryan", "Joe", "Jordan", "Billy", "Bruce", "Albert", "Willie", "Gabriel", "Logan", "Alan", "Juan", "Wayne",
