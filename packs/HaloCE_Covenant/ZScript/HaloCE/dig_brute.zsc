// Halo 2 Brute support class: the helmet that pops off when a Brute takes a headshot.
class HCE_BruteHelmetDebris : Actor
{
	Default
	{
		Radius 6;
		Height 8;
		Gravity 0.8;
		BounceType "Doom";
		BounceFactor 0.4;
		WallBounceFactor 0.4;
		BounceCount 4;
		+MISSILE
		+NOBLOCKMAP
		+DROPOFF
		+MOVEWITHSECTOR
		+THRUACTORS
		+DECOUPLEDANIMATIONS
		Scale 64;
	}
	int life;
	String hce_piece;                // armour kit helmet: debris_<piece>.iqm swapped in on the first tick
	override void Tick()
	{
		if(hce_piece.Length() > 0)
		{
			A_ChangeModel('None', 0, "models/hce_dig/BruteKit", hce_piece);
			hce_piece = "";
		}
		super.Tick();
	}
	States
	{
	Spawn:
		HCEM A 1
		{
			roll += 14; pitch += 9;
			if(++life > 35 * 20) A_FadeOut(0.05);
		}
		Loop;
	Death:
		HCEM A 1 { if(++life > 35 * 20) A_FadeOut(0.05); }
		Loop;
	}
}

// Halo 2's Brute Captain hologram flag (brute_captain_flag.py): the pennant on the pole on a Captain's back, drawn
// additively and bright on its own copy of the Brute's skeleton, playing the Brute's animations (HCE_ApplyAnim mirrors
// them onto hce_holoActor). Its shimmer, scan lines and flicker are the hce_holoflag.fp shader. It stays with the body
// once the Captain is dead, and goes when the body does (or is torn apart).
class HCE_BruteCaptainFlag : Actor
{
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+DECOUPLEDANIMATIONS
		+NOTONAUTOMAP
		RenderStyle "Add";
		Alpha 1.0;
	}
	States
	{
	Spawn:
		HCEM A -1 Bright;
		Stop;
	}
	override void Tick()
	{
		if(!master || master.bDestroyed) { Destroy(); return; }
		if(isFrozen()) return;
		SetOrigin(master.pos, true);
		angle = master.angle; pitch = master.pitch; roll = master.roll;
		scale = master.scale;
		bInvisible = master.bInvisible || master.alpha < 0.05;
		alpha = 0.92 + 0.08 * sin(level.maptime * 23.0) - (random[HCEFlag](0, 40) == 0 ? 0.5 : 0);   // a hologram's flicker
	}
}
