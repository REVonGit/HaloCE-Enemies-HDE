		case 'stand rifle cover-left-unpeek': return 16;
		case 'stand rifle cover-right-enter': return 24;
		case 'stand rifle cover-right-exit': return 15;
		case 'stand rifle cover-right-idle': return 104;
		case 'stand rifle cover-right-open': return 2;
		case 'stand rifle cover-right-peek': return 22;
		case 'stand rifle cover-right-unpeek': return 22;
		case 'stand rifle dive-front': return 77;
		case 'stand rifle dive-left': return 66;
