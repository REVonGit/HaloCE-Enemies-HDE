		case 'stand rifle melee': return 57;
		case 'stand rifle move-back': return 29;
		case 'stand rifle move-front': return 29;
		case 'stand rifle move-left': return 29;
		case 'stand rifle move-right': return 29;
		case 'stand rifle signal-attack': return 37;
		case 'stand rifle throw-grenade': return 69;
		case 'stand rifle turn-left': return 16;
		case 'stand rifle turn-right': return 16;
		case 'stand rifle warn': return 63;
		}
		return 30;
