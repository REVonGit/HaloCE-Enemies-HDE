		case 'h-kill front head': return 105;
		case 'h-ping back gut': return 27;
		case 'h-ping front gut': return 22;
		case 's-kill back gut': return 48;
		case 's-kill front gut': return 69;
		case 's-kill left gut': return 40;
		case 's-kill right gut': return 51;
		case 's-ping back gut baked': return 16;
		case 's-ping front gut baked': return 16;
		case 's-ping left gut baked': return 16;
		case 's-ping right gut baked': return 16;
		case 'stand airborne-dead': return 49;
		case 'stand landing-dead': return 34;
		case 'stand rifle airborne': return 91;
		case 'stand rifle berserk': return 50;
		case 'stand rifle celebrate': return 66;
		case 'stand rifle cover-left-enter': return 24;
		case 'stand rifle cover-left-exit': return 10;
		case 'stand rifle cover-left-idle': return 104;
		case 'stand rifle cover-left-open': return 2;
		case 'stand rifle cover-left-peek': return 16;
		case 'stand rifle cover-left-unpeek': return 16;
		case 'stand rifle cover-right-enter': return 24;
		case 'stand rifle cover-right-exit': return 15;
		case 'stand rifle cover-right-idle': return 104;
		case 'stand rifle cover-right-open': return 2;
		case 'stand rifle cover-right-peek': return 22;
		case 'stand rifle cover-right-unpeek': return 22;
		case 'stand rifle dive-front': return 77;
		case 'stand rifle dive-left': return 66;
		case 'stand rifle dive-right': return 75;
		case 'stand rifle evade-left': return 33;
		case 'stand rifle evade-right': return 34;
		case 'stand rifle fire-1 pr baked': return 10;
		case 'stand rifle hoist': return 51;
		case 'stand rifle idle': return 69;
		case 'stand rifle land-soft': return 38;
		case 'stand rifle low-idle': return 140;
		case 'stand rifle low-move': return 60;
		case 'stand rifle melee%0': return 42;
		case 'stand rifle melee%1': return 43;
		case 'stand rifle move-back': return 29;
		case 'stand rifle move-front': return 27;
		case 'stand rifle move-left': return 33;
		case 'stand rifle move-right': return 30;
		case 'stand rifle signal-attack': return 80;
		case 'stand rifle surprise-front': return 78;
		case 'stand rifle throw-grenade%1': return 77;
		case 'stand rifle turn-left': return 27;
		case 'stand rifle turn-right': return 28;
		case 'stand rifle warn': return 57;
		case 'stand support vault': return 21;
		case 'stand unarmed melee%0': return 42;
		case 'stand unarmed melee%1': return 42;
		}
		return 30;
