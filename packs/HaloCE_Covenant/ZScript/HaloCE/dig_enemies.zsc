		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: return 's-ping front gut baked';
		case HCE_A_PING_B: return 's-ping back gut baked';
		case HCE_A_PING_L: return 's-ping left gut baked';
