		switch(kind)
		{
		case HCE_A_IDLE: { static const Name o[] = { 'stand unarmed idle%0', 'stand unarmed idle%1', 'stand unarmed idle%2' }; return o[random(0, 2)]; }
		case HCE_A_ALERT: return 'alert unarmed idle';
		case HCE_A_MOVE_F: return 'stand unarmed move-front';
		case HCE_A_MOVE_B: return 'stand unarmed move-back';
