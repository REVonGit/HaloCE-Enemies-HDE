		case 5: A_ChangeModel('None', 0, "", 'None', 5, "models/hce_dig/EliteRifle", 'skins/eliterangerplasmacarbine_eliterifle_5.png', CMDL_USESURFACESKIN); return;
		case 6: A_ChangeModel('None', 0, "", 'None', 6, "models/hce_dig/weapons", 'w_cmt_carbine_gray.png', CMDL_USESURFACESKIN); return;
		case 7: A_ChangeModel('None', 0, "", 'None', 7, "models/hce_dig/weapons", 'w_cmt_carbine_lights.png', CMDL_USESURFACESKIN); return;
		case 8: A_ChangeModel('None', 0, "", 'None', 8, "models/hce_dig/weapons", 'w_cmt_carbine_icon.png', CMDL_USESURFACESKIN); return;
		case 9: A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/weapons", 'w_cmt_carbine_meter.png', CMDL_USESURFACESKIN); return;
		case 10: A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'w_cmt_carbine_purple.png', CMDL_USESURFACESKIN); return;
		case 11: A_ChangeModel('None', 0, "", 'None', 11, "models/hce_dig/EliteRifle", 'skins/eliterangerplasmacarbine_eliterifle_0.png', CMDL_USESURFACESKIN); return;
		case 12: A_ChangeModel('None', 0, "", 'None', 12, "models/hce_dig/EliteRifle", 'skins/eliterangerplasmacarbine_eliterifle_1.png', CMDL_USESURFACESKIN); return;
		case 13: A_ChangeModel('None', 0, "", 'None', 13, "models/hce_dig/EliteRifle", 'skins/eliterangerplasmacarbine_eliterifle_5.png', CMDL_USESURFACESKIN); return;
		case 14: A_ChangeModel('None', 0, "", 'None', 14, "models/hce_dig/EliteRifle", 'skins/eliterangerplasmacarbine_eliterifle_5.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
	override void HCE_DressSurfaces()
