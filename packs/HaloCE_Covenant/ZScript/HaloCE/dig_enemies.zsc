		case 's-kill back gut': return 48;
		case 's-kill front gut': return 69;
		case 's-kill left gut': return 40;
		case 's-kill right gut': return 51;
		case 's-ping back gut baked': return 16;
		case 's-ping front gut baked': return 16;
		case 's-ping left gut baked': return 16;
		case 's-ping right gut baked': return 16;
		case 'stand airborne-dead': return 49;
		case 'stand landing-dead': return 34;
		case 'stand rifle airborne': return 69;
		case 'stand rifle berserk': return 51;
		case 'stand rifle celebrate': return 66;
