		case 'stand pistol hoist': return 29;
		case 'stand pistol idle': return 70;
		case 'stand pistol land-soft': return 28;
		case 'stand pistol low-idle': return 70;
		case 'stand pistol low-move': return 34;
		case 'stand pistol melee': return 57;
		case 'stand pistol move-back': return 24;
		case 'stand pistol move-front': return 23;
		case 'stand pistol move-left': return 23;
		case 'stand pistol move-right': return 23;
		case 'stand pistol overheat': return 71;
		case 'stand pistol reload-1': return 43;
		case 'stand pistol signal-attack': return 77;
		case 'stand pistol surprise-back': return 28;
		case 'stand pistol surprise-front': return 33;
		case 'stand pistol turn-left': return 16;
		case 'stand pistol turn-right': return 16;
		case 'stand pistol warn': return 50;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand pistol hoist': return (59.0, 0.1, 39.9);
		}
		return (0, 0, 0);
	}

	// ---- Halo 2 Jackal: its arm shield rides the 'shield' node of the right forearm, the gun is in the left hand
	override Name HCE_ShieldBone() { return 'shield'; }
	override Name HCE_GunHandBone() { return 'l_hand'; }
	override int HCE_ShieldSurface() { return 10; }
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch pistol idle': return (19.6, -7.6, 1.9);
		case 'crouch pistol move-front': return (29.4, -7.6, 5.2);
		case 'stand pistol move-back': return (29.1, -7.5, 16.9);
		case 'stand pistol move-front': return (36.2, -8.3, 14.1);
		case 'stand pistol move-left': return (33.6, -7.8, 7.6);
		case 'stand pistol move-right': return (33.6, -6.0, 5.3);
		}
		return hce_gunOffset;
	}
}

