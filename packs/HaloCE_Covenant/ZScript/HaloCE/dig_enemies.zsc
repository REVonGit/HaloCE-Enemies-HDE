	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'stand rifle cover-left-open': return (15.9, 8.2, -5.8);
		case 'stand rifle cover-right-open': return (24.2, -6.5, 7.2);
		case 'stand rifle idle': return (58.2, 7.0, 25.0);
		case 'stand rifle move-back': return (51.8, 12.2, 13.1);
		case 'stand rifle move-front': return (57.2, 11.2, 20.0);
		case 'stand rifle move-left': return (47.4, 9.8, 26.3);
		case 'stand rifle move-right': return (52.2, 22.3, 18.8);
		}
		return hce_gunOffset;
	}
