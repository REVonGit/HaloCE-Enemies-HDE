		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 76;
		Radius 30;
		Mass 317;
		PainChance 0;
		Tag "Brute";
		BloodColor "16 1C 40";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Name HCE_ShellClass() { return 'HCE_BruteShieldShell'; }
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			HCE_HideSurface(4);
			HCE_HideSurface(5);
			HCE_HideSurface(7);
			HCE_HideSurface(8);
			HCE_HideSurface(28);
			HCE_HideSurface(29);
			HCE_HideSurface(30);
			HCE_ShowStumps(hce_severed | (1 << 0));
			HCE_SpawnLimb(0, (0.1345, -0.0001, 0.7725), 92.00, "models/hce_dig/Brute", 'Brute_gib_head.iqm', 31, 'gore_Brute.png', 0.0940);
			HCE_OnSever(0, false);
			return true;
		case 1:
			if(bDECOUPLEDANIMATIONS) SetNamedBoneScaling('l_upperarm', (0, 0, 0), SB_REPLACE, 0);
			HCE_ShowStumps(hce_severed | (1 << 1));
			HCE_SpawnLimb(1, (0.0952, 0.2310, 0.5749), 92.00, "models/hce_dig/Brute", 'Brute_gib_larm.iqm', 31, 'gore_Brute.png', 0.0892);
			HCE_OnSever(1, false);
			return true;
		case 2:
			HCE_HideSurface(20);
			HCE_HideSurface(21);
			HCE_HideSurface(22);
			HCE_HideSurface(23);
			HCE_HideSurface(24);
			HCE_HideSurface(25);
			HCE_HideSurface(26);
			HCE_HideSurface(27);
			if(bDECOUPLEDANIMATIONS) SetNamedBoneScaling('r_upperarm', (0, 0, 0), SB_REPLACE, 0);
			HCE_ShowStumps(hce_severed | (1 << 2));
			HCE_SpawnLimb(2, (0.1193, -0.2363, 0.5389), 92.00, "models/hce_dig/Brute", 'Brute_gib_rarm.iqm', 31, 'gore_Brute.png', 0.0734);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	void HCE_ShowStumps(int sev)
	{
		if(sev & (1 << 0)) A_ChangeModel('None', 9, "models/hce_dig/Brute", 'Brute_stumps.iqm', 0, "models/hce_dig/Brute", 'gore_Brute.png', CMDL_USESURFACESKIN);
		else A_ChangeModel('None', 9, "models/hce_dig/Brute", 'Brute_stumps.iqm', 0, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		if(sev & (1 << 1)) A_ChangeModel('None', 9, "models/hce_dig/Brute", 'Brute_stumps.iqm', 1, "models/hce_dig/Brute", 'gore_Brute.png', CMDL_USESURFACESKIN);
		else A_ChangeModel('None', 9, "models/hce_dig/Brute", 'Brute_stumps.iqm', 1, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		if(sev & (1 << 2)) A_ChangeModel('None', 9, "models/hce_dig/Brute", 'Brute_stumps.iqm', 2, "models/hce_dig/Brute", 'gore_Brute.png', CMDL_USESURFACESKIN);
		else A_ChangeModel('None', 9, "models/hce_dig/Brute", 'Brute_stumps.iqm', 2, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (12.4, -0.0, 85.3);
		case 1: return (8.8, 21.2, 63.5);
		case 2: return (11.0, -21.7, 59.5);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce_dig/Brute", 'Brute_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce_dig/Brute", 'Brute_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce_dig/Brute", 'Brute_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 4, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 5, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 7, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 8, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 28, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 29, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 30, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			break;
		case 2:
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		static const int W[] = { 20, 21, 22, 23, 24, 25, 26, 27 };
		for(int i = 0; i < W.Size(); i++)
		{
			if(show) HCE_ShowSurface(W[i]);
			else HCE_HideSurface(W[i]);    // the guns it never held stay undrawn
		}
		if(!show && hce_hasLoadout) A_ChangeModel('None', 8, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);   // a picked-up overlay gun
	}
	// guns it can pick up off the ground (HaloDoom_EnemyBase.HCE_ScavengeScan): Halo_AssaultRifle, Halo_BeamRifle, Halo_Bulldog, Halo_DBLShotgun, Halo_Flamethrower, Halo_FuelRod, Halo_GPMG, Halo_GrenadeLauncher, Halo_Hydra, Halo_MA5B, Halo_PlasmaRifle, Halo_RocketLauncher, Halo_SMG, Halo_Shotgun, Halo_Spiker
	override bool HCE_HasLoadouts() { return true; }
