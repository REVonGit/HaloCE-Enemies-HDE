class HCE_EliteRifleBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 64;
		Radius 16;
		Mass 177;
		PainChance 0;
		Tag "EliteRifle";
		BloodColor "3A 1E 8C";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 2, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 15, "models/hce_dig/EliteRifle", 'gore_EliteRifle.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.1664, 0.0003, 0.6444), 80.00, "models/hce_dig/EliteRifle", 'EliteRifle_gib_head.iqm', 15, 'gore_EliteRifle.png', 0.0713);
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 0, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce_dig/EliteRifle", 'gore_EliteRifle.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (0.0048, 0.1506, 0.3901), 80.00, "models/hce_dig/EliteRifle", 'EliteRifle_gib_larm.iqm', 16, 'gore_EliteRifle.png', 0.0454);
			HCE_OnSever(1, false);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 6, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 7, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 11, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 17, "models/hce_dig/EliteRifle", 'gore_EliteRifle.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (0.0058, -0.1484, 0.3862), 80.00, "models/hce_dig/EliteRifle", 'EliteRifle_gib_rarm.iqm', 17, 'gore_EliteRifle.png', 0.0446);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (13.3, 0.0, 61.9);
		case 1: return (0.4, 12.0, 37.4);
		case 2: return (0.5, -11.9, 37.1);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce_dig/EliteRifle", 'EliteRifle_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce_dig/EliteRifle", 'EliteRifle_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce_dig/EliteRifle", 'EliteRifle_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 2, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 12, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 0, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 13, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 11, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 14, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		Name sk = show ? 'None' : 'hce_hidden.png';
		static const int W[] = { 6, 7, 8, 9, 10 };
		for(int i = 0; i < W.Size(); i++) A_ChangeModel('None', 0, "", 'None', W[i], "models/hce_dig/weapons", sk, CMDL_USESURFACESKIN);
	}
}

