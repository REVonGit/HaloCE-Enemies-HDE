		case 'stand sword throw-grenade': return 63;
		case 'stand sword turn-left': return 16;
		case 'stand sword turn-right': return 16;
		case 'stand sword vault': return 22;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand sword hoist': return (92.4, -0.0, 84.4);
		case 'stand sword vault': return (71.4, -0.0, 1.8);
		}
		return (0, 0, 0);
	}
	override bool HCE_HasLoadouts() { return false; }      // keeps the gun it is built around
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch guard sword idle': return (43.9, 20.3, -27.3);
		case 'crouch guard sword move-front': return (46.0, 25.0, -20.7);
		case 'crouch sword idle': return (43.9, 20.3, -27.3);
