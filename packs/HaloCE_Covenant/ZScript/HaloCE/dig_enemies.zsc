		case 's-kill front gut': return 289;
		case 's-ping back gut baked': return 18;
		case 's-ping front gut baked': return 16;
		case 's-ping left gut baked': return 16;
		case 's-ping right gut baked': return 18;
		case 'stand airborne-dead': return 49;
		case 'stand landing-dead': return 65;
		case 'stand pistol evade-left': return 33;
		case 'stand pistol evade-right': return 38;
