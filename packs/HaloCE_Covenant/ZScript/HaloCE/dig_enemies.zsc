		case 20: A_ChangeModel('None', 0, "", 'None', 20, "models/hce_dig/weapons", 'w_plasma_rifle_0.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
