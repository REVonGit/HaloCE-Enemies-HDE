// characters\brute\brute captain plasma caster
class HCE_BruteCaptainPlasmaCaster : HCE_BruteBase
{
	Default
	{
		Health 200;
		Speed 6.5;
		HaloDoom_EnemyBase.HCE_Type 0;
		HaloDoom_EnemyBase.HCE_Variant "brute captain plasma caster";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 160;
		HaloDoom_EnemyBase.HCE_Movement 4.23, 6.50, 12;
