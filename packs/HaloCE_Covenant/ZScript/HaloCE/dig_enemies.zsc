	{
		switch(w)
		{
		case 'Halo_AssaultRifle': return 0;
		case 'Halo_BeamRifle': return 1;
		case 'Halo_Bulldog': return 2;
		case 'Halo_DBLShotgun': return 3;
		case 'Halo_Flamethrower': return 4;
		case 'Halo_FuelRod': return 5;
		case 'Halo_GPMG': return 6;
		case 'Halo_GrenadeLauncher': return 7;
		case 'Halo_Hydra': return 8;
		case 'Halo_MA5B': return 9;
		case 'Halo_PlasmaRifle': return 10;
		case 'Halo_RocketLauncher': return 11;
		case 'Halo_SMG': return 12;
		case 'Halo_Shotgun': return 13;
		case 'Halo_Spiker': return 14;
		}
		return -1;
	}
