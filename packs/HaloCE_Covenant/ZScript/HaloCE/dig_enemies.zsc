		case HCE_A_PING_F: { static const Name o[] = { 's-ping front chest%0 baked', 's-ping front chest%1 baked', 's-ping front gut baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut baked', 's-ping left l-leg baked', 's-ping left r-leg baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut baked', 's-ping right l-leg baked', 's-ping right r-leg baked' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 'h-kill back gut';
