		HaloDoom_EnemyBase.HCE_Movement 5.61, 8.63, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 0.00;
		HaloDoom_EnemyBase.HCE_Weapon "HCE_PulseCarbineBolt", 1, 3.00, 0.06, 3200;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 112.0;
		HaloDoom_EnemyBase.HCE_DamageModifier 0.50;
		HaloDoom_EnemyBase.HCE_CombatRange 400, 2720;
		HaloDoom_EnemyBase.HCE_Burst 0.55, 0.85, 2.00, 3.00, 0.25, 0.50;
		HaloDoom_EnemyBase.HCE_GunOffset (33.0, -0.9, 2.6);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 24, 20;
		HaloDoom_EnemyBase.HCE_Leap 0, 0, 0.00, 6.5;
		HaloDoom_EnemyBase.HCE_Grenades 0, 0, 0.00, 0.0, 0, 960, 18.7;
		HaloDoom_EnemyBase.HCE_Panic 0.80, 0.20, 4.0, 6.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.00, 0.00, 0;
