		case HCE_A_FLEE_IDLE: return 'flee pistol idle';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'crouch rifle idle': return 69;
		case 'crouch rifle move-front': return 42;
		case 'flee pistol idle': return 70;
		case 'flee pistol move-front': return 23;
		case 'h-kill back gut': return 49;
		case 'h-kill front gut': return 41;
		case 'h-ping back gut': return 38;
		case 'h-ping front chest': return 41;
		case 'h-ping front gut': return 28;
		case 'h-ping front r-hand': return 44;
		case 's-kill back gut': return 93;
		case 's-kill front gut': return 82;
		case 's-kill left gut': return 46;
		case 's-kill right gut': return 46;
		case 's-ping back gut baked': return 7;
		case 's-ping front gut baked': return 6;
		case 's-ping left gut baked': return 7;
		case 's-ping right gut baked': return 10;
		case 'stand airborne-dead': return 85;
		case 'stand landing-dead': return 24;
		case 'stand pistol melee': return 57;
		case 'stand rifle airborne': return 72;
		case 'stand rifle celebrate': return 61;
		case 'stand rifle dive-front': return 50;
		case 'stand rifle dive-left': return 50;
		case 'stand rifle dive-right': return 50;
		case 'stand rifle evade-left': return 32;
		case 'stand rifle evade-right': return 32;
		case 'stand rifle fire-1 csr baked': return 12;
		case 'stand rifle hoist': return 29;
		case 'stand rifle idle': return 69;
		case 'stand rifle land-soft': return 28;
		case 'stand rifle low-move': return 34;
		case 'stand rifle move-back': return 23;
		case 'stand rifle move-front': return 23;
		case 'stand rifle move-left': return 23;
		case 'stand rifle move-right': return 23;
		case 'stand rifle signal-attack': return 78;
		case 'stand rifle surprise-back': return 28;
		case 'stand rifle surprise-front': return 33;
		case 'stand rifle turn-left': return 16;
		case 'stand rifle turn-right': return 16;
		case 'stand rifle warn': return 50;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand rifle hoist': return (59.0, 0.1, 39.9);
		}
		return (0, 0, 0);
	}

	// ---- Halo 2 Jackal: its arm shield rides the 'shield' node of the right forearm, the gun is in the left hand
	override Name HCE_ShieldBone() { return 'shield'; }
	override Name HCE_GunHandBone() { return 'l_hand'; }
	override int HCE_ShieldSurface() { return 10; }

	// the carbine's tracer: every round draws HaloDoom Evolved's green carbine laser trail along its path, from the
	// muzzle to where it will land, fading in a few tics
	override void HCE_OnShot(Actor shot)
	{
		if(shot.vel.Length() < 0.1) return;
		HCE_EnemyLaser.Flash(shot.pos, HCE_TraceEnd(shot.pos, shot.vel), "Green", 2.0, 0.5);
	}
	override bool HCE_HasLoadouts() { return false; }      // keeps the gun it is built around
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch rifle idle': return (31.8, -3.9, 10.7);
		case 'crouch rifle move-front': return (35.3, -4.1, 15.0);
		}
		return hce_gunOffset;
	}
}

