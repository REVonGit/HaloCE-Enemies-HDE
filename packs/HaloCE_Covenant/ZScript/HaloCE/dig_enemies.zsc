	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		if(hce_berserk) switch(kind)
		{
		case HCE_A_IDLE: return 'berserk idle';
		case HCE_A_ALERT: return 'berserk idle';
		case HCE_A_MOVE_F: return 'berserk move-front';
		case HCE_A_MOVE_B: return 'berserk move-front';
		case HCE_A_MOVE_L: return 'berserk move-front';
		case HCE_A_MOVE_R: return 'berserk move-front';
		case HCE_A_FLEE: return 'berserk move-front';
		case HCE_A_MELEE: { static const Name o[] = { 'berserk melee 1', 'berserk melee 2', 'berserk melee 3', 'berserk melee 4', 'berserk melee 5', 'berserk tackle 1', 'berserk tackle 2' }; return o[random(0, 6)]; }
		case HCE_A_TURN_L: return 'berserk turn-left';
		case HCE_A_TURN_R: return 'berserk turn-right';
		}
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand carbine idle';
		case HCE_A_ALERT: return 'stand carbine idle';
		case HCE_A_MOVE_F: return 'stand carbine move-front';
		case HCE_A_MOVE_B: return 'stand carbine move-back';
		case HCE_A_MOVE_L: return 'stand carbine move-left';
		case HCE_A_MOVE_R: return 'stand carbine move-right';
		case HCE_A_FIRE: return 'stand carbine fire-1 baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand carbine melee%0', 'stand carbine melee%1' }; return o[random(0, 1)]; }
		case HCE_A_THROW: return 'stand carbine throw-grenade%1';
		case HCE_A_DIVE_L: return 'stand carbine dive-left';
		case HCE_A_DIVE_R: return 'stand carbine dive-right';
		case HCE_A_DIVE_F: return 'stand carbine dive-front';
		case HCE_A_EVADE_L: return 'stand carbine evade-left';
		case HCE_A_EVADE_R: return 'stand carbine evade-right';
		case HCE_A_SURPRISE_F: return 'stand carbine surprise-front';
		case HCE_A_BERSERK: return 'stand carbine berserk';
		case HCE_A_WARN: return 'stand carbine warn';
		case HCE_A_SIGNAL: { static const Name o[] = { 'stand carbine signal-attack%0', 'stand carbine signal-attack%1', 'stand carbine signal-attack%2', 'stand carbine signal-attack%3', 'stand carbine signal-attack%4' }; return o[random(0, 4)]; }
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LEAP_MELEE: { static const Name o[] = { 'stand unarmed melee%0', 'stand unarmed melee%1' }; return o[random(0, 1)]; }
		case HCE_A_PING_F: return 's-ping front gut baked';
		case HCE_A_PING_B: return 's-ping back gut baked';
		case HCE_A_PING_L: return 's-ping left gut baked';
		case HCE_A_PING_R: return 's-ping right gut baked';
		case HCE_A_HPING_F: return 'h-ping front gut';
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: { static const Name o[] = { 'h-kill front gut', 'h-kill front head' }; return o[random(0, 1)]; }
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_CELEBRATE: return 'stand rifle celebrate';
		case HCE_A_SLEEP: { static const Name o[] = { 'asleep any idle%0', 'asleep any idle%1' }; return o[random(0, 1)]; }
		case HCE_A_TURN_L: return 'stand carbine turn-left';
		case HCE_A_TURN_R: return 'stand carbine turn-right';
		case HCE_A_FLAME_IDLE: return 'flaming carbine idle';
		case HCE_A_COVER_L_ENTER: return 'stand rifle cover-left-enter';
		case HCE_A_COVER_L_IDLE: return 'stand rifle cover-left-idle';
		case HCE_A_COVER_L_PEEK: return 'stand rifle cover-left-peek';
		case HCE_A_COVER_L_OPEN: return 'stand rifle cover-left-open';
		case HCE_A_COVER_L_UNPEEK: return 'stand rifle cover-left-unpeek';
		case HCE_A_COVER_L_EXIT: return 'stand rifle cover-left-exit';
		case HCE_A_COVER_R_ENTER: return 'stand rifle cover-right-enter';
		case HCE_A_COVER_R_IDLE: return 'stand rifle cover-right-idle';
		case HCE_A_COVER_R_PEEK: return 'stand rifle cover-right-peek';
		case HCE_A_COVER_R_OPEN: return 'stand rifle cover-right-open';
		case HCE_A_COVER_R_UNPEEK: return 'stand rifle cover-right-unpeek';
		case HCE_A_COVER_R_EXIT: return 'stand rifle cover-right-exit';
		case HCE_A_HOIST: return 'stand rifle hoist';
		case HCE_A_VAULT: return 'stand support vault';
		}
		return 'None';
	}

