		case HCE_A_PING_R: return 's-ping right gut baked';
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front gut', 'h-ping front head' }; return o[random(0, 1)]; }
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 's-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'h-kill front gut': return 79;
		case 'h-ping back gut': return 47;
		case 'h-ping front gut': return 47;
		case 'h-ping front head': return 37;
		case 's-kill back gut': return 153;
		case 's-kill front gut': return 289;
		case 's-ping back gut baked': return 18;
		case 's-ping front gut baked': return 16;
		case 's-ping left gut baked': return 16;
		case 's-ping right gut baked': return 18;
		case 'stand airborne-dead': return 49;
		case 'stand landing-dead': return 65;
		case 'stand pistol evade-left': return 33;
		case 'stand pistol evade-right': return 38;
		case 'stand pistol fire-1 baked': return 8;
		case 'stand pistol idle': return 128;
		case 'stand pistol move-back': return 51;
		case 'stand pistol move-front': return 57;
		case 'stand pistol move-left': return 69;
		case 'stand pistol move-right': return 69;
		case 'stand pistol surprise-back': return 32;
		case 'stand pistol surprise-front': return 28;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
}

// ---- EliteRifle: the body every EliteRifle variant below is drawn with (characters\elite\elite rifle): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every EliteRifle; one variant's numbers are in its own class
class HCE_EliteRifleBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 64;
		Radius 16;
		Mass 177;
		PainChance 0;
		Tag "EliteRifle";
		BloodColor "3A 1E 8C";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			HCE_HideSurface(2);
			HCE_HideSurface(12);
			A_ChangeModel('None', 0, "", 'None', 15, "models/hce_dig/EliteRifle", 'gore_EliteRifle.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.1664, 0.0003, 0.6444), 80.00, "models/hce_dig/EliteRifle", 'EliteRifle_gib_head.iqm', 15, 'gore_EliteRifle.png', 0.0713);
			HCE_OnSever(0, false);
			return true;
		case 1:
			HCE_HideSurface(0);
			HCE_HideSurface(13);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce_dig/EliteRifle", 'gore_EliteRifle.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (0.0048, 0.1506, 0.3901), 80.00, "models/hce_dig/EliteRifle", 'EliteRifle_gib_larm.iqm', 16, 'gore_EliteRifle.png', 0.0454);
			HCE_OnSever(1, false);
			return true;
		case 2:
			HCE_HideSurface(6);
			HCE_HideSurface(7);
			HCE_HideSurface(8);
			HCE_HideSurface(9);
			HCE_HideSurface(10);
			HCE_HideSurface(11);
			HCE_HideSurface(14);
			A_ChangeModel('None', 0, "", 'None', 17, "models/hce_dig/EliteRifle", 'gore_EliteRifle.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (0.0058, -0.1484, 0.3862), 80.00, "models/hce_dig/EliteRifle", 'EliteRifle_gib_rarm.iqm', 17, 'gore_EliteRifle.png', 0.0446);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (13.3, 0.0, 61.9);
		case 1: return (0.4, 12.0, 37.4);
		case 2: return (0.5, -11.9, 37.1);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce_dig/EliteRifle", 'EliteRifle_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce_dig/EliteRifle", 'EliteRifle_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce_dig/EliteRifle", 'EliteRifle_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 2, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 12, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 0, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 13, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 11, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 14, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		static const int W[] = { 6, 7, 8, 9, 10 };
		for(int i = 0; i < W.Size(); i++)
		{
			if(show) HCE_ShowSurface(W[i]);
			else HCE_HideSurface(W[i]);    // the guns it never held stay undrawn
		}
	}
}

// HCE_EliteCommanderPlasmaCarbine: Halo variant "characters\elite\elite commander\elite commander plasma carbine", plasma carbine, 100 body / 200 shield, 6 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_EliteCommanderPlasmaCarbine : HCE_EliteRifleBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
	{
		static const int K[] = { 6, 7, 8, 9, 10, 15, 16, 17 };
		for(int i = 0; i < K.Size(); i++) if(K[i] == s) { A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN); return; }
		A_ChangeModel('None', 0, "", 'None', s, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowSurface(int s)
	{
		switch(s)
		{
		case 6: A_ChangeModel('None', 0, "", 'None', 6, "models/hce_dig/weapons", 'w_cmt_carbine_gray.png', CMDL_USESURFACESKIN); return;
		case 7: A_ChangeModel('None', 0, "", 'None', 7, "models/hce_dig/weapons", 'w_cmt_carbine_lights.png', CMDL_USESURFACESKIN); return;
		case 8: A_ChangeModel('None', 0, "", 'None', 8, "models/hce_dig/weapons", 'w_cmt_carbine_icon.png', CMDL_USESURFACESKIN); return;
		case 9: A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/weapons", 'w_cmt_carbine_meter.png', CMDL_USESURFACESKIN); return;
		case 10: A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'w_cmt_carbine_purple.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
	override void HCE_DressSurfaces()
	{
		A_ChangeModel('None', 0, "", 'None', 6, "models/hce_dig/weapons", 'w_cmt_carbine_gray.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 7, "models/hce_dig/weapons", 'w_cmt_carbine_lights.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 8, "models/hce_dig/weapons", 'w_cmt_carbine_icon.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/weapons", 'w_cmt_carbine_meter.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'w_cmt_carbine_purple.png', CMDL_USESURFACESKIN);
	}

	//$Category "Halo CE/Covenant/Elite Rifle"
