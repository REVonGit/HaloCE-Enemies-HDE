	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand rifle idle';
		case HCE_A_ALERT: return 'alert rifle idle';
		case HCE_A_MOVE_F: return 'stand rifle move-front';
		case HCE_A_MOVE_B: return 'stand rifle move-back';
		case HCE_A_MOVE_L: return 'stand rifle move-left';
		case HCE_A_MOVE_R: return 'stand rifle move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch rifle idle';
		case HCE_A_CROUCH_MOVE: return 'crouch rifle move-front';
		case HCE_A_FIRE: return 'stand rifle cr fire-1 baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand rifle melee%0', 'stand rifle melee%1' }; return o[random(0, 1)]; }
		case HCE_A_THROW: return 'stand rifle throw-grenade';
		case HCE_A_DIVE_L: return 'stand rifle dive-left';
		case HCE_A_DIVE_R: return 'stand rifle dive-right';
		case HCE_A_DIVE_F: return 'stand rifle dive-front';
		case HCE_A_EVADE_L: return 'stand rifle evade-left';
		case HCE_A_EVADE_R: return 'stand rifle evade-right';
		case HCE_A_SURPRISE_F: return 'stand rifle surprise-front';
		case HCE_A_SURPRISE_B: return 'stand rifle surprise-back';
		case HCE_A_BERSERK: return 'stand rifle berserk';
		case HCE_A_WARN: return 'stand rifle warn';
		case HCE_A_SIGNAL: return 'stand rifle signal-attack';
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut baked', 's-ping front gut%1 baked', 's-ping front head baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%0 baked', 's-ping left gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-foot' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back gut', 'h-ping back l-arm', 'h-ping back r-arm' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 's-kill front gut%0', 's-kill front gut%1' }; return o[random(0, 1)]; }
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_TURN_L: return 'stand rifle turn-left';
		case HCE_A_TURN_R: return 'stand rifle turn-right';
		case HCE_A_RELOAD: return 'stand rifle reload-1';
		case HCE_A_VENT: return 'stand rifle overheat';
		case HCE_A_LOW_IDLE: return 'stand rifle low-idle';
