		case 'stand rifle cover-left-peek': return (9.8, 7.1, 3.6);
		case 'stand rifle cover-right-open': return (26.2, -6.2, 5.3);
		case 'stand sword idle': return (30.4, 23.3, -8.9);
		case 'stand sword move-back': return (23.9, 23.1, -6.7);
		case 'stand sword move-front': return (28.0, 35.2, -4.6);
		case 'stand sword move-left': return (28.5, 14.6, -17.2);
		case 'stand sword move-right': return (27.9, 29.6, -12.3);
		}
		return hce_gunOffset;
	}
}

// energy-shield flare for the EliteZealots: the same model, every surface the glowing shield texture
class HCE_EliteZealotShieldShell : HCE_ShieldShell {}

// ---- Engineer: the body every Engineer variant below is drawn with (characters\engineer\engineer): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every Engineer; one variant's numbers are in its own class
class HCE_EngineerBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 56;
		Radius 26;
		Mass 101;
		PainChance 0;
		Tag "Engineer";
		BloodColor "E0 60 7A";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce_dig/Engineer", 'Engineer_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce_dig/Engineer", 'Engineer_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce_dig/Engineer", 'Engineer_blood3.iqm'); break;
		}
	}
}

// HCE_Engineer: Halo variant "characters\engineer\engineer", no gun, 150 body / 200 shield, 1 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_Engineer : HCE_EngineerBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
	{
		A_ChangeModel('None', 0, "", 'None', s, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}

	//$Category "Halo CE/Covenant/Engineer"
	//$Title "Engineer"
	//$Sprite "HU25A0"
	Default
	{
		Health 150;
		Speed 6.5;
		HaloDoom_EnemyBase.HCE_Type 4;
		HaloDoom_EnemyBase.HCE_Variant "engineer";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 2000, 800;
		HaloDoom_EnemyBase.HCE_Movement 4.21, 6.48, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 0.00;
		HaloDoom_EnemyBase.HCE_Weapon "None", 1, 6.00, 1.00, 800;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 0.0;
		HaloDoom_EnemyBase.HCE_DamageModifier 0.50;
		HaloDoom_EnemyBase.HCE_CombatRange 0, 32;
		HaloDoom_EnemyBase.HCE_Burst 0.17, 0.55, 0.75, 1.10, 0.30, 0.70;
		HaloDoom_EnemyBase.HCE_GunOffset (26.0, -0.0, -14.0);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 36, 30;
		HaloDoom_EnemyBase.HCE_Leap 0, 0, 0.00, 6.5;
		HaloDoom_EnemyBase.HCE_Grenades 0, 0, 0.00, 0.0, 0, 960, 26.0;
		HaloDoom_EnemyBase.HCE_Panic 0.01, 1.00, 15.0, 20.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.00, 0.00, 0;
		HaloDoom_EnemyBase.HCE_Defensive 0.90, 1.00, 0.00, 0.00, 0.00;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 200, 5.0, 6.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 48;
		HaloDoom_EnemyBase.HCE_Voices "Engineer";
		+HaloDoom_EnemyBase.HCE_Flying
	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: { static const Name o[] = { 'stand unarmed idle%1', 'stand unarmed idle%2', 'stand unarmed idle%3' }; return o[random(0, 2)]; }
		case HCE_A_ALERT: { static const Name o[] = { 'alert unarmed idle%1', 'alert unarmed idle%2', 'alert unarmed idle%3', 'alert unarmed idle%4' }; return o[random(0, 3)]; }
		case HCE_A_MOVE_F: return 'stand unarmed move-front';
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front gut%1', 'h-ping front gut%2', 'h-ping front gut%3', 'h-ping front r-foot' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back gut%1', 'h-ping back gut%2' }; return o[random(0, 1)]; }
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert unarmed idle%1': return 70;
		case 'alert unarmed idle%2': return 78;
		case 'alert unarmed idle%3': return 58;
		case 'alert unarmed idle%4': return 105;
		case 'h-ping back gut%1': return 47;
		case 'h-ping back gut%2': return 70;
		case 'h-ping front gut%1': return 35;
		case 'h-ping front gut%2': return 35;
		case 'h-ping front gut%3': return 47;
		case 'h-ping front r-foot': return 35;
		case 'stand unarmed idle%1': return 47;
		case 'stand unarmed idle%2': return 93;
		case 'stand unarmed idle%3': return 93;
		case 'stand unarmed move-front': return 47;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}

	// The Engineer never fights: nothing is its enemy (not even whoever shoots it), so it never picks a
	// target. It just drifts around; when killed it bursts and sprays charged Plasma Caster grenades.
	override bool HCE_IsEnemy(Actor other) { return false; }

	double hce_driftAngle, hce_driftSpeed;
	int hce_driftNext;

	// Its gift (as in Halo 3): every second it overshields the allies around it that are in a fight and in
	// its sight, with a pink tether to each. Shielded allies are topped up past their maximum (to 1.5x);
	// unshielded ones (Grunts, Jackals' bodies...) get a small shield of their own. Out of its reach for a few
	// seconds, or when it dies, the gift goes away: overshields fall back to their maximum, given shields vanish.
	Array<HaloDoom_EnemyBase> hce_buffed;
	Array<int> hce_buffAt;
	Array<bool> hce_buffGiven;
	HaloDoom_EnemyBase hce_buffNear;

	// True when e is a live, enabled ally on the Engineer's team and side that is in a fight and is not another
	// Engineer or a Stealth (cloaked) class; those are the ones it shields.
	bool HCE_EngAlly(HaloDoom_EnemyBase e)
	{
		return e && e != self && e.hce_enabled && e.health > 0 && e.hce_team == hce_team && e.bFRIENDLY == bFRIENDLY
			&& !(e is GetClass()) && e.HCE_Alerted() && String.Format("%s", e.GetClassName()).IndexOf("Stealth") < 0;   // cloaked Elites stay shieldless
	}

	// The once-a-second gift: for every ally within 420 units in sight, gives a 40-point shield (x HCE_ShieldScale) to
	// one that has none or tops an existing one up by 20% of its max, to 1.5x max; remembers each in hce_buffed with
	// the time, and keeps the nearest in hce_buffNear. Then releases allies dead or unseen for over 4 s.
	// To change the reach, edit the two 420s; the cap, the 1.5s.
	void HCE_EngPulse()
	{
		hce_buffNear = null;
		double best = 1e9;
		let it = BlockThingsIterator.Create(self, 420);
		while(it.Next())
		{
			let e = HaloDoom_EnemyBase(it.thing);
			if(!HCE_EngAlly(e)) continue;
			double d = Distance3D(e);
			if(d > 420 || !CheckSight(e, SF_IGNOREVISIBILITY)) continue;
			if(d < best) { best = d; hce_buffNear = e; }
			int k = hce_buffed.Find(e);
			bool given = false;
			let sh = ShieldProcessor(e.FindInventory("ShieldProcessor", true));
			if(!sh)
			{
				sh = e.A_SetupShield(40 * HCE_ShieldScale(), 35 * 3, 35 * 2, "Shield/Explode", "", "", "HCE_Shield");
				if(!sh) continue;
				given = true;
			}
			else if(sh.shields < sh.maxshields * 1.5)
				sh.shields = min(sh.maxshields * 1.5, max(sh.shields, 0) + sh.maxshields * 0.2);
			if(k >= hce_buffed.Size()) { hce_buffed.Push(e); hce_buffAt.Push(level.maptime); hce_buffGiven.Push(given); }
			else hce_buffAt[k] = level.maptime;
		}
		// lapsed gifts
		for(int i = hce_buffed.Size() - 1; i >= 0; i--)
			if(!hce_buffed[i] || hce_buffed[i].health <= 0 || level.maptime - hce_buffAt[i] > 35 * 4) HCE_EngRelease(i);
	}

	// Takes the gift back from entry i of hce_buffed: a shield the Engineer gave is destroyed (and its loop sound
	// stopped), a topped-up one is clamped back to its max. Drops the entry from the three parallel arrays.
	void HCE_EngRelease(int i)
	{
		let e = hce_buffed[i];
		if(e && e.health > 0)
		{
			let sh = ShieldProcessor(e.FindInventory("ShieldProcessor", true));
			if(sh)
			{
				if(hce_buffGiven[i]) { e.A_StopSound(ShieldProcessor.CHAN_SHIELDLOOP); sh.Destroy(); }
				else sh.shields = min(sh.shields, sh.maxshields);
			}
		}
		hce_buffed.Delete(i); hce_buffAt.Delete(i); hce_buffGiven.Delete(i);
	}

	// Draws the pink/violet particle tethers from the Engineer's middle to each ally it pulsed in the last 40 tics:
	// 2-18 particles per tether, drifting along it with a slight arc. Purely visual.
	void HCE_EngTether()
	{
		vector3 from = pos + (0, 0, height * 0.5);
		for(int i = 0; i < hce_buffed.Size(); i++)
		{
			let e = hce_buffed[i];
			if(!e || e.health <= 0 || level.maptime - hce_buffAt[i] > 40) continue;
			vector3 d = level.Vec3Diff(from, e.pos + (0, 0, e.height * 0.55));
			int n = clamp(int(d.Length() / 24), 2, 18);
			double ph = (level.maptime % 12) / 12.0;
			for(int k = 0; k < n; k++)
			{
				double t = (k + ph) / n;
				vector3 o = d * t + (frandom(-1.5, 1.5), frandom(-1.5, 1.5), sin(t * 180) * 6);
				A_SpawnParticle(k % 2 ? "FF8CE8" : "C69CFF", SPF_FULLBRIGHT, 4, 3, 0, o.x, o.y, o.z + height * 0.5, 0, 0, 0, 0, 0, 0, 0.85, -0.15);
			}
		}
	}

	// Per tic: pulses the shields once a second (maptime % 35 == 7), redraws tethers every 3 tics, then drifts: toward
	// its nearest shielded ally when farther than 300 or away when closer than 200 (new heading every 2 s), otherwise
	// a random heading every 3-7 s at 0.8-1.8 speed (1 in 4 chance of hovering still). A blocked move repicks at once.
	override void Tick()
	{
		super.Tick();
		if(health <= 0 || bDORMANT || isFrozen()) return;
		if(level.maptime % 35 == 7) HCE_EngPulse();
		if(level.maptime % 3 == 0) HCE_EngTether();
		if(hce_animLock > 0) return;
		// it keeps near the fight: drifts toward the allies it's shielding, but no closer than ~200
		if(hce_buffNear && hce_buffNear.health > 0)
		{
			double d = Distance2D(hce_buffNear);
			if(d > 300 || d < 200)
			{
				double a = AngleTo(hce_buffNear) + (d < 200 ? 180 : 0) + frandom(-25, 25);
				if(level.maptime >= hce_driftNext || abs(DeltaAngle(hce_driftAngle, a)) > 60)
				{
					hce_driftAngle = a; hce_driftSpeed = frandom(1.4, 2.2);
					hce_driftNext = level.maptime + 35 * 2;
				}
			}
		}
		if(level.maptime >= hce_driftNext)
		{
			hce_driftNext = level.maptime + 35 * random(3, 7);
			hce_driftAngle = frandom(0, 360);
			hce_driftSpeed = random(0, 3) == 0 ? 0 : frandom(0.8, 1.8);   // sometimes it just hangs there
		}
		if(hce_driftSpeed <= 0) return;
		if(!HCE_Move(hce_driftAngle, hce_driftSpeed)) { hce_driftNext = 0; return; }   // bumped into something: new heading
		A_SetAngle(angle + clamp(DeltaAngle(angle, hce_driftAngle), -2, 2), SPF_INTERPOLATE);
	}

	// Death: takes back every shield it gave, then bursts (explosion sound, quake, 40 particles) and throws 4-6 charged
	// Plasma Caster cluster shots in a ring, scaled by HCE_DamageScale. The body is hidden; nothing lies on the floor.
	// To change the grenade count, edit random(4, 6).
	override void HCE_Die()
	{
		super.HCE_Die();
		for(int i = hce_buffed.Size() - 1; i >= 0; i--) HCE_EngRelease(i);
		A_StartSound("HCE/Engineer/Explode", CHAN_BODY, CHANF_OVERLAP, 1.0);
		A_StartSound("Halo/Weapons/PlasmaCaster/ChargedFire", CHAN_WEAPON, CHANF_OVERLAP, 1.0);
		A_Quake(2, 8, 0, 512, "");
		for(int i = 0; i < 40; i++)
			A_SpawnParticle(i % 3 ? "C69CFF" : "FFE6FF", SPF_FULLBRIGHT, random(18, 34), frandom(4, 9), 0, 0, 0, height * 0.5,
				frandom(-5, 5), frandom(-5, 5), frandom(-3, 5), 0, 0, -0.12, 1.0, -0.035);
		// charged Plasma Caster shots (HDE): they stick, arm for two seconds, burst and throw two mini bolts
		int n = random(4, 6);
		double a0 = frandom(0, 360);
		for(int i = 0; i < n; i++)
		{
			let g = Spawn("HCE_PlasmaCasterClusterScaled", pos + (0, 0, height * 0.5), ALLOW_REPLACE);
			if(!g) continue;
			g.target = self;
			HCE_ScaleProjectile(g, HCE_DamageScale());          // the projectile nerf covers the bursts too
			g.angle = a0 + i * 360.0 / n + frandom(-20, 20);
			g.vel = (AngleToVector(g.angle, frandom(4, 8)), frandom(4, 9));
		}
		bInvisible = true;            // nothing left to lie on the floor
		vel = (0, 0, 0);
	}
}

// ---- FloodBrute: the body every FloodBrute variant below is drawn with (characters\floodcombat_brute\floodcombat_brute): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every FloodBrute; one variant's numbers are in its own class
class HCE_FloodBruteBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_FLOOD";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_FLOOD;
		Height 76;
		Radius 30;
		Mass 277;
		PainChance 0;
		Tag "FloodBrute";
		BloodColor "76 70 3A";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			HCE_HideSurface(6);
			HCE_HideSurface(7);
			HCE_HideSurface(9);
			HCE_HideSurface(24);
			HCE_HideSurface(25);
			HCE_HideSurface(26);
			HCE_HideSurface(27);
			HCE_ShowStumps(hce_severed | (1 << 0));
			HCE_SpawnLimb(0, (0.0635, -0.0130, 0.8245), 92.00, "models/hce_dig/FloodBrute", 'FloodBrute_gib_head.iqm', 28, 'gore_FloodBrute.png', 0.0939);
			HCE_OnSever(0, false);
			return true;
		case 1:
			if(bDECOUPLEDANIMATIONS) SetNamedBoneScaling('b_l_upperarm', (0, 0, 0), SB_REPLACE, 0);
			HCE_ShowStumps(hce_severed | (1 << 1));
			HCE_SpawnLimb(1, (0.0788, 0.2602, 0.4911), 92.00, "models/hce_dig/FloodBrute", 'FloodBrute_gib_larm.iqm', 28, 'gore_FloodBrute.png', 0.0786);
			HCE_OnSever(1, false);
			return true;
		case 2:
			HCE_HideSurface(17);
			HCE_HideSurface(18);
			HCE_HideSurface(19);
			HCE_HideSurface(20);
			HCE_HideSurface(21);
			HCE_HideSurface(22);
			HCE_HideSurface(23);
			if(bDECOUPLEDANIMATIONS) SetNamedBoneScaling('b_r_upperarm', (0, 0, 0), SB_REPLACE, 0);
			HCE_ShowStumps(hce_severed | (1 << 2));
			HCE_SpawnLimb(2, (0.1196, -0.2259, 0.5458), 92.00, "models/hce_dig/FloodBrute", 'FloodBrute_gib_rarm.iqm', 28, 'gore_FloodBrute.png', 0.0716);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	void HCE_ShowStumps(int sev)
	{
		if(sev & (1 << 0)) A_ChangeModel('None', 9, "models/hce_dig/FloodBrute", 'FloodBrute_stumps.iqm', 0, "models/hce_dig/FloodBrute", 'gore_FloodBrute.png', CMDL_USESURFACESKIN);
		else A_ChangeModel('None', 9, "models/hce_dig/FloodBrute", 'FloodBrute_stumps.iqm', 0, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		if(sev & (1 << 1)) A_ChangeModel('None', 9, "models/hce_dig/FloodBrute", 'FloodBrute_stumps.iqm', 1, "models/hce_dig/FloodBrute", 'gore_FloodBrute.png', CMDL_USESURFACESKIN);
		else A_ChangeModel('None', 9, "models/hce_dig/FloodBrute", 'FloodBrute_stumps.iqm', 1, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		if(sev & (1 << 2)) A_ChangeModel('None', 9, "models/hce_dig/FloodBrute", 'FloodBrute_stumps.iqm', 2, "models/hce_dig/FloodBrute", 'gore_FloodBrute.png', CMDL_USESURFACESKIN);
		else A_ChangeModel('None', 9, "models/hce_dig/FloodBrute", 'FloodBrute_stumps.iqm', 2, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (5.8, -1.2, 91.0);
		case 1: return (7.2, 23.9, 54.2);
		case 2: return (11.0, -20.8, 60.3);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce_dig/FloodBrute", 'FloodBrute_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce_dig/FloodBrute", 'FloodBrute_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce_dig/FloodBrute", 'FloodBrute_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 6, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 7, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 9, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 24, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 25, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 26, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 27, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			break;
		case 2:
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		static const int W[] = { 17, 18, 19, 20, 21, 22, 23 };
		for(int i = 0; i < W.Size(); i++)
		{
			if(show) HCE_ShowSurface(W[i]);
			else HCE_HideSurface(W[i]);    // the guns it never held stay undrawn
		}
	}
}

