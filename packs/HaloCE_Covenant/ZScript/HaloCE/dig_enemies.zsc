		Speed 9.0;
		HaloDoom_EnemyBase.HCE_Type 1;
		HaloDoom_EnemyBase.HCE_Variant "jackal major helmet plasma rifle";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 240;
