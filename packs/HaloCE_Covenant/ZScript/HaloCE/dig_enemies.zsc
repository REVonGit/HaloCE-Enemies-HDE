	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		Name sk = show ? 'None' : 'hce_hidden.png';
		static const int W[] = { 5, 6, 7, 8, 9, 10, 11 };
		for(int i = 0; i < W.Size(); i++) A_ChangeModel('None', 0, "", 'None', W[i], "models/hce_dig/weapons", sk, CMDL_USESURFACESKIN);
	}
