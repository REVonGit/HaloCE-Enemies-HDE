		case HCE_A_VAULT: return 'stand rifle vault';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert rifle idle': return 70;
		case 'crouch rifle idle': return 70;
		case 'crouch rifle move-front': return 35;
		case 'h-kill back gut': return 63;
