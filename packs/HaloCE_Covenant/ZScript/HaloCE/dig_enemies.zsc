// ---- EliteZealot: the body every EliteZealot variant below is drawn with (characters\elite\elite ultra zealot): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every EliteZealot; one variant's numbers are in its own class
class HCE_EliteZealotBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 64;
		Radius 16;
		Mass 177;
		PainChance 0;
		Tag "EliteZealot";
		BloodColor "3A 1E 8C";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Name HCE_ShellClass() { return 'HCE_EliteZealotShieldShell'; }

	override void HCE_Die()
	{
		super.HCE_Die();
		HCE_HideSurface(9);
		HCE_ResumeAnim();      // (A_ChangeModel restarts the model's animation: the death animation goes on)
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			HCE_HideSurface(7);
			HCE_HideSurface(8);
			HCE_HideSurface(12);
			HCE_HideSurface(15);
			HCE_HideSurface(20);
			A_ChangeModel('None', 0, "", 'None', 21, "models/hce_dig/EliteZealot", 'gore_EliteZealot.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.2061, -0.0001, 0.6582), 80.00, "models/hce_dig/EliteZealot", 'EliteZealot_gib_head.iqm', 21, 'gore_EliteZealot.png', 0.0877);
			HCE_OnSever(0, false);
			return true;
		case 1:
			HCE_HideSurface(9);
			HCE_HideSurface(13);
			HCE_HideSurface(16);
			HCE_HideSurface(18);
			A_ChangeModel('None', 0, "", 'None', 22, "models/hce_dig/EliteZealot", 'gore_EliteZealot.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (0.0127, 0.1593, 0.5567), 80.00, "models/hce_dig/EliteZealot", 'EliteZealot_gib_larm.iqm', 22, 'gore_EliteZealot.png', 0.0486);
			HCE_OnSever(1, false);
			return true;
		case 2:
			HCE_HideSurface(10);
			HCE_HideSurface(11);
			HCE_HideSurface(14);
			HCE_HideSurface(17);
			HCE_HideSurface(19);
			A_ChangeModel('None', 0, "", 'None', 23, "models/hce_dig/EliteZealot", 'gore_EliteZealot.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (0.0127, -0.1594, 0.5567), 80.00, "models/hce_dig/EliteZealot", 'EliteZealot_gib_rarm.iqm', 23, 'gore_EliteZealot.png', 0.0484);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (16.5, -0.0, 63.2);
		case 1: return (1.0, 12.7, 53.4);
		case 2: return (1.0, -12.7, 53.4);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce_dig/EliteZealot", 'EliteZealot_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce_dig/EliteZealot", 'EliteZealot_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce_dig/EliteZealot", 'EliteZealot_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 7, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 8, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 12, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 15, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 20, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 13, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 16, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 18, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 14, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 17, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 19, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		static const int W[] = { 10, 11 };
		for(int i = 0; i < W.Size(); i++)
		{
			if(show) HCE_ShowSurface(W[i]);
			else HCE_HideSurface(W[i]);    // the guns it never held stay undrawn
		}
	}
}

// HCE_EliteUltraZealotEnergySword: Halo variant "characters\elite\elite ultra zealot\elite ultra zealot energy sword", energy sword, 130 body / 400 shield, 7 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_EliteUltraZealotEnergySword : HCE_EliteZealotBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
	{
		static const int K[] = { 10, 11, 21, 22, 23 };
		for(int i = 0; i < K.Size(); i++) if(K[i] == s) { A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN); return; }
		A_ChangeModel('None', 0, "", 'None', s, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowSurface(int s)
	{
		switch(s)
		{
		case 10: A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'w_energy_sword_0.png', CMDL_USESURFACESKIN); return;
		case 11: A_ChangeModel('None', 0, "", 'None', 11, "models/hce_dig/weapons", 'w_energy_sword_glow.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
	override void HCE_DressSurfaces()
	{
		A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'w_energy_sword_0.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 11, "models/hce_dig/weapons", 'w_energy_sword_glow.png', CMDL_USESURFACESKIN);
	}

	//$Category "Halo CE/Covenant/Elite Zealot"
	//$Title "Elite Ultra Zealot (Energy Sword)"
	//$Sprite "HU24A0"
	Default
	{
		Health 130;
		Speed 6.5;
		HaloDoom_EnemyBase.HCE_Type 0;
		HaloDoom_EnemyBase.HCE_Variant "elite ultra zealot energy sword";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 80;
		HaloDoom_EnemyBase.HCE_Movement 4.22, 6.50, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 1.23;
		HaloDoom_EnemyBase.HCE_Weapon "None", 1, 3.00, 0.00, 960;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 0.0;
		HaloDoom_EnemyBase.HCE_DamageModifier 1.00;
		HaloDoom_EnemyBase.HCE_CombatRange 0, 32;
		HaloDoom_EnemyBase.HCE_Burst 0.60, 1.20, 0.80, 1.80, 0.00, 1.00;
		HaloDoom_EnemyBase.HCE_GunOffset (46.6, 5.4, 21.7);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 64, 151;
		HaloDoom_EnemyBase.HCE_Leap 136, 360, 0.35, 11.2;
		HaloDoom_EnemyBase.HCE_Grenades 0, 0, 0.00, 0.0, 0, 960, 26.0;
		HaloDoom_EnemyBase.HCE_Panic 0.00, 0.00, 0.0, 0.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.20, 0.80, 200;
		HaloDoom_EnemyBase.HCE_Defensive 0.75, 0.80, 0.10, 0.30, 0.30;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 400, 5.0, 6.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_Voices "Elite_Dogmatic,Elite_Loose";
		HaloDoom_EnemyBase.HCE_Drops "Halo_EnergySword", "None";
		+HaloDoom_EnemyBase.HCE_AlwaysBerserk
		+HaloDoom_EnemyBase.HCE_Berserks
		+HaloDoom_EnemyBase.HCE_Evades
		+HaloDoom_EnemyBase.HCE_Leader
		+HaloDoom_EnemyBase.HCE_SeeksCover
		+HaloDoom_EnemyBase.HCE_ShieldStun
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand sword idle';
		case HCE_A_ALERT: return 'stand sword idle';
		case HCE_A_MOVE_F: return 'stand sword move-front';
		case HCE_A_MOVE_B: return 'stand sword move-back';
		case HCE_A_MOVE_L: return 'stand sword move-left';
		case HCE_A_MOVE_R: return 'stand sword move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch sword idle';
		case HCE_A_CROUCH_MOVE: return 'crouch sword move-front';
		case HCE_A_FIRE: return 'stand missle fire-1 fr baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand sword melee%0', 'stand sword melee%1' }; return o[random(0, 1)]; }
		case HCE_A_THROW: return 'stand sword throw-grenade';
		case HCE_A_DIVE_L: return 'stand sword dive-left';
		case HCE_A_DIVE_R: return 'stand sword dive-right';
		case HCE_A_DIVE_F: return 'stand sword dive-front';
		case HCE_A_EVADE_L: return 'stand sword evade-left';
		case HCE_A_EVADE_R: return 'stand sword evade-right';
		case HCE_A_SURPRISE_F: return 'stand sword surprise-front';
		case HCE_A_SURPRISE_B: return 'stand sword surprise-back';
		case HCE_A_BERSERK: return 'stand sword berserk';
		case HCE_A_WARN: { static const Name o[] = { 'stand pistol warn%0', 'stand pistol warn%1' }; return o[random(0, 1)]; }
		case HCE_A_SIGNAL: return 'stand pistol signal-attack';
		case HCE_A_AIRBORNE: return 'stand sword airborne';
		case HCE_A_LAND: return 'stand sword land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut baked', 's-ping front gut%1 baked', 's-ping front head baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%0 baked', 's-ping left gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-foot' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back gut', 'h-ping back l-arm', 'h-ping back r-arm' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 's-kill front gut%0', 's-kill front gut%1' }; return o[random(0, 1)]; }
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_TURN_L: return 'stand sword turn-left';
		case HCE_A_TURN_R: return 'stand sword turn-right';
		case HCE_A_FLAME_IDLE: return 'flaming pistol idle';
		case HCE_A_LOW_IDLE: return 'stand sword low-idle';
		case HCE_A_LOW_MOVE: return 'stand sword low-move';
		case HCE_A_GUARD_IDLE: return 'guard sword idle';
		case HCE_A_GUARD_MOVE_F: return 'guard sword move-front';
		case HCE_A_GUARD_MOVE_B: return 'guard sword move-back';
		case HCE_A_GUARD_MOVE_L: return 'guard sword move-left';
		case HCE_A_GUARD_MOVE_R: return 'guard sword move-right';
		case HCE_A_GUARD_CROUCH_IDLE: return 'crouch guard sword idle';
		case HCE_A_GUARD_CROUCH_MOVE: return 'crouch guard sword move-front';
		case HCE_A_COVER_L_ENTER: return 'stand rifle cover-left-enter';
		case HCE_A_COVER_L_IDLE: return 'stand rifle cover-left-idle';
		case HCE_A_COVER_L_PEEK: return 'stand rifle cover-left-peek';
		case HCE_A_COVER_L_OPEN: return 'stand rifle cover-left-open';
		case HCE_A_COVER_L_UNPEEK: return 'stand rifle cover-left-unpeek';
		case HCE_A_COVER_L_EXIT: return 'stand rifle cover-left-exit';
		case HCE_A_COVER_R_ENTER: return 'stand rifle cover-right-enter';
		case HCE_A_COVER_R_IDLE: return 'stand rifle cover-right-idle';
		case HCE_A_COVER_R_PEEK: return 'stand rifle cover-right-peek';
		case HCE_A_COVER_R_OPEN: return 'stand rifle cover-right-open';
		case HCE_A_COVER_R_UNPEEK: return 'stand rifle cover-right-unpeek';
		case HCE_A_COVER_R_EXIT: return 'stand rifle cover-right-exit';
		case HCE_A_HOIST: return 'stand sword hoist';
		case HCE_A_VAULT: return 'stand sword vault';
		case HCE_A_DRAW: return 'stand sword enter';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'crouch guard sword idle': return 70;
		case 'crouch guard sword move-front': return 35;
		case 'crouch sword idle': return 70;
		case 'crouch sword move-front': return 35;
		case 'flaming pistol idle': return 37;
		case 'guard sword idle': return 70;
		case 'guard sword move-back': return 30;
		case 'guard sword move-front': return 30;
		case 'guard sword move-left': return 30;
		case 'guard sword move-right': return 30;
		case 'h-kill back gut': return 63;
