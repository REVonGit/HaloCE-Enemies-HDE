	// ---- armour kit (extract_brute_kit.py): each Minor / Major / Captain rolls its own helmet, chest, shoulder,
	// arm, leg and waist pieces when it spawns (some ranks may also roll a whole outfit); the Chieftain keeps
	// Tartarus's look or wears one of the kit's chieftain sets. Pieces are model attachments {1-6} riding the
	// Brute's own bones; their textures are named in the piece models.
	String hce_kitHelmet;
	static String HCE_KitPool(int i)
	{
		switch(i)
		{
			case 0: return "h2_helmet.iqm:3|h3_helmet_minor_minor.iqm:3|kh_helmet_wing.iqm:2|kh_helmet_enclosed.iqm:1|:1";
			case 1: return ":2|h3_chest_minor_minor.iqm:3|kh_chest_wires.iqm:1|h2_bandolier.iqm:2|kh_chest_superlight.iqm:2";
			case 2: return "h2_shoulders.iqm:3|h3_shoulders_minor_minor.iqm:3|:2";
			case 3: return ":3|kh_wrists.iqm:2";
			case 4: return ":3|h3_kneeguards_minor.iqm:2|h2_leg_plates.iqm:1";
			case 5: return ":3|kh_belt.iqm:1";
			case 6: return "h3_helmet_minor_major.iqm:3|kh_helmet_spine.iqm:2|kh_helmet_crusader.iqm:2|kh_helmet_enclosed_sides.iqm:2|kh_helmet_enclosed.iqm:1";
			case 7: return "h3_chest_major_major.iqm:3|kh_chest_medium.iqm:2|kh_chest_light.iqm:2|kh_bandolier.iqm:2";
			case 8: return "h3_shoulder_major_major.iqm:3|kh_shoulders_parts.iqm:2|h2_shoulders.iqm:1";
			case 9: return "kh_wrist_plates.iqm:2|kh_handguard.iqm:2|h3_arm_pads_major.iqm:2|:1";
			case 10: return "h3_legs_medium_major.iqm:2|h3_legs_spiked_major.iqm:2|kh_kneeguards.iqm:2|h3_shins_major.iqm:2";
			case 11: return "kh_belt.iqm:2|kh_groin_plates.iqm:1|:2";
			case 12: return "h3_helmet_captain_captain.iqm:3|kh_helmet_bighorn.iqm:2|kh_helmet_heavy.iqm:2|kh_helmet_crusader_chain.iqm:2";
			case 13: return "kh_chest_heavy.iqm:3|h3_chest_major_captain.iqm:2|kh_chest_light.iqm:2";
			case 14: return "kh_shoulder_big.iqm:3|h3_shoulder_major_captain.iqm:2|h2_shoulders_huge.iqm:1";
			case 15: return "kh_wrist_plates.iqm:2|h3_arm_pads_captain.iqm:2|kh_handguard.iqm:1";
			case 16: return "kh_legs_thick.iqm:2|kh_legs_heavy.iqm:2|h3_shins_captain.iqm:1|kh_kneeguards.iqm:1";
			case 17: return "kh_belt_long.iqm:2|kh_groin_plates.iqm:2";
			case 18: return ":1";
			case 19: return ":1";
			case 20: return ":1";
			case 21: return ":1";
			case 22: return ":1";
			case 23: return ":1";
		}
		return "";
	}
	static String HCE_KitOutfits(int r)
	{
		switch(r)
		{
			case 1: return "0.2;h3_helmet_jumper_jumper.iqm,h3_suit_jumper_jumper.iqm,,,h3_shins_jumper.iqm,";
			case 3: return "0.5;h3_helmet_chieftain_chieftain.iqm,h3_suit_chieftain_chieftain.iqm,,,,|0.5;kh_helmet_chieftain.iqm,kh_chest_heavy.iqm,h2_shoulders_huge.iqm,kh_handguard_chieftain.iqm,kh_legs_chieftain.iqm,kh_belt_long.iqm";
		}
		return "";
	}
	static double HCE_KitKeepBase(int r)
	{
		switch(r)
		{
			case 3: return 0.5;
		}
		return 0;
	}
	static String HCE_KitRoll(String pool)
	{
		Array<String> opts; pool.Split(opts, "|");
		double tot = 0;
		for(int i = 0; i < opts.Size(); i++) { Array<String> p; opts[i].Split(p, ":"); if(p.Size() > 1) tot += p[1].ToDouble(); }
		double x = frandom[HCEKit](0, tot);
		for(int i = 0; i < opts.Size(); i++)
		{
			Array<String> p; opts[i].Split(p, ":");
			if(p.Size() < 2) continue;
			x -= p[1].ToDouble();
			if(x <= 0) return p[0];
		}
		return "";
	}
	void HCE_DressArmour()
	{
		String cn = GetClassName();
		int r = cn.IndexOf("Minor") >= 0 ? 0 : cn.IndexOf("Major") >= 0 ? 1 : cn.IndexOf("Captain") >= 0 ? 2 : cn.IndexOf("Chieftain") >= 0 ? 3 : -1;
		if(r < 0) return;
		double keep = HCE_KitKeepBase(r);
		if(keep > 0 && frandom[HCEKit](0, 1) < keep) return;
		Array<String> pick;
		for(int s = 0; s < 6; s++) pick.Push("");
		bool outfit = false;
		String outs = HCE_KitOutfits(r);
		if(outs.Length() > 0)
		{
			Array<String> ol; outs.Split(ol, "|");
			double x = frandom[HCEKit](0, 1);
			for(int i = 0; i < ol.Size() && !outfit; i++)
			{
				Array<String> p; ol[i].Split(p, ";");
				if(p.Size() < 2) continue;
				double c = p[0].ToDouble();
				if(x < c)
				{
					Array<String> f; p[1].Split(f, ",");
					for(int s = 0; s < 6 && s < f.Size(); s++) pick[s] = f[s];
					outfit = true;
				}
				else x -= c;
			}
		}
		if(!outfit) for(int s = 0; s < 6; s++) pick[s] = HCE_KitRoll(HCE_KitPool(r * 6 + s));
		if(r == 3)
		{
			A_ChangeModel('None', 0, "", 'None', 1, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 4, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 5, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 6, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 7, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 11, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 17, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 18, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 19, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 30, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 31, "models/hce_dig/Brute/skins", 'hce_hidden.png', CMDL_USESURFACESKIN);
		}
		for(int s = 0; s < 6; s++)
			if(pick[s].Length() > 0) A_ChangeModel('None', s + 1, "models/hce_dig/BruteKit", pick[s], s + 1, "", 'None');
		hce_kitHelmet = pick[0];
		if(hce_kitHelmet.Length() == 0 && r < 3) hce_helmetOff = true;     // bare-headed: nothing to knock off
	}

	// ---- Halo 2 Brute behaviour ----------------------------------------------------------------------
	// berserk (badly hurt, or the pack is gone): roar, throw the gun away, charge on all fours with the
	// berserk swings and tackles. Headshots knock a Minor/Major/Captain's helmet off. Losing pack mates
	// can send the survivors berserk; the last Brute standing always goes.
	// The Chieftain (Tartarus's look and hammer) keeps his gravity hammer when berserk: every swing and every
	// landed leap ends in a gravity shockwave that hurts and throws back everything around the impact.
	bool hce_weaponTossed, hce_helmetOff, hce_chief;
	int hce_stepTics, hce_fallTics, hce_smashTics, hce_prevLeap;
	Name hce_lastSwing;
	override void PostBeginPlay()
	{
		HCE_DressArmour();                     // before any animation starts (A_ChangeModel resets the current one)
		super.PostBeginPlay();
		String cn = GetClassName();
		hce_chief = cn.IndexOf("Chieftain") >= 0;
	}
	override bool HCE_TryMelee()
	{
		if(!super.HCE_TryMelee()) return false;
		if(hce_chief) hce_smashTics = max(4, int(hce_animLock * 0.45));
		return true;
	}
	void HCE_HammerSmash(double reach)
	{
		vector3 at = Vec3Angle(radius + reach, angle, 0);
		A_StartSound("Halo/Weapons/GravityHammer/Fire", CHAN_WEAPON, CHANF_OVERLAP, 1.0);
		A_StartSound("Halo/Weapons/GravityHammer/Fire/Bass", CHAN_7, CHANF_OVERLAP, 1.0);
		Spawn("GravityHammerExplosion", at, ALLOW_REPLACE);
		let it = BlockThingsIterator.CreateFromPos(at.x, at.y, at.z, 64, 150, false);
		while(it.Next())
		{
			Actor mo = it.thing;
			if(!mo || mo == self || !mo.bSHOOTABLE || mo.health <= 0) continue;
			if(mo is "HaloDoom_EnemyBase" && !HCE_IsEnemy(mo)) continue;      // spare the pack
			double d = (mo.pos.xy - at.xy).Length();
			if(d > 150 || abs(mo.pos.z - at.z) > 96) continue;
			double f = 1.0 - d / 150.0;
			mo.DamageMobj(self, self, int(10 + 25 * f), 'Crush', DMG_THRUSTLESS);
			double a = atan2(mo.pos.y - at.y, mo.pos.x - at.x);
			if(mo.bSOLID && mo.mass < 2000) mo.vel += (AngleToVector(a, 6 + 10 * f), 4 + 5 * f);
		}
	}
	override void Tick()
	{
		super.Tick();
		if(hce_chief && health > 0 && !isFrozen())
		{
			if(hce_smashTics > 0 && --hce_smashTics == 0) HCE_HammerSmash(36);
			if(hce_prevLeap == 2 && hce_leapState == 0) HCE_HammerSmash(12);     // leap ends: ground pound
			hce_prevLeap = hce_leapState;
		}
		if(hce_fallTics > 0 && --hce_fallTics == 0) A_StartSound("HCE/Brute/BodyFall", CHAN_BODY, CHANF_OVERLAP, 0.9);
		if(health > 0 && !isFrozen())
		{
			// footfalls: heavier, quicker on the berserk run
			double sp = vel.xy.Length() + hce_moveSpeed;
			if(pos.z <= floorz + 1 && sp > 1.5 && ++hce_stepTics >= (hce_berserk ? 9 : 15))
			{
				hce_stepTics = 0;
				A_StartSound(hce_berserk ? "HCE/Brute/Run" : "HCE/Brute/Step", CHAN_BODY, CHANF_OVERLAP, 0.7);
			}
			// swing whoosh on each melee / tackle, chest thump on the berserk roar
			if(hce_curAnim != hce_lastSwing)
			{
				String an = hce_curAnim;
				if(an.IndexOf("melee") >= 0 || an.IndexOf("tackle") >= 0) A_StartSound("HCE/Brute/MeleeMove", CHAN_6, CHANF_OVERLAP, 0.9);
				else if(an.IndexOf("berserk") >= 0 && an.IndexOf("stand") == 0) A_StartSound("HCE/Brute/Thump", CHAN_6, CHANF_OVERLAP, 1.0);
				hce_lastSwing = hce_curAnim;
			}
		}
		if(health > 0 && hce_berserk && !hce_weaponTossed && !hce_chief && hce_animLock <= 0) HCE_TossWeapon();
		// a Brute without its gun only charges
		if(hce_weaponTossed && health > 0 && target && hce_action != HCE_ACT_CHARGE) { hce_berserk = true; hce_action = HCE_ACT_CHARGE; }
	}
	void HCE_TossWeapon()
	{
		hce_weaponTossed = true;
		CVar cv = CVar.FindCVar("hce_dropweapons");
		class<Actor> wc = (class<Actor>)(hce_dropWeapon);
		if(wc && (!cv || cv.GetBool())) HCE_Toss(wc);
		hce_dropWeapon = 'None';
		HCE_HideWeaponSurfaces();
		HCE_StopFireLoop();
		hce_projectile = 'None';
		hce_runSpeed *= 1.35; hce_walkSpeed *= 1.35;
		hce_curAnimKind = -1;
	}
	override void HCE_OnDamaged(Actor inflictor, Actor source, int dealt, Name mod)
	{
		super.HCE_OnDamaged(inflictor, source, dealt, mod);
		if(health <= 0 || hce_helmetOff || dealt <= 0 || HCE_HelmetFixed()) return;
		bool head = mod == 'Headshot' || (inflictor && inflictor != source && inflictor.pos.z > pos.z + height * 0.8);
		if(!head) return;
		HCE_KnockHelmet(inflictor ? inflictor : source);
		HCE_Say('PainHeavy', 1.0, 0, true);
	}
	void HCE_KnockHelmet(Actor from)
	{
		hce_helmetOff = true;
		A_ChangeModel('None', 1, "", 'None', 1, "", 'None', CMDL_HIDEMODEL);           // the kit helmet (attachment 1) flies off
		let h = HCE_BruteHelmetDebris(Spawn("HCE_BruteHelmetDebris", pos + (0, 0, height * 0.95), ALLOW_REPLACE));
		if(h)
		{
			h.hce_piece = "debris_" .. hce_kitHelmet;
			double a = from ? from.AngleTo(self) : angle + 180;
			h.vel = (AngleToVector(a + frandom(-30, 30), frandom(3, 6)), frandom(4, 7));
			h.angle = angle;
		}
	}
	// decapitated with the kit helmet still on: it comes off too (the gib is the bare head)
	override void HCE_OnSever(int limb, bool gunArm)
	{
		if(limb == HCE_LIMB_HEAD && !hce_helmetOff && !HCE_HelmetFixed() && hce_kitHelmet.Length() > 0) HCE_KnockHelmet(target);
	}
	override color HCE_ShieldColor() { return Color(255, 255, 200, 90); }       // the Chieftain's gold overshield
	bool HCE_HelmetFixed() { String cn = GetClassName(); return hce_chief || cn.IndexOf("HonorGuard") >= 0; }   // honor guard helmets are part of the armour
	// the helmet takes the first head hit (it flies off instead): only a bare head can be headshot
	override bool HCE_HeadProtected() { return !hce_helmetOff || HCE_HelmetFixed(); }
	override void HCE_Die()
	{
		super.HCE_Die();
		hce_fallTics = 22;
		// pack morale: the last Brute nearby always goes berserk, others sometimes do
		Array<HaloDoom_EnemyBase> pack;
		let it = BlockThingsIterator.Create(self, 640);
		while(it.Next())
		{
			let b = HaloDoom_EnemyBase(it.thing);
			if(b && b != self && b.health > 0 && b.GetClassName() != 'None' && (b is "HCE_BruteBase")) pack.Push(b);
		}
		for(int i = 0; i < pack.Size(); i++)
			if(!pack[i].hce_berserk && (pack.Size() == 1 || frandom(0, 1) < 0.35)) pack[i].HCE_GoBerserk(true);
	}
	void HCE_HideWeaponSurfaces()
	{
		A_ChangeModel('None', 0, "", 'None', 20, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 21, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 22, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 23, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 24, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 25, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 26, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 27, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_BloodHideClass()
	{
		A_ChangeModel('None', 7, "", 'None', 1, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 6, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 7, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 8, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 9, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 11, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 13, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 14, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 16, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 18, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 19, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 30, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
}

// characters\brute\brute honor guard plasma rifle
class HCE_BruteHonorGuardPlasmaRifle : HCE_BruteBase
{
	Default
	{
		Health 150;
		Speed 6.5;
		HaloDoom_EnemyBase.HCE_Type 0;
		HaloDoom_EnemyBase.HCE_Variant "brute honor guard plasma rifle";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 160;
		HaloDoom_EnemyBase.HCE_Movement 4.23, 6.50, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 1.42;
		HaloDoom_EnemyBase.HCE_Weapon "HCE_PlasmaRifleBolt", 1, 7.00, 1.00, 1120;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 155.9;
		HaloDoom_EnemyBase.HCE_DamageModifier 0.50;
		HaloDoom_EnemyBase.HCE_CombatRange 320, 640;
		HaloDoom_EnemyBase.HCE_Burst 0.75, 1.10, 0.30, 1.20, 0.00, 0.50;
		HaloDoom_EnemyBase.HCE_GunOffset (30.0, -0.0, -19.0);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 130, 35;
		HaloDoom_EnemyBase.HCE_Leap 0, 0, 0.00, 6.5;
		HaloDoom_EnemyBase.HCE_Grenades 2, 2, 0.10, 6.0, 240, 1600, 26.0;
		HaloDoom_EnemyBase.HCE_Panic 0.00, 0.00, 0.0, 0.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.25, 0.45, 0;
		HaloDoom_EnemyBase.HCE_Defensive 0.65, 0.75, 0.10, 0.30, 0.30;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 0, 5.0, 6.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_FirePattern 4, 7, 4, 0.75, 1.33, 0;
		HaloDoom_EnemyBase.HCE_FireSounds "Halo/Weapons/PlasmaRifle/Fire", "Halo/Weapons/PlasmaRifle/Fire/Bass", "", "";
		HaloDoom_EnemyBase.HCE_Voices "Brute_Bloodthirsty,Brute_Cruel";
		HaloDoom_EnemyBase.HCE_Drops "Halo_PlasmaRifle", "PlasmaGrenades";
		+HaloDoom_EnemyBase.HCE_Berserks
		+HaloDoom_EnemyBase.HCE_Evades
		+HaloDoom_EnemyBase.HCE_Leader
		+HaloDoom_EnemyBase.HCE_Surprise
		+HaloDoom_EnemyBase.HCE_ThrowsGrenades
	}
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		if(hce_berserk) switch(kind)
		{
		case HCE_A_IDLE: return 'berserk idle';
		case HCE_A_ALERT: return 'berserk idle';
		case HCE_A_MOVE_F: return 'berserk move-front';
		case HCE_A_MOVE_B: return 'berserk move-front';
		case HCE_A_MOVE_L: return 'berserk move-front';
		case HCE_A_MOVE_R: return 'berserk move-front';
		case HCE_A_FLEE: return 'berserk move-front';
		case HCE_A_MELEE: { static const Name o[] = { 'berserk melee 1', 'berserk melee 2', 'berserk melee 3', 'berserk melee 4', 'berserk melee 5', 'berserk tackle 1', 'berserk tackle 2' }; return o[random(0, 6)]; }
		case HCE_A_TURN_L: return 'berserk turn-left';
		case HCE_A_TURN_R: return 'berserk turn-right';
		}
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand rifle idle';
		case HCE_A_ALERT: return 'stand rifle idle';
		case HCE_A_MOVE_F: return 'stand rifle move-front';
		case HCE_A_MOVE_B: return 'stand rifle move-back';
		case HCE_A_MOVE_L: return 'stand rifle move-left';
		case HCE_A_MOVE_R: return 'stand rifle move-right';
		case HCE_A_FIRE: return 'stand rifle fire-1 pr baked';
		case HCE_A_MELEE: return 'stand rifle melee';
