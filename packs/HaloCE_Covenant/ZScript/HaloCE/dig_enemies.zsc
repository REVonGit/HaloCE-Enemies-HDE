	override int HCE_AnimTics(Name anim)
	{
		switch(anim)
		{
		case 'berserk idle': return 51;
		case 'berserk melee 1': return 20;
		case 'berserk melee 2': return 20;
		case 'berserk melee 3': return 20;
		case 'berserk melee 4': return 20;
		case 'berserk melee 5': return 22;
		case 'berserk move-front': return 24;
		case 'berserk tackle 1': return 36;
		case 'berserk tackle 2': return 61;
		case 'berserk turn-left': return 16;
		case 'berserk turn-right': return 16;
		case 'h-kill back gut': return 48;
		case 'h-kill front gut': return 69;
		case 'h-ping back gut': return 27;
		case 'h-ping front gut': return 22;
