		{
		case HCE_A_IDLE: return 'stand unarmed idle%0';
		case HCE_A_ALERT: { static const Name o[] = { 'alert unarmed idle%0', 'alert unarmed idle%1', 'alert unarmed idle%2' }; return o[random(0, 2)]; }
		case HCE_A_MOVE_F: return 'stand unarmed move-front';
		case HCE_A_MELEE: return 'stand unarmed melee';
		case HCE_A_LEAP_MELEE: return 'stand unarmed melee';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut baked', 's-ping front head baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_B: return 's-ping back gut baked';
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_TURN_L: return 'stand unarmed turn-left';
		case HCE_A_TURN_R: return 'stand unarmed turn-right';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert unarmed idle%0': return 116;
		case 'alert unarmed idle%1': return 116;
		case 'alert unarmed idle%2': return 116;
		case 'h-kill back gut': return 48;
		case 'h-kill front gut': return 48;
		case 's-kill back gut': return 48;
		case 's-kill front gut': return 48;
		case 's-kill left gut': return 48;
		case 's-kill right gut': return 48;
		case 's-ping back gut baked': return 10;
		case 's-ping front gut baked': return 10;
		case 's-ping front head baked': return 10;
		case 'stand unarmed idle%0': return 116;
		case 'stand unarmed melee': return 57;
		case 'stand unarmed move-front': return 34;
		case 'stand unarmed turn-left': return 28;
		case 'stand unarmed turn-right': return 28;
		}
		return 30;
	}

	// heavy footfalls from its own sound set while it walks
	int hce_stepTics;
	override void Tick()
	{
		super.Tick();
		if(health <= 0 || pos.z > floorz + 2 || vel.xy.Length() < 1.5) return;
		if(++hce_stepTics >= 16) { hce_stepTics = 0; A_StartSound("HCE/ThornBeast/Step", CHAN_BODY, CHANF_OVERLAP, 0.8); }
	}
}

