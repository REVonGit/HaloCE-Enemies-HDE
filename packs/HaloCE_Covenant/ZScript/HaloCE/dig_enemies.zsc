	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand rifle idle';
		case HCE_A_ALERT: return 'alert rifle idle';
		case HCE_A_MOVE_F: return 'stand rifle move-front';
		case HCE_A_MOVE_B: return 'stand rifle move-back';
		case HCE_A_MOVE_L: return 'stand rifle move-left';
		case HCE_A_MOVE_R: return 'stand rifle move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch rifle idle';
		case HCE_A_CROUCH_MOVE: return 'crouch rifle move-front';
		case HCE_A_FIRE: return 'stand rifle cr fire-1 baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand rifle melee%0', 'stand rifle melee%1' }; return o[random(0, 1)]; }
		case HCE_A_THROW: return 'stand rifle throw-grenade';
		case HCE_A_DIVE_L: return 'stand rifle dive-left';
		case HCE_A_DIVE_R: return 'stand rifle dive-right';
		case HCE_A_DIVE_F: return 'stand rifle dive-front';
		case HCE_A_EVADE_L: return 'stand rifle evade-left';
		case HCE_A_EVADE_R: return 'stand rifle evade-right';
		case HCE_A_SURPRISE_F: return 'stand rifle surprise-front';
		case HCE_A_SURPRISE_B: return 'stand rifle surprise-back';
		case HCE_A_BERSERK: return 'stand rifle berserk';
		case HCE_A_WARN: return 'stand rifle warn';
		case HCE_A_SIGNAL: return 'stand rifle signal-attack';
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut baked', 's-ping front gut%1 baked', 's-ping front head baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%0 baked', 's-ping left gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-foot' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back gut', 'h-ping back l-arm', 'h-ping back r-arm' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 's-kill front gut%0', 's-kill front gut%1' }; return o[random(0, 1)]; }
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_TURN_L: return 'stand rifle turn-left';
		case HCE_A_TURN_R: return 'stand rifle turn-right';
		case HCE_A_RELOAD: return 'stand rifle reload-1';
		case HCE_A_VENT: return 'stand rifle overheat';
		case HCE_A_LOW_IDLE: return 'stand rifle low-idle';
		case HCE_A_LOW_MOVE: return 'stand rifle low-move';
		case HCE_A_COVER_L_ENTER: return 'stand rifle cover-left-enter';
		case HCE_A_COVER_L_IDLE: return 'stand rifle cover-left-idle';
		case HCE_A_COVER_L_PEEK: return 'stand rifle cover-left-peek';
		case HCE_A_COVER_L_OPEN: return 'stand rifle cover-left-open';
		case HCE_A_COVER_L_UNPEEK: return 'stand rifle cover-left-unpeek';
		case HCE_A_COVER_L_EXIT: return 'stand rifle cover-left-exit';
		case HCE_A_COVER_R_ENTER: return 'stand rifle cover-right-enter';
		case HCE_A_COVER_R_IDLE: return 'stand rifle cover-right-idle';
		case HCE_A_COVER_R_PEEK: return 'stand rifle cover-right-peek';
		case HCE_A_COVER_R_OPEN: return 'stand rifle cover-right-open';
		case HCE_A_COVER_R_UNPEEK: return 'stand rifle cover-right-unpeek';
		case HCE_A_COVER_R_EXIT: return 'stand rifle cover-right-exit';
		case HCE_A_HOIST: return 'stand rifle hoist';
		case HCE_A_VAULT: return 'stand rifle vault';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert rifle idle': return 70;
		case 'crouch rifle idle': return 70;
		case 'crouch rifle move-front': return 35;
		case 'h-kill back gut': return 63;
		case 'h-kill front gut': return 51;
		case 'h-ping back gut': return 40;
		case 'h-ping back l-arm': return 42;
		case 'h-ping back r-arm': return 32;
		case 'h-ping front chest': return 40;
		case 'h-ping front gut': return 38;
		case 'h-ping front l-arm': return 43;
		case 'h-ping front l-foot': return 69;
		case 's-kill back gut': return 77;
		case 's-kill front gut%0': return 70;
		case 's-kill front gut%1': return 77;
		case 's-kill left gut': return 43;
		case 's-kill right gut': return 49;
		case 's-ping back gut%0 baked': return 6;
		case 's-ping back gut%1 baked': return 24;
		case 's-ping front gut baked': return 6;
		case 's-ping front gut%1 baked': return 12;
		case 's-ping front head baked': return 23;
		case 's-ping left gut%0 baked': return 6;
		case 's-ping left gut%1 baked': return 15;
		case 's-ping right gut%0 baked': return 6;
		case 's-ping right gut%1 baked': return 15;
		case 'stand airborne-dead': return 49;
		case 'stand landing-dead': return 47;
		case 'stand rifle airborne': return 74;
		case 'stand rifle berserk': return 52;
		case 'stand rifle cover-left-enter': return 24;
		case 'stand rifle cover-left-exit': return 10;
		case 'stand rifle cover-left-idle': return 104;
		case 'stand rifle cover-left-open': return 2;
		case 'stand rifle cover-left-peek': return 16;
		case 'stand rifle cover-left-unpeek': return 16;
		case 'stand rifle cover-right-enter': return 24;
		case 'stand rifle cover-right-exit': return 10;
		case 'stand rifle cover-right-idle': return 104;
		case 'stand rifle cover-right-open': return 2;
		case 'stand rifle cover-right-peek': return 16;
		case 'stand rifle cover-right-unpeek': return 16;
		case 'stand rifle cr fire-1 baked': return 9;
		case 'stand rifle dive-front': return 46;
		case 'stand rifle dive-left': return 46;
		case 'stand rifle dive-right': return 46;
		case 'stand rifle evade-left': return 35;
		case 'stand rifle evade-right': return 35;
		case 'stand rifle hoist': return 65;
		case 'stand rifle idle': return 70;
		case 'stand rifle land-soft': return 47;
		case 'stand rifle low-idle': return 70;
		case 'stand rifle low-move': return 48;
		case 'stand rifle melee%0': return 41;
		case 'stand rifle melee%1': return 47;
		case 'stand rifle move-back': return 30;
		case 'stand rifle move-front': return 30;
		case 'stand rifle move-left': return 30;
		case 'stand rifle move-right': return 30;
		case 'stand rifle overheat': return 36;
		case 'stand rifle reload-1': return 51;
		case 'stand rifle signal-attack': return 64;
		case 'stand rifle surprise-back': return 29;
		case 'stand rifle surprise-front': return 24;
		case 'stand rifle throw-grenade': return 63;
		case 'stand rifle turn-left': return 16;
		case 'stand rifle turn-right': return 16;
		case 'stand rifle vault': return 26;
		case 'stand rifle warn': return 33;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand rifle hoist': return (92.3, -0.0, 84.7);
		case 'stand rifle vault': return (103.9, 0.0, 10.6);
		}
		return (0, 0, 0);
	}

	// the carbine's tracer: every round draws HaloDoom Evolved's green carbine laser trail along its path, from the
	// muzzle to where it will land, fading in a few tics
	override void HCE_OnShot(Actor shot)
	{
		if(shot.vel.Length() < 0.1) return;
		HCE_EnemyLaser.Flash(shot.pos, HCE_TraceEnd(shot.pos, shot.vel), "Green", 2.0, 0.5);
	}
	// Halo 2 over the CE Elite (extract_h2_elite_kit.py): honor_body; the CE body hidden under it
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		static const int BS[] = { 0, 1, 2, 3, 4, 5, 11, 12, 13, 14 };
		for(int i = 0; i < BS.Size(); i++) HCE_HideSurface(BS[i]);
		A_ChangeModel('None', 1, "models/hce/EliteKit", "honor_body.iqm", 1, "", 'None');
		A_ChangeModel('None', 1, "", 'None', 18, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "", 'None', 19, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "", 'None', 20, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		HCE_ResumeAnim();        // A_ChangeModel resets the animation the spawn started (idle, sleeping)
	}
	override void HCE_OnSever(int limb, bool gunArm)
	{
		super.HCE_OnSever(limb, gunArm);
		if(limb == HCE_LIMB_LARM)
		{
			A_ChangeModel('None', 1, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 3, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 15, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 18, "models/hce/EliteKit", 'ek_gore_arm.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(16);
		}
		if(limb == HCE_LIMB_RARM)
		{
			A_ChangeModel('None', 1, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 19, "models/hce/EliteKit", 'ek_gore_arm.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(17);
		}
		if(limb == HCE_LIMB_HEAD)
		{
			A_ChangeModel('None', 1, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 20, "models/hce/EliteKit", 'gore_Elite.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(15);
		}
	}
	override void HCE_GibOverride(int limb, out String path, out Name model, out int stub, out Name tex)
	{
		switch(limb)
		{
		case HCE_LIMB_HEAD: path = "models/hce/EliteKit"; model = 'honor_body_gib_head.iqm'; stub = 28; tex = 'gore_Elite.png'; break;
		case HCE_LIMB_LARM: path = "models/hce/EliteKit"; model = 'honor_body_gib_larm.iqm'; stub = 27; tex = 'gore_Elite.png'; break;
		case HCE_LIMB_RARM: path = "models/hce/EliteKit"; model = 'honor_body_gib_rarm.iqm'; stub = 26; tex = 'gore_Elite.png'; break;
		}
	}
	override Name HCE_ShellClass() { return 'HCE_EliteRifleHonorBodyShieldShell'; }
	override void HCE_BloodHideClass()
	{
		super.HCE_BloodHideClass();
		static const int BS[] = { 0, 1, 2, 3, 4, 5, 11, 12, 13, 14 };
		for(int i = 0; i < BS.Size(); i++) A_ChangeModel('None', 7, "", 'None', BS[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override bool HCE_HasLoadouts() { return false; }      // keeps the gun it is built around
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'alert rifle idle': return (25.4, -4.0, 2.7);
		case 'crouch rifle idle': return (41.3, 8.2, -10.9);
		case 'crouch rifle move-front': return (38.4, 7.6, -1.7);
		case 'stand rifle cover-left-open': return (22.7, 11.2, 5.6);
		case 'stand rifle cover-left-peek': return (8.0, 5.3, 4.6);
		case 'stand rifle cover-right-open': return (20.9, -6.2, 5.4);
		case 'stand rifle low-idle': return (31.9, 3.9, -10.5);
		case 'stand rifle low-move': return (31.3, 4.5, -7.1);
		case 'stand rifle move-back': return (33.0, 6.7, 14.2);
		case 'stand rifle move-front': return (42.0, 10.8, 8.9);
		case 'stand rifle move-left': return (39.3, 0.5, 16.7);
		case 'stand rifle move-right': return (36.0, 11.2, 14.2);
		}
		return hce_gunOffset;
	}
}

// HCE_EliteMajorPlasmaCarbine: Halo variant "characters\elite\elite major\elite major plasma carbine", plasma carbine, 100 body / 150 shield, 6 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_EliteMajorPlasmaCarbine : HCE_EliteRifleBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
	{
		static const int K[] = { 6, 7, 8, 9, 10, 15, 16, 17 };
		for(int i = 0; i < K.Size(); i++) if(K[i] == s) { A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN); return; }
		A_ChangeModel('None', 0, "", 'None', s, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowSurface(int s)
	{
		switch(s)
		{
		case 6: A_ChangeModel('None', 0, "", 'None', 6, "models/hce_dig/weapons", 'w_cmt_carbine_gray.png', CMDL_USESURFACESKIN); return;
		case 7: A_ChangeModel('None', 0, "", 'None', 7, "models/hce_dig/weapons", 'w_cmt_carbine_lights.png', CMDL_USESURFACESKIN); return;
		case 8: A_ChangeModel('None', 0, "", 'None', 8, "models/hce_dig/weapons", 'w_cmt_carbine_icon.png', CMDL_USESURFACESKIN); return;
		case 9: A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/weapons", 'w_cmt_carbine_meter.png', CMDL_USESURFACESKIN); return;
		case 10: A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'w_cmt_carbine_purple.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
	override void HCE_DressSurfaces()
	{
		A_ChangeModel('None', 0, "", 'None', 6, "models/hce_dig/weapons", 'w_cmt_carbine_gray.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 7, "models/hce_dig/weapons", 'w_cmt_carbine_lights.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 8, "models/hce_dig/weapons", 'w_cmt_carbine_icon.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/weapons", 'w_cmt_carbine_meter.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'w_cmt_carbine_purple.png', CMDL_USESURFACESKIN);
	}

