		case 'stand rifle celebrate': return 66;
		case 'stand rifle cover-left-enter': return 24;
		case 'stand rifle cover-left-exit': return 10;
		case 'stand rifle cover-left-idle': return 104;
		case 'stand rifle cover-left-open': return 2;
