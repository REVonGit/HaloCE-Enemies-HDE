		case 'stand carbine move-left': return 30;
		case 'stand carbine move-right': return 29;
		case 'stand carbine signal-attack%0': return 80;
		case 'stand carbine signal-attack%1': return 51;
		case 'stand carbine signal-attack%2': return 86;
		case 'stand carbine signal-attack%3': return 55;
		case 'stand carbine signal-attack%4': return 57;
		case 'stand carbine surprise-front': return 78;
