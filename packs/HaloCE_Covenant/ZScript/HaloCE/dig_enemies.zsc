	{
		switch(lo)
		{
		case 0: HCE_ApplyLoadout0(); return;
		case 1: HCE_ApplyLoadout1(); return;
		case 2: HCE_ApplyLoadout2(); return;
		case 3: HCE_ApplyLoadout3(); return;
		}
	}
