	}
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		if(hce_berserk) switch(kind)
		{
		case HCE_A_IDLE: return 'berserk idle';
		case HCE_A_ALERT: return 'berserk idle';
		case HCE_A_MOVE_F: return 'berserk move-front';
		case HCE_A_MOVE_B: return 'berserk move-front';
		case HCE_A_MOVE_L: return 'berserk move-front';
		case HCE_A_MOVE_R: return 'berserk move-front';
		case HCE_A_FLEE: return 'berserk move-front';
		case HCE_A_MELEE: { static const Name o[] = { 'berserk melee 1', 'berserk melee 2', 'berserk melee 3', 'berserk melee 4', 'berserk melee 5', 'berserk tackle 1', 'berserk tackle 2' }; return o[random(0, 6)]; }
		case HCE_A_TURN_L: return 'berserk turn-left';
		case HCE_A_TURN_R: return 'berserk turn-right';
		}
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand rifle idle';
		case HCE_A_ALERT: return 'stand rifle idle';
		case HCE_A_MOVE_F: return 'stand rifle move-front';
		case HCE_A_MOVE_B: return 'stand rifle move-back';
		case HCE_A_MOVE_L: return 'stand rifle move-left';
		case HCE_A_MOVE_R: return 'stand rifle move-right';
		case HCE_A_FIRE: return 'stand rifle fire-1 pr baked';
		case HCE_A_MELEE: return 'stand rifle melee';
		case HCE_A_THROW: return 'stand rifle throw-grenade';
		case HCE_A_DIVE_L: return 'stand rifle dive-left';
		case HCE_A_DIVE_R: return 'stand rifle dive-right';
		case HCE_A_DIVE_F: return 'stand rifle dive-front';
		case HCE_A_EVADE_L: return 'stand rifle evade-left';
		case HCE_A_EVADE_R: return 'stand rifle evade-right';
		case HCE_A_BERSERK: return 'stand rifle berserk';
		case HCE_A_WARN: return 'stand rifle warn';
		case HCE_A_SIGNAL: return 'stand rifle signal-attack';
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: return 's-ping front gut baked';
		case HCE_A_PING_B: return 's-ping back gut baked';
		case HCE_A_PING_L: return 's-ping left gut baked';
		case HCE_A_PING_R: return 's-ping right gut baked';
		case HCE_A_HPING_F: return 'h-ping front gut';
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_CELEBRATE: return 'stand rifle celebrate';
		case HCE_A_TURN_L: return 'stand rifle turn-left';
		case HCE_A_TURN_R: return 'stand rifle turn-right';
		case HCE_A_LOW_IDLE: return 'stand rifle low-idle';
		case HCE_A_LOW_MOVE: return 'stand rifle low-move';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
