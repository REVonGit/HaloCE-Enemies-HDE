			A_ChangeModel('None', 0, "", 'None', 11, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 22, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 27, "models/hce_dig/H2Jackal", 'gore_H2Jackal.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.0715, -0.0001, 0.6408), 80.00, "models/hce_dig/H2Jackal", 'H2Jackal_gib_head.iqm', 27, 'gore_H2Jackal.png', 0.0547);
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 15, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 17, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 18, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 19, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 20, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 21, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 23, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 25, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 28, "models/hce_dig/H2Jackal", 'gore_H2Jackal.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (0.0918, 0.1815, 0.4110), 80.00, "models/hce_dig/H2Jackal", 'H2Jackal_gib_larm.iqm', 28, 'gore_H2Jackal.png', 0.0299);
			HCE_OnSever(1, true);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 24, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 26, "models/hce_dig/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 29, "models/hce_dig/H2Jackal", 'gore_H2Jackal.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (0.0926, -0.1815, 0.4108), 80.00, "models/hce_dig/H2Jackal", 'H2Jackal_gib_rarm.iqm', 29, 'gore_H2Jackal.png', 0.0301);
			HCE_OnSever(2, false);
			return true;
		}
		return false;
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (5.7, -0.0, 61.5);
		case 1: return (7.3, 14.5, 39.5);
		case 2: return (7.4, -14.5, 39.4);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 1; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce_dig/H2Jackal", 'H2Jackal_blood1.iqm'); break;
