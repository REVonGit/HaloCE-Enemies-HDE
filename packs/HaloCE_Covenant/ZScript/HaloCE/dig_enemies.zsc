		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_FirePattern 2, 3, 9, 0.75, 1.28, 0;
		HaloDoom_EnemyBase.HCE_FireSounds "Halo/Weapons/Carbine/Fire", "Halo/Weapons/Carbine/Fire/Bass", "", "";
		HaloDoom_EnemyBase.HCE_Voices "Brute_Bloodthirsty,Brute_Cruel";
