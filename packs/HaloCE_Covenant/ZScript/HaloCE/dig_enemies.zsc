		case HCE_A_WARN: return 'stand rifle warn';
		case HCE_A_SIGNAL: return 'stand rifle signal-attack';
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: return 's-ping front gut baked';
		case HCE_A_PING_B: return 's-ping back gut baked';
		case HCE_A_PING_L: return 's-ping left gut baked';
		case HCE_A_PING_R: return 's-ping right gut baked';
		case HCE_A_HPING_F: return 'h-ping front gut';
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
