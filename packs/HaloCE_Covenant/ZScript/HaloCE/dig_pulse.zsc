// the core's HCE_NerfMixin, repeated here (mixins don't cross pk3s): HDE recomputes a projectile's damage when it
// hits, so the enemy damage nerf is re-applied there
mixin class HCE_DigNerfMixin
{
	// HDE's range falloff rebuilds truedamage from the unscaled default once a shot is past its falloff range, so the
	// enemy damage scale goes back on it then. Inside that range HDE leaves the value alone, and it was scaled when
	// fired (HCE_ScaleProjectile): scaling it again there used to apply the nerf twice (0.16x for 0.4), and small
	// rounds such as Spiker spikes rounded down to no damage at all.
	override void AdjustRangeDamage()
	{
		double before = truedamage;
		super.AdjustRangeDamage();
		if(range_max > 0 && !bDESTROYED && DamageMultiply > 0 && truedamage != before) truedamage *= DamageMultiply;
	}
}

// Pulse Carbine bolts for the Elites: HDE's Pulse Carbine projectile (slow launch, accelerating, homing),
// locked onto the shooter's target. HDE's own homing grabs the nearest visible thing, which for a monster
// would include its allies, so this one never picks a new target once its victim is gone.
class HCE_PulseCarbineHoming : HaloPulseCarbine_Proj
{
	mixin HCE_DigNerfMixin;
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		if(target && !target.player && target.target) tracer = target.target;
	}
	override void Handle_Homing(double turnMax, bool ignoreCorpses)
	{
		if(!tracer) return;
		super.Handle_Homing(turnMax, ignoreCorpses);
	}
}
