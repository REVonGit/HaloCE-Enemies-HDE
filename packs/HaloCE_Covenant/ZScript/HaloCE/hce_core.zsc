// ============================================================================
// hce_core.zsc -- shared Halo CE enemy code that needs ZScript 4.15 (bone queries), so it
// lives in the core pack instead of the enemy API (which also compiles inside HDE's 4.10 unit).
// ============================================================================

// ---------------------------------------------------------------------------
// Jackal energy shield as its own entity. The shield you see is part of the Jackal's model
// (skinned to the shield node of its arm, HCE_ShieldBone()); this invisible, shootable cylinder rides
// that node every tic, so it sits wherever the arm holds the shield, and it soaks up what hits it:
//   bullets, pellets, spikes   nothing (they spark off it)
//   needles / fire             a little
//   explosions                 full damage
//   melee                      2.5x, and the Jackal staggers
//   plasma                     4x (an overcharged plasma bolt 10x)
// Hits that miss the shield hit the Jackal itself; so do shots from its side or back that clip the shield's
// hitbox, and a shot whose line passes the gun hand poking out past the shield makes the Jackal reel (hard ping). Drained, it
// breaks for good: the field bursts into shards, the Jackal reels (hard ping) and often panics, and it fights on without it
// (the body keeps the broken gauntlet bare).
// ---------------------------------------------------------------------------
class HCE_JackalShield : Actor
{
	double hp, maxhp;
	int regenWait, bone, handBone;
	bool down, skinHidden, broken;

	Default
	{
		+SHOOTABLE
		+NOGRAVITY
		+NOBLOOD
		+DONTTHRUST
		+NOTAUTOAIMED
		+NOTONAUTOMAP
		+DONTSPLASH
		+NODAMAGETHRUST
		+NOTARGET
		+NEVERTARGET
		+DONTBLAST
		-SOLID
		-COUNTKILL
		Health 1000000;
		Radius 10;
		Height 34;
		Mass 100000;
		Tag "Jackal shield";
	}

	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}

	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		bone = -2; handBone = -1;      // master is set right after the spawn: set up on the first tic
	}

	static double HitMul(Actor inflictor, Name mod, int flags)
	{
		String cn = inflictor ? String.Format("%s", inflictor.GetClassName()) : "";
		cn = cn.MakeLower();
		if(mod == 'Melee' || mod == 'Kick' || mod == 'Sword' || mod == 'Punch' || mod == 'Fist' || mod == 'Chainsaw') return 2.5;
		if(cn.IndexOf("charged") >= 0 && cn.IndexOf("plasma") >= 0) return 10.0;
		if(mod == 'Plasma' || mod == 'PlasmaExplosion' || cn.IndexOf("plasma") >= 0) return 4.0;
		if((flags & DMG_EXPLOSION) || mod == 'Explosive' || mod == 'Explosion' || mod == 'Grenade' || mod == 'Rocket') return 1.0;
		if(cn.IndexOf("needle") >= 0) return 0.3;
		if(mod == 'Fire' || mod == 'Burn') return 0.5;
		return 0;                                               // bullets, pellets, spikes
	}

	override bool CanCollideWith(Actor other, bool passive)
	{
		// the Jackal's own shots and its squad's pass through
		if(other == master) return false;
		let j = HaloDoom_EnemyBase(master);
		if(j && other.bMISSILE && other.target && (other.target == master || HaloDoom_EnemyBase.HCE_TeamOf(other.target) == j.hce_team))
			return false;
		return Super.CanCollideWith(other, passive);
	}

	override int DamageMobj(Actor inflictor, Actor source, int damage, Name mod, int flags, double angle)
	{
		let j = HaloDoom_EnemyBase(master);
		if(!j || j.health <= 0 || down || damage <= 0) return 0;
		if(source == j) return 0;
		if(source && !source.player && HaloDoom_EnemyBase.HCE_TeamOf(source) == j.hce_team) return 0;
		bool blast = (flags & DMG_EXPLOSION) != 0;          // a blast reaches the Jackal on its own: no hand-over
		// the shield only covers what it faces: a shot from the Jackal's side or back that happens to clip the
		// shield's hitbox (held out to the side) goes on into the Jackal
		Actor from = source ? source : inflictor;
		if(!blast && from && abs(DeltaAngle(j.angle, j.AngleTo(from))) > 80)
			return PassOn(j, inflictor, source, damage, mod, flags, false);
		// the gun hand poking out past the shield: the hit goes into the Jackal and it reels (hard ping)
		if(!blast && HandHit(j, inflictor, source))
			return PassOn(j, inflictor, source, damage, mod, flags, true);
		double m = HitMul(inflictor, mod, flags);
		vector3 at = inflictor && inflictor != source ? inflictor.pos : pos + (0, 0, height * 0.5);
		if(m <= 0)
		{
			// glances off: a small flash at the shield face
			HCE_ShieldImpact.Burst(self, inflictor, source, ShieldColor(j), 0.4, at, true);
			regenWait = max(regenWait, 35);
			return 0;
		}
		hp -= damage * m;
		regenWait = 35 * 4;
		HCE_ShieldImpact.Burst(self, inflictor, source, hp < maxhp * 0.25 ? Color(255, 255, 80, 64) : ShieldColor(j), clamp(damage * m / 20.0, 0.5, 2.0), at, true);
		if(mod == 'Melee' && hp > 0 && j.hce_animLock <= 0)
		{
			int k = j.HCE_DirKind(HCE_A_PING_F, HCE_A_PING_B, HCE_A_PING_L, HCE_A_PING_R);
			if(j.HCE_HasAnim(k)) j.HCE_PlayLocked(k, 0.6);
		}
		if(hp <= 0) BreakShield(j);
		return 0;
	}

	int PassOn(HaloDoom_EnemyBase j, Actor inflictor, Actor source, int damage, Name mod, int flags, bool hand)
	{
		j.DamageMobj(inflictor, source, damage, mod, flags);
		if(hand && j.health > 0 && j.hce_leapState == 0 && j.hce_jumpState == 0 && j.hce_lockPing != 2)
		{
			int k = j.HCE_DirKind(HCE_A_HPING_F, HCE_A_HPING_B, HCE_A_HPING_F, HCE_A_HPING_F);
			if(!j.HCE_HasAnim(k)) k = HCE_A_HPING_F;
			if(j.HCE_HasAnim(k))
			{
				j.HCE_StopFireLoop(); j.hce_shotsLeft = 0; j.hce_chargeTics = 0; j.hce_pendingMelee = 0; j.hce_diveTics = 0;
				j.HCE_PlayLocked(k, 0.85);
				j.hce_lockPing = 2;
			}
		}
		return 0;
	}

	// did the shot's line pass the gun hand (HCE_GunHandBone)? Hitscans: from the shooter's eye through the puff;
	// projectiles: along their flight path to where they struck
	bool HandHit(HaloDoom_EnemyBase j, Actor inflictor, Actor source)
	{
		if(handBone < 0 || !inflictor) return false;
		vector3 hand, f, u;
		[hand, f, u] = j.GetBonePosition(handBone);
		if(hand == (0, 0, 0)) return false;
		vector3 o, d;
		if(inflictor != source && inflictor.bMISSILE && inflictor.vel.Length() > 0.1)
		{
			d = inflictor.vel.Unit();
			o = inflictor.pos - d * 64;
		}
		else
		{
			if(!source || inflictor == source) return false;
			// where a hitscan leaves the shooter (Doom: half its height plus the attack offset)
			double oz = source.height * 0.5 + 8;
			let pp = PlayerPawn(source);
			if(pp && source.player) oz = source.height * 0.5 + pp.AttackZOffset * source.player.crouchfactor;
			o = source.pos + (0, 0, oz);
			vector3 to = level.Vec3Diff(o, inflictor.pos);
			if(to.Length() < 1) return false;
			d = to.Unit();
		}
		vector3 rel = level.Vec3Diff(o, hand);
		double along = rel dot d;
		if(along < 0) return false;
		double miss = (rel - d * along).Length();
		return miss < 6 + (inflictor.bMISSILE ? inflictor.radius : 0);
	}

	// the gauntlet's energy colour by rank (matches the baked shield skins)
	static color ShieldColor(Actor j)
	{
		String n = "";
		if(j) n = j.GetClassName();
		if(n.IndexOf("Zealot") >= 0) return Color(255, 255, 214, 80);
		if(n.IndexOf("Ultra") >= 0) return Color(255, 255, 140, 30);
		if(n.IndexOf("Major") >= 0) return Color(255, 255, 80, 215);
		return Color(255, 80, 120, 255);
	}

	void BreakShield(HaloDoom_EnemyBase j)
	{
		down = true; broken = true;
		hp = 0;
		bSHOOTABLE = false;
		A_StartSound("HCE/Jackal/ShieldPop", CHAN_AUTO, CHANF_OVERLAP);     // Halo 2's Jackal shield popping
		A_StartSound("Shield/Explode", CHAN_AUTO, CHANF_OVERLAP, 0.8);
		// it shatters: a flash, then shards of the field tumbling down in the shield's colour
		color sc = ShieldColor(j);
		HCE_ShieldImpact.Burst(self, null, null, sc, 2.0, pos + (0, 0, height * 0.5), true);
		for(int i = 0; i < 40; i++)            // relative to the shield's facing: out in front and to the sides
			A_SpawnParticle(sc, SPF_FULLBRIGHT | SPF_RELATIVE, random(18, 34), frandom(2, 7), 0,
				frandom(-4, 4), frandom(-height * 0.4, height * 0.4), height * 0.5 + frandom(-height * 0.4, height * 0.4),
				frandom(0.5, 3), frandom(-2.5, 2.5), frandom(-1, 4), 0, 0, -0.35, frandom(0.8, 1.0), -1, -0.1);
		for(int i = 0; i < 16; i++)
			A_SpawnParticle("FFFFFF", SPF_FULLBRIGHT, 8, frandom(2, 4), 0, 0, 0, height * 0.5, frandom(-6, 6), frandom(-6, 6), frandom(-3, 5));
		SetShieldVisible(j, false);
		if(j.health > 0 && j.bHCE_Panics && frandom(0, 1) < 0.6) j.HCE_StartPanic();     // naked behind a broken gauntlet
		// the Jackal reels from it
		if(j.health > 0 && j.hce_leapState == 0 && j.hce_jumpState == 0)
		{
			int k = j.HCE_DirKind(HCE_A_HPING_F, HCE_A_HPING_B, HCE_A_HPING_F, HCE_A_HPING_F);
			if(!j.HCE_HasAnim(k)) k = HCE_A_HPING_F;
			if(j.HCE_HasAnim(k)) { j.HCE_StopFireLoop(); j.HCE_PlayLocked(k, 0.9); j.hce_lockPing = 2; }
			j.HCE_Say('PainHeavy', 0.8, 35, true);
		}
	}

	// the shield surface on the Jackal's model: hidden while it's down
	void SetShieldVisible(Actor j, bool on)
	{
		if(skinHidden == !on) return;
		skinHidden = !on;
		let e = HaloDoom_EnemyBase(j);
		if(!e || !e.bHCE_FrontShield) return;
		int SURF = e.HCE_ShieldSurface();                   // the model surface the shield's energy field is drawn on
		if(on) j.A_ChangeModel('None', 0, "", 'None', SURF, "", 'None', CMDL_USESURFACESKIN);
		else j.A_ChangeModel('None', 0, "", 'None', SURF, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}

	override void Tick()
	{
		let j = HaloDoom_EnemyBase(master);
		if(!j || j.health <= 0) { if(j) SetShieldVisible(j, false); Destroy(); return; }   // the field dies with its Jackal
		if(isFrozen()) return;
		// ride the arm's 'frame shield' node (the model's bone positions are on for the Jackal)
		if(bone == -2)
		{
			maxhp = hp = max(1, j.hce_frontShieldMax);
			A_SetSize(max(8, j.radius * 0.9), j.height * 0.7);
			j.SetModelFlag(0, IQM_GET_BONE_INFO);
			bone = j.GetBoneIndex(j.HCE_ShieldBone());          // CE 'frame shield'; Halo 2 'shield'
			handBone = j.GetBoneIndex(j.HCE_GunHandBone());    // CE 'bip01 r hand'; Halo 2 'l_hand'
		}
		vector3 p = j.pos + (AngleToVector(j.angle, j.radius + 4), j.height * 0.5);
		if(bone >= 0)
		{
			vector3 bp, f, u;
			[bp, f, u] = j.GetBonePosition(bone);
			if(bp != (0, 0, 0)) p = bp;
		}
		SetOrigin(p - (0, 0, height * 0.5), true);
		angle = j.angle;
		// recharge out of harm
		if(regenWait > 0) regenWait--;
		else if(hp < maxhp && !broken)
		{
			hp = min(maxhp, hp + maxhp / 70.0);
			if(down && hp >= maxhp * 0.5)
			{
				down = false;
				bSHOOTABLE = true;
				SetShieldVisible(j, true);
				A_StartSound("Shield/Regenerate", CHAN_AUTO, CHANF_OVERLAP, 0.6);
			}
		}
		j.hce_frontShieldHP = down ? 0 : hp;
	}
}

// ---------------------------------------------------------------------------
// Energy-shield flare: a copy of the wearer's model, a touch larger and skinned with a bright noise
// texture, drawn additively over it. Invisible until the shield is hit; then it flares (brighter when the
// shield pops, softer while it recharges) and fades in a fraction of a second. The enemy API sets the alpha;
// the shell follows its wearer and mirrors its animation (the generated code drives both).
// ---------------------------------------------------------------------------
// the energy sword's blade on a cloaked Elite: the Elite's own model with only the blade drawn, glowing at full
// strength while the body is all but invisible (build_pack.py gives each such class a <class>Blade model)
class HCE_BladeShell : Actor
{
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+DECOUPLEDANIMATIONS
		+NOTONAUTOMAP
		RenderStyle "Add";
		Alpha 1.0;
	}

	States
	{
	Spawn:
		HCEM A -1 Bright;
		Stop;
	}

	override void Tick()
	{
		let e = HaloDoom_EnemyBase(master);
		if(!e || e.health <= 0) { Destroy(); return; }
		if(isFrozen()) return;
		SetOrigin(e.pos, true);
		angle = e.angle; pitch = e.pitch; roll = e.roll;
		scale = e.scale;
		bInvisible = e.bInvisible || e.alpha >= 0.95;     // once the camo is down the Elite draws its own sword
	}
}

class HCE_ShieldShell : Actor
{
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+DECOUPLEDANIMATIONS
		+NOTONAUTOMAP
		+INVISIBLE
		RenderStyle "Add";
		Alpha 0;
	}

	States
	{
	Spawn:
		HCEM A -1 Bright;
		Stop;
	}

	override void Tick()
	{
		if(!master || master.health <= 0) { Destroy(); return; }
		if(isFrozen()) return;
		SetOrigin(master.pos, true);
		angle = master.angle; pitch = master.pitch; roll = master.roll;
		scale = master.scale;
		bInvisible = master.bInvisible || alpha <= 0.01;
		if(alpha > 0) alpha = max(0, alpha - 0.045);
	}
}
