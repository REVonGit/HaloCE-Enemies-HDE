// ============================================================================
// hce_core.zsc -- shared Halo CE enemy code that needs ZScript 4.15 (bone queries), so it
// lives in the core pack instead of the enemy API (which also compiles inside HDE's 4.10 unit).
// ============================================================================

// ---------------------------------------------------------------------------
// Jackal energy shield as its own entity. The shield you see is part of the Jackal's model
// (skinned to the shield node of its arm, HCE_ShieldBone()); this invisible, shootable cylinder rides
// that node every tic, so it sits wherever the arm holds the shield, and it soaks up what hits it:
//   bullets, pellets, spikes   nothing (they spark off it)
//   needles / fire             a little
//   explosions                 full damage
//   melee                      2.5x, and the Jackal staggers
//   plasma                     4x (an overcharged plasma bolt 10x)
// Hits that miss the shield hit the Jackal itself; so do shots from its side or back that clip the shield's
// hitbox, and a shot whose line passes the gun hand poking out past the shield makes the Jackal reel (hard ping). Drained, it
// breaks for good: the field bursts into shards, the Jackal reels (hard ping) and often panics, and it fights on without it
// (the body keeps the broken gauntlet bare).
// ---------------------------------------------------------------------------
class HCE_JackalShield : Actor
{
	double hp, maxhp;
	int regenWait, bone, handBone;
	bool down, skinHidden, broken;

	Default
	{
		+SHOOTABLE
		+NOGRAVITY
		+NOBLOOD
		+DONTTHRUST
		+NOTAUTOAIMED
		+NOTONAUTOMAP
		+DONTSPLASH
		+NODAMAGETHRUST
		+NOTARGET
		+NEVERTARGET
		+DONTBLAST
		-SOLID
		-COUNTKILL
		Health 1000000;
		Radius 10;
		Height 34;
		Mass 100000;
		Tag "Jackal shield";
	}

	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}

	// bone -2 marks "not set up yet": the first Tick() sizes the shield, reads hce_frontShieldMax and finds the bones,
	// because the Jackal (master) is only assigned after Spawn() returns
	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		bone = -2; handBone = -1;      // master is set right after the spawn: set up on the first tic
	}

	// how much of a hit the shield takes, as a multiplier on the damage (the table in the banner above): by damage
	// type, then by the inflictor's class name ("charged"+"plasma", "plasma", "needle"). 0 means it glances off.
	// To make a weapon drain the shield more or less, add or change a line here (first match wins).
	static double HitMul(Actor inflictor, Name mod, int flags)
	{
		String cn = inflictor ? String.Format("%s", inflictor.GetClassName()) : "";
		cn = cn.MakeLower();
		if(mod == 'Melee' || mod == 'Kick' || mod == 'Sword' || mod == 'Punch' || mod == 'Fist' || mod == 'Chainsaw') return 2.5;
		if(cn.IndexOf("charged") >= 0 && cn.IndexOf("plasma") >= 0) return 10.0;
		if(mod == 'Plasma' || mod == 'PlasmaExplosion' || cn.IndexOf("plasma") >= 0) return 4.0;
		if((flags & DMG_EXPLOSION) || mod == 'Explosive' || mod == 'Explosion' || mod == 'Grenade' || mod == 'Rocket') return 1.0;
		if(cn.IndexOf("needle") >= 0) return 0.3;
		if(mod == 'Fire' || mod == 'Burn') return 0.5;
		return 0;                                               // bullets, pellets, spikes
	}

	// what the shield blocks: everything except the Jackal itself and missiles fired by it or by its own team
	override bool CanCollideWith(Actor other, bool passive)
	{
		// the Jackal's own shots and its squad's pass through
		if(other == master) return false;
		let j = HaloDoom_EnemyBase(master);
		if(j && other.bMISSILE && other.target && (other.target == master || HaloDoom_EnemyBase.HCE_TeamOf(other.target) == j.hce_team))
			return false;
		return Super.CanCollideWith(other, passive);
	}

	// a hit on the shield cylinder. Friendly fire is ignored; a non-blast hit from behind the Jackal (over 80 degrees
	// off its facing) or along the gun hand is handed to the Jackal (PassOn); the rest drains hp by HitMul() and
	// flashes the face (HCE_ShieldImpact), staggers the Jackal on a melee hit and pops the shield at 0. Always returns
	// 0: the shield actor itself never loses health. regenWait (tics) is how long recharge is held off after a hit.
	override int DamageMobj(Actor inflictor, Actor source, int damage, Name mod, int flags, double angle)
	{
		let j = HaloDoom_EnemyBase(master);
		if(!j || j.health <= 0 || down || damage <= 0) return 0;
		if(source == j) return 0;
		if(source && !source.player && HaloDoom_EnemyBase.HCE_TeamOf(source) == j.hce_team) return 0;
		bool blast = (flags & DMG_EXPLOSION) != 0;          // a blast reaches the Jackal on its own: no hand-over
		// the shield only covers what it faces: a shot from the Jackal's side or back that happens to clip the
		// shield's hitbox (held out to the side) goes on into the Jackal
		Actor from = source ? source : inflictor;
		if(!blast && from && abs(DeltaAngle(j.angle, j.AngleTo(from))) > 80)
			return PassOn(j, inflictor, source, damage, mod, flags, false);
		// the gun hand poking out past the shield: the hit goes into the Jackal and it reels (hard ping)
		if(!blast && HandHit(j, inflictor, source))
			return PassOn(j, inflictor, source, damage, mod, flags, true);
		double m = HitMul(inflictor, mod, flags);
		vector3 at = inflictor && inflictor != source ? inflictor.pos : pos + (0, 0, height * 0.5);
		if(m <= 0)
		{
			// glances off: a small flash at the shield face
			HCE_ShieldImpact.Burst(self, inflictor, source, ShieldColor(j), 0.4, at, true);
			HCE_ShieldField.FlashOn(j, 0.25);
			A_StartSound("HCE/JShield/Hit", CHAN_AUTO, CHANF_OVERLAP, 0.6);    // Halo CE's shield impact
			regenWait = max(regenWait, 35);
			return 0;
		}
		hp -= damage * m;
		regenWait = 35 * 4;
		HCE_ShieldImpact.Burst(self, inflictor, source, hp < maxhp * 0.25 ? Color(255, 255, 80, 64) : ShieldColor(j), clamp(damage * m / 20.0, 0.5, 2.0), at, true);
		HCE_ShieldField.FlashOn(j, 0.4 + damage * m / max(1.0, maxhp) * 3.0);      // Halo's 'shield hit flash'
		A_StartSound("HCE/JShield/Hit", CHAN_AUTO, CHANF_OVERLAP);         // Halo CE's shield impact
		if(mod == 'Melee' && hp > 0 && j.hce_animLock <= 0)
		{
			int k = j.HCE_DirKind(HCE_A_PING_F, HCE_A_PING_B, HCE_A_PING_L, HCE_A_PING_R);
			if(j.HCE_HasAnim(k)) j.HCE_PlayLocked(k, 0.6);
		}
		if(hp <= 0) BreakShield(j);
		return 0;
	}

	// gives a hit that missed the shield to the Jackal in full. With hand set (the gun hand was hit) the Jackal also
	// drops whatever it was doing and plays a hard ping, unless it is mid-leap, mid-jump or already in one
	int PassOn(HaloDoom_EnemyBase j, Actor inflictor, Actor source, int damage, Name mod, int flags, bool hand)
	{
		j.DamageMobj(inflictor, source, damage, mod, flags);
		if(hand && j.health > 0 && j.hce_leapState == 0 && j.hce_jumpState == 0 && j.hce_lockPing != 2)
		{
			int k = j.HCE_DirKind(HCE_A_HPING_F, HCE_A_HPING_B, HCE_A_HPING_F, HCE_A_HPING_F);
			if(!j.HCE_HasAnim(k)) k = HCE_A_HPING_F;
			if(j.HCE_HasAnim(k))
			{
				j.HCE_StopFireLoop(); j.hce_shotsLeft = 0; j.hce_chargeTics = 0; j.hce_pendingMelee = 0; j.hce_diveTics = 0;
				j.HCE_PlayLocked(k, 0.85);
				j.hce_lockPing = 2;
			}
		}
		return 0;
	}

	// did the shot's line pass the gun hand (HCE_GunHandBone)? Hitscans: from the shooter's eye through the puff;
	// projectiles: along their flight path to where they struck
	bool HandHit(HaloDoom_EnemyBase j, Actor inflictor, Actor source)
	{
		if(handBone < 0 || !inflictor) return false;
		vector3 hand, f, u;
		[hand, f, u] = j.GetBonePosition(handBone);
		if(hand == (0, 0, 0)) return false;
		vector3 o, d;
		if(inflictor != source && inflictor.bMISSILE && inflictor.vel.Length() > 0.1)
		{
			d = inflictor.vel.Unit();
			o = inflictor.pos - d * 64;
		}
		else
		{
			if(!source || inflictor == source) return false;
			// where a hitscan leaves the shooter (Doom: half its height plus the attack offset)
			double oz = source.height * 0.5 + 8;
			let pp = PlayerPawn(source);
			if(pp && source.player) oz = source.height * 0.5 + pp.AttackZOffset * source.player.crouchfactor;
			o = source.pos + (0, 0, oz);
			vector3 to = level.Vec3Diff(o, inflictor.pos);
			if(to.Length() < 1) return false;
			d = to.Unit();
		}
		vector3 rel = level.Vec3Diff(o, hand);
		double along = rel dot d;
		if(along < 0) return false;
		double miss = (rel - d * along).Length();
		return miss < 6 + (inflictor.bMISSILE ? inflictor.radius : 0);
	}

	// the gauntlet's energy colour by rank (matches the baked shield skins)
	static color ShieldColor(Actor j)
	{
		String n = "";
		if(j) n = j.GetClassName();
		if(n.IndexOf("Zealot") >= 0) return Color(255, 255, 214, 80);
		if(n.IndexOf("Ultra") >= 0) return Color(255, 255, 140, 30);
		if(n.IndexOf("Major") >= 0) return Color(255, 255, 80, 215);
		return Color(255, 80, 120, 255);
	}

	// the shield is drained: it stops being shootable for good (broken), pops with sound, flash and shards, is hidden on
	// the model, and the Jackal reels and may panic (60%, if its class panics at all)
	void BreakShield(HaloDoom_EnemyBase j)
	{
		down = true; broken = true;
		hp = 0;
		bSHOOTABLE = false;
		A_StartSound("HCE/Jackal/ShieldPop", CHAN_AUTO, CHANF_OVERLAP);     // Halo 2's Jackal shield popping
		A_StartSound("HCE/JShield/Deplete", CHAN_AUTO, CHANF_OVERLAP);     // Halo CE's Jackal shield depletion
		// it shatters: a flash, then shards of the field tumbling down in the shield's colour
		color sc = ShieldColor(j);
		HCE_ShieldImpact.Burst(self, null, null, sc, 2.0, pos + (0, 0, height * 0.5), true);
		for(int i = 0; i < 40; i++)            // relative to the shield's facing: out in front and to the sides
			A_SpawnParticle(sc, SPF_FULLBRIGHT | SPF_RELATIVE, random(18, 34), frandom(2, 7), 0,
				frandom(-4, 4), frandom(-height * 0.4, height * 0.4), height * 0.5 + frandom(-height * 0.4, height * 0.4),
				frandom(0.5, 3), frandom(-2.5, 2.5), frandom(-1, 4), 0, 0, -0.35, frandom(0.8, 1.0), -1, -0.1);
		for(int i = 0; i < 16; i++)
			A_SpawnParticle("FFFFFF", SPF_FULLBRIGHT, 8, frandom(2, 4), 0, 0, 0, height * 0.5, frandom(-6, 6), frandom(-6, 6), frandom(-3, 5));
		SetShieldVisible(j, false);
		if(j.health > 0 && j.bHCE_Panics && frandom(0, 1) < 0.6) j.HCE_StartPanic();     // naked behind a broken gauntlet
		// the Jackal reels from it
		if(j.health > 0 && j.hce_leapState == 0 && j.hce_jumpState == 0)
		{
			int k = j.HCE_DirKind(HCE_A_HPING_F, HCE_A_HPING_B, HCE_A_HPING_F, HCE_A_HPING_F);
			if(!j.HCE_HasAnim(k)) k = HCE_A_HPING_F;
			if(j.HCE_HasAnim(k)) { j.HCE_StopFireLoop(); j.HCE_PlayLocked(k, 0.9); j.hce_lockPing = 2; }
			j.HCE_Say('PainHeavy', 0.8, 35, true);
		}
	}

	// the shield surface on the Jackal's model: hidden while it's down
	void SetShieldVisible(Actor j, bool on)
	{
		if(skinHidden == !on) return;
		skinHidden = !on;
		let e = HaloDoom_EnemyBase(j);
		if(!e || !e.bHCE_FrontShield) return;
		if(e.hce_shellActor is 'HCE_ShieldField') { e.hce_shellActor.bInvisible = !on; return; }   // drawn by its field
		int SURF = e.HCE_ShieldSurface();                   // the model surface the shield's energy field is drawn on
		if(on) e.HCE_ShowSurface(SURF);
		else e.HCE_HideSurface(SURF);     // the Jackal's own: its MODELDEF leaves the shield to it, so a downed one isn't drawn
	}

	// every tic: first-time setup (size, hp, bones), then follow the shield bone (or a point in front of the Jackal
	// when the bone is missing), then recharge once regenWait has run out: maxhp/70 per tic, back up and shootable at
	// half. A broken shield never recharges. Publishes the hp to the Jackal as hce_frontShieldHP.
	override void Tick()
	{
		let j = HaloDoom_EnemyBase(master);
		if(!j || j.health <= 0) { if(j) SetShieldVisible(j, false); Destroy(); return; }   // the field dies with its Jackal
		if(isFrozen()) return;
		// ride the arm's 'frame shield' node (the model's bone positions are on for the Jackal)
		if(bone == -2)
		{
			maxhp = hp = max(1, j.hce_frontShieldMax);
			A_SetSize(max(8, j.radius * 0.9), j.height * 0.7);
			j.SetModelFlag(0, IQM_GET_BONE_INFO);
			bone = j.GetBoneIndex(j.HCE_ShieldBone());          // CE 'frame shield'; Halo 2 'shield'
			handBone = j.GetBoneIndex(j.HCE_GunHandBone());    // CE 'bip01 r hand'; Halo 2 'l_hand'
		}
		vector3 p = j.pos + (AngleToVector(j.angle, j.radius + 4), j.height * 0.5);
		if(bone >= 0)
		{
			vector3 bp, f, u;
			[bp, f, u] = j.GetBonePosition(bone);
			if(bp != (0, 0, 0)) p = bp;
		}
		SetOrigin(p - (0, 0, height * 0.5), true);
		angle = j.angle;
		// recharge out of harm
		if(regenWait > 0) regenWait--;
		else if(hp < maxhp && !broken)
		{
			hp = min(maxhp, hp + maxhp / 70.0);
			if(down && hp >= maxhp * 0.5)
			{
				down = false;
				bSHOOTABLE = true;
				SetShieldVisible(j, true);          // (silently: only the player's own shield is heard recharging)
			}
		}
		j.hce_frontShieldHP = down ? 0 : hp;
	}
}

// ---------------------------------------------------------------------------
// Energy-shield flare: a copy of the wearer's model, a touch larger and skinned with a bright noise
// texture, drawn additively over it. Invisible until the shield is hit; then it flares (brighter when the
// shield pops, softer while it recharges) and fades in a fraction of a second. The enemy API sets the alpha;
// the shell follows its wearer and mirrors its animation (the generated code drives both).
// ---------------------------------------------------------------------------
// the energy sword's blade on a cloaked Elite: the Elite's own model with only the blade drawn, glowing at full
// strength while the body is all but invisible (build_pack.py gives each such class a <class>Blade model)
class HCE_BladeShell : Actor
{
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+DECOUPLEDANIMATIONS
		+NOTONAUTOMAP
		RenderStyle "Add";
		Alpha 1.0;
	}

	States
	{
	Spawn:
		HCEM A -1 Bright;
		Stop;
	}

	// follows the Elite (position, angles, scale) and hides itself once the Elite is visible enough to draw its own sword
	override void Tick()
	{
		let e = HaloDoom_EnemyBase(master);
		if(!e || e.health <= 0) { Destroy(); return; }
		if(isFrozen()) return;
		SetOrigin(e.pos, true);
		angle = e.angle; pitch = e.pitch; roll = e.roll;
		scale = e.scale;
		bInvisible = e.bInvisible || e.alpha >= 0.95;     // once the camo is down the Elite draws its own sword
	}
}

// A Jackal's energy shield (and the Sentinel Enforcer's two): the wearer's model with only the shield drawn, additively,
// in Halo CE's Jackal shield shader (shaders/hce_jshield.fp), so it is the see-through glowing field it is in the game.
// It is the wearer's hce_shellActor (the enemy API places it with the body every tic and plays its animations), or for
// a body whose shell is its flare (the Ultra Zealot's arm shield) its hce_holoActor, placing itself; its
// alpha carries Halo's 'shield hit flash' to the shader: 1 - 0.1 x flash, set by FlashOn() on a hit, dying away.
// Hidden (bInvisible) while the shield is down.
class HCE_ShieldField : Actor
{
	double flash;

	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+DECOUPLEDANIMATIONS
		+NOTONAUTOMAP
		RenderStyle "Add";
		Alpha 1.0;
	}

	States
	{
	Spawn:
		HCEM A -1 Bright;
		Stop;
	}

	// a hit on wearer w's shield: its field flashes (f: 0..1, the bigger hit wins)
	static void FlashOn(Actor w, double f)
	{
		let e = HaloDoom_EnemyBase(w);
		let fld = e ? HCE_ShieldField(e.hce_shellActor) : null;
		if(fld) fld.flash = clamp(max(fld.flash, f), 0.0, 1.0);
	}

	bool hce_joined;
	override void Tick()
	{
		if(!master || master.health <= 0) { Destroy(); return; }     // the field dies with its wearer (no thinker left on the corpse)
		if(isFrozen()) return;
		let e = HaloDoom_EnemyBase(master);
		if(e && e.hce_holoActor == self)
		{
			// a hologram companion (a body whose shell slot is its flare: the Ultra Zealot) places itself with it
			SetOrigin(e.pos, true);
			angle = e.angle; pitch = e.pitch; roll = e.roll;
		}
		if(!hce_joined && e && e.hce_curAnim != 'None')
		{
			// the wearer's animation where it is now (as HCE_ShieldShell does: its own first one may come before it)
			hce_joined = true;
			int len = max(1, int(e.HCE_AnimTics(e.hce_curAnim) * 30.0 / 35.0));
			int f = int((level.maptime - e.hce_animStartTic) * 30.0 / 35.0);
			SetAnimation(e.hce_curAnim, -1, e.hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, e.hce_curLoop ? SAF_LOOP : 0);
		}
		flash = max(0.0, flash - 1.0 / 18.0);            // gone in half a second
		alpha = 1.0 - 0.1 * flash;
	}
}

class HCE_ShieldShell : Actor
{
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+DECOUPLEDANIMATIONS
		+NOTONAUTOMAP
		+INVISIBLE
		RenderStyle "Add";
		Alpha 0;
	}

	States
	{
	Spawn:
		HCEM A -1 Bright;
		Stop;
	}

	bool hce_dressed;
	// on the first tic with a dressed wearer, copies its look and joins its animation in progress; then follows the
	// wearer and fades its alpha by 0.045 a tic (the enemy API raises the alpha when the shield is hit)
	override void Tick()
	{
		if(!master || master.health <= 0) { Destroy(); return; }
		if(isFrozen()) return;
		let e = HaloDoom_EnemyBase(master);
		if(!hce_dressed && e)
		{
			// once the enemy has dressed itself (its permutation, armour pieces): the same look, and its animation
			// where it is now (the flare's own first animation can come before its model is set up)
			hce_dressed = true;
			e.HCE_DressShell(self); e.HCE_DressShellVariant(self);
			if(e.hce_curAnim != 'None')
			{
				int len = max(1, int(e.HCE_AnimTics(e.hce_curAnim) * 30.0 / 35.0));
				int f = int((level.maptime - e.hce_animStartTic) * 30.0 / 35.0);
				SetAnimation(e.hce_curAnim, -1, e.hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, e.hce_curLoop ? SAF_LOOP : 0);
			}
		}
		SetOrigin(master.pos, true);
		angle = master.angle; pitch = master.pitch; roll = master.roll;
		scale = master.scale;
		bInvisible = master.bInvisible || alpha <= 0.01;
		if(alpha > 0) alpha = max(0, alpha - 0.045);
	}
}

// A shield that gives out shatters like glass (HCE_Shield.OnShieldBreak spawns this at the enemy): pale glass shards
// (graphics/HCESHARD, split_factions.py draws it) burst off the shield's surface, tumbling and falling, with sparks in
// the shield's own colour and a flash
class HCE_ShieldShatter : Actor
{
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		RenderStyle "None";
	}
	// a one-shot: spawns 22-60 shards (scaled to the wearer's radius) plus sparks and a flash at the wearer, then
	// destroys itself. To change the look, edit the particle calls here; the shard sprite is HCESHARD.
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		let e = HaloDoom_EnemyBase(master);
		Actor o = master ? master : Actor(self);
		color c = e ? e.HCE_ShieldColor() : Color(255, 127, 178, 255);
		TextureID shard = TexMan.CheckForTexture("HCESHARD", TexMan.Type_Any);
		double r = max(12, o.radius * 1.15), h = max(16, o.height);
		int n = clamp(int(r * 1.2), 22, 60);
		for(int i = 0; i < n; i++)
		{
			// a point on the shield's surface (an ellipsoid round the body) and outward from there
			double a = frandom(0, 360), el = frandom(-60, 75);
			vector3 dir = (cos(a) * cos(el), sin(a) * cos(el), sin(el));
			vector3 at = (dir.x * r, dir.y * r, h * 0.55 + dir.z * h * 0.55);
			double sp = frandom(2.5, 6.5);
			if(shard.IsValid())
				o.A_SpawnParticleEx("FFFFFF", shard, STYLE_Add, SPF_FULLBRIGHT | SPF_ROLL, random(28, 46), frandom(4, 11), 0,
					at.x, at.y, at.z, dir.x * sp, dir.y * sp, dir.z * sp + frandom(0.5, 2.5), 0, 0, -0.32,
					frandom(0.75, 1.0), -1, frandom(-0.05, 0.02), frandom(0, 360), frandom(-24, 24), 0);
			if(i % 2 == 0)
				o.A_SpawnParticle(c, SPF_FULLBRIGHT, random(10, 18), frandom(2, 4), 0, at.x, at.y, at.z,
					dir.x * sp * 1.3, dir.y * sp * 1.3, dir.z * sp + 1, 0, 0, -0.2);
		}
		o.A_SpawnParticle(c, SPF_FULLBRIGHT, 6, r * 2.2, 0, 0, 0, h * 0.55, 0, 0, 0, 0, 0, 0, 0.6, -1, r * 0.4);   // the flash
		Destroy();
	}
}

// ---------------------------------------------------------------------------
// The Halo enemies' blood (their BloodType). Without Nash's Gore Mod it is Doom's own Blood. NashGore swaps Doom's
// blood for its own sprays, splats and pools; with it loaded, the Halo gore patch (Covenant pack, hce_halogore on)
// draws Halo's blood instead, so this one goes away. With the patch turned off, it hands over to NashGore's blood as
// NashGore would have it (nashgore_bloodtype).
// ---------------------------------------------------------------------------
class HCE_HaloBlood : Blood
{
	bool hce_checked;
	// decided once, on the first tic: with NashGore absent, behave as plain Blood; with it present and hce_halogore on,
	// become a Halo gore puff (human or Covenant by the shedder's class name, tinted its BloodColor) and go away;
	// with the patch off, become whichever NashGore blood nashgore_bloodtype asks for (0 NashGore, 1 Classic, 2 Doom's)
	override void Tick()
	{
		if(!hce_checked)
		{
			hce_checked = true;
			String nash = "NashGoreBlood";
			class<Actor> nb = nash;
			if(nb)
			{
				CVar hg = CVar.FindCVar("hce_halogore");
				if(hg && hg.GetBool())
				{
					// the gore patch draws the hits; blood the enemy sheds itself (a stump, a corpse, a gib) becomes
					// a puff of Halo's blood burst in its blood colour (hce_gore.zsc)
					if(target)
					{
						String pn = target.GetClassName();
						pn = pn.IndexOf("Marine") >= 0 || pn.IndexOf("Johnson") >= 0 ? "HCE_GorePuffHuman" : "HCE_GorePuffCov";
						class<Actor> pc = pn;
						let p = pc ? Spawn(pc, pos, NO_REPLACE) : null;
						if(p)
						{
							color c = target.BloodColor;
							p.SetShade(c != 0 ? c : Color(255, 120, 0, 0));
							p.frame = random[HCEGore](0, 11);
							p.scale *= frandom[HCEGore](0.5, 0.9);
							p.vel = vel * 0.4;
						}
					}
					Destroy(); return;
				}
				CVar bt = CVar.FindCVar("nashgore_bloodtype");
				int k = bt ? bt.GetInt() : 0;
				if(k != 2)                                   // 2: NashGore set to Doom's blood
				{
					String cn = k == 1 ? "NashGoreClassicBlood" : "NashGoreBlood";
					class<Actor> c = cn;
					let b = c ? Spawn(c, pos, NO_REPLACE) : null;
					if(b) { b.vel = vel; b.angle = angle; b.Translation = Translation; b.target = target; }
					Destroy(); return;
				}
			}
		}
		Super.Tick();
	}
}

// ---------------------------------------------------------------------------
// A friendly Marine's dot on HaloDoom Evolved's motion tracker. The tracker draws a monster only while it has a
// target (yellow if friendly, red if not), so a Marine with nothing to shoot at, following or holding, was missing
// from it. This rides on him and stands in for him then: a monster with a target (him), friendly, a speck at his feet, that
// nothing can hit (NONSHOOTABLE), target or collide with, and that never counts as a kill. While he has a target of
// his own he shows by himself, and the stand-in steps aside.
// ---------------------------------------------------------------------------
class HCE_RadarBlip : Actor
{
	Default
	{
		+SHOOTABLE
		+NONSHOOTABLE
		+ISMONSTER
		+FRIENDLY
		-SOLID
		-COUNTKILL
		+NOGRAVITY
		+NOCLIP
		+NOTARGET
		+NEVERTARGET
		+NOTAUTOAIMED
		+NOBLOOD
		+DONTTHRUST
		+NOTONAUTOMAP
		+INVULNERABLE
		+NODAMAGE
		+DONTSPLASH
		+NOTELEPORT
		+DONTBLAST
		+THRUACTORS
		Health 1000;
		Radius 1;           // a speck at his feet: line traces (aim, use, the crosshair name) find him, not it
		Height 1;
	}
	States
	{
	Spawn:
		TNT1 A -1;
		Stop;
	}
	// sits on the Marine and targets him only while he has no target of his own; gone when he dies or turns hostile
	override void Tick()
	{
		if(!master || master.health <= 0 || !master.bFRIENDLY || master.bCORPSE) { Destroy(); return; }
		if(pos != master.pos) SetOrigin(master.pos, true);
		target = master.target ? null : master;      // shown only while he isn't
	}
}
