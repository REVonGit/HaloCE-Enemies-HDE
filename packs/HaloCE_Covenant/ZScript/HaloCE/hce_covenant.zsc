	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'stand missle idle': return (26.9, 3.0, 22.6);
		case 'stand missle low-idle': return (27.8, 14.9, -7.5);
		case 'stand missle low-move': return (33.0, 10.4, -2.0);
		case 'stand missle move-back': return (27.1, 7.9, 19.6);
		case 'stand missle move-front': return (24.6, 6.5, 19.4);
		case 'stand missle move-left': return (26.8, 3.7, 20.6);
		case 'stand missle move-right': return (26.6, -2.0, 23.5);
		}
		return hce_gunOffset;
	}
}

