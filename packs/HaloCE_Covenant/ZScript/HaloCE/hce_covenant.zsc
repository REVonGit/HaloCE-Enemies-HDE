		switch(anim)
		{
		case 'alert pistol idle': return (18.4, 1.7, 2.5);
		case 'crouch pistol idle': return (36.6, 13.5, -6.2);
		case 'crouch pistol move-front': return (35.5, 7.9, -2.5);
		case 'stand pistol cover-left-open': return (8.8, 10.2, -13.8);
		case 'stand pistol cover-right-open': return (9.3, -6.0, -3.9);
		case 'stand pistol move-back': return (33.1, 5.7, 14.7);
		case 'stand pistol move-front': return (39.5, 7.9, 7.1);
		case 'stand pistol move-left': return (33.2, 1.5, 17.4);
		case 'stand pistol move-right': return (34.7, 8.5, 11.1);
		}
		return hce_gunOffset;
	}
}

class HCE_EliteSpecialBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 68;
		Radius 16;
		Mass 177;
		PainChance 0;
		Tag "EliteSpecial";
		BloodColor "3A 1E 8C";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Name HCE_ShellClass() { return 'HCE_EliteSpecialShieldShell'; }
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 17, "models/hce/EliteSpecial", 'gore_EliteSpecial.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.1717, 0.0002, 0.6404), 80.00, "models/hce/EliteSpecial", 'EliteSpecial_gib_head.iqm', 17, 'gore_EliteSpecial.png', 0.0870);
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 15, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 18, "models/hce/EliteSpecial", 'gore_EliteSpecial.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (0.0055, 0.1488, 0.3826), 80.00, "models/hce/EliteSpecial", 'EliteSpecial_gib_larm.iqm', 18, 'gore_EliteSpecial.png', 0.0429);
			HCE_OnSever(1, false);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 6, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 19, "models/hce/EliteSpecial", 'gore_EliteSpecial.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (0.0055, -0.1492, 0.3826), 80.00, "models/hce/EliteSpecial", 'EliteSpecial_gib_rarm.iqm', 19, 'gore_EliteSpecial.png', 0.0429);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (13.7, 0.0, 61.5);
		case 1: return (0.4, 11.9, 36.7);
		case 2: return (0.4, -11.9, 36.7);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/EliteSpecial", 'EliteSpecial_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/EliteSpecial", 'EliteSpecial_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/EliteSpecial", 'EliteSpecial_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 15, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		Name sk = show ? 'None' : 'hce_hidden.png';
		static const int W[] = { 6, 7, 8, 9, 10, 11 };
		for(int i = 0; i < W.Size(); i++) A_ChangeModel('None', 0, "", 'None', W[i], "models/hce/weapons", sk, CMDL_USESURFACESKIN);
		if(!show && hce_hasLoadout) A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);   // a picked-up overlay gun
	}
	// guns it can pick up off the ground (HaloDoom_EnemyBase.HCE_ScavengeScan): Halo_BeamRifle, Halo_Needler, Halo_PlasmaRifle
	override bool HCE_HasLoadouts() { return true; }
	override int HCE_LoadoutIndex(Name w)
	{
		switch(w)
		{
		case 'Halo_BeamRifle': return 0;
		case 'Halo_Needler': return 1;
		case 'Halo_PlasmaRifle': return 2;
		}
		return -1;
	}
