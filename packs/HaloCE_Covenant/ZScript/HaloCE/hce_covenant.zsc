		case HCE_A_FIRE: return 'crouch unarmed fr fire-1 baked';
		case HCE_A_MELEE: return 'stand unarmed melee';
		case HCE_A_DIVE_L: return 'stand unarmed dive-left';
		case HCE_A_DIVE_R: return 'stand unarmed dive-right';
		case HCE_A_DIVE_F: return 'stand unarmed dive-front';
		case HCE_A_AIRBORNE: return 'stand unarmed airborne';
		case HCE_A_LAND: return 'stand unarmed land-soft';
		case HCE_A_LEAP_AIR: return 'stand unarmed airborne';
		case HCE_A_LEAP_MELEE: return 'stand unarmed melee';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front chest%0 baked', 's-ping front chest%1 baked', 's-ping front gut baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: return 's-ping left gut baked';
		case HCE_A_PING_R: return 's-ping right gut baked';
		case HCE_A_DIE_F: return 's-kill front gut';
