	// Halo 2 over the CE Elite (extract_h2_elite_kit.py): ranger_body, elite_jetpack; the CE body hidden under it
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		static const int BS[] = { 0, 1, 2, 3, 4, 5, 12, 13, 14, 15 };
		for(int i = 0; i < BS.Size(); i++) A_ChangeModel('None', 0, "", 'None', BS[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "models/hce/EliteKit", "ranger_body.iqm", 1, "", 'None');
		A_ChangeModel('None', 2, "models/hce/EliteKit", "elite_jetpack.iqm", 2, "", 'None');
		A_ChangeModel('None', 1, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		hce_jetNozzle = (-0.1561, 0.0816, 0.67944) * 80.0;
		hce_jetDir = (-0.807, 0.174, -0.565);
		HCE_ResumeAnim();        // A_ChangeModel resets the animation the spawn started (idle, sleeping)
	}
	override void HCE_OnSever(int limb, bool gunArm)
	{
		super.HCE_OnSever(limb, gunArm);
		if(limb == HCE_LIMB_LARM)
		{
			A_ChangeModel('None', 1, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 12, "models/hce/EliteKit", 'ek_gore_arm.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 17, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		}
		if(limb == HCE_LIMB_RARM)
		{
			A_ChangeModel('None', 1, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 13, "models/hce/EliteKit", 'ek_gore_arm.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 18, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		}
		if(limb == HCE_LIMB_HEAD)
		{
			A_ChangeModel('None', 1, "", 'None', 6, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 1, "", 'None', 14, "models/hce/EliteKit", 'gore_Elite.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		}
	}
	override void HCE_GibOverride(int limb, out String path, out Name model, out int stub, out Name tex)
	{
		switch(limb)
		{
		case HCE_LIMB_HEAD: path = "models/hce/EliteKit"; model = 'ranger_body_gib_head.iqm'; stub = 27; tex = 'gore_Elite.png'; break;
		case HCE_LIMB_LARM: path = "models/hce/EliteKit"; model = 'ranger_body_gib_larm.iqm'; stub = 25; tex = 'gore_Elite.png'; break;
		case HCE_LIMB_RARM: path = "models/hce/EliteKit"; model = 'ranger_body_gib_rarm.iqm'; stub = 25; tex = 'gore_Elite.png'; break;
		}
	}
	override Name HCE_ShellClass() { return 'HCE_EliteRangerBodyShieldShell'; }
	override void HCE_BloodHideClass()
	{
		super.HCE_BloodHideClass();
		static const int BS[] = { 0, 1, 2, 3, 4, 5, 12, 13, 14, 15 };
		for(int i = 0; i < BS.Size(); i++) A_ChangeModel('None', 7, "", 'None', BS[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'alert pistol idle': return (18.6, 1.6, 3.2);
		case 'crouch pistol idle': return (36.5, 13.5, -5.5);
		case 'crouch pistol move-front': return (35.4, 7.9, -1.8);
		case 'stand pistol cover-left-open': return (8.8, 10.2, -13.1);
		case 'stand pistol cover-right-open': return (9.3, -6.1, -3.1);
		case 'stand pistol move-back': return (33.1, 5.7, 15.5);
		case 'stand pistol move-front': return (39.5, 7.8, 7.8);
		case 'stand pistol move-left': return (33.2, 1.4, 18.1);
		case 'stand pistol move-right': return (34.6, 8.4, 11.8);
		}
		return hce_gunOffset;
	}
}

