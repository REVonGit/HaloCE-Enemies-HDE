	override void PostBeginPlay()
	{
		hce_bladeActor = Spawn("HCE_StealthEliteMajorEnergySwordBlade", pos, NO_REPLACE);
		if(hce_bladeActor) hce_bladeActor.master = self;
		super.PostBeginPlay();
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		super.HCE_ApplyAnim(n, blend, loop);
		if(hce_bladeActor) hce_bladeActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
	}
	override void HCE_OnSever(int limb, bool gunArm)
	{
		if(gunArm && hce_bladeActor) { hce_bladeActor.Destroy(); hce_bladeActor = null; }
	}
