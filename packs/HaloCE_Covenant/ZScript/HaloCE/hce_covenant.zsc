	}
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand pistol idle';
		case HCE_A_ALERT: return 'stand pistol idle';
		case HCE_A_MOVE_F: return 'stand pistol move-front';
		case HCE_A_MOVE_B: return 'stand pistol move-back';
		case HCE_A_MOVE_L: return 'stand pistol move-left';
		case HCE_A_MOVE_R: return 'stand pistol move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch pistol idle';
		case HCE_A_CROUCH_MOVE: return 'crouch pistol move-front';
		case HCE_A_FLEE: return 'flee pistol move-front';
		case HCE_A_FIRE: return 'stand pistol pr fire-1 baked';
		case HCE_A_DIVE_L: return 'stand pistol dive-left';
		case HCE_A_DIVE_R: return 'stand pistol dive-right';
		case HCE_A_DIVE_F: return 'stand pistol dive-front';
		case HCE_A_EVADE_L: return 'stand pistol evade-left';
		case HCE_A_EVADE_R: return 'stand pistol evade-right';
		case HCE_A_SURPRISE_F: return 'stand pistol surprise-front';
		case HCE_A_SURPRISE_B: return 'stand pistol surprise-back';
		case HCE_A_WARN: return 'stand pistol warn';
		case HCE_A_SIGNAL: return 'stand pistol signal-attack';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LAND: return 'stand pistol land-hard';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front r-hand%0 baked', 's-ping front r-hand%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-foot' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back gut', 'h-ping back l-arm', 'h-ping back r-arm' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_CELEBRATE: return 'stand pistol celebrate';
		case HCE_A_TURN_L: return 'stand pistol turn-left';
		case HCE_A_TURN_R: return 'stand pistol turn-right';
		case HCE_A_FLAME_IDLE: return 'flaming pistol idle';
		case HCE_A_FLAME_MOVE: return 'flaming pistol move-front';
		case HCE_A_RELOAD: return 'stand pistol reload-1';
		case HCE_A_VENT: return 'stand pistol overheat';
		case HCE_A_LOW_IDLE: return 'alert pistol idle';
		case HCE_A_LOW_MOVE: return 'alert pistol move-front';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert pistol idle': return 70;
		case 'alert pistol move-front': return 30;
		case 'crouch pistol idle': return 54;
		case 'crouch pistol move-front': return 42;
		case 'flaming pistol idle': return 70;
		case 'flaming pistol move-front': return 16;
		case 'flee pistol move-front': return 21;
		case 'h-kill back gut': return 49;
		case 'h-kill front gut': return 52;
		case 'h-ping back gut': return 38;
		case 'h-ping back l-arm': return 32;
		case 'h-ping back r-arm': return 33;
		case 'h-ping front chest': return 41;
		case 'h-ping front gut': return 28;
		case 'h-ping front l-arm': return 43;
		case 'h-ping front l-foot': return 55;
		case 's-kill back gut': return 71;
		case 's-kill front gut': return 79;
		case 's-kill left gut': return 46;
		case 's-kill right gut': return 52;
		case 's-ping front r-hand%0 baked': return 10;
		case 's-ping front r-hand%1 baked': return 13;
		case 'stand airborne-dead': return 43;
		case 'stand landing-dead': return 24;
		case 'stand pistol airborne': return 72;
		case 'stand pistol celebrate': return 57;
		case 'stand pistol dive-front': return 75;
		case 'stand pistol dive-left': return 75;
		case 'stand pistol dive-right': return 75;
		case 'stand pistol evade-left': return 52;
		case 'stand pistol evade-right': return 58;
		case 'stand pistol idle': return 70;
		case 'stand pistol land-hard': return 97;
		case 'stand pistol move-back': return 28;
		case 'stand pistol move-front': return 28;
		case 'stand pistol move-left': return 28;
		case 'stand pistol move-right': return 28;
		case 'stand pistol overheat': return 71;
		case 'stand pistol pr fire-1 baked': return 7;
		case 'stand pistol reload-1': return 43;
		case 'stand pistol signal-attack': return 77;
		case 'stand pistol surprise-back': return 47;
		case 'stand pistol surprise-front': return 64;
		case 'stand pistol turn-left': return 16;
		case 'stand pistol turn-right': return 16;
		case 'stand pistol warn': return 55;
		}
		return 30;
	}
}

