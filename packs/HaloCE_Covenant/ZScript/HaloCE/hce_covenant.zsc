				A_ChangeModel('None', 0, "", 'None', 21, "models/hce/GruntSpecOps", 'gore_GruntSpecOps.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(0, (0.0794, 0.0000, 0.4375), 80.00, "models/hce/GruntSpecOps", 'GruntSpecOps_gib_head_shellback.iqm', 21, 'gore_GruntSpecOps.png', 0.0504);
