class HCE_JackalMajorBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 48;
		Radius 14;
		Mass 113;
		PainChance 0;
		Tag "JackalMajor";
		BloodColor "4A 2A 9A";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce/JackalMajor", 'gore_JackalMajor.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.0695, 0.0000, 0.5840), 80.00, "models/hce/JackalMajor", 'JackalMajor_gib_head.iqm', 14, 'gore_JackalMajor.png');
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 6, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 15, "models/hce/JackalMajor", 'gore_JackalMajor.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (-0.0004, 0.2002, 0.3861), 80.00, "models/hce/JackalMajor", 'JackalMajor_gib_larm.iqm', 15, 'gore_JackalMajor.png');
			HCE_OnSever(1, true);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 5, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce/JackalMajor", 'gore_JackalMajor.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (-0.0047, -0.2105, 0.3796), 80.00, "models/hce/JackalMajor", 'JackalMajor_gib_rarm.iqm', 16, 'gore_JackalMajor.png');
			HCE_OnSever(2, false);
			return true;
		}
		return false;
	}
}

