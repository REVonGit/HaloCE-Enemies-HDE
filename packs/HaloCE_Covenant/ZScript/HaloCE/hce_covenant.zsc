		HaloDoom_EnemyBase.HCE_DamageModifier 1.00;
		HaloDoom_EnemyBase.HCE_CombatRange 0, 32;
		HaloDoom_EnemyBase.HCE_Burst 0.60, 1.20, 0.80, 1.80, 0.00, 1.00;
		HaloDoom_EnemyBase.HCE_GunOffset (16.0, -0.0, -16.0);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 64, 151;
		HaloDoom_EnemyBase.HCE_Leap 136, 360, 0.35, 11.2;
		HaloDoom_EnemyBase.HCE_Grenades 0, 0, 0.00, 0.0, 0, 960, 26.0;
		HaloDoom_EnemyBase.HCE_Panic 0.00, 0.00, 0.0, 0.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.20, 0.80, 200;
		HaloDoom_EnemyBase.HCE_Defensive 0.75, 0.80, 0.10, 0.30, 0.30;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 300, 5.0, 6.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_Voices "Elite_Dogmatic,Elite_Loose";
		HaloDoom_EnemyBase.HCE_Drops "Halo_EnergySword", "None";
		+HaloDoom_EnemyBase.HCE_AlwaysBerserk
		+HaloDoom_EnemyBase.HCE_Berserks
		+HaloDoom_EnemyBase.HCE_Evades
		+HaloDoom_EnemyBase.HCE_Leader
		+HaloDoom_EnemyBase.HCE_SeeksCover
		+HaloDoom_EnemyBase.HCE_ShieldStun
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	override Name HCE_AnimName(int kind)
	{
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand sword idle';
		case HCE_A_ALERT: return 'stand sword idle';
		case HCE_A_MOVE_F: return 'stand sword move-front';
		case HCE_A_MOVE_B: return 'stand sword move-back';
		case HCE_A_MOVE_L: return 'stand sword move-left';
		case HCE_A_MOVE_R: return 'stand sword move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch sword idle';
		case HCE_A_CROUCH_MOVE: return 'crouch sword move-front';
		case HCE_A_FIRE: return 'stand missle fire-1 fr baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand sword melee%0', 'stand sword melee%1' }; return o[random(0, 1)]; }
		case HCE_A_THROW: return 'stand sword throw-grenade';
