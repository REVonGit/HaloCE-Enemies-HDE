	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand pistol idle%0';
		case HCE_A_ALERT: return 'alert pistol idle';
		case HCE_A_MOVE_F: return 'stand pistol move-front';
		case HCE_A_MOVE_B: return 'stand pistol move-back';
		case HCE_A_MOVE_L: return 'stand pistol move-left';
		case HCE_A_MOVE_R: return 'stand pistol move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch pistol idle';
		case HCE_A_CROUCH_MOVE: return 'crouch pistol move-front';
		case HCE_A_FIRE: return 'stand pistol pp fire-1 baked';
		case HCE_A_MELEE: return 'stand pistol melee';
		case HCE_A_THROW: return 'stand pistol throw-grenade';
		case HCE_A_DIVE_L: return 'stand pistol dive-left';
		case HCE_A_DIVE_R: return 'stand pistol dive-right';
		case HCE_A_DIVE_F: return 'stand pistol dive-front';
		case HCE_A_EVADE_L: return 'stand pistol evade-left';
		case HCE_A_EVADE_R: return 'stand pistol evade-right';
		case HCE_A_SURPRISE_F: return 'stand pistol surprise-front';
		case HCE_A_SURPRISE_B: return 'stand pistol surprise-back';
		case HCE_A_BERSERK: return 'stand pistol berserk';
		case HCE_A_WARN: return 'stand pistol warn';
		case HCE_A_SIGNAL: return 'stand pistol signal-attack';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LAND: return 'stand pistol land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut baked', 's-ping front gut%1 baked', 's-ping front head baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%0 baked', 's-ping left gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-foot' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back gut', 'h-ping back l-arm', 'h-ping back r-arm' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
