	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'alert pistol idle': return (19.5, -0.8, 6.8);
		case 'crouch pistol idle': return (35.6, 10.4, -4.2);
		case 'crouch pistol move-front': return (35.4, 4.3, 0.7);
		case 'stand pistol move-back': return (32.7, 2.7, 19.9);
		case 'stand pistol move-front': return (22.2, 11.1, -0.8);
		case 'stand pistol move-left': return (33.4, -2.8, 21.8);
		case 'stand pistol move-right': return (34.8, 5.1, 15.9);
		}
		return hce_gunOffset;
	}
}

