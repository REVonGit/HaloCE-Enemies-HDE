			{
				A_ChangeModel('None', 0, "", 'None', 20, "models/hce/GruntSpecOps", 'gore_GruntSpecOps.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(0, (0.0845, -0.0000, 0.4259), 80.00, "models/hce/GruntSpecOps", 'GruntSpecOps_gib_head_base00.iqm', 20, 'gore_GruntSpecOps.png', 0.0525);
