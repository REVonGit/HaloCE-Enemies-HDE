class HCE_GruntBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 44;
		Radius 16;
		Mass 94;
		PainChance 0;
		Tag "Grunt";
		BloodColor "40 C8 D0";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.0845, -0.0000, 0.4259), 80.00, "models/hce/Grunt", 'Grunt_gib_head.iqm', 12, 'gore_Grunt.png');
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (0.0386, 0.1982, 0.2480), 80.00, "models/hce/Grunt", 'Grunt_gib_larm.iqm', 13, 'gore_Grunt.png');
			HCE_OnSever(1, false);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 5, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 6, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (0.0386, -0.1955, 0.2514), 80.00, "models/hce/Grunt", 'Grunt_gib_rarm.iqm', 14, 'gore_Grunt.png');
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
}

