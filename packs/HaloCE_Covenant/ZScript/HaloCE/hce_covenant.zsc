// characters\draeth\draeth commander excavator
class HCE_DraethCommanderExcavator : HCE_DraethBase
{
	//$Category "Halo CE/Covenant/Draeth"
	//$Title "Draeth Commander (Excavator)"
	//$Sprite "HU0DA0"
	Default
	{
		Health 100;
		Speed 8.1;
