		HaloDoom_EnemyBase.HCE_GunOffset (14.0, -0.0, -13.5);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 36, 55;
		HaloDoom_EnemyBase.HCE_Leap 0, 0, 0.00, 6.5;
		HaloDoom_EnemyBase.HCE_Grenades 0, 0, 0.00, 0.0, 0, 960, 18.7;
		HaloDoom_EnemyBase.HCE_Panic 0.80, 0.20, 4.0, 6.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.00, 0.00, 0;
		HaloDoom_EnemyBase.HCE_Defensive 0.10, 0.75, 0.00, 0.60, 0.00;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 250, 5.0, 4.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_FirePattern 3, 3, 12, 1.60, 2.60, 0;
		HaloDoom_EnemyBase.HCE_FireSounds "Halo/Weapons/Needler/Fire", "Halo/Weapons/Needler/Fire/Bass", "", "";
		HaloDoom_EnemyBase.HCE_Voices "Jackal";
