	override int HCE_AnimTics(Name anim)
	{
		switch(anim)
		{
		case 'crouch rifle idle': return 70;
		case 'crouch rifle move-front': return 35;
		case 'h-kill back gut': return 63;
		case 'h-kill front gut': return 51;
		case 'h-ping back gut': return 40;
		case 'h-ping back l-arm': return 42;
		case 'h-ping back r-arm': return 32;
		case 'h-ping front chest': return 40;
		case 'h-ping front gut': return 38;
		case 'h-ping front l-arm': return 43;
		case 'h-ping front l-foot': return 69;
		case 's-kill back gut': return 77;
		case 's-kill front gut': return 77;
		case 's-kill left gut': return 43;
		case 's-kill right gut': return 49;
		case 's-ping back gut%0 baked': return 6;
		case 's-ping back gut%1 baked': return 24;
		case 's-ping front gut baked': return 6;
		case 's-ping front gut%1 baked': return 12;
		case 's-ping front head baked': return 23;
		case 's-ping left gut%0 baked': return 6;
		case 's-ping left gut%1 baked': return 15;
		case 's-ping right gut%0 baked': return 6;
		case 's-ping right gut%1 baked': return 15;
		case 'stand airborne-dead': return 49;
		case 'stand landing-dead': return 47;
		case 'stand pistol dive-front': return 46;
		case 'stand pistol dive-left': return 46;
		case 'stand pistol dive-right': return 46;
		case 'stand pistol evade-left': return 35;
		case 'stand pistol evade-right': return 35;
