	override void HCE_GibOverride(int limb, out String path, out Name model, out int stub, out Name tex)
	{
		switch(limb)
		{
		case HCE_LIMB_HEAD: path = "models/hce/EliteKit"; model = 'honor_body_gib_head.iqm'; stub = 28; tex = 'gore_Elite.png'; break;
		case HCE_LIMB_LARM: path = "models/hce/EliteKit"; model = 'honor_body_gib_larm.iqm'; stub = 27; tex = 'gore_Elite.png'; break;
