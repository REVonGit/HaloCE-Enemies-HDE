	{
		switch(anim)
		{
		case 'crouch sword idle': return (43.9, 20.3, -29.3);
		case 'crouch sword move-front': return (46.0, 25.0, -22.7);
		case 'stand rifle cover-left-open': return (28.0, 11.2, 3.5);
