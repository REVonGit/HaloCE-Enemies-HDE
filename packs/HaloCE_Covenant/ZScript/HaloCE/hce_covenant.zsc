		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert unarmed idle%0': return 52;
		case 'alert unarmed idle%1': return 385;
		case 'alert unarmed idle%2': return 139;
		case 'alert unarmed idle%3': return 140;
		case 'alert unarmed idle%4': return 112;
		case 'crouch unarmed fr fire-1 baked': return 23;
		case 'crouch unarmed idle': return 52;
		case 'crouch unarmed move-front': return 26;
		case 'h-kill back gut': return 58;
		case 'h-kill front gut': return 61;
		case 's-kill front gut': return 82;
		case 's-kill left gut': return 80;
		case 's-kill right gut': return 82;
		case 's-ping back gut%0 baked': return 14;
		case 's-ping back gut%1 baked': return 18;
		case 's-ping front chest%0 baked': return 16;
		case 's-ping front chest%1 baked': return 16;
		case 's-ping front gut baked': return 18;
		case 's-ping left gut baked': return 18;
		case 's-ping right gut baked': return 18;
