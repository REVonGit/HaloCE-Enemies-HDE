			hce_fireSound = "Halo/Weapons/PlasmaPistol/Fire"; hce_fireSoundBass = "Halo/Weapons/PlasmaPistol/Fire/Bass"; hce_specialSound = "Halo/Weapons/PlasmaPistol/Fire/Charged"; hce_chargeSound = "Halo/Weapons/PlasmaPistol/Charge/Start"; hce_fireLoop = false;
			hce_specialProj = 'None'; hce_specialCount = 0;
		}
	}
