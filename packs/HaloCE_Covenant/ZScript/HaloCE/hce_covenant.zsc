		Height 68;
		Radius 16;
		Mass 185;
		PainChance 0;
		Tag "Draeth";
		BloodColor "3A 1E 8C";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Name HCE_StepSet() { return 'reaver'; }    // the Reavers' own steps
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		Name sk = show ? 'None' : 'hce_hidden.png';
		static const int W[] = { 1, 2, 3, 4 };
		for(int i = 0; i < W.Size(); i++) A_ChangeModel('None', 0, "", 'None', W[i], "models/hce/weapons", sk, CMDL_USESURFACESKIN);
	}
	// guns it can pick up off the ground (HaloDoom_EnemyBase.HCE_ScavengeScan): Halo_Needler, Halo_PlasmaRifle
	override bool HCE_HasLoadouts() { return true; }
	override int HCE_LoadoutIndex(Name w)
	{
		switch(w)
		{
		case 'Halo_Needler': return 0;
		case 'Halo_PlasmaRifle': return 1;
		}
		return -1;
	}
	override void HCE_ApplyLoadout(int lo)
	{
		switch(lo)
		{
		case 0: HCE_ApplyLoadout0(); return;
		case 1: HCE_ApplyLoadout1(); return;
		}
	}
	void HCE_ApplyLoadout0()
	{
		{
			hce_projectile = 'HCE_Needle'; hce_projectilesPerShot = 1; hce_rateOfFire = 3.00; hce_errorAngle = 4.00; hce_maxRange = 1760; hce_projSpeed = 12.1;
			hce_rangeMin = 360; hce_rangeMax = 480; hce_damageMod = 0.50; hce_specialFire = 0; hce_specialChance = 0; bHCE_Lobbed = false;
			hce_patShotsMin = 3; hce_patShotsMax = 3; hce_patInterval = 12; hce_patPauseMin = 1.76; hce_patPauseMax = 2.86; hce_patChargeTics = 0;
			hce_fireSound = "Halo/Weapons/Needler/Fire"; hce_fireSoundBass = "Halo/Weapons/Needler/Fire/Bass"; hce_specialSound = ""; hce_chargeSound = ""; hce_fireLoop = false;
			hce_specialProj = 'None'; hce_specialCount = 0;
		}
	}
	void HCE_ApplyLoadout1()
	{
		{
			hce_projectile = 'HCE_PlasmaRifleBolt'; hce_projectilesPerShot = 1; hce_rateOfFire = 7.00; hce_errorAngle = 1.00; hce_maxRange = 1760; hce_projSpeed = 155.9;
			hce_rangeMin = 320; hce_rangeMax = 640; hce_damageMod = 0.50; hce_specialFire = 0; hce_specialChance = 0; bHCE_Lobbed = false;
			hce_patShotsMin = 4; hce_patShotsMax = 7; hce_patInterval = 4; hce_patPauseMin = 0.75; hce_patPauseMax = 1.33; hce_patChargeTics = 0;
			hce_fireSound = "Halo/Weapons/PlasmaRifle/Fire"; hce_fireSoundBass = "Halo/Weapons/PlasmaRifle/Fire/Bass"; hce_specialSound = ""; hce_chargeSound = ""; hce_fireLoop = false;
			hce_specialProj = 'None'; hce_specialCount = 0;
		}
	}
	override void HCE_LoadoutVisual(int lo)
	{
		switch(lo)
		{
		case 0: HCE_LoadoutVisual0(); return;
		case 1: HCE_LoadoutVisual1(); return;
		}
	}
	void HCE_LoadoutVisual0()
	{
		{
			A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 2, "models/hce/weapons", 'w_needler_glow.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 3, "models/hce/weapons", 'w_needler_1.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		}
	}
	void HCE_LoadoutVisual1()
	{
		{
			A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 3, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 4, "models/hce/weapons", 'w_plasma_rifle_0.png', CMDL_USESURFACESKIN);
		}
	}
	override Name HCE_LoadoutAnim(int lo, int kind)
	{
		switch(lo)
		{
		case 0: return HCE_LoadoutAnim0(kind);
		case 1: return HCE_LoadoutAnim1(kind);
		}
		return 'None';
	}
