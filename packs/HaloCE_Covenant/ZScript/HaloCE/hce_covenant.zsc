class HCE_GruntBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 48;
		Radius 16;
		Mass 98;
		PainChance 0;
		Tag "Grunt";
		BloodColor "40 C8 D0";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 18, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			if(hce_perm == 0)
			{
				A_ChangeModel('None', 0, "", 'None', 20, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(0, (0.0845, -0.0000, 0.4259), 80.00, "models/hce/Grunt", 'Grunt_gib_head_base00.iqm', 20, 'gore_Grunt.png', 0.0525);
			}
			else if(hce_perm == 1)
			{
				A_ChangeModel('None', 0, "", 'None', 21, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(0, (0.0794, 0.0000, 0.4375), 80.00, "models/hce/Grunt", 'Grunt_gib_head_shellback.iqm', 21, 'gore_Grunt.png', 0.0504);
			}
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			if(hce_perm == 0)
			{
				A_ChangeModel('None', 0, "", 'None', 22, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(1, (0.0386, 0.1982, 0.2480), 80.00, "models/hce/Grunt", 'Grunt_gib_larm_base00.iqm', 22, 'gore_Grunt.png', 0.0412);
			}
			else if(hce_perm == 1)
			{
				A_ChangeModel('None', 0, "", 'None', 23, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(1, (0.0386, 0.1982, 0.2480), 80.00, "models/hce/Grunt", 'Grunt_gib_larm_shellback.iqm', 23, 'gore_Grunt.png', 0.0412);
			}
			HCE_OnSever(1, false);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 17, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			if(hce_perm == 0)
			{
				A_ChangeModel('None', 0, "", 'None', 24, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(2, (0.0386, -0.1955, 0.2514), 80.00, "models/hce/Grunt", 'Grunt_gib_rarm_base00.iqm', 24, 'gore_Grunt.png', 0.0495);
			}
			else if(hce_perm == 1)
			{
				A_ChangeModel('None', 0, "", 'None', 25, "models/hce/Grunt", 'gore_Grunt.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(2, (0.0379, -0.1930, 0.2544), 80.00, "models/hce/Grunt", 'Grunt_gib_rarm_shellback.iqm', 25, 'gore_Grunt.png', 0.0429);
			}
			HCE_OnSever(2, true);
			return true;
		case 3:
			A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 15, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 19, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
