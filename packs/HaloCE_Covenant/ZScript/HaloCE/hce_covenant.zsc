		case 'stand pistol airborne': return 52;
		case 'stand pistol dive-front': return 55;
		case 'stand pistol dive-left': return 55;
		case 'stand pistol dive-right': return 55;
		case 'stand pistol evade-left': return 34;
		case 'stand pistol evade-right': return 30;
		case 'stand pistol idle%0': return 70;
		case 'stand pistol land-soft': return 58;
		case 'stand pistol low-idle': return 92;
		case 'stand pistol low-move': return 38;
		case 'stand pistol move-back': return 23;
		case 'stand pistol move-front%0': return 19;
		case 'stand pistol move-left': return 23;
		case 'stand pistol move-right': return 23;
		case 'stand pistol overheat': return 132;
		case 'stand pistol pp fire-1 baked': return 10;
		case 'stand pistol reload-1': return 132;
		case 'stand pistol surprise-back': return 24;
		case 'stand pistol surprise-front': return 32;
		case 'stand pistol throw-grenade': return 66;
		case 'stand pistol turn-left': return 16;
