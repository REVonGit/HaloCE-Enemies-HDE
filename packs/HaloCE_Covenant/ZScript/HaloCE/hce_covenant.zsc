	override Name HCE_LoadoutAnim(int lo, int kind)
	{
		switch(lo)
		{
		case 0: return HCE_LoadoutAnim0(kind);
		case 1: return HCE_LoadoutAnim1(kind);
		case 2: return HCE_LoadoutAnim2(kind);
		}
		return 'None';
	}
	Name HCE_LoadoutAnim0(int kind)
	{
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand missle idle';
		case HCE_A_ALERT: return 'stand missle idle';
		case HCE_A_MOVE_F: return 'stand missle move-front';
		case HCE_A_MOVE_B: return 'stand missle move-back';
		case HCE_A_MOVE_L: return 'stand missle move-left';
		case HCE_A_MOVE_R: return 'stand missle move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch missle idle';
		case HCE_A_CROUCH_MOVE: return 'crouch missle move-front';
		case HCE_A_FIRE: return 'stand missle fire-1 fr baked';
		case HCE_A_MELEE: return 'stand missle melee';
		case HCE_A_THROW: return 'stand missle throw-grenade';
		case HCE_A_DIVE_L: return 'stand missle dive-left';
		case HCE_A_DIVE_R: return 'stand missle dive-right';
		case HCE_A_DIVE_F: return 'stand missle dive-front';
		case HCE_A_EVADE_L: return 'stand missle evade-left';
		case HCE_A_EVADE_R: return 'stand missle evade-right';
		case HCE_A_SURPRISE_F: return 'stand missle surprise-front';
		case HCE_A_SURPRISE_B: return 'stand missle surprise-back';
		case HCE_A_BERSERK: return 'stand missle berserk';
		case HCE_A_WARN: return 'stand pistol warn';
		case HCE_A_SIGNAL: return 'stand missle signal-attack';
		case HCE_A_AIRBORNE: return 'stand missle airborne';
		case HCE_A_LAND: return 'stand missle land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut baked', 's-ping front gut%1 baked', 's-ping front head baked' }; return o[random(0, 2)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%0 baked', 's-ping left gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-foot' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back gut', 'h-ping back l-arm', 'h-ping back r-arm' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: return 's-kill front gut';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_TURN_L: return 'stand missle turn-left';
		case HCE_A_TURN_R: return 'stand missle turn-right';
		case HCE_A_FLAME_IDLE: return 'flaming pistol idle';
		case HCE_A_RELOAD: return 'stand missle reload-1';
		case HCE_A_LOW_IDLE: return 'stand missle low-idle';
		case HCE_A_LOW_MOVE: return 'stand missle low-move';
		}
		return 'None';
	}
