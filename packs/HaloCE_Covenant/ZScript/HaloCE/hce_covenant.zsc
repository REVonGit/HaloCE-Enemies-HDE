class HCE_GruntSpecOpsBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 48;
		Radius 16;
		Mass 98;
		PainChance 0;
		Tag "GruntSpecOps";
		BloodColor "40 C8 D0";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Name HCE_ShellClass() { return 'HCE_GruntSpecOpsShieldShell'; }
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 18, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			if(hce_perm == 0)
			{
				A_ChangeModel('None', 0, "", 'None', 20, "models/hce/GruntSpecOps", 'gore_GruntSpecOps.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(0, (0.0845, -0.0000, 0.4259), 80.00, "models/hce/GruntSpecOps", 'GruntSpecOps_gib_head_base00.iqm', 20, 'gore_GruntSpecOps.png', 0.0525);
			}
			else if(hce_perm == 1)
			{
				A_ChangeModel('None', 0, "", 'None', 21, "models/hce/GruntSpecOps", 'gore_GruntSpecOps.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(0, (0.0794, 0.0000, 0.4375), 80.00, "models/hce/GruntSpecOps", 'GruntSpecOps_gib_head_shellback.iqm', 21, 'gore_GruntSpecOps.png', 0.0504);
			}
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			if(hce_perm == 0)
			{
				A_ChangeModel('None', 0, "", 'None', 22, "models/hce/GruntSpecOps", 'gore_GruntSpecOps.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(1, (0.0386, 0.1982, 0.2480), 80.00, "models/hce/GruntSpecOps", 'GruntSpecOps_gib_larm_base00.iqm', 22, 'gore_GruntSpecOps.png', 0.0412);
			}
			else if(hce_perm == 1)
			{
				A_ChangeModel('None', 0, "", 'None', 23, "models/hce/GruntSpecOps", 'gore_GruntSpecOps.png', CMDL_USESURFACESKIN);
				HCE_SpawnLimb(1, (0.0386, 0.1982, 0.2480), 80.00, "models/hce/GruntSpecOps", 'GruntSpecOps_gib_larm_shellback.iqm', 23, 'gore_GruntSpecOps.png', 0.0412);
