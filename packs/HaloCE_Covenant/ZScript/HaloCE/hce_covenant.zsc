	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (6.8, -0.0, 40.9);
		case 1: return (3.1, 15.9, 23.8);
		case 2: return (3.1, -15.6, 24.1);
		case 3: return (-12.0, 0.0, 47.4);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/Grunt", 'Grunt_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/Grunt", 'Grunt_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/Grunt", 'Grunt_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 18, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 17, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 3:
			A_ChangeModel('None', 7, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 15, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 19, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		Name sk = show ? 'None' : 'hce_hidden.png';
		static const int W[] = { 7, 8, 9 };
		for(int i = 0; i < W.Size(); i++) A_ChangeModel('None', 0, "", 'None', W[i], "models/hce/weapons", sk, CMDL_USESURFACESKIN);
	}
	// Halo CE's two Grunt backs (base00, shellback), one rolled per Grunt
	int hce_perm;
	Array<int> hce_permHide;
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		hce_perm = random[HCEPerm](0, 1);
		hce_permHide.Clear();
		switch(hce_perm)
		{
		case 0: { static const int H[] = { 4, 5, 6, 16, 17, 18, 19 }; for(int i = 0; i < H.Size(); i++) hce_permHide.Push(H[i]); break; }
		case 1: { static const int H[] = { 1, 2, 3, 12, 13, 14, 15 }; for(int i = 0; i < H.Size(); i++) hce_permHide.Push(H[i]); break; }
		}
		for(int i = 0; i < hce_permHide.Size(); i++) A_ChangeModel('None', 0, "", 'None', hce_permHide[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		HCE_ResumeAnim();        // A_ChangeModel resets the animation the spawn started (idle, sleeping)
	}
	override void HCE_BloodHideClass()
	{
		super.HCE_BloodHideClass();
		for(int i = 0; i < hce_permHide.Size(); i++) A_ChangeModel('None', 7, "", 'None', hce_permHide[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	// guns it can pick up off the ground (HaloDoom_EnemyBase.HCE_ScavengeScan): Halo_Needler, Halo_PlasmaPistol
	override bool HCE_HasLoadouts() { return true; }
	override int HCE_LoadoutIndex(Name w)
	{
		switch(w)
		{
		case 'Halo_Needler': return 0;
		case 'Halo_PlasmaPistol': return 1;
		}
		return -1;
	}
	override void HCE_ApplyLoadout(int lo)
	{
		switch(lo)
