		case 'stand unarmed dive-right': return 55;
		case 'stand unarmed land-soft': return 24;
		case 'stand unarmed melee': return 71;
		case 'stand unarmed move-front': return 30;
		}
		return 30;
	}
	override Name HCE_LimbReplacement(int limb) { if(limb != HCE_LIMB_RARM) return 'None'; return "Halo_PlasmaCaster"; }
}

class HCE_JackalBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_COVENANT";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_COVENANT;
		Height 54;
		Radius 14;
		Mass 131;
		PainChance 0;
		Tag "Jackal";
		BloodColor "4A 2A 9A";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce/Jackal", 'gore_Jackal.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.0551, 0.0002, 0.5808), 80.00, "models/hce/Jackal", 'Jackal_gib_head.iqm', 12, 'gore_Jackal.png', 0.0447);
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 6, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce/Jackal", 'gore_Jackal.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (-0.0004, 0.2002, 0.3861), 80.00, "models/hce/Jackal", 'Jackal_gib_larm.iqm', 13, 'gore_Jackal.png', 0.0380);
			HCE_OnSever(1, true);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 5, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce/Jackal", 'gore_Jackal.png', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (-0.0047, -0.2105, 0.3796), 80.00, "models/hce/Jackal", 'Jackal_gib_rarm.iqm', 14, 'gore_Jackal.png', 0.0512);
			HCE_OnSever(2, false);
			return true;
		}
		return false;
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (4.4, 0.0, 55.8);
		case 1: return (-0.0, 16.0, 37.1);
		case 2: return (-0.4, -16.8, 36.4);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 1; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/Jackal", 'Jackal_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/Jackal", 'Jackal_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/Jackal", 'Jackal_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 9, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 8, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		Name sk = show ? 'None' : 'hce_hidden.png';
		static const int W[] = { 6 };
		for(int i = 0; i < W.Size(); i++) A_ChangeModel('None', 0, "", 'None', W[i], "models/hce/weapons", sk, CMDL_USESURFACESKIN);
	}
}

