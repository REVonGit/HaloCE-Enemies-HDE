	{
		{
			hce_projectile = 'HCE_Needle'; hce_projectilesPerShot = 1; hce_rateOfFire = 8.00; hce_errorAngle = 4.00; hce_maxRange = 800; hce_projSpeed = 12.1;
			hce_rangeMin = 120; hce_rangeMax = 320; hce_damageMod = 0.50; hce_specialFire = 0; hce_specialChance = 0; bHCE_Lobbed = false;
			hce_patShotsMin = 3; hce_patShotsMax = 3; hce_patInterval = 12; hce_patPauseMin = 1.60; hce_patPauseMax = 2.60; hce_patChargeTics = 0;
