// The Flood's guns: any gun but the Forerunners' in any armed Flood body's hand (generator/post/flood_arsenal.py:
// written by it, edit there). The firing data is the Marine body's loadouts' (HCE_MarineBase); the gun model is
// the body's own overlay, models/hce/FloodArsenal/<Body>_w_<gun>.iqm in the Flood pack, shown as model 6.
class HCE_FloodArsenal play
{
	static int Index(Name w)
	{
		switch(w)
		{
		case 'Halo_AssaultRifle': return 0;
		case 'Halo_BattleRifle': return 1;
		case 'Halo_BeamRifle': return 2;
		case 'Halo_Bulldog': return 3;
		case 'Halo_Carbine': return 4;
		case 'Halo_Commando': return 5;
		case 'Halo_DBLShotgun': return 6;
		case 'Halo_DMR': return 7;
		case 'Halo_Flamethrower': return 8;
		case 'Halo_FuelRod': return 9;
		case 'Halo_GPMG': return 10;
		case 'Halo_GrenadeLauncher': return 11;
		case 'Halo_Hydra': return 12;
		case 'Halo_MA5B': return 13;
		case 'Halo_Magnum': return 14;
		case 'Halo_Needler': return 15;
		case 'Halo_NeedlerJavelin': return 16;
		case 'Halo_PlasmaCaster': return 17;
		case 'Halo_PlasmaPistol': return 18;
		case 'Halo_PlasmaRifle': return 19;
		case 'Halo_PulseCarbine': return 20;
		case 'Halo_RocketLauncher': return 21;
		case 'Halo_SMG': return 22;
		case 'Halo_Shotgun': return 23;
		case 'Halo_Sidekick': return 24;
		case 'Halo_SniperRifle': return 25;
		case 'Halo_Spiker': return 26;
		case 'Halo_StickyDetonator': return 27;
		}
		return -1;
	}
	static void Apply(HaloDoom_EnemyBase e, int lo)
	{
		switch(lo)
		{
		case 0: Apply0(e); return;
		case 1: Apply1(e); return;
		case 2: Apply2(e); return;
		case 3: Apply3(e); return;
		case 4: Apply4(e); return;
		case 5: Apply5(e); return;
		case 6: Apply6(e); return;
		case 7: Apply7(e); return;
		case 8: Apply8(e); return;
		case 9: Apply9(e); return;
		case 10: Apply10(e); return;
		case 11: Apply11(e); return;
		case 12: Apply12(e); return;
		case 13: Apply13(e); return;
		case 14: Apply14(e); return;
		case 15: Apply15(e); return;
		case 16: Apply16(e); return;
		case 17: Apply17(e); return;
		case 18: Apply18(e); return;
		case 19: Apply19(e); return;
		case 20: Apply20(e); return;
		case 21: Apply21(e); return;
		case 22: Apply22(e); return;
		case 23: Apply23(e); return;
		case 24: Apply24(e); return;
		case 25: Apply25(e); return;
		case 26: Apply26(e); return;
		case 27: Apply27(e); return;
		}
	}
	static void Apply0(HaloDoom_EnemyBase e)   // Halo_AssaultRifle
	{
		e.hce_projectile = 'HCE_MA37Round'; e.hce_projectilesPerShot = 1; e.hce_rateOfFire = 10.00; e.hce_errorAngle = 1.00; e.hce_maxRange = 2400; e.hce_projSpeed = 1008.0;
		e.hce_rangeMin = 240; e.hce_rangeMax = 1200; e.hce_damageMod = 0.40; e.hce_specialFire = 0; e.hce_specialChance = 0; e.bHCE_Lobbed = false;
		e.hce_patShotsMin = 4; e.hce_patShotsMax = 8; e.hce_patInterval = 3; e.hce_patPauseMin = 1.00; e.hce_patPauseMax = 1.75; e.hce_patChargeTics = 0;
		e.hce_fireSound = "Halo/Weapons/Rifle/Fire"; e.hce_fireSoundBass = "Halo/Weapons/Rifle/Fire/Bass"; e.hce_specialSound = ""; e.hce_chargeSound = ""; e.hce_fireLoop = false;
		e.hce_specialProj = 'None'; e.hce_specialCount = 0;
	}
