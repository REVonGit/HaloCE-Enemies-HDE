// Halo gore for Nash's Gore Mod (Covenant pack). Only runs while NashGore is loaded (and hce_halogore is on):
// on top of NashGore's own sprays, splats and pools, Covenant enemies and Marines bleed the way they do in Halo CE and
// Halo 2:
// * every hit sprays the species' Halo blood decal onto the wall behind it (Halo CE and Halo 2 splats, chosen at
//   random: the Elite's lavender, the Grunt's blue, the Hunter's orange with its glowing splats, the Brute's
//   navy, the Drone's khaki, the Engineer's pink; Slug Men, a Mgalekgolo sub-species, bleed the Hunter's orange; the beasts
//   red; the Marines Halo CE's human red, dying in its blood pool)
// * a Halo blood burst puffs out of the wound, in the victim's blood colour, with a few streaks: Halo CE's Covenant
//   impact burst for the Covenant, its human impact for the Marines;
// * kills leave bigger splats and the Elite / Grunt smears, and a larger burst;
// * the blood lands on the floor too, Halo's splats laid flat (Doom's decals go on walls only): under a wounded enemy
//   at most hits, a spread of them around a kill, and a pool of the large splats and smears (the Marines' Halo CE
//   blood pool) where the body comes to rest;
// * a body flung by its death (a rocket, a shotgun blast, a melee blow: not a grenade, which throws them every which
//   way) leaves skid marks, Halo CE's blood smears laid along its slide.
// The splats are big (Halo spreads its small blood bitmaps over a body's width and more) and plentiful.
// NashGore's own blood is kept off these enemies: their blood type is the core's HCE_HaloBlood (NashGore only
// replaces Doom's own), and NashGore's per-monster gore (corpse pools, spurts, its gibs) is turned off for them as they
// spawn (it reads their no-blood flag once, then: set for that moment). The Flood and the Sentinels keep NashGore's.
// Textures and decals: extract_halo_gore.py (graphics/hcegore, sprites/hcegore, decaldef.hcegore).
class HCE_HaloGoreHandler : EventHandler
{
	bool hasNash, checked;
	Array<Actor> recent; Array<int> recentUntil;      // a decal per victim at most every few tics
	Array<Actor> unbled;                               // no-blood set only while NashGore looks at them (WorldThingSpawned)
	Array<Actor> splats;                               // floor splats, oldest first
	const MAX_SPLATS = 400;
	// the dead: a body flung by a hit (not a grenade) leaves skid marks as it slides, and every body leaves its pool
	// where it comes to rest
	Array<Actor> bodies; Array<int> bodyUntil, bodyStill; Array<double> bodyLastX, bodyLastY; Array<bool> bodySkid, bodyAir;

	override void OnRegister()
	{
		SetOrder(-1000);          // before NashGore's handler, so the no-blood flag is set when it reads it
	}

	override void WorldThingSpawned(WorldEvent e)
	{
		let v = e.Thing;
		if(!v || !(v is "HaloDoom_EnemyBase") || v.bNOBLOOD || !Active() || Species(v) == "") return;
		v.bNOBLOOD = true;
		unbled.Push(v);
	}

	override void WorldThingDied(WorldEvent e)
	{
		let v = e.Thing;
		if(!v || !(v is "HaloDoom_EnemyBase") || v.bNOBLOOD || !Active() || Species(v) == "") return;
		String inf = "";
		if(e.Inflictor) inf = e.Inflictor.GetClassName();
		bodies.Push(v); bodyUntil.Push(level.maptime + 35 * 5); bodyStill.Push(0);
		bodyLastX.Push(v.pos.x); bodyLastY.Push(v.pos.y);
		bodySkid.Push(inf.IndexOf("Grenade") < 0 && inf.IndexOf("grenade") < 0);   // a grenade throws them every which way
		bodyAir.Push(false);
	}

	override void WorldTick()
	{
		for(int i = 0; i < unbled.Size(); i++)
			if(unbled[i]) unbled[i].bNOBLOOD = unbled[i].default.bNOBLOOD;
		unbled.Clear();
		for(int i = bodies.Size() - 1; i >= 0; i--)
		{
			let v = bodies[i];
			bool done = !v || v.bInvisible || v.bDESTROYED;
			if(!done)
			{
				String sp = Species(v);
				bool grounded = v.pos.z <= v.floorz + 4;
				double spd = v.vel.xy.Length();
				vector2 last = (bodyLastX[i], bodyLastY[i]);
				vector2 moved = v.pos.xy - last;
				// skid marks: where a thrown body comes down, a smear dragged on ahead of it (as long as it hit the
				// ground hard), and a smear laid along a slide every so often
				if(bodySkid[i] && grounded && bodyAir[i] && spd > 1.5)
				{
					vector2 dir = v.vel.xy / spd;
					double len = clamp(spd / 3.5, 0.9, 2.2);
					SkidMark(v, sp, v.pos.xy + dir * len * 14, atan2(dir.y, dir.x), len);
					bodyLastX[i] = v.pos.x; bodyLastY[i] = v.pos.y;
				}
				else if(bodySkid[i] && grounded && spd > 1.0 && moved.Length() >= 22)
				{
					SkidMark(v, sp, (last + v.pos.xy) * 0.5, atan2(moved.y, moved.x), clamp(moved.Length() / 40.0, 0.7, 1.6));
					bodyLastX[i] = v.pos.x; bodyLastY[i] = v.pos.y;
				}
				else if(!grounded || moved.Length() > 60) { bodyLastX[i] = v.pos.x; bodyLastY[i] = v.pos.y; }
				bodyAir[i] = !grounded;
				bodyStill[i] = (grounded && spd < 0.6) ? bodyStill[i] + 1 : 0;
				if(bodyStill[i] >= 4 || level.maptime >= bodyUntil[i])
				{
					// at rest: its pool, and a ring of splats
					FloorSplat(v, sp, true, frandom[HCEGore](0, v.radius * 0.3), clamp(v.radius / 16.0, 1.0, 2.0));
					FloorSplat(v, sp, true, frandom[HCEGore](v.radius * 0.4, v.radius), clamp(v.radius / 24.0, 0.7, 1.4));
					done = true;
				}
			}
			if(done)
			{
				bodies.Delete(i); bodyUntil.Delete(i); bodyStill.Delete(i); bodyLastX.Delete(i); bodyLastY.Delete(i); bodySkid.Delete(i); bodyAir.Delete(i);
			}
		}
	}

	// a skid mark: one of Halo CE's blood smears laid flat along the body's slide
	void SkidMark(Actor v, String group, vector2 at, double ang, double len)
	{
		let s = HCE_GoreFloorSplat(Actor.Spawn("HCE_GoreFloorSplat", (at, v.floorz), ALLOW_REPLACE));
		if(!s) return;
		if(!s.Pick("HK" .. FloorCode(group), 1.0)) { s.Destroy(); return; }
		s.angle = ang + 90;                                     // a flat sprite's width lies across its angle
		s.bXFLIP = false;
		s.scale.x *= len * 1.6;
		splats.Push(s);
		while(splats.Size() > MAX_SPLATS) { if(splats[0]) splats[0].Destroy(); splats.Delete(0); }
	}

	static String FloorCode(String group)
	{
		static const String g[] = { "Elite", "Grunt", "Hunter", "Brute", "Drone", "Engineer", "Beast", "Human" };
		static const String c[] = { "EL", "GR", "HU", "BR", "DR", "EN", "BE", "HM" };
		for(int i = 0; i < g.Size(); i++) if(g[i] == group) return c[i];
		return "BE";
	}

	// a Halo blood splat on the floor under the wound: hit (HS) or death pool (HP)
	void FloorSplat(Actor v, String group, bool pool, double off, double size)
	{
		vector3 at = v.Vec3Angle(off, frandom[HCEGore](0, 360), 0);
		let s = HCE_GoreFloorSplat(Actor.Spawn("HCE_GoreFloorSplat", (at.xy, v.floorz), ALLOW_REPLACE));
		if(!s) return;
		if(!s.Pick((pool ? "HP" : "HS") .. FloorCode(group), size)) { s.Destroy(); return; }
		splats.Push(s);
		while(splats.Size() > MAX_SPLATS) { if(splats[0]) splats[0].Destroy(); splats.Delete(0); }
	}

	bool Active()
	{
		if(!checked)
		{
			checked = true;
			String nash = "NashGoreBlood";                  // a run-time lookup: NashGore loads after this pack
			hasNash = (class<Actor>)(nash) != null;
		}
		if(!hasNash) return false;
		CVar cv = CVar.FindCVar("hce_halogore");
		return !cv || cv.GetBool();
	}

	static String Species(Actor a)
	{
		String n = a.GetClassName();
		if(n.IndexOf("Flood") >= 0 || n.IndexOf("Sentinel") >= 0) return "";
		if(n.IndexOf("Marine") >= 0 || n.IndexOf("Johnson") >= 0) return "Human";
		static const String keys[] = { "Hunter", "Brute", "Drone", "Engineer", "SlugMan", "Grunt", "Elite", "Jackal", "Drinol", "BlindWolf", "ThornBeast" };
		static const String groups[] = { "Hunter", "Brute", "Drone", "Engineer", "Hunter", "Grunt", "Elite", "Elite", "Beast", "Beast", "Beast" };
		for(int i = 0; i < keys.Size(); i++) if(n.IndexOf(keys[i]) >= 0) return groups[i];
		return "";
	}

	bool Throttled(Actor v, int tics)
	{
		for(int i = recent.Size() - 1; i >= 0; i--)
		{
			if(!recent[i] || recentUntil[i] < level.maptime) { recent.Delete(i); recentUntil.Delete(i); continue; }
			if(recent[i] == v) return true;
		}
		recent.Push(v); recentUntil.Push(level.maptime + tics);
		return false;
	}

	// wound position: the projectile if one hit, else the side facing the attacker at chest height
	static vector3 WoundPos(Actor v, Actor inflictor, Actor source)
	{
		if(inflictor && inflictor != source && v.Distance3D(inflictor) < v.radius * 3 + 32) return inflictor.pos;
		Actor from = source ? source : inflictor;
		double a = from ? v.AngleTo(from) : v.angle;
		return v.Vec3Angle(v.radius * 0.7, a, v.height * frandom[HCEGore](0.45, 0.8));
	}

	static void Burst(Actor v, String group, vector3 at, Actor from, int puffs, int streaks, double size)
	{
		color c = v.BloodColor;
		if(c == 0) c = Color(255, 120, 0, 0);
		double away = from ? from.AngleTo(v) : v.angle + 180;
		// the puff sheet: Halo CE's human impact for the Marines, its Covenant one for the Covenant, the generic for beasts
		class<HCE_GorePuff> pc = group == "Human" ? (class<HCE_GorePuff>)("HCE_GorePuffHuman") : group == "Beast" ? (class<HCE_GorePuff>)("HCE_GorePuff") : (class<HCE_GorePuff>)("HCE_GorePuffCov");
		for(int i = 0; i < puffs; i++)
		{
			let p = HCE_GorePuff(Actor.Spawn(pc, at, ALLOW_REPLACE));
			if(!p) continue;
			p.SetShade(c);
			p.frame = random[HCEGore](0, p.Frames() - 1);
			p.scale *= size * frandom[HCEGore](0.6, 1.1);
			p.vel = (Actor.AngleToVector(away + frandom[HCEGore](-50, 50), frandom[HCEGore](0.3, 1.6)), frandom[HCEGore](-0.2, 1.0));
		}
		for(int i = 0; i < streaks; i++)
		{
			let s = Actor.Spawn("HCE_GoreStreak", at, ALLOW_REPLACE);
			if(!s) continue;
			s.SetShade(c);
			s.frame = random[HCEGore](0, 11);
			s.roll = frandom[HCEGore](0, 360);
			s.scale *= size;
			s.vel = (Actor.AngleToVector(away + frandom[HCEGore](-40, 40), frandom[HCEGore](3, 7)), frandom[HCEGore](1, 4));
		}
	}

	static void Spray(Actor v, String group, Actor from, double spread, double up)
	{
		double a = (from ? from.AngleTo(v) : v.angle + 180) + frandom[HCEGore](-spread, spread);
		double pt = frandom[HCEGore](-10, up);
		vector3 dir = (Actor.AngleToVector(a, cos(pt)), -sin(pt));
		v.A_SprayDecal(group, 210, (0, 0, v.height * frandom[HCEGore](0.3, 0.7)), dir);
	}

	override void WorldThingDamaged(WorldEvent e)
	{
		let v = e.Thing;
		if(!v || e.Damage <= 0 || !(v is "HaloDoom_EnemyBase") || v.bNOBLOOD || !Active()) return;
		if(e.DamageType == 'Fire' || e.DamageType == 'Burn' || e.DamageType == 'Flame' || e.DamageType == 'Ice' || e.DamageType == 'Drowning' || e.DamageType == 'Telefrag') return;
		String sp = Species(v);
		if(sp == "") return;
		Actor from = e.DamageSource ? e.DamageSource : e.Inflictor;
		bool dead = v.health <= 0;
		double size = clamp(e.Damage / 22.0, 0.7, 1.7);
		vector3 at = WoundPos(v, e.Inflictor, e.DamageSource);
		if(dead)
		{
			// a kill paints the wall behind and around it and the floor under it (the pool comes when the body
			// has come to rest: WorldTick)
			Burst(v, sp, at, from, 8, 6, size * 1.45);
			for(int i = 0; i < 4; i++) Spray(v, "HCEGore_" .. sp .. "Big", from, i == 0 ? 15 : 125, i == 0 ? 18 : 60);
			for(int i = random[HCEGore](2, 3); i > 0; i--) FloorSplat(v, sp, false, frandom[HCEGore](v.radius * 0.4, v.radius * 1.8), size);
			return;
		}
		Burst(v, sp, at, from, e.Damage >= 15 ? 4 : 2, e.Damage >= 15 ? 4 : 2, size * 1.15);
		if(!Throttled(v, 4))
		{
			Spray(v, "HCEGore_" .. sp, from, 20, 20);
			if(e.Damage >= 15) Spray(v, "HCEGore_" .. sp, from, 55, 40);
			if(frandom[HCEGore](0, 1) < 0.6 + e.Damage / 60.0) FloorSplat(v, sp, false, frandom[HCEGore](0, v.radius * 1.3), size * 0.8);
		}
	}
}

// the Halo blood burst: one puff of Halo CE / Halo 2's blood-burst sheet, stencilled in the victim's blood colour
class HCE_GorePuff : Actor
{
	virtual int Frames() { return 12; }
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+FORCEXYBILLBOARD
		RenderStyle "Stencil";
		Alpha 0.9;
		Scale 0.35;
	}
	States
	{
	Precache:
		HGBP ABCDEFGHIJKL 0;
		Stop;
	Spawn:
		HGBP # 1
		{
			scale *= 1.07;
			vel *= 0.86; vel.z -= 0.04;
			A_FadeOut(0.06);
		}
		Loop;
	}
}

// Halo CE's Covenant impact burst (with its blood bursts): the Covenant's puffs
class HCE_GorePuffCov : HCE_GorePuff
{
	override int Frames() { return 13; }
	States
	{
	Precache:
		HGBC ABCDEFGHIJKLM 0;
		Stop;
	Spawn:
		HGBC # 1
		{
			scale *= 1.07;
			vel *= 0.86; vel.z -= 0.04;
			A_FadeOut(0.06);
		}
		Loop;
	}
}

// Halo CE's human impact burst: the Marines' puffs
class HCE_GorePuffHuman : HCE_GorePuff
{
	override int Frames() { return 13; }
	States
	{
	Precache:
		HGBH ABCDEFGHIJKLM 0;
		Stop;
	Spawn:
		HGBH # 1
		{
			scale *= 1.07;
			vel *= 0.86; vel.z -= 0.04;
			A_FadeOut(0.06);
		}
		Loop;
	}
}

// a streak of blood flung from the wound (Halo 2's blood trails), falling and fading
class HCE_GoreStreak : Actor
{
	Default
	{
		+NOINTERACTION
		+NOBLOCKMAP
		+ROLLSPRITE
		RenderStyle "Stencil";
		Alpha 0.95;
		Scale 0.3;
	}
	States
	{
	Precache:
		HGBS ABCDEFGHIJKL 0;
		Stop;
	Spawn:
		HGBS # 1
		{
			vel.z -= 0.45;
			vel.xy *= 0.95;
			A_FadeOut(0.045);
		}
		Loop;
	}
}

// Halo's blood on the floor: a splat lying flat (Halo CE / Halo 2's blood decals as flat sprites, extract_halo_gore.py:
// HS<species> hit splats, HP<species> death pools and smears, HK<species> skid marks), fading after two minutes
class HCE_GoreFloorSplat : Actor
{
	int life;
	Default
	{
		+FLATSPRITE
		+NOINTERACTION
		+NOBLOCKMAP
		+DONTSPLASH
		+NOTONAUTOMAP
		RenderStyle "Translucent";
		Alpha 0.9;
		Scale 1.2;
	}
	States
	{
	Precache:
		HSEL A 0; HPEL A 0; HSGR A 0; HPGR A 0; HSHU A 0; HPHU A 0; HSBR A 0; HPBR A 0;
		HSDR A 0; HPDR A 0; HSEN A 0; HPEN A 0; HSBE A 0; HPBE A 0; HSHM A 0; HPHM A 0;
		HKEL A 0; HKGR A 0; HKHU A 0; HKBR A 0; HKDR A 0; HKEN A 0; HKBE A 0; HKHM A 0;
		Stop;
	Spawn:
		HSBE A -1;
		Stop;
	}
	// its sprite and a random frame of it (the frames that exist: the sprite's own count)
	bool Pick(String spr, double size)
	{
		int si = GetSpriteIndex(spr);
		if(si < 0) return false;
		int n = 0;
		while(n < 26 && TexMan.CheckForTexture(String.Format("%s%c0", spr, 65 + n), TexMan.Type_Sprite).IsValid()) n++;
		if(n == 0) return false;
		sprite = si;
		frame = random[HCEGore](0, n - 1);
		scale *= size * frandom[HCEGore](0.8, 1.15);
		angle = frandom[HCEGore](0, 360);
		bXFLIP = random[HCEGore](0, 1) == 1;
		SetZ(floorz + frandom[HCEGore](0.1, 0.4));    // a hair apart, so overlapping splats don't flicker
		life = 35 * 120;
		return true;
	}
	override void Tick()
	{
		if(isFrozen()) return;
		if(--life < 35 * 10) { alpha -= 0.9 / (35 * 10); if(alpha <= 0 || life <= 0) { Destroy(); return; } }
		if(pos.z > floorz + 1 || pos.z < floorz) SetZ(floorz + 0.2);   // a lift or a crusher moved the floor
	}
}
