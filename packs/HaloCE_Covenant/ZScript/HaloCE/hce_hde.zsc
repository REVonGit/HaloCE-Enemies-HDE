// HaloDoom Evolved only (the standalone packs leave this file out): the weapon a dropped HDE gun gives, which guns
// HDE's weapon preset spawns, and whether the player's flashlight is on. HDE turns
// a dropped weapon into a WeaponPickupProxy that carries the weapon class; enemies and Marines that pick guns up
// off the ground (HaloDoom_EnemyBase.HCE_ScavengeScan) read it through this.
class HCE_HDEPickupResolver : HCE_PickupResolver
{
	// the weapon class a ground pickup gives, read off HDE's WeaponPickupProxy; 'None' for anything else
	override Name WeaponOf(Actor a)
	{
		let p = WeaponPickupProxy(a);
		if(!p || !p.trueitem) return 'None';
		return p.trueitem.GetClassName();
	}

	// HaloDoom Evolved's weapon presets (Options > HaloDoom > game type: halodoom_gametype, its GTDEFS game types). The
	// preset's weapon list is read once per map (HaloDoom_EnemyBase.HCE_SharedResolver keeps this resolver for the map).
	bool presetRead, presetAll;
	Array<String> presetGuns;
	// reads the current game type once: everything is allowed when there is none or it doesn't filter weapons,
	// otherwise its weaponClasses (lower-case class names) are the allowed guns
	void ReadPreset()
	{
		presetRead = true;
		let gt = HaloMath.getCurrentGameType();
		presetAll = !gt || (gt.flags & GameTypeInfo.DONTFILTERWEAPONS);
		if(gt) presetGuns.Copy(gt.weaponClasses);
	}

	// does the preset spawn this gun: true for anything that isn't an HDE HaloGun, else whether it is on the list
	override bool WeaponAllowed(Name w)
	{
		if(!presetRead) ReadPreset();
		if(presetAll) return true;
		String low = w;
		class<HaloGun> gc = low;
		if(!gc) return true;                                  // not one of HDE's guns (none of the presets list it)
		low = low.MakeLower();
		return presetGuns.Find(low) != presetGuns.Size();
	}

	// Human guns in the world more often (hce_humanweapons): this pack fills the maps with Covenant drops, so a Covenant
	// gun HDE picks for a map's own Doom weapon or ammo (not a dropped one, nor a Halo gun the map places) is swapped,
	// that often, for a human gun HDE's game type spawns sharing one of its power tiers (spawn tier: the Doom weapon
	// slot it fills). To weigh it differently, change hce_humanweapons (0: HDE's own mix, 1: every Covenant gun swapped)
	override Name WorldWeapon(Name replacee, Name w)
	{
		String rs = replacee, ws = w;
		class<HaloGun> rc = rs;
		class<HaloGun> gc = ws;
		if(rc || !gc) return w;                               // a Halo gun placed or dropped as itself; not a gun
		let d = GetDefaultByType(gc);
		if(d.faction != 'Covenant') return w;
		CVar cv = CVar.FindCVar("hce_humanweapons");
		if(frandom[HCEWorldGun](0, 1) >= (cv ? cv.GetFloat() : 0.5)) return w;
		int tier = SlotTier(replacee);
		if(!tier) tier = d.SpawnTier & ~HaloGun.P_ANY;
		Array<Name> ok;
		for(int i = 0; i < AllActorClasses.Size(); i++)
		{
			class<HaloGun> c = (class<HaloGun>)(AllActorClasses[i]);
			if(!c || c.GetClassName() == 'HaloGun') continue;
			let cd = GetDefaultByType(c);
			if(cd.faction != 'Human' || cd.SpawnRarity == 0 || !(cd.SpawnTier & (tier | HaloGun.P_ANY))) continue;
			if(WeaponAllowed(c.GetClassName())) ok.Push(c.GetClassName());
		}
		return ok.Size() ? ok[random[HCEWorldGun](0, ok.Size() - 1)] : w;
	}

	// the power tier HaloDoom Evolved fills a Doom weapon or ammo slot from (its CheckReplacement: the pistol and chaingun
	// basic, the shotgun mid, the super shotgun strong, the rocket launcher power, the plasma rifle energy, the BFG uber,
	// the chainsaw melee; their ammo likewise); 0 for anything else
	static int SlotTier(Name item)
	{
		String n = item; n = n.MakeLower();
		if(n.IndexOf("chainsaw") >= 0 || n.IndexOf("fist") >= 0) return HaloGun.P_MELEE;
		if(n.IndexOf("supershotgun") >= 0 || n == "shellbox") return HaloGun.P_STRONG;
		if(n.IndexOf("shotgun") >= 0 || n == "shell") return HaloGun.P_MID;
		if(n.IndexOf("pistol") >= 0 || n.IndexOf("chaingun") >= 0 || n == "clip" || n == "clipbox") return HaloGun.P_NORM;
		if(n.IndexOf("rocket") >= 0) return HaloGun.P_POWER;
		if(n.IndexOf("plasmarifle") >= 0 || n == "cell") return HaloGun.P_ENERGY;
		if(n.IndexOf("bfg") >= 0 || n == "cellpack") return HaloGun.P_UBER;
		return 0;
	}

	// an allowed HDE gun sharing a spawn tier with w, picked at random; 'None' when the preset has none of that tier
	override Name SubstituteWeapon(Name w)
	{
		String sw = w;
		class<HaloGun> gc = sw;
		if(!gc) return w;
		int tier = GetDefaultByType(gc).SpawnTier & ~HaloGun.P_ANY;
		Array<Name> ok;
		for(int i = 0; i < AllActorClasses.Size(); i++)
		{
			class<HaloGun> c = (class<HaloGun>)(AllActorClasses[i]);
			if(!c || c.GetClassName() == 'HaloGun') continue;
			let d = GetDefaultByType(c);
			if(d.SpawnRarity == 0 || !(d.SpawnTier & tier)) continue;
			if(WeaponAllowed(c.GetClassName())) ok.Push(c.GetClassName());
		}
		return ok.Size() ? ok[random[HCEPreset](0, ok.Size() - 1)] : 'None';
	}

	// HaloDoom Evolved's flashlight is on (enemies notice its beam: HCE_MissileTracker.Flashlight)
	override bool FlashlightOn(Actor p)
	{
		let hp = HaloPlayer(p);
		return hp && hp.flashlight && hp.flashlight.active;
	}
}
