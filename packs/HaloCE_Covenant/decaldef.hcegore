// Halo CE and Halo 2 blood decals (extract_halo_gore.py), used by the NashGore patch (hce_gore.zsc)
Fader HCEGoreFade
{
	DecayStart 60.0
	DecayTime 20.0
}

Decal HCEG_ce_blood_splat_elite_0
{
	Pic "graphics/hcegore/ce_blood_splat_elite_0.png"
	Translucent 0.95
	X-Scale 0.80
	Y-Scale 0.80
	RandomFlipX
	RandomFlipY
	Animator HCEGoreFade
}

