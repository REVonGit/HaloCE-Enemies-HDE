material texture "models/hce_dig/Engineer/skins/engineer_engineer_1.png"
{
	shader "shaders/hce_derez.fp"
	define "HCE_SELFILLUM"
	define "SI_FN" = "2"
	define "SI_PERIOD" = "1.000"
	define "SI_LO" = "vec3(0.0000, 0.0000, 0.0000)"
	define "SI_HI" = "vec3(0.4667, 0.3765, 0.9843)"
	define "SI_GAIN" = "1.500"
	speed 1.0
	brightmap "models/hce_dig/hce_fx/black.png"
	texture si_mask "models/hce_dig/Engineer/skins/engineer_engineer_1_si.png"
}
