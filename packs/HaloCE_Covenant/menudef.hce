AddOptionMenu "OptionsMenu"
{
	Submenu "Halo CE Gore", "HCE_GoreOptions"
	Submenu "Halo CE AI", "HCE_AIOptions"
}

OptionValue "HCE_Difficulty"
{
	-1, "From the skill level"
	0, "Easy"
	1, "Normal"
	2, "Heroic"
	3, "Legendary"
}

OptionMenu "HCE_AIOptions"
{
	Title "Halo CE AI"
	Option "Halo difficulty", "hce_difficulty", "HCE_Difficulty"
	StaticText "Halo CE's own difficulty table: damage, toughness, aim,", 1
	StaticText "rate of fire, reactions and grenades.", 1
	StaticText ""
	StaticText "Behaviour", 1
	Option "Fight from cover", "hce_cover", "OnOff"
	Option "Squad tactics", "hce_tactics", "OnOff"
	Option "Grunt and Jackal squads", "hce_squads", "OnOff"
	Option "Jumping and climbing", "hce_jumping", "OnOff"
	Option "Idle patrols", "hce_patrols", "OnOff"
	Option "Search for lost targets", "hce_search", "OnOff"
	Option "Dodge grenades", "hce_grenadedodge", "OnOff"
	Option "Hunters in bonded pairs", "hce_hunterpairs", "OnOff"
	Option "Marines turn on a traitor", "hce_betrayal", "OnOff"
	Option "Drop weapons", "hce_dropweapons", "OnOff"
	Slider "Shooting the dead", "hce_corpseshoot", 0, 1, 0.05, 2
	Slider "Sleeping Grunts", "hce_sleepinggrunts", 0, 1, 0.05, 2
	Slider "Most pursuers per target (0 = any)", "hce_maxpursuers", 0, 12, 1, 0
	StaticText ""
	StaticText "Balance", 1
	Slider "Enemy weapon damage", "hce_enemydamage", 0.1, 3, 0.1, 1
	Slider "Enemy projectile damage", "hce_nerf_projectiles", 0.1, 1.5, 0.05, 2
	Slider "Enemy health", "hce_nerf_health", 0.1, 2, 0.05, 2
	Slider "Enemy shields", "hce_nerf_shields", 0.1, 2, 0.05, 2
	Slider "Enemy aim error", "hce_enemyspread", 0.5, 4, 0.05, 2
	Slider "Enemy aim tracking", "hce_enemytracking", 1, 10, 0.5, 1
	Slider "Pause between bursts", "hce_burstpause", 0.5, 3, 0.1, 1
	Slider "Grenade frequency", "hce_grenadefreq", 0, 3, 0.1, 1
	Slider "Gunfire hearing range", "hce_hearing", 256, 4096, 128, 0
	StaticText ""
	StaticText "Spawning", 1
	Option "Keep Doom's monsters", "hce_keepdoommonsters", "OnOff"
	Slider "Digsite enemy spawns", "hce_digsite_spawns", 0, 2, 0.1, 1
}

OptionMenu "HCE_GoreOptions"
{
	Title "Halo CE Gore"
	Option "Blood on bodies", "hce_bodyblood", "OnOff"
	StaticText "Enemies get bloodier as they are hurt.", 1
	StaticText ""
	Option "Dismemberment", "hce_dismember", "OnOff"
	StaticText "Hard kills can take heads and arms off.", 1
	StaticText ""
	Option "Halo blood with NashGore", "hce_halogore", "OnOff"
	StaticText "With NashGore loaded: Halo CE / Halo 2 decals and bursts.", 1
}
