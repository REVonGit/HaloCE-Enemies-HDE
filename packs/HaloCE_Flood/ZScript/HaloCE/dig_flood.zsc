		case 'stand pistol airborne': return 51;
		case 'stand pistol dive-front': return 78;
		case 'stand pistol dive-left': return 66;
		case 'stand pistol dive-right': return 66;
		case 'stand pistol evade-left': return 51;
		case 'stand pistol evade-right': return 57;
		case 'stand pistol fire-1 baked': return 8;
		case 'stand pistol idle%0': return 104;
		case 'stand pistol idle%1': return 162;
		case 'stand pistol land-soft': return 41;
		case 'stand pistol leap-airborne': return 32;
		case 'stand pistol leap-melee': return 20;
