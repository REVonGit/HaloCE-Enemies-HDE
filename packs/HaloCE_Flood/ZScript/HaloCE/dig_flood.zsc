	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'stand pistol idle%0': return (38.9, 14.6, 23.5);
		case 'stand pistol idle%1': return (40.2, 13.8, 23.0);
		case 'stand pistol move-back': return (52.4, 10.9, 10.0);
		case 'stand pistol move-front': return (51.3, 17.2, 13.6);
