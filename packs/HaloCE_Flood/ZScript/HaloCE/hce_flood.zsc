		Height 48;
		Radius 14;
		Mass 100;
		PainChance 0;
		Tag "FloodMarine";
		BloodColor "76 70 3A";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 0, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 3, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 1, "", 'None', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 2, "", 'None', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 5, "", 'None', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(0, (0.0595, -0.0473, 0.4908), 80.00, "models/hce/FloodMarine", 'FloodMarine_gib_head.iqm', 15, 'gore_FloodMarine.png', 0.0470);
			HCE_OnSever(0, false);
			return true;
		case 1:
			A_ChangeModel('None', 0, "", 'None', 6, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 7, "", 'None', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 8, "", 'None', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(1, (-0.0808, 0.0749, 0.3321), 80.00, "models/hce/FloodMarine", 'FloodMarine_gib_larm.iqm', 15, 'gore_FloodMarine.png', 0.0535);
			HCE_OnSever(1, false);
			return true;
		case 2:
			A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 0, "", 'None', 11, "", 'None', CMDL_USESURFACESKIN);
			HCE_SpawnLimb(2, (0.1846, -0.0936, 0.3912), 80.00, "models/hce/FloodMarine", 'FloodMarine_gib_rarm.iqm', 15, 'gore_FloodMarine.png', 0.0277);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		static const int D[] = { 1, 2, 5, 7, 8, 11 };
		for(int i = 0; i < D.Size(); i++) A_ChangeModel('None', 0, "", 'None', D[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		HCE_ResumeAnim();
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (4.8, -3.8, 47.1);
		case 1: return (-6.5, 6.0, 31.9);
		case 2: return (14.8, -7.5, 37.6);
