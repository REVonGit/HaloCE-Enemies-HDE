		case HCE_A_TURN_L: return 'stand pistol turn-left';
		case HCE_A_TURN_R: return 'stand pistol turn-right';
		case HCE_A_HOIST: return 'stand pistol hoist';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
