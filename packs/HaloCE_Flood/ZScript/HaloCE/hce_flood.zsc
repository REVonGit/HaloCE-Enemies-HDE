	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand pistol idle';
		case HCE_A_ALERT: return 'stand pistol idle';
		case HCE_A_MOVE_F: { static const Name o[] = { 'stand pistol move-front%0', 'stand pistol move-front%1' }; return o[random(0, 1)]; }
		case HCE_A_CROUCH_MOVE: return 'crouch pistol move-front';
		case HCE_A_FLEE: return 'flee pistol move-front';
		case HCE_A_FIRE: return 'stand pistol ar fire-1%0 baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand pistol melee%0', 'stand pistol melee%1' }; return o[random(0, 1)]; }
		case HCE_A_SURPRISE_F: return 'stand pistol surprise-front';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LAND: return 'stand pistol land-hard';
		case HCE_A_LEAP_START: return 'stand pistol leap-start';
		case HCE_A_LEAP_AIR: return 'stand pistol leap-airborne';
		case HCE_A_LEAP_MELEE: return 'stand pistol leap-melee';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%0 baked', 's-ping front gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%0 baked', 's-ping left gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-hand', 'h-ping front r-hand' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: return 's-kill front gut%0';
		case HCE_A_DIE_B: return 's-kill back gut';
