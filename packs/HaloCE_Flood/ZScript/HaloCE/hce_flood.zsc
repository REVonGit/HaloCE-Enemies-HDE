		case 'flee pistol move-front': return (21.6, 18.1, 19.2);
		case 'stand unarmed idle%0': return (11.9, 0.2, 11.4);
		case 'stand unarmed idle%1': return (11.4, 0.1, 11.1);
		}
		return hce_gunOffset;
	}
}

