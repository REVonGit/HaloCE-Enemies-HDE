		+HaloDoom_EnemyBase.HCE_Berserks
		+HaloDoom_EnemyBase.HCE_Explodes
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: { static const Name o[] = { 'stand unarmed idle%0', 'stand unarmed idle%1' }; return o[random(0, 1)]; }
		case HCE_A_ALERT: { static const Name o[] = { 'alert unarmed idle%0', 'alert unarmed idle%1' }; return o[random(0, 1)]; }
		case HCE_A_MOVE_F: return 'alert unarmed move-front';
		case HCE_A_CROUCH_MOVE: return 'crouch unarmed move-front';
		case HCE_A_FLEE: return 'flee pistol move-front';
		case HCE_A_FIRE: return 'stand pistol pp fire-1 baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand pistol melee%0', 'stand pistol melee%1' }; return o[random(0, 1)]; }
		case HCE_A_SURPRISE_F: return 'stand pistol surprise-front';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LEAP_START: return 'stand pistol leap-start';
		case HCE_A_LEAP_AIR: return 'stand pistol leap-airborne';
		case HCE_A_LEAP_MELEE: return 'stand pistol leap-melee';
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-hand', 'h-ping front r-hand' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: return 's-kill front gut%0';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_RESURRECT_F: return 'stand unarmed resurrect-front';
		case HCE_A_RESURRECT_B: return 'stand unarmed resurrect-back';
		case HCE_A_TURN_L: return 'stand unarmed turn-left';
		case HCE_A_TURN_R: return 'stand unarmed turn-right';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert unarmed idle%0': return 70;
		case 'alert unarmed idle%1': return 187;
		case 'alert unarmed move-front': return 30;
		case 'crouch unarmed move-front': return 19;
		case 'flee pistol move-front': return 19;
		case 'h-kill back gut': return 35;
		case 'h-kill front gut': return 58;
		case 'h-ping back gut': return 30;
		case 'h-ping front chest': return 38;
		case 'h-ping front gut': return 38;
		case 'h-ping front l-hand': return 47;
		case 'h-ping front r-hand': return 47;
		case 's-kill back gut': return 35;
		case 's-kill front gut%0': return 47;
		case 's-kill left gut': return 47;
		case 's-kill right gut': return 48;
		case 'stand airborne-dead': return 43;
		case 'stand landing-dead': return 16;
		case 'stand pistol airborne': return 70;
		case 'stand pistol leap-airborne': return 70;
		case 'stand pistol leap-melee': return 34;
		case 'stand pistol leap-start': return 70;
		case 'stand pistol melee%0': return 34;
		case 'stand pistol melee%1': return 34;
		case 'stand pistol pp fire-1 baked': return 10;
		case 'stand pistol surprise-front': return 70;
		case 'stand unarmed idle%0': return 70;
		case 'stand unarmed idle%1': return 70;
		case 'stand unarmed resurrect-back': return 70;
		case 'stand unarmed resurrect-front': return 70;
		case 'stand unarmed turn-left': return 16;
		case 'stand unarmed turn-right': return 16;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
	// the Flood Grunt bursts like a carrier, a smaller one: 2-4 infection forms
	override void HCE_OnDetonate()
	{
		Name n = 'HCE_FloodInfection';
		class<Actor> ic = (class<Actor>)(n);
		if(!ic) return;
		int count = random(2, 4);
		for(int i = 0; i < count; i++)
		{
			let f = Spawn(ic, pos + (frandom(-8, 8), frandom(-8, 8), height * 0.5), ALLOW_REPLACE);
			if(f) { f.vel = (frandom(-4, 4), frandom(-4, 4), frandom(3, 6)); f.target = target; f.SetStateLabel("See"); }
		}
	}
	override Sound HCE_PopSound() { return "HCE/FloodGrunt/Pop"; }
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'alert unarmed idle%0': return (8.0, 12.8, -16.2);
		case 'alert unarmed idle%1': return (8.0, 13.0, -15.7);
		case 'alert unarmed move-front': return (14.2, 11.5, -16.0);
		case 'crouch unarmed move-front': return (22.5, 8.0, 2.7);
		case 'flee pistol move-front': return (22.5, 8.0, 2.7);
		case 'stand unarmed idle%0': return (28.2, 4.0, 2.2);
		case 'stand unarmed idle%1': return (28.2, 4.0, 2.2);
		}
		return hce_gunOffset;
	}
}

