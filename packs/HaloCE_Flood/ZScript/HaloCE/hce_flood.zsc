			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(12);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 12, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
