			HCE_HideSurface(17);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 17, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(18);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 18, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(19);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 19, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(20);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 20, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
