		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-hand', 'h-ping front r-hand' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: return 'h-ping back gut';
