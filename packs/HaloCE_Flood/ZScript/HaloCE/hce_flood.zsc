	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: { static const Name o[] = { 'stand pistol idle%0', 'stand pistol idle%1', 'stand pistol idle%2' }; return o[random(0, 2)]; }
		case HCE_A_ALERT: { static const Name o[] = { 'stand pistol idle%0', 'stand pistol idle%1', 'stand pistol idle%2' }; return o[random(0, 2)]; }
		case HCE_A_MOVE_F: return 'stand pistol move-front';
		case HCE_A_MOVE_B: return 'stand pistol move-back';
		case HCE_A_CROUCH_MOVE: return 'crouch pistol move-front';
		case HCE_A_FLEE: return 'flee pistol move-front';
		case HCE_A_FIRE: return 'stand pistol ar fire-1 baked';
		case HCE_A_MELEE: return 'stand pistol melee';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LAND: return 'stand pistol land-soft';
		case HCE_A_LEAP_START: return 'stand pistol leap-start';
		case HCE_A_LEAP_AIR: return 'stand pistol leap-airborne';
		case HCE_A_LEAP_MELEE: return 'stand pistol leap-melee';
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-leg' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back chest', 'h-ping back gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_F: return 'h-kill front gut';
		case HCE_A_DIE_B: return 'h-kill back gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_RESURRECT_F: return 'stand unarmed resurrect-front';
		case HCE_A_RESURRECT_B: return 'stand unarmed resurrect-back';
		case HCE_A_TURN_L: return 'stand pistol turn-left';
		case HCE_A_TURN_R: return 'stand pistol turn-right';
		case HCE_A_HOIST: return 'stand pistol hoist';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'crouch pistol move-front': return 76;
		case 'flee pistol move-front': return 23;
		case 'h-kill back gut': return 56;
		case 'h-kill front gut': return 47;
		case 'h-ping back chest': return 47;
		case 'h-ping back gut': return 47;
		case 'h-ping front chest': return 47;
		case 'h-ping front gut': return 47;
		case 'h-ping front l-arm': return 47;
		case 'h-ping front l-leg': return 47;
		case 'stand airborne-dead': return 43;
		case 'stand landing-dead': return 48;
		case 'stand pistol airborne': return 47;
		case 'stand pistol ar fire-1 baked': return 4;
		case 'stand pistol hoist': return 70;
		case 'stand pistol idle%0': return 47;
		case 'stand pistol idle%1': return 58;
		case 'stand pistol idle%2': return 141;
		case 'stand pistol land-soft': return 35;
		case 'stand pistol leap-airborne': return 52;
		case 'stand pistol leap-melee': return 52;
		case 'stand pistol leap-start': return 12;
		case 'stand pistol melee': return 58;
		case 'stand pistol move-back': return 35;
		case 'stand pistol move-front': return 35;
		case 'stand pistol turn-left': return 16;
		case 'stand pistol turn-right': return 16;
		case 'stand unarmed resurrect-back': return 27;
		case 'stand unarmed resurrect-front': return 35;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand pistol hoist': return (0.0, 0.0, 153.5);
		}
		return (0, 0, 0);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch pistol move-front': return (22.8, 4.7, 15.6);
		case 'stand pistol idle%1': return (28.0, 6.9, 17.1);
		}
		return hce_gunOffset;
	}
}

