		case 'stand pistol leap-start': return 12;
		case 'stand pistol move-back': return 35;
		case 'stand pistol move-front': return 35;
		case 'stand unarmed hoist': return 70;
		case 'stand unarmed idle%0': return 47;
		case 'stand unarmed idle%1': return 58;
		case 'stand unarmed idle%2': return 141;
		case 'stand unarmed land-soft': return 35;
		case 'stand unarmed leap-melee': return 52;
		case 'stand unarmed melee': return 58;
		case 'stand unarmed resurrect-back': return 27;
		case 'stand unarmed resurrect-front': return 35;
		case 'stand unarmed turn-left': return 16;
		case 'stand unarmed turn-right': return 16;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand unarmed hoist': return (0.0, 0.0, 153.5);
		}
		return (0, 0, 0);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'flee pistol move-front': return (7.7, 9.2, -4.1);
		case 'stand pistol move-back': return (8.1, 4.2, -7.3);
		case 'stand pistol move-front': return (9.7, 2.8, -5.2);
		case 'stand unarmed idle%0': return (7.0, 6.2, -4.4);
		case 'stand unarmed idle%1': return (7.0, 5.6, -4.3);
		case 'stand unarmed idle%2': return (7.0, 6.1, -5.1);
		}
		return hce_gunOffset;
	}
}

// ---- FloodODST: the body every FloodODST variant below is drawn with (characters\floodcombat_odst\floodcombat_odst): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every FloodODST; one variant's numbers are in its own class
class HCE_FloodODSTBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_FLOOD";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_FLOOD;
		Height 48;
		Radius 14;
		Mass 120;
		PainChance 0;
		Tag "FloodODST";
		BloodColor "76 70 3A";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			HCE_HideSurface(0);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(1);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(4);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(5);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 5, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_ShowSurface(2);
			HCE_ShowSurface(3);
			HCE_ShowSurface(6);
			HCE_SpawnLimb(0, (0.0170, -0.0169, 0.5832), 80.00, "models/hce/FloodODST", 'FloodODST_gib_head.iqm', 19, 'gore_FloodODST.png', 0.0550);
			HCE_OnSever(0, false);
			return true;
		case 1:
			HCE_HideSurface(7);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_ShowSurface(8);
			HCE_ShowSurface(9);
			HCE_SpawnLimb(1, (-0.0207, 0.2149, 0.3975), 80.00, "models/hce/FloodODST", 'FloodODST_gib_larm.iqm', 19, 'gore_FloodODST.png', 0.0640);
			HCE_OnSever(1, false);
			return true;
		case 2:
			HCE_HideSurface(11);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(13);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 13, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(14);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(15);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 15, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(16);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(17);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 17, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(18);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 18, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_ShowSurface(12);
			HCE_SpawnLimb(2, (-0.0302, -0.1492, 0.4660), 80.00, "models/hce/FloodODST", 'FloodODST_gib_rarm.iqm', 19, 'gore_FloodODST.png', 0.0394);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		static const int D[] = { 2, 3, 6, 8, 9, 12 };
		for(int i = 0; i < D.Size(); i++) HCE_HideSurface(D[i]);
		HCE_ResumeAnim();
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (1.4, -1.4, 56.0);
		case 1: return (-1.7, 17.2, 38.2);
		case 2: return (-2.4, -11.9, 44.7);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/FloodODST", 'FloodODST_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/FloodODST", 'FloodODST_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/FloodODST", 'FloodODST_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 5, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 7, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		static const int W[] = { 13, 14, 15, 16, 17, 18 };
		for(int i = 0; i < W.Size(); i++)
		{
			if(show) HCE_ShowSurface(W[i]);
			else HCE_HideSurface(W[i]);    // the guns it never held stay undrawn
		}
	}
}

// HCE_FloodcombatOdstAssaultRifle: Halo variant "characters\floodcombat_odst\floodcombat_odst assault rifle", assault rifle, 150 body, 4 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_FloodcombatOdstAssaultRifle : HCE_FloodODSTBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
	{
		static const int K[] = { 2, 3, 6, 8, 9, 12, 13, 14, 15, 16, 17, 18 };
		for(int i = 0; i < K.Size(); i++) if(K[i] == s) { A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN); return; }
		A_ChangeModel('None', 0, "", 'None', s, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowSurface(int s)
	{
		switch(s)
		{
		case 2: A_ChangeModel('None', 0, "", 'None', 2, "models/hce/FloodODST", 'skins/floododst_floododst_0.png', CMDL_USESURFACESKIN); return;
		case 3: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN); return;
		case 6: A_ChangeModel('None', 0, "", 'None', 6, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN); return;
		case 8: A_ChangeModel('None', 0, "", 'None', 8, "models/hce/FloodODST", 'skins/floododst_floododst_0.png', CMDL_USESURFACESKIN); return;
		case 9: A_ChangeModel('None', 0, "", 'None', 9, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN); return;
		case 12: A_ChangeModel('None', 0, "", 'None', 12, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN); return;
		case 13: A_ChangeModel('None', 0, "", 'None', 13, "models/hce/weapons", 'w_assault_rifle_0.png', CMDL_USESURFACESKIN); return;
		case 14: A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'w_assault_rifle_1.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
	override void HCE_DressSurfaces()
	{
		A_ChangeModel('None', 0, "", 'None', 2, "models/hce/FloodODST", 'skins/floododst_floododst_0.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 3, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 6, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 8, "models/hce/FloodODST", 'skins/floododst_floododst_0.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 9, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 12, "models/hce/FloodODST", 'skins/floododst_floododst_2.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 13, "models/hce/weapons", 'w_assault_rifle_0.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'w_assault_rifle_1.png', CMDL_USESURFACESKIN);
	}

	//$Category "Halo CE/Flood/Flood ODST"
	//$Title "Floodcombat Odst (Assault Rifle)"
	//$Sprite "HU3RA0"
	Default
	{
		Health 150;
		Speed 5.7;
		HaloDoom_EnemyBase.HCE_Type 9;
		HaloDoom_EnemyBase.HCE_Variant "floodcombat_odst assault rifle";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 160;
		HaloDoom_EnemyBase.HCE_Movement 3.73, 5.73, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 0.00;
		HaloDoom_EnemyBase.HCE_Weapon "HCE_ARBullet", 1, 15.00, 5.00, 1440;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 1008.0;
		HaloDoom_EnemyBase.HCE_DamageModifier 0.40;
		HaloDoom_EnemyBase.HCE_CombatRange 160, 480;
		HaloDoom_EnemyBase.HCE_Burst 0.15, 0.25, 0.20, 0.60, 0.40, 0.00;
		HaloDoom_EnemyBase.HCE_GunOffset (36.0, 10.0, 14.7);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 40, 55;
		HaloDoom_EnemyBase.HCE_Leap 120, 400, 0.50, 14.9;
		HaloDoom_EnemyBase.HCE_Grenades 0, 2, 0.00, 0.0, 0, 960, 18.7;
		HaloDoom_EnemyBase.HCE_Panic 0.00, 0.00, 0.0, 0.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.10, 0.55, 0;
		HaloDoom_EnemyBase.HCE_Defensive 0.00, 0.00, 0.50, 0.60, 0.00;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 0, 3.0, 4.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_FirePattern 4, 7, 3, 0.60, 1.05, 0;
		HaloDoom_EnemyBase.HCE_FireSounds "Halo/Weapons/MA5B/Fire", "Halo/Weapons/MA5B/Fire/Bass", "", "";
		HaloDoom_EnemyBase.HCE_Voices "Flood";
		HaloDoom_EnemyBase.HCE_Drops "Halo_MA5B", "None";
		+HaloDoom_EnemyBase.HCE_Berserks
		+HaloDoom_EnemyBase.HCE_Leaps
		+HaloDoom_EnemyBase.HCE_Resurrects
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: { static const Name o[] = { 'stand pistol idle%0', 'stand pistol idle%1', 'stand pistol idle%2' }; return o[random(0, 2)]; }
		case HCE_A_ALERT: { static const Name o[] = { 'stand pistol idle%0', 'stand pistol idle%1', 'stand pistol idle%2' }; return o[random(0, 2)]; }
		case HCE_A_MOVE_F: return 'stand pistol move-front';
		case HCE_A_MOVE_B: return 'stand pistol move-back';
		case HCE_A_MOVE_L: return 'stand pistol move-left';
		case HCE_A_MOVE_R: return 'stand pistol move-right';
		case HCE_A_CROUCH_MOVE: return 'crouch pistol move-front';
		case HCE_A_FLEE: return 'flee pistol move-front';
		case HCE_A_FIRE: return 'stand pistol ar fire-1 baked';
		case HCE_A_MELEE: return 'stand pistol melee';
		case HCE_A_THROW: return 'stand pistol throw-grenade';
		case HCE_A_DIVE_L: return 'stand pistol dive-left';
		case HCE_A_DIVE_R: return 'stand pistol dive-right';
		case HCE_A_DIVE_F: return 'stand pistol dive-front';
		case HCE_A_EVADE_L: return 'stand pistol evade-left';
		case HCE_A_EVADE_R: return 'stand pistol evade-right';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LAND: return 'stand pistol land-soft';
		case HCE_A_LEAP_START: return 'stand pistol leap-start';
		case HCE_A_LEAP_AIR: return 'stand pistol leap-airborne';
		case HCE_A_LEAP_MELEE: return 'stand pistol leap-melee';
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-leg' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back chest', 'h-ping back gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_F: return 'h-kill front gut';
		case HCE_A_DIE_B: return 'h-kill back gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_RESURRECT_F: return 'stand unarmed resurrect-front';
		case HCE_A_RESURRECT_B: return 'stand unarmed resurrect-back';
		case HCE_A_TURN_L: return 'stand pistol turn-left';
		case HCE_A_TURN_R: return 'stand pistol turn-right';
		case HCE_A_HOIST: return 'stand pistol hoist';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'crouch pistol move-front': return 76;
		case 'flee pistol move-front': return 23;
		case 'h-kill back gut': return 56;
		case 'h-kill front gut': return 47;
		case 'h-ping back chest': return 47;
		case 'h-ping back gut': return 47;
		case 'h-ping front chest': return 47;
		case 'h-ping front gut': return 47;
		case 'h-ping front l-arm': return 47;
		case 'h-ping front l-leg': return 47;
		case 'stand airborne-dead': return 43;
		case 'stand landing-dead': return 48;
		case 'stand pistol airborne': return 47;
		case 'stand pistol ar fire-1 baked': return 4;
		case 'stand pistol dive-front': return 90;
		case 'stand pistol dive-left': return 90;
		case 'stand pistol dive-right': return 89;
		case 'stand pistol evade-left': return 46;
		case 'stand pistol evade-right': return 46;
		case 'stand pistol hoist': return 70;
		case 'stand pistol idle%0': return 47;
		case 'stand pistol idle%1': return 58;
		case 'stand pistol idle%2': return 141;
		case 'stand pistol land-soft': return 35;
		case 'stand pistol leap-airborne': return 52;
		case 'stand pistol leap-melee': return 52;
		case 'stand pistol leap-start': return 12;
		case 'stand pistol melee': return 58;
		case 'stand pistol move-back': return 35;
		case 'stand pistol move-front': return 35;
		case 'stand pistol move-left': return 18;
		case 'stand pistol move-right': return 18;
		case 'stand pistol throw-grenade': return 60;
		case 'stand pistol turn-left': return 16;
		case 'stand pistol turn-right': return 16;
		case 'stand unarmed resurrect-back': return 27;
		case 'stand unarmed resurrect-front': return 35;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand pistol hoist': return (0.0, 0.0, 153.5);
		}
		return (0, 0, 0);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch pistol move-front': return (31.3, 6.9, 16.5);
		case 'stand pistol idle%1': return (36.6, 7.7, 19.5);
		case 'stand pistol move-left': return (31.8, -0.7, 8.6);
		case 'stand pistol move-right': return (24.2, 22.9, 10.3);
		}
		return hce_gunOffset;
	}
}

// HCE_FloodcombatOdstShotgun: Halo variant "characters\floodcombat_odst\floodcombat_odst shotgun", shotgun, 150 body, 4 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_FloodcombatOdstShotgun : HCE_FloodODSTBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
