	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand unarmed idle';
		case HCE_A_ALERT: return 'stand unarmed idle';
		case HCE_A_MOVE_F: return 'stand unarmed move-front';
		case HCE_A_CROUCH_MOVE: return 'crouch unarmed move-front';
		case HCE_A_MELEE: return 'stand unarmed melee';
		case HCE_A_AIRBORNE: return 'stand unarmed airborne';
		case HCE_A_LAND: return 'stand unarmed land-hard';
		case HCE_A_LEAP_AIR: return 'stand unarmed airborne';
		case HCE_A_LEAP_MELEE: return 'stand unarmed melee';
		case HCE_A_HPING_F: return 'h-ping front gut';
		case HCE_A_DIE_F: { static const Name o[] = { 'h-kill front gut%0', 'h-kill front gut%1', 'h-kill front gut%2' }; return o[random(0, 2)]; }
		case HCE_A_DIE_HARD_F: { static const Name o[] = { 'h-kill front gut%0', 'h-kill front gut%1', 'h-kill front gut%2' }; return o[random(0, 2)]; }
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_FEED: return 'stand unarmed feeding';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'crouch unarmed move-front': return 33;
		case 'h-kill front gut%0': return 8;
		case 'h-kill front gut%1': return 8;
		case 'h-kill front gut%2': return 8;
		case 'h-ping front gut': return 16;
		case 'stand airborne-dead': return 28;
		case 'stand landing-dead': return 58;
		case 'stand unarmed airborne': return 28;
		case 'stand unarmed feeding': return 140;
		case 'stand unarmed idle': return 70;
		case 'stand unarmed land-hard': return 13;
		case 'stand unarmed melee': return 47;
		case 'stand unarmed move-front': return 32;
		}
		return 30;
	}
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}

	// infection forms hunt for dead humans / elites and reanimate them
	override bool HCE_SeekCorpse()
	{
		if(++hce_actionTics < 20) return false;
		hce_actionTics = 0;
		let it = BlockThingsIterator.Create(self, 512);
		Actor best = null; double bd = 1e9;
		while(it.Next())
		{
			let c = HaloDoom_EnemyBase(it.thing);
			if(!c || !c.bCORPSE || !c.hce_enabled || c.bHCE_Resurrects || c.hce_gibbed) continue;
			if(c.hce_team != HCE_TEAM_HUMAN && c.hce_team != HCE_TEAM_COVENANT) continue;
			if(c.hce_type != 0 && c.hce_type != 7) continue;   // elites and marines only
			double d = Distance2D(c);
			if(d < bd) { bd = d; best = c; }
		}
		if(!best) return false;
		hce_feedTarget = best;
		hce_action = HCE_ACT_FEED;
		return true;
	}
	override void HCE_Feed()
	{
		let c = hce_feedTarget;
		if(!c || !c.bCORPSE) { hce_action = HCE_ACT_IDLE; hce_feedTarget = null; return; }
		if(Distance2D(c) > radius + c.radius + 4)
		{
			HCE_Move(AngleTo(c), hce_runSpeed);
			A_SetAngle(AngleTo(c), SPF_INTERPOLATE);
			HCE_Play(HCE_A_MOVE_F);
			return;
		}
		if(hce_curAnimKind != HCE_A_FEED) { HCE_Play(HCE_A_FEED, true, true); hce_leapState = 0; hce_reviveTics = 35 * 3; return; }
		if(--hce_reviveTics > 0) return;
		Name nc = HaloDoom_EnemyBase(c).hce_type == 0 ? 'HCE_FloodcombatEliteUnarmed' : 'HCE_FloodcombatHumanUnarmed';
		class<Actor> cc = (class<Actor>)(nc);
		if(cc)
		{
			let f = Spawn(cc, c.pos, ALLOW_REPLACE);
			if(f)
			{
				f.angle = c.angle;
				let fe = HaloDoom_EnemyBase(f);
				if(fe && fe.HCE_HasAnim(HCE_A_RESURRECT_F)) fe.HCE_PlayLocked(HCE_A_RESURRECT_F);
				f.SetStateLabel("See");
			}
			c.Destroy();
		}
		Destroy();
	}
	override Sound HCE_PopSound() { return "HCE/FloodInfection/Pop"; }
}

class HCE_FloodMarineBase : HaloDoom_EnemyBase abstract
{
