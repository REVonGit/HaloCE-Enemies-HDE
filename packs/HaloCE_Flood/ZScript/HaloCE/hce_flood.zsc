		case 'stand landing-dead': return 16;
		case 'stand pistol airborne': return 70;
		case 'stand pistol idle': return 70;
		case 'stand pistol land-hard': return 57;
		case 'stand pistol leap-airborne': return 70;
		case 'stand pistol leap-melee': return 34;
		case 'stand pistol leap-start': return 70;
		case 'stand pistol melee%0': return 34;
		case 'stand pistol melee%1': return 34;
		case 'stand pistol move-front%0': return 19;
		case 'stand pistol move-front%1': return 19;
		case 'stand pistol pp fire-1 baked': return 10;
		case 'stand pistol surprise-front': return 70;
		case 'stand pistol turn-left': return 16;
		case 'stand pistol turn-right': return 16;
		case 'stand unarmed resurrect-back': return 70;
		case 'stand unarmed resurrect-front': return 70;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
	// the Flood Grunt bursts like a carrier, a smaller one: 2-4 infection forms
	override void HCE_OnDetonate()
	{
		Name n = 'HCE_FloodInfection';
		class<Actor> ic = (class<Actor>)(n);
		if(!ic) return;
		int count = random(2, 4);
		for(int i = 0; i < count; i++)
		{
			let f = Spawn(ic, pos + (frandom(-8, 8), frandom(-8, 8), height * 0.5), ALLOW_REPLACE);
			if(f) { f.vel = (frandom(-4, 4), frandom(-4, 4), frandom(3, 6)); f.target = target; f.SetStateLabel("See"); }
		}
	}
	override Sound HCE_PopSound() { return "HCE/FloodGrunt/Pop"; }
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch pistol move-front': return (29.5, 8.3, 1.1);
		case 'flee pistol move-front': return (29.5, 8.3, 1.1);
		case 'stand pistol idle': return (35.4, 4.4, 1.6);
		case 'stand pistol move-front%0': return (29.5, 8.3, 1.1);
		case 'stand pistol move-front%1': return (29.5, 8.3, 1.1);
		}
		return hce_gunOffset;
	}
}

// HCE_FloodGruntPlasmaPistol: Halo variant "characters\flood grunt\flood grunt plasma pistol", plasma pistol, 75 body, 4 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_FloodGruntPlasmaPistol : HCE_FloodGruntBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
	{
		static const int K[] = { 6, 7, 8, 11, 12 };
		for(int i = 0; i < K.Size(); i++) if(K[i] == s) { A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN); return; }
		A_ChangeModel('None', 0, "", 'None', s, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowSurface(int s)
	{
		switch(s)
		{
		case 8: A_ChangeModel('None', 0, "", 'None', 8, "models/hce/weapons", 'w_plasma_pistol_0.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
	override void HCE_DressSurfaces()
	{
		A_ChangeModel('None', 0, "", 'None', 8, "models/hce/weapons", 'w_plasma_pistol_0.png', CMDL_USESURFACESKIN);
	}

	//$Category "Halo CE/Flood/Flood Grunt"
	//$Title "Flood Grunt (Plasma Pistol)"
	//$Sprite "HU28A0"
	Default
	{
		Health 75;
		Speed 5.9;
		HaloDoom_EnemyBase.HCE_Type 9;
		HaloDoom_EnemyBase.HCE_Variant "flood grunt plasma pistol";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 160;
		HaloDoom_EnemyBase.HCE_Movement 3.83, 5.89, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 0.00;
		HaloDoom_EnemyBase.HCE_Weapon "HCE_PlasmaPistolBolt", 1, 5.00, 2.00, 1200;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 77.5;
		HaloDoom_EnemyBase.HCE_DamageModifier 1.00;
		HaloDoom_EnemyBase.HCE_CombatRange 80, 400;
