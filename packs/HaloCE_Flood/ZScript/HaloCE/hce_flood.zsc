// ---- FloodEliteArmored: the body every FloodEliteArmored variant below is drawn with (characters\floodcombat elite new\armored\floodcombat elite armored): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every FloodEliteArmored; one variant's numbers are in its own class
class HCE_FloodEliteArmoredBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_FLOOD";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_FLOOD;
		Height 56;
		Radius 16;
		Mass 166;
		PainChance 0;
		Tag "FloodEliteArmored";
		BloodColor "76 70 3A";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override bool HCE_SeverLimb(int limb)
	{
		if(hce_severed & (1 << limb)) return false;
		switch(limb)
		{
		case 0:
			HCE_HideSurface(0);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(2);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(3);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 3, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_ShowSurface(1);
			HCE_ShowSurface(4);
			HCE_SpawnLimb(0, (0.0711, 0.0016, 0.6552), 80.00, "models/hce/FloodEliteArmored", 'FloodEliteArmored_gib_head.iqm', 18, 'gore_FloodEliteArmored.png', 0.0753);
			HCE_OnSever(0, false);
			return true;
		case 1:
			HCE_HideSurface(5);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 5, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_ShowSurface(6);
			HCE_SpawnLimb(1, (0.0045, 0.1705, 0.3773), 80.00, "models/hce/FloodEliteArmored", 'FloodEliteArmored_gib_larm.iqm', 18, 'gore_FloodEliteArmored.png', 0.0695);
			HCE_OnSever(1, false);
			return true;
		case 2:
			HCE_HideSurface(10);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(11);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(14);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(15);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 15, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(16);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 16, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_HideSurface(17);
			if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 17, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			HCE_ShowSurface(12);
			HCE_SpawnLimb(2, (0.0113, -0.1403, 0.4113), 80.00, "models/hce/FloodEliteArmored", 'FloodEliteArmored_gib_rarm.iqm', 18, 'gore_FloodEliteArmored.png', 0.0641);
			HCE_OnSever(2, true);
			return true;
		}
		return false;
	}
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		static const int D[] = { 1, 4, 6, 12 };
		for(int i = 0; i < D.Size(); i++) HCE_HideSurface(D[i]);
		HCE_ResumeAnim();
	}
	override vector3 HCE_LimbOffset(int limb)
	{
		switch(limb)
		{
		case 0: return (5.7, 0.1, 62.9);
		case 1: return (0.4, 13.6, 36.2);
		case 2: return (0.9, -11.2, 39.5);
		}
		return (0, 0, -1000);
	}
	override int HCE_GunLimb() { return 2; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/FloodEliteArmored", 'FloodEliteArmored_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/FloodEliteArmored", 'FloodEliteArmored_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/FloodEliteArmored", 'FloodEliteArmored_blood3.iqm'); break;
		}
	}
	override void HCE_BloodHideLimb(int limb)
	{
		switch(limb)
		{
		case 0:
			A_ChangeModel('None', 7, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 3, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 1:
			A_ChangeModel('None', 7, "", 'None', 5, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		case 2:
			A_ChangeModel('None', 7, "", 'None', 10, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 7, "", 'None', 11, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
			break;
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		static const int W[] = { 14, 15, 16, 17 };
		for(int i = 0; i < W.Size(); i++)
		{
			if(show) HCE_ShowSurface(W[i]);
			else HCE_HideSurface(W[i]);    // the guns it never held stay undrawn
		}
	}
}

// HCE_FloodcombatEliteMajorNeedler: Halo variant "characters\floodcombat elite shield\floodcombat elite major needler", needler, 45 body / 100 shield, 4 behaviour flags
// (the editor keys below are Ultimate Doom Builder's; the numbers are explained at the top of this file)
class HCE_FloodcombatEliteMajorNeedler : HCE_FloodEliteArmoredBase
{
	// lib/modeldef_prune.py: the surfaces this class's MODELDEF leaves undrawn are hidden by setting them back
	// to it (the engine skips them); the ones its spawn dressing may hide get their skins here as it spawns
	override void HCE_HideSurface(int s)
	{
		static const int K[] = { 1, 4, 6, 12, 14, 15, 16, 17 };
		for(int i = 0; i < K.Size(); i++) if(K[i] == s) { A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN); return; }
		A_ChangeModel('None', 0, "", 'None', s, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowSurface(int s)
	{
		switch(s)
		{
		case 1: A_ChangeModel('None', 0, "", 'None', 1, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN); return;
		case 4: A_ChangeModel('None', 0, "", 'None', 4, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN); return;
		case 6: A_ChangeModel('None', 0, "", 'None', 6, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN); return;
		case 12: A_ChangeModel('None', 0, "", 'None', 12, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN); return;
		case 14: A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'w_needler_glow.png', CMDL_USESURFACESKIN); return;
		case 15: A_ChangeModel('None', 0, "", 'None', 15, "models/hce/weapons", 'w_needler_1.png', CMDL_USESURFACESKIN); return;
		}
		A_ChangeModel('None', 0, "", 'None', s, "", 'None', CMDL_USESURFACESKIN);
	}
	override void HCE_DressSurfaces()
	{
		A_ChangeModel('None', 0, "", 'None', 1, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 4, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 6, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 12, "models/hce/FloodEliteArmored", 'skins/floodcombatelitemajorneedler_floodelitearmored_1.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 14, "models/hce/weapons", 'w_needler_glow.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 15, "models/hce/weapons", 'w_needler_1.png', CMDL_USESURFACESKIN);
	}

	//$Category "Halo CE/Flood/Flood Elite Armored"
	//$Title "Floodcombat Elite Major (Needler)"
	//$Sprite "HU2RA0"
	Default
	{
