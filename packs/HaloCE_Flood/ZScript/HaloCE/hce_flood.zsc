		+HaloDoom_EnemyBase.HCE_Leaps
		+HaloDoom_EnemyBase.HCE_Resurrects
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand pistol idle';
		case HCE_A_ALERT: return 'stand pistol idle';
		case HCE_A_MOVE_F: { static const Name o[] = { 'stand pistol move-front%0', 'stand pistol move-front%1' }; return o[random(0, 1)]; }
		case HCE_A_CROUCH_MOVE: return 'crouch pistol move-front';
		case HCE_A_FLEE: return 'flee pistol move-front';
		case HCE_A_FIRE: return 'stand pistol ar fire-1%0 baked';
		case HCE_A_MELEE: { static const Name o[] = { 'stand pistol melee%0', 'stand pistol melee%1' }; return o[random(0, 1)]; }
		case HCE_A_SURPRISE_F: return 'stand pistol surprise-front';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LAND: return 'stand pistol land-hard';
		case HCE_A_LEAP_START: return 'stand pistol leap-start';
		case HCE_A_LEAP_AIR: return 'stand pistol leap-airborne';
		case HCE_A_LEAP_MELEE: return 'stand pistol leap-melee';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%0 baked', 's-ping front gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%0 baked', 's-ping back gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%0 baked', 's-ping left gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%0 baked', 's-ping right gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-hand', 'h-ping front r-hand' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: return 's-kill front gut%0';
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_RESURRECT_F: return 'stand unarmed resurrect-front';
		case HCE_A_RESURRECT_B: return 'stand unarmed resurrect-back';
		case HCE_A_TURN_L: return 'stand pistol turn-left';
		case HCE_A_TURN_R: return 'stand pistol turn-right';
		case HCE_A_HOIST: return 'stand pistol hoist';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'crouch pistol move-front': return 42;
		case 'flee pistol move-front': return 47;
		case 'h-kill back gut': return 57;
		case 'h-kill front gut': return 54;
		case 'h-ping back gut': return 42;
		case 'h-ping front chest': return 43;
		case 'h-ping front gut': return 47;
		case 'h-ping front l-hand': return 49;
		case 'h-ping front r-hand': return 49;
		case 's-kill back gut': return 69;
		case 's-kill front gut%0': return 57;
		case 's-kill left gut': return 47;
		case 's-kill right gut': return 66;
		case 's-ping back gut%0 baked': return 24;
		case 's-ping back gut%1 baked': return 24;
		case 's-ping front gut%0 baked': return 24;
		case 's-ping front gut%1 baked': return 24;
		case 's-ping left gut%0 baked': return 24;
		case 's-ping left gut%1 baked': return 24;
		case 's-ping right gut%0 baked': return 24;
		case 's-ping right gut%1 baked': return 24;
		case 'stand airborne-dead': return 43;
		case 'stand landing-dead': return 40;
		case 'stand pistol airborne': return 37;
		case 'stand pistol ar fire-1%0 baked': return 12;
		case 'stand pistol hoist': return 61;
		case 'stand pistol idle': return 140;
		case 'stand pistol land-hard': return 65;
		case 'stand pistol leap-airborne': return 29;
		case 'stand pistol leap-melee': return 21;
		case 'stand pistol leap-start': return 6;
		case 'stand pistol melee%0': return 60;
		case 'stand pistol melee%1': return 43;
		case 'stand pistol move-front%0': return 28;
		case 'stand pistol move-front%1': return 26;
		case 'stand pistol surprise-front': return 47;
		case 'stand pistol turn-left': return 16;
		case 'stand pistol turn-right': return 16;
		case 'stand unarmed resurrect-back': return 27;
		case 'stand unarmed resurrect-front': return 27;
		}
		return 30;
	}
	// the ground each moving clip covers in map units a tic (its root motion), so the stride matches the walk
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand pistol hoist': return (0.0, 0.0, 153.7);
		}
		return (0, 0, 0);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch pistol move-front': return (27.7, 10.8, 10.9);
		case 'flee pistol move-front': return (26.9, 20.8, 20.5);
		case 'stand pistol move-front%0': return (22.5, 9.4, 1.5);
		case 'stand pistol move-front%1': return (22.7, 9.9, 1.8);
		}
		return hce_gunOffset;
	}
}

