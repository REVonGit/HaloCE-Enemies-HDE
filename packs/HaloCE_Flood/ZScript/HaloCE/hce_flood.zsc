		if(hce_severed & (1 << 0)) A_ChangeModel('None', 0, "", 'None', 1, "models/hce/FloodElite/skins", 'floodcombatelitestealthunarmed_floodelite_1_plain.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 2, "models/hce/FloodElite/skins", 'floodcombatelitestealthunarmed_floodelite_0_plain.png', CMDL_USESURFACESKIN);
