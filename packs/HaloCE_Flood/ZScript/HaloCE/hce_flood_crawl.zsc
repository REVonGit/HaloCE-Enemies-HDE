// The Flood's small crawlers (Infection Forms, Flood Jackals) climb walls and creep along ceilings, and the Flood
// Jackal's spit and the Flood Wolf's spikes (SPV3's flood_spider and flood_wolf weapons).
//
// Crawling (HCE_FloodCrawler, mixed into HCE_FloodInfectionBase and HCE_FloodJackalBase; their See state runs
// HCE_CrawlThink in place of HCE_Think):
//  * a ledge: a wall between it and its target whose top (the far side's floor) is above its step height and at or
//    below the target's feet is climbed, and it steps off onto the ledge;
//  * an ambush: a solid wall up to an indoor ceiling (not sky) beside or ahead of it, now and then, while its target is
//    a little way off: it climbs to the ceiling, creeps along it to above the target and drops on it. It drops early
//    when the ceiling steps, when hurt (sometimes), when the target is lost, or after 15 seconds up there.
// The models turn about their middle (MODELDEF UseRotationCenter): pitched up on a wall, rolled over on a ceiling.

mixin class HCE_FloodCrawler
{
	int hce_crawl;            // 0 on its feet, 1 on a wall, 2 on the ceiling, 3 dropping from it
	bool hce_crawlToCeil;     // the climb ends on the ceiling (else on the ledge at hce_crawlTop)
	vector2 hce_wallN;        // the wall's normal (out of it, towards us)
	vector2 hce_wallAt;       // the point on the wall it climbs
	double hce_crawlTop;
	int hce_crawlTics, hce_crawlNext, hce_crawlHp;

	void HCE_CrawlThink()
	{
		if(health <= 0) { if(hce_crawl) HCE_CrawlEnd(); HCE_Think(); return; }
		if(hce_crawl == 0)
		{
			HCE_Think();
			if(health > 0 && level.maptime >= hce_crawlNext) HCE_CrawlTry();
			return;
		}
		hce_crawlTics++;
		// hurt up there: now and then it lets go
		if(health < hce_crawlHp && (hce_crawl == 1 || hce_crawl == 2) && random(0, 2) == 0) { hce_crawlHp = health; HCE_CrawlDrop(); return; }
		hce_crawlHp = health;
		if(hce_crawl == 1) HCE_WallTick();
		else if(hce_crawl == 2) HCE_CeilTick();
		else HCE_DropTick();
	}

	// ---- starting a climb
	void HCE_CrawlTry()
	{
		hce_crawlNext = level.maptime + 10;
		if(!target || target.health <= 0 || !InStateSequence(CurState, ResolveState("See"))) return;
		if(hce_leapState > 0 || hce_jumpState > 0 || hce_animLock > 0 || pos.z > floorz + 1 || bNOGRAVITY) return;
		double toT = AngleTo(target), d = Distance2D(target);
		if(HCE_CrawlProbe(toT, d, false)) return;
		// now and then a wall to one side for a ceiling ambush
		if(d > 192 && d < 1400 && random(0, 5) == 0) HCE_CrawlProbe(toT + (random(0, 1) ? 90 : -90), d, true);
	}
	bool HCE_CrawlProbe(double ang, double d, bool ambushOnly)
	{
		FLineTraceData t;
		if(!LineTrace(ang, radius + (ambushOnly ? 64 : 24), 0, TRF_THRUACTORS, MaxStepHeight + 6, data: t)) return false;
		if(t.HitType != TRACE_HitWall || !t.HitLine) return false;
		Line ln = t.HitLine;
		vector2 n = (ln.delta.y, -ln.delta.x).Unit();
		if(t.LineSide == Line.back) n = -n;
		if(n dot (cos(ang), sin(ang)) > -0.5) return false;          // a wall met edge-on
		Sector here = level.PointInSector(pos.xy);
		Sector far = ln.sidedef[1] ? (t.LineSide == Line.front ? ln.backsector : ln.frontsector) : null;
		vector2 at = t.HitLocation.xy;
		if(far && !(ln.flags & (Line.ML_BLOCKING | Line.ML_BLOCKMONSTERS | Line.ML_BLOCKEVERYTHING)))
		{
			if(ambushOnly) return false;
			// a ledge: worth climbing only towards a target up there
			double top = far.floorplane.ZAtPoint(at - n * 8), room = far.ceilingplane.ZAtPoint(at - n * 8) - top;
			if(top - pos.z <= MaxStepHeight || top - pos.z > 640 || room < height + 2) return false;
			if(target.pos.z < top - 24) return false;
			hce_crawlToCeil = false; hce_crawlTop = top;
		}
		else
		{
			// a solid wall to the ceiling: an ambush from above, not every time
			if(far) return false;                                        // an impassable two-sided line: leave it
			double cz = here.ceilingplane.ZAtPoint(pos.xy);
			if(here.GetTexture(Sector.ceiling) == skyflatnum || cz - floorz < height + 48 || cz - floorz > 768) return false;
			if(d < 192 || d > 1400 || random(0, 99) >= (ambushOnly ? 60 : 20)) return false;
			hce_crawlToCeil = true; hce_crawlTop = cz;
		}
		hce_wallN = n; hce_wallAt = at;
		hce_crawl = 1; hce_crawlTics = 0; hce_crawlHp = health;
		bNOGRAVITY = true; vel = (0, 0, 0);
		A_SetAngle(atan2(-n.y, -n.x), SPF_INTERPOLATE);
		HCE_Play(HCE_A_MOVE_F, true, true);
		return true;
	}

	// ---- on the wall: straight up it, belly to it
	void HCE_WallTick()
	{
		if(!target || target.health <= 0 || hce_crawlTics > 35 * 8) { HCE_CrawlDrop(); return; }
		double spd = max(3.0, hce_runSpeed * 0.7);
		vector2 xy = hce_wallAt + hce_wallN * max(radius * 0.5, height * 0.5);
		vel = (0, 0, 0);
		vector2 gap = xy - pos.xy;
		if(gap.Length() > 2 && pos.z < floorz + 2)
		{
			// to the foot of the wall first
			SetOrigin((pos.xy + gap.Unit() * min(gap.Length(), max(4.0, hce_runSpeed)), pos.z), true);
			HCE_Play(HCE_A_MOVE_F);
			return;
		}
		double z = pos.z + spd;
		A_SetPitch(max(-90.0, pitch - 30), SPF_INTERPOLATE);
		if(hce_crawlToCeil)
		{
			double cz = level.PointInSector(hce_wallAt + hce_wallN * 2).ceilingplane.ZAtPoint(hce_wallAt);
			if(z + height >= cz - 1)
			{
				// over onto the ceiling, upside down, a body's width out from the wall
				vector2 c = hce_wallAt + hce_wallN * (radius + 2);
				SetOrigin((c, level.PointInSector(c).ceilingplane.ZAtPoint(c) - height), true);
				hce_crawl = 2; hce_crawlTics = 0;
				A_SetPitch(0, SPF_INTERPOLATE); A_SetRoll(180, SPF_INTERPOLATE);
				return;
			}
		}
		else if(z >= hce_crawlTop)
		{
			// up and over the edge onto the ledge
			vector2 c = hce_wallAt - hce_wallN * (radius + 4);
			vector3 old = pos;
			SetOrigin((c, hce_crawlTop), true);
			if(!TestMobjLocation()) { SetOrigin(old, true); HCE_CrawlDrop(); return; }
			HCE_CrawlEnd();
			return;
		}
		SetOrigin((xy, z), true);
		HCE_Play(HCE_A_MOVE_F);
	}

	// ---- on the ceiling: creeping on to above the target, then down on it
	void HCE_CeilTick()
	{
		if(!target || target.health <= 0 || hce_crawlTics > 35 * 15) { HCE_CrawlDrop(); return; }
		double d = Distance2D(target);
		if(d > 1600) { HCE_CrawlDrop(); return; }
		double toT = AngleTo(target);
		A_SetAngle(angle + clamp(DeltaAngle(angle, toT), -12, 12), SPF_INTERPOLATE);
		A_SetRoll(180, SPF_INTERPOLATE);
		if(d < radius + target.radius + 24) { HCE_CrawlDrop(); return; }
		if(hce_projectile != 'None' && d < hce_maxRange && CheckSight(target)) HCE_UpdateFiring(d);
		double spd = max(2.0, hce_runSpeed * 0.6);
		vector2 step = (cos(toT), sin(toT)) * min(spd, d);
		vector2 to = pos.xy + step;
		Sector s = level.PointInSector(to);
		double cz = s.ceilingplane.ZAtPoint(to);
		if(abs(cz - (pos.z + height)) > 16 || s.GetTexture(Sector.ceiling) == skyflatnum || cz - s.floorplane.ZAtPoint(to) < height + 8)
		{
			HCE_CrawlDrop(); return;                                     // the ceiling steps or opens: down here
		}
		vector3 old = pos;
		SetOrigin((to, cz - height), true);
		if(!TestMobjLocation()) { SetOrigin(old, true); HCE_CrawlDrop(); return; }
		vel = (0, 0, 0);
		HCE_Play(HCE_A_MOVE_F);
	}

	// ---- letting go: falls, turning back over on the way down
	void HCE_CrawlDrop()
	{
		bool ceil = hce_crawl == 2;
		hce_crawl = 3; hce_crawlTics = 0;
		bNOGRAVITY = false;
		if(hce_crawl == 3 && !ceil)
		{
			// off a wall: pushed clear of it
			SetOrigin((hce_wallAt + hce_wallN * (radius + 2), pos.z), true);
			if(!TestMobjLocation()) SetOrigin((hce_wallAt + hce_wallN * (radius + 6), pos.z), true);
		}
		vel = (0, 0, -2);
		if(target) { vector2 dir = (target.pos.xy - pos.xy); if(dir.Length() > 1) vel.xy = dir.Unit() * min(6.0, dir.Length() / 8); }
	}
	void HCE_DropTick()
	{
		A_SetRoll(roll * 0.6, SPF_INTERPOLATE);
		A_SetPitch(pitch * 0.6, SPF_INTERPOLATE);
		if(pos.z <= floorz + 1 || hce_crawlTics > 35 * 3) HCE_CrawlEnd();
	}
	void HCE_CrawlEnd()
	{
		hce_crawl = 0;
		bNOGRAVITY = false;
		A_SetRoll(0); A_SetPitch(0);
		hce_crawlNext = level.maptime + 35 * 2;
	}

	override void Die(Actor source, Actor inflictor, int dmgflags, Name MeansOfDeath)
	{
		if(hce_crawl) { hce_crawl = 0; bNOGRAVITY = false; A_SetRoll(0); A_SetPitch(0); }
		super.Die(source, inflictor, dmgflags, MeansOfDeath);
	}
}

// ---- the Flood Wolf's spikes: a slow bone spike (SPV3's flood_wolf spike, at a quarter of a Spiker round's speed)
class HCE_FloodWolfSpike : HCE_SpikerSpike
{
	Default
	{
		Speed 24;
		HaloSlowProjectile.Speed_MPS 104;     // HDE sets the flight speed from this as it launches (Speed: the aim's)
		HaloSlowProjectile.BaseDamage 12;     // about a sixth of a Spartan's shield a hit: a volley strips it, the bite finishes
		Translation "0:255=@60[230, 205, 150]";
	}
	// launched (and its speed set): the height of its line put on the target's chest, the sideways spread kept
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		let foe = target ? target.target : null;
		if(!foe || !bMISSILE || vel.xy.Length() < 1) return;
		vector3 to = level.Vec3Diff(pos, foe.pos + (0, 0, foe.height * 0.6));
		double flat = to.xy.Length();
		if(flat < 1) return;
		vel.z = to.z / flat * vel.xy.Length() + frandom(-0.3, 0.3);
	}
}

// ---- the Flood Jackal's spit: a glob of Flood bile on a shallow arc; a little damage, a yellow splash
class HCE_FloodSpit : Actor
{
	Default
	{
		Projectile;
		-NOGRAVITY
		Gravity 0.1;
		Speed 30;
		Radius 4;
		Height 6;
		DamageFunction (4);
		DamageType "Poison";
		RenderStyle "None";
	}
	void Glob(double size, double a, int life)
	{
		TextureID g = TexMan.CheckForTexture("HCEGLOW", TexMan.Type_Any);
		FSpawnParticleParams p;
		p.color1 = Color(255, 200, 190, 60);
		p.texture = g;
		p.style = STYLE_Translucent;
		p.flags = SPF_FULLBRIGHT | SPF_REPLACE;
		p.lifetime = life;
		p.size = size;
		p.sizestep = -size / max(1, life);
		p.startalpha = a;
		p.fadestep = -1;
		p.pos = pos + (0, 0, height * 0.5);
		Level.SpawnParticle(p);
	}
	override void Tick()
	{
		super.Tick();
		if(bDESTROYED || !bMISSILE || IsFrozen()) return;
		Glob(9, 0.9, 2);
		Glob(5, 0.6, 8);
	}
	States
	{
	Spawn:
		TNT1 A 1;
		Loop;
	Death:
		TNT1 A 1
		{
			A_StartSound("HCE/FloodAcid/Splat", CHAN_BODY, 0, 0.9);
			for(int i = 0; i < 8; i++)
				A_SpawnParticle(Color(200, 190, 60), SPF_FULLBRIGHT | SPF_RELATIVE, 18, 4, random(0, 359),
					0, 0, 2, frandom(0.5, 2.5), 0, frandom(0.5, 2.5), 0, 0, -0.2);
			HCE_FloodAcid.Pool(self, target);
		}
		Stop;
	}
}

// ---- where the spit lands: a puddle of bile on the floor below (within 64 units), sizzling for four seconds and
// eating at anything not Flood that stands in it (2 a third of a second); a glob landing in a puddle feeds it instead
class HCE_FloodAcid : Actor
{
	int life;
	Default
	{
		+NOBLOCKMAP
		+NOGRAVITY
		+DONTSPLASH
		+NOINTERACTION
		Radius 28;
		Height 8;
		RenderStyle "None";
	}
	static void Pool(Actor glob, Actor owner)
	{
		if(!glob || glob.pos.z - glob.floorz > 64) return;
		Sector sec = level.PointInSector(glob.pos.xy);
		if(sec && sec.GetTexture(Sector.floor) == skyflatnum) return;
		vector3 at = (glob.pos.xy, glob.floorz);
		let it = ThinkerIterator.Create("HCE_FloodAcid");
		HCE_FloodAcid a;
		while(a = HCE_FloodAcid(it.Next()))
			if(a.Distance2D(glob) < 32 && abs(a.pos.z - at.z) < 8) { a.life = 0; return; }   // fed: four seconds more
		let n = HCE_FloodAcid(Actor.Spawn("HCE_FloodAcid", at));
		if(n) n.target = owner;
	}
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		A_StartSound("HCE/FloodAcid/Loop", CHAN_BODY, CHANF_LOOPING, 0.55, 1.5);
		let st = Spawn("HCE_FloodBurstPool", pos);     // the bile left on the floor (it lingers, then fades)
		if(st) st.A_SetScale(0.7);
	}
	override void Tick()
	{
		if(IsFrozen()) return;
		life++;
		if(life >= 35 * 4)
		{
			A_StopSound(CHAN_BODY);
			A_StartSound("HCE/FloodAcid/Fade", CHAN_AUTO, 0, 0.55, 1.5);
			Destroy();
			return;
		}
		// bubbling: soft bile-yellow blobs swelling up off the floor and popping
		if(!(life % 2))
		{
			double r = frandom(0, radius * 0.7), a = frandom(0, 360);
			FSpawnParticleParams p;
			p.color1 = Color(255, 190, 200, 55);
			p.texture = TexMan.CheckForTexture("HCEGLOW", TexMan.Type_Any);
			p.style = STYLE_Translucent;
			p.flags = SPF_FULLBRIGHT | SPF_REPLACE;
			p.lifetime = random(12, 24);
			p.size = frandom(4, 9);
			p.sizestep = 0.25;
			p.startalpha = life > 35 * 3 ? 0.5 * (35 * 4 - life) / 35.0 : 0.5;
			p.fadestep = -1;
			p.pos = pos + (cos(a) * r, sin(a) * r, 1);
			p.vel = (0, 0, frandom(0.15, 0.45));
			Level.SpawnParticle(p);
		}
		if(life % 10) return;
		let bi = BlockThingsIterator.Create(self, radius + 32);
		while(bi.Next())
		{
			Actor t = bi.thing;
			if(!t || t == self || !t.bSHOOTABLE || t.health <= 0 || t.species == 'HCE_FLOOD') continue;
			if(Distance2D(t) > radius + t.radius || t.pos.z > pos.z + 8 || t.pos.z + t.height < pos.z) continue;
			t.DamageMobj(self, target, 2, 'Poison', DMG_THRUSTLESS);
		}
	}
}
