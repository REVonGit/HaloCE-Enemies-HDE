// The Flood Dr'aeth (generator/post/flood_draeth.py; written by it, edit there): a Dr'aeth (Reaver) taken by the Flood.
// One class over each Flood Elite class: the Flood Elite in everything but its body (models/hce/FloodDraeth, the
// pack author's: the Flood Elite with the Dr'aeth's 1999 armour and helmet grown into it). The infection forms raise a
// dead Dr'aeth as one (HCE_HostForm).

mixin class HCE_FloodDraethBody
{
	// its own head flies off (the arms are the Flood Elite's), its own body under the blood, an Elite's footsteps
	override bool HCE_SeverLimb(int limb)
	{
		if(limb != 0 || (hce_severed & 1)) return super.HCE_SeverLimb(limb);
		HCE_HideSurface(0);
		if(hce_shellActor) hce_shellActor.A_ChangeModel('None', 0, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		HCE_ShowSurface(1);
		HCE_SpawnLimb(0, (0.0278, -0.1105, 0.6441), 80.00, "models/hce/FloodDraeth", 'FloodDraeth_gib_head.iqm', 24, 'gore_FloodDraeth.png', 0.0804);
		HCE_OnSever(0, false);
		return true;
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/FloodDraeth", 'FloodDraeth_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/FloodDraeth", 'FloodDraeth_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/FloodDraeth", 'FloodDraeth_blood3.iqm'); break;
		}
	}
	override Name HCE_StepSet() { return 'elite'; }
}

class HCE_FloodcombatDraethAssaultRifle : HCE_FloodcombatEliteAssaultRifle
{
	mixin HCE_FloodDraethBody;
	//$Category "Halo CE/Flood/Flood Dr'aeth"
	//$Title "Floodcombat Dr'aeth (Assault Rifle)"
	//$Sprite "HU2OA0"
	Default
	{
		Tag "FloodDraeth";
		HaloDoom_EnemyBase.HCE_Variant "floodcombat draeth assault rifle";
	}
}

