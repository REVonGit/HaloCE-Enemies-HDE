// Halo CE and Halo 2 blood decals for the flood (extract_halo_gore.py), used by hce_gore.zsc in the core pack
Fader HCEGoreFade
{
	DecayStart 60.0
	DecayTime 20.0
}

Decal HCEG_flood_h2_flood_splat_0
{
	Pic "graphics/hcegore/h2_flood_splat_0.png"
	Translucent 0.95
	X-Scale 0.80
	Y-Scale 0.80
	RandomFlipX
	RandomFlipY
	Animator HCEGoreFade
}

Decal HCEG_flood_h2_flood_splat_1
{
	Pic "graphics/hcegore/h2_flood_splat_1.png"
	Translucent 0.95
	X-Scale 0.80
	Y-Scale 0.80
	RandomFlipX
	RandomFlipY
	Animator HCEGoreFade
}

