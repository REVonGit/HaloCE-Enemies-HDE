// the Flood's blood: Halo 2's flood_splat and flood_splat_large (extract_flood_gore.py)

// (a fader of its own: the merged pk3 reads this file before the Covenant pack's decaldef.hcegore and its HCEGoreFade)
Fader HCEFloodGoreFade
{
	DecayStart 90.0
	DecayTime 25.0
}

Decal HCEG_h2_flood_splat_0
{
	Pic "graphics/hcegore/h2_flood_splat_0.png"
	Translucent 0.95
	X-Scale 1.10
	Y-Scale 1.10
	RandomFlipX
	RandomFlipY
	Animator HCEFloodGoreFade
}

Decal HCEG_h2_flood_splat_1
{
	Pic "graphics/hcegore/h2_flood_splat_1.png"
	Translucent 0.95
	X-Scale 1.10
	Y-Scale 1.10
	RandomFlipX
	RandomFlipY
	Animator HCEFloodGoreFade
}

Decal HCEG_h2_flood_splat_2
{
	Pic "graphics/hcegore/h2_flood_splat_2.png"
	Translucent 0.95
	X-Scale 1.10
	Y-Scale 1.10
	RandomFlipX
	RandomFlipY
	Animator HCEFloodGoreFade
}

Decal HCEG_h2_flood_splat_3
{
	Pic "graphics/hcegore/h2_flood_splat_3.png"
	Translucent 0.95
	X-Scale 1.10
	Y-Scale 1.10
	RandomFlipX
	RandomFlipY
	Animator HCEFloodGoreFade
}

Decal HCEG_h2_flood_splat_large
{
	Pic "graphics/hcegore/h2_flood_splat_large.png"
	Translucent 0.95
	X-Scale 1.60
	Y-Scale 1.60
	RandomFlipX
	RandomFlipY
	Animator HCEFloodGoreFade
}

DecalGroup HCEGore_Flood
{
	HCEG_h2_flood_splat_0 1
	HCEG_h2_flood_splat_1 1
	HCEG_h2_flood_splat_2 1
	HCEG_h2_flood_splat_3 1
}

DecalGroup HCEGore_FloodBig
{
	HCEG_h2_flood_splat_0 1
	HCEG_h2_flood_splat_1 1
	HCEG_h2_flood_splat_2 1
	HCEG_h2_flood_splat_3 1
	HCEG_h2_flood_splat_large 1
	HCEG_h2_flood_splat_large 2
}

