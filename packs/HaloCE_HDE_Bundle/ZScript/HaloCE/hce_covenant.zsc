		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_CELEBRATE: return 'stand pistol celebrate';
		case HCE_A_TURN_L: return 'stand pistol turn-left';
		case HCE_A_TURN_R: return 'stand pistol turn-right';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		switch(anim)
		{
		case 'alert pistol idle': return 70;
		case 'crouch pistol idle': return 54;
		case 'crouch pistol move-front': return 42;
		case 'flee pistol move-front': return 21;
		case 'h-kill back gut': return 49;
		case 'h-kill front gut': return 52;
		case 'h-ping back gut': return 38;
		case 'h-ping back l-arm': return 32;
		case 'h-ping back r-arm': return 33;
		case 'h-ping front chest': return 41;
		case 'h-ping front gut': return 28;
		case 'h-ping front l-arm': return 43;
		case 'h-ping front l-foot': return 55;
		case 's-kill back gut': return 71;
		case 's-kill front gut': return 79;
		case 's-kill left gut': return 46;
		case 's-kill right gut': return 52;
		case 's-ping front r-hand%0 baked': return 10;
		case 's-ping front r-hand%1 baked': return 13;
		case 'stand airborne-dead': return 43;
		case 'stand landing-dead': return 24;
		case 'stand pistol airborne': return 72;
		case 'stand pistol celebrate': return 57;
		case 'stand pistol dive-front': return 75;
		case 'stand pistol dive-left': return 75;
		case 'stand pistol dive-right': return 75;
		case 'stand pistol evade-left': return 52;
		case 'stand pistol evade-right': return 58;
		case 'stand pistol idle': return 70;
		case 'stand pistol land-hard': return 97;
		case 'stand pistol move-back': return 28;
		case 'stand pistol move-front': return 28;
		case 'stand pistol move-left': return 28;
		case 'stand pistol move-right': return 28;
		case 'stand pistol pr fire-1 baked': return 7;
		case 'stand pistol signal-attack': return 77;
		case 'stand pistol surprise-back': return 47;
		case 'stand pistol surprise-front': return 64;
		case 'stand pistol turn-left': return 16;
		case 'stand pistol turn-right': return 16;
		case 'stand pistol warn': return 55;
		}
		return 30;
	}
}

