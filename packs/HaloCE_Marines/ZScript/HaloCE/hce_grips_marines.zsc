// ---- where the left hand holds each gun, and how it is turned to a fore-grip that hangs under its gun: the
// enemy API's HCE_GripTick (enemies_base.zsc) looks these up. Written by generator/grip_ik.py (why, and how each
// is measured); not for editing by hand: change its STATION, LIFT, HOLD or CURL and run it again.

class HCE_GripTable_Marines : HCE_GripReach
{
	// (the body an actor is: its place in this table)
	override int Rig(Actor a)
	{
		if(a is "HCE_MarineBase") return 0;
		if(a is "HCE_MarineArmoredBase") return 1;
		if(a is "HCE_MarineODSTBase") return 2;
		return -1;
	}
