	// (for a body, a gun and a stance: its arm's bones, where the stance has the left wrist, how far the hand is
	// moved, and where its bone's x and z face when it is turned upright)
	override bool Find(int rig, Name gun, Name stance)
	{
		gripTurn = false;
		switch(rig)
		{
		case 0: armU = 'bip01 l upperarm'; armF = 'bip01 l forearm'; armH = 'bip01 l hand'; handR = 'bip01 r hand'; break;
		case 1: armU = 'bip01 l upperarm'; armF = 'bip01 l forearm'; armH = 'bip01 l hand'; handR = 'bip01 r hand'; break;
		case 2: armU = 'bip01 l upperarm'; armF = 'bip01 l forearm'; armH = 'bip01 l hand'; handR = 'bip01 r hand'; break;
		default: return false;
		}
		if(rig == 0 && stance == 'h2bulldog')
		{
			gripRef = (-0.0378, -0.4504, 0.5183);
			if(gun == 'bulldog') { gripMove = (0.0035, 0.0062, -0.0003); gripTurn = true; gripX = (0.0771, -0.9016, 0.4256); gripZ = (-0.8241, -0.2979, -0.4818); return true; }
			return false;
		}
		if(rig == 0 && stance == 'h2smg')
		{
			gripRef = (-0.0056, -0.3571, 0.4956);
			if(gun == 'smg') { gripMove = (-0.0091, 0.0151, -0.0003); gripTurn = true; gripX = (0.0771, -0.9016, 0.4256); gripZ = (-0.8241, -0.2979, -0.4818); return true; }
			return false;
		}
		if(rig == 0 && stance == 'rifle')
		{
			gripRef = (-0.0280, -0.3826, 0.4984);
			if(gun == 'beam_rifle') { gripMove = (-0.0704, -0.0591, 0.0086); return true; }
			if(gun == 'carbine') { gripMove = (-0.0339, 0.0013, -0.0029); return true; }
			if(gun == 'commando') { gripMove = (0.0103, -0.0235, 0.0064); return true; }
			if(gun == 'double_barrel') { gripMove = (0.0112, -0.0006, 0.0004); return true; }
			if(gun == 'hydra') { gripMove = (0.0198, -0.0010, 0.0005); return true; }
			if(gun == 'needle_ballista') { gripMove = (-0.0416, 0.0016, -0.0037); return true; }
			if(gun == 'pulse_carbine') { gripMove = (-0.0339, 0.0013, -0.0029); return true; }
			if(gun == 'pump_shotgun') { gripMove = (0.0015, -0.0455, 0.0111); return true; }
			if(gun == 'sniper') { gripMove = (-0.0014, -0.0392, 0.0099); return true; }
			return false;
		}
		if(rig == 1 && stance == 'h2bulldog')
		{
			gripRef = (-0.0378, -0.4504, 0.5183);
			if(gun == 'bulldog') { gripMove = (0.0034, 0.0066, -0.0009); gripTurn = true; gripX = (0.0837, -0.9063, 0.4142); gripZ = (-0.8251, -0.2961, -0.4813); return true; }
			return false;
		}
		if(rig == 1 && stance == 'h2smg')
		{
			gripRef = (-0.0056, -0.3571, 0.4956);
			if(gun == 'smg') { gripMove = (-0.0092, 0.0155, -0.0009); gripTurn = true; gripX = (0.0837, -0.9063, 0.4142); gripZ = (-0.8250, -0.2961, -0.4813); return true; }
			return false;
		}
		if(rig == 1 && stance == 'rifle')
		{
			gripRef = (-0.0280, -0.3826, 0.4984);
			if(gun == 'beam_rifle') { gripMove = (-0.0703, -0.0587, 0.0085); return true; }
			if(gun == 'carbine') { gripMove = (-0.0338, 0.0013, -0.0029); return true; }
			if(gun == 'commando') { gripMove = (0.0104, -0.0231, 0.0062); return true; }
			if(gun == 'double_barrel') { gripMove = (0.0112, -0.0006, 0.0004); return true; }
			if(gun == 'hydra') { gripMove = (0.0198, -0.0010, 0.0006); return true; }
			if(gun == 'needle_ballista') { gripMove = (-0.0415, 0.0016, -0.0036); return true; }
			if(gun == 'pulse_carbine') { gripMove = (-0.0338, 0.0013, -0.0029); return true; }
			if(gun == 'pump_shotgun') { gripMove = (0.0015, -0.0450, 0.0109); return true; }
			if(gun == 'sniper') { gripMove = (-0.0014, -0.0387, 0.0098); return true; }
			return false;
		}
		if(rig == 2 && stance == 'rifle')
		{
			gripRef = (-0.0280, -0.3826, 0.4984);
			if(gun == 'double_barrel') { gripMove = (0.0112, -0.0006, 0.0004); return true; }
			if(gun == 'pump_shotgun') { gripMove = (0.0015, -0.0453, 0.0110); return true; }
			if(gun == 'sniper') { gripMove = (-0.0014, -0.0390, 0.0099); return true; }
			return false;
		}
		return false;
	}
