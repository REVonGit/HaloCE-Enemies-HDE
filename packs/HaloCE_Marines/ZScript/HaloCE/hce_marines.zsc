class HCE_MarineBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_HUMAN";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_HUMAN;
		Height 51;
		Radius 14;
		Mass 113;
		PainChance 0;
		Tag "Marine";
		BloodColor "A0 10 10";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
	}
}

// characters\marine\marine assault rifle
class HCE_MarineAssaultRifle : HCE_MarineBase
{
	Default
	{
		Health 12;
		+FRIENDLY
		Speed 6.5;
		HaloDoom_EnemyBase.HCE_Type 7;
		HaloDoom_EnemyBase.HCE_Variant "marine assault rifle";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 400;
		HaloDoom_EnemyBase.HCE_Movement 4.25, 6.53, 12;
		HaloDoom_EnemyBase.HCE_Weapon "HCE_ARBullet", 1, 10.00, 2.00, 1040;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 1008.0;
		HaloDoom_EnemyBase.HCE_DamageModifier 0.40;
		HaloDoom_EnemyBase.HCE_CombatRange 240, 480;
		HaloDoom_EnemyBase.HCE_Burst 0.60, 0.80, 1.00, 1.50, 0.25, 0.50;
		HaloDoom_EnemyBase.HCE_GunOffset (14.0, -0.0, -12.8);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 36, 55;
		HaloDoom_EnemyBase.HCE_Leap 0, 0, 0.00, 6.5;
		HaloDoom_EnemyBase.HCE_Grenades 1, 2, 0.25, 1.0, 240, 1120, 26.0;
		HaloDoom_EnemyBase.HCE_Panic 0.30, 0.00, 4.0, 6.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.10, 0.35, 0;
		HaloDoom_EnemyBase.HCE_Defensive 0.00, 0.00, 0.00, 0.75, 0.00;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 24, 5.0, 1.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_FirePattern 4, 7, 3, 1.00, 1.75, 0;
		HaloDoom_EnemyBase.HCE_FireSounds "Halo/Weapons/MA5B/Fire", "Halo/Weapons/MA5B/Fire/Bass", "", "";
		HaloDoom_EnemyBase.HCE_Drops "Halo_MA5B", "FragGrenades";
		+HaloDoom_EnemyBase.HCE_Evades
		+HaloDoom_EnemyBase.HCE_FollowPlayer
		+HaloDoom_EnemyBase.HCE_Panics
		+HaloDoom_EnemyBase.HCE_ThrowsGrenades
	}
	override Name HCE_AnimName(int kind)
	{
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand rifle idle';
		case HCE_A_ALERT: return 'alert rifle idle%0';
		case HCE_A_MOVE_F: return 'stand rifle move-front';
		case HCE_A_MOVE_B: return 'stand rifle move-back';
		case HCE_A_MOVE_L: return 'stand rifle move-left';
		case HCE_A_MOVE_R: return 'stand rifle move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch rifle idle';
		case HCE_A_CROUCH_MOVE: return 'crouch rifle move-front';
		case HCE_A_FLEE: return 'flee rifle move-front';
		case HCE_A_FIRE: return 'stand rifle ar fire-1 baked';
		case HCE_A_THROW: return 'stand rifle throw-grenade';
		case HCE_A_DIVE_L: return 'stand rifle dive-left';
		case HCE_A_DIVE_R: return 'stand rifle dive-right';
		case HCE_A_DIVE_F: return 'stand rifle dive-front';
		case HCE_A_EVADE_L: return 'stand rifle evade-left';
		case HCE_A_EVADE_R: return 'stand rifle evade-right';
		case HCE_A_BERSERK: return 'stand rifle berserk%3';
		case HCE_A_WARN: return 'stand rifle warn%1';
		case HCE_A_SIGNAL: return 'stand rifle signal-attack';
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%0 baked', 's-ping front gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-leg' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back chest', 'h-ping back gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 's-kill front chest', 's-kill front gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: { static const Name o[] = { 'h-kill front gut', 'h-kill front head' }; return o[random(0, 1)]; }
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: { static const Name o[] = { 'stand landing-dead', 'stand landing-dead%2' }; return o[random(0, 1)]; }
		case HCE_A_CELEBRATE: { static const Name o[] = { 'stand rifle celebrate%1', 'stand rifle celebrate%2', 'stand rifle celebrate%3' }; return o[random(0, 2)]; }
		case HCE_A_TURN_L: return 'stand rifle turn-left';
		case HCE_A_TURN_R: return 'stand rifle turn-right';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		switch(anim)
		{
		case 'alert rifle idle%0': return 93;
		case 'crouch rifle idle': return 70;
		case 'crouch rifle move-front': return 28;
		case 'flee rifle move-front': return 20;
		case 'h-kill back gut': return 47;
		case 'h-kill front gut': return 52;
