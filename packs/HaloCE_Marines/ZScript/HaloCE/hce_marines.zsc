	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand pistol hoist': return (40.6, -0.3, 34.9);
		case 'stand pistol vault': return (38.0, -3.3, -0.9);
		}
		return (0, 0, 0);
	}

	// the sticky detonator's muzzle: the charge seated in it when loaded, the empty muzzle once fired, until it
	// reloads (setting the charges off is the API's: HCE_StickyTick, for any Marine carrying one)
	int hce_stickyReload;
	override void HCE_OnShot(Actor shot)
	{
		super.HCE_OnShot(shot);
		if(hce_hasLoadout) return;             // traded / picked up something else: not this gun any more
		HCE_StickyFired();
		hce_stickyReload = level.maptime + 45;
	}
	void HCE_StickyLoaded()
	{
		A_ChangeModel('None', 6, "models/hce/MarineArmored", 'MarineArmored_w_sticky_detonator.iqm');
		A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_sticky_detonator_0.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_m_sticky_bomb_0.png', CMDL_USESURFACESKIN);
	}
	void HCE_StickyFired()
	{
		A_ChangeModel('None', 6, "models/hce/MarineArmored", 'MarineArmored_w_sticky_detonator_fired.iqm');
		A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_sticky_detonator_0.png', CMDL_USESURFACESKIN);
	}
	override void Tick()
	{
		super.Tick();
		if(hce_stickyReload > 0 && level.maptime >= hce_stickyReload && health > 0) { hce_stickyReload = 0; if(!hce_hasLoadout) HCE_StickyLoaded(); }
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show)
		{
			A_ChangeModel('None', 6, "models/hce/MarineArmored", 'MarineArmored_w_sticky_detonator.iqm');
			A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_sticky_detonator_0.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_m_sticky_bomb_0.png', CMDL_USESURFACESKIN);
		}
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}
}

class HCE_MarineODSTBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_HUMAN";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_HUMAN;
		Height 58;
		Radius 14;
		Mass 115;
		PainChance 0;
		Tag "MarineODST";
		BloodColor "A0 10 10";
		BloodType "HCE_HaloBlood";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/MarineODST", 'MarineODST_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/MarineODST", 'MarineODST_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/MarineODST", 'MarineODST_blood3.iqm'); break;
		}
	}
	// guns it can pick up off the ground (HaloDoom_EnemyBase.HCE_ScavengeScan): Halo_BattleRifle, Halo_Flamethrower, Halo_MA5B, Halo_RocketLauncher, Halo_Shotgun, Halo_SniperRifle
