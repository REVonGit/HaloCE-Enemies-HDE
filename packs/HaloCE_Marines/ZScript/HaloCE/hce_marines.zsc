		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%0 baked', 's-ping front gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-leg' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back chest', 'h-ping back gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 's-kill front chest', 's-kill front gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: { static const Name o[] = { 'h-kill front gut', 'h-kill front head' }; return o[random(0, 1)]; }
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: { static const Name o[] = { 'stand landing-dead', 'stand landing-dead%2' }; return o[random(0, 1)]; }
		case HCE_A_CELEBRATE: { static const Name o[] = { 'stand rifle celebrate%1', 'stand rifle celebrate%2', 'stand rifle celebrate%3' }; return o[random(0, 2)]; }
		case HCE_A_TURN_L: return 'stand rifle turn-left';
		case HCE_A_TURN_R: return 'stand rifle turn-right';
		case HCE_A_FLAME_IDLE: return 'flaming rifle idle';
		case HCE_A_FLAME_MOVE: return 'flaming rifle move-front';
		case HCE_A_RELOAD: return 'stand rifle reload-1';
		case HCE_A_VENT: return 'stand rifle overheat';
		case HCE_A_LOW_IDLE: return 'alert rifle idle%0';
		case HCE_A_LOW_MOVE: return 'alert rifle move-front%0';
		case HCE_A_COVER_L_ENTER: return 'stand rifle cover-left-enter';
		case HCE_A_COVER_L_IDLE: return 'stand rifle cover-left-idle';
		case HCE_A_COVER_L_PEEK: return 'stand rifle cover-left-peek';
		case HCE_A_COVER_L_OPEN: return 'stand rifle cover-left-open';
		case HCE_A_COVER_L_UNPEEK: return 'stand rifle cover-left-unpeek';
		case HCE_A_COVER_L_EXIT: return 'stand rifle cover-left-exit';
		case HCE_A_COVER_R_ENTER: return 'stand rifle cover-right-enter';
		case HCE_A_COVER_R_IDLE: return 'stand rifle cover-right-idle';
		case HCE_A_COVER_R_PEEK: return 'stand rifle cover-right-peek';
		case HCE_A_COVER_R_OPEN: return 'stand rifle cover-right-open';
		case HCE_A_COVER_R_UNPEEK: return 'stand rifle cover-right-unpeek';
		case HCE_A_COVER_R_EXIT: return 'stand rifle cover-right-exit';
		case HCE_A_HOIST: return 'stand rifle hoist';
		case HCE_A_VAULT: return 'stand rifle vault';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert rifle idle%0': return 93;
		case 'alert rifle move-front%0': return 35;
		case 'crouch rifle idle': return 70;
		case 'crouch rifle move-front': return 28;
		case 'flaming rifle idle': return 62;
		case 'flaming rifle move-front': return 40;
		case 'flee rifle move-front': return 20;
		case 'h-kill back gut': return 47;
		case 'h-kill front gut': return 52;
		case 'h-kill front head': return 70;
		case 'h-ping back chest': return 37;
		case 'h-ping back gut': return 48;
		case 'h-ping front chest': return 26;
		case 'h-ping front gut': return 22;
		case 'h-ping front l-arm': return 38;
		case 'h-ping front l-leg': return 57;
		case 's-kill back gut': return 47;
		case 's-kill front chest': return 51;
		case 's-kill front gut': return 79;
		case 's-kill left gut': return 70;
		case 's-kill right gut': return 54;
		case 's-ping front gut%0 baked': return 12;
		case 's-ping front gut%1 baked': return 12;
		case 'stand airborne-dead': return 43;
		case 'stand landing-dead': return 43;
		case 'stand landing-dead%2': return 66;
		case 'stand rifle airborne': return 92;
		case 'stand rifle ar fire-1 baked': return 5;
		case 'stand rifle berserk%3': return 51;
		case 'stand rifle celebrate%1': return 72;
		case 'stand rifle celebrate%2': return 80;
		case 'stand rifle celebrate%3': return 64;
		case 'stand rifle cover-left-enter': return 21;
		case 'stand rifle cover-left-exit': return 10;
		case 'stand rifle cover-left-idle': return 104;
		case 'stand rifle cover-left-open': return 2;
		case 'stand rifle cover-left-peek': return 16;
		case 'stand rifle cover-left-unpeek': return 16;
		case 'stand rifle cover-right-enter': return 21;
		case 'stand rifle cover-right-exit': return 10;
		case 'stand rifle cover-right-idle': return 104;
		case 'stand rifle cover-right-open': return 2;
		case 'stand rifle cover-right-peek': return 16;
		case 'stand rifle cover-right-unpeek': return 16;
		case 'stand rifle dive-front': return 90;
		case 'stand rifle dive-left': return 90;
		case 'stand rifle dive-right': return 90;
		case 'stand rifle evade-left': return 46;
		case 'stand rifle evade-right': return 46;
		case 'stand rifle hoist': return 34;
		case 'stand rifle idle': return 57;
		case 'stand rifle land-soft': return 46;
		case 'stand rifle move-back': return 23;
		case 'stand rifle move-front': return 23;
		case 'stand rifle move-left': return 23;
		case 'stand rifle move-right': return 23;
		case 'stand rifle overheat': return 69;
		case 'stand rifle reload-1': return 51;
		case 'stand rifle signal-attack': return 55;
		case 'stand rifle throw-grenade': return 72;
		case 'stand rifle turn-left': return 16;
		case 'stand rifle turn-right': return 16;
		case 'stand rifle vault': return 13;
		case 'stand rifle warn%1': return 51;
		}
		return 30;
	}
	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand rifle hoist': return (40.6, -0.3, 34.9);
		case 'stand rifle vault': return (38.0, -3.3, -2.2);
		}
		return (0, 0, 0);
	}
	// another sealed helmet in place of the ODST's own: helmet_closed (a Marine kit piece on the Marine's skeleton), silver visor
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "models/hce/MarineKit", "helmet_closed.iqm", 1, "", 'None');
		A_ChangeModel('None', 1, "", 'None', 1, "models/hce/MarineKit", 'mk_visor_silver.png', CMDL_USESURFACESKIN);
		HCE_ResumeAnim();
	}
	override void HCE_BloodHideClass()
	{
		A_ChangeModel('None', 7, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show)
		{
			A_ChangeModel('None', 6, "models/hce/MarineODST", 'Marine_w_sniper.iqm');
			A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_sniper_rifle_0.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_sniper_rifle_0.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 2, "models/hce/weapons", 'w_sniper_rifle_1.png', CMDL_USESURFACESKIN);
		}
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}
}

