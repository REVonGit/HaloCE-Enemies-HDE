	// a pilot (extract_h2_pilot.py): Halo 2's flight helmet over one of its faces, and none of the field kit
	override void HCE_KitOverride()
	{
		static const String F[] = { "smith", "banks", "dion", "morgan", "perez", "walter" };
		for(int i = 0; i < hce_kit.Size(); i++) hce_kit[i] = "";
		hce_kit[0] = "h2_pilot_" .. F[random[HCEKit](0, F.Size() - 1)];
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show)
		{
			A_ChangeModel('None', 6, "models/hce/Marine", 'Marine_w_magnum.iqm');
			A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_pistol_0.png', CMDL_USESURFACESKIN);
