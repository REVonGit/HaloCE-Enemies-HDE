		case 'crouch h2pistol idle': return 69;
		case 'crouch h2pistol move-front': return 28;
		case 'flaming rifle idle': return 62;
		case 'flaming rifle move-front': return 40;
		case 'flee rifle move-front': return 20;
		case 'h-kill back gut': return 47;
		case 'h-kill front gut': return 52;
		case 'h-kill front head': return 70;
		case 'h-ping back chest': return 37;
		case 'h-ping back gut': return 48;
		case 'h-ping front chest': return 26;
		case 'h-ping front gut': return 22;
		case 'h-ping front l-arm': return 38;
		case 'h-ping front l-leg': return 57;
		case 's-kill back gut': return 47;
		case 's-kill front chest': return 51;
		case 's-kill front gut': return 79;
		case 's-kill left gut': return 70;
		case 's-kill right gut': return 54;
		case 's-ping front gut%0 baked': return 12;
		case 's-ping front gut%1 baked': return 12;
		case 'stand airborne-dead': return 43;
		case 'stand h2pistol airborne': return 92;
		case 'stand h2pistol dive-front': return 90;
		case 'stand h2pistol dive-left': return 90;
		case 'stand h2pistol dive-right': return 90;
		case 'stand h2pistol evade-left': return 35;
		case 'stand h2pistol evade-right': return 35;
		case 'stand h2pistol fire-1 baked': return 13;
		case 'stand h2pistol idle': return 69;
		case 'stand h2pistol land-soft': return 35;
		case 'stand h2pistol melee': return 28;
		case 'stand h2pistol move-back': return 23;
		case 'stand h2pistol move-front': return 23;
		case 'stand h2pistol move-left': return 23;
		case 'stand h2pistol move-right': return 23;
		case 'stand h2pistol turn-left': return 16;
		case 'stand h2pistol turn-right': return 16;
		case 'stand h2pistol warn': return 51;
		case 'stand landing-dead': return 43;
		case 'stand landing-dead%2': return 66;
		case 'stand rifle berserk%3': return 51;
		case 'stand rifle celebrate%1': return 72;
		case 'stand rifle celebrate%2': return 80;
		case 'stand rifle celebrate%3': return 64;
		case 'stand rifle signal-attack': return 55;
		case 'stand rifle throw-grenade': return 72;
		}
		return 30;
	}

	// the sticky detonator: the Marine sets each charge off a second and a half after it lands
	Array<Actor> hce_stickies;
	Array<int> hce_stickyAt;
	// the gun shows its charge seated in the muzzle when loaded, the empty muzzle once fired, until it reloads
	int hce_stickyReload;
	override void HCE_OnShot(Actor shot)
	{
		if(shot) { hce_stickies.Push(shot); hce_stickyAt.Push(level.maptime + 52); }
		HCE_StickyFired();
		hce_stickyReload = level.maptime + 45;
	}
	void HCE_StickyLoaded()
	{
		A_ChangeModel('None', 6, "models/hce/MarineArmored", 'MarineArmored_w_sticky_detonator.iqm');
		A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_sticky_detonator_0.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_m_sticky_bomb_0.png', CMDL_USESURFACESKIN);
	}
	void HCE_StickyFired()
	{
		A_ChangeModel('None', 6, "models/hce/MarineArmored", 'MarineArmored_w_sticky_detonator_fired.iqm');
		A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_sticky_detonator_0.png', CMDL_USESURFACESKIN);
	}
	override void Tick()
	{
		super.Tick();
		if(hce_stickyReload > 0 && level.maptime >= hce_stickyReload && health > 0) { hce_stickyReload = 0; HCE_StickyLoaded(); }
		for(int i = hce_stickies.Size() - 1; i >= 0; i--)
		{
			Actor c = hce_stickies[i];
			if(c && level.maptime < hce_stickyAt[i]) continue;
			if(c) { State st = c.FindState("ExplodeAndDie"); if(st) c.SetState(st); }
			hce_stickies.Delete(i); hce_stickyAt.Delete(i);
		}
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show) A_ChangeModel('None', 6, "models/hce/MarineArmored", 'MarineArmored_w_sticky_detonator.iqm');
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}
}

