	override Name HCE_LoadoutAnim(int lo, int kind)
	{
		switch(lo)
		{
		case 0: return HCE_LoadoutAnim0(kind);
		case 1: return HCE_LoadoutAnim1(kind);
		case 2: return HCE_LoadoutAnim2(kind);
		case 3: return HCE_LoadoutAnim3(kind);
		case 4: return HCE_LoadoutAnim4(kind);
		case 5: return HCE_LoadoutAnim5(kind);
		case 6: return HCE_LoadoutAnim6(kind);
		case 7: return HCE_LoadoutAnim7(kind);
		case 8: return HCE_LoadoutAnim8(kind);
		case 9: return HCE_LoadoutAnim9(kind);
		case 10: return HCE_LoadoutAnim10(kind);
		case 11: return HCE_LoadoutAnim11(kind);
		case 12: return HCE_LoadoutAnim12(kind);
		case 13: return HCE_LoadoutAnim13(kind);
		case 14: return HCE_LoadoutAnim14(kind);
		case 15: return HCE_LoadoutAnim15(kind);
		case 16: return HCE_LoadoutAnim16(kind);
		case 17: return HCE_LoadoutAnim17(kind);
		case 18: return HCE_LoadoutAnim18(kind);
		case 19: return HCE_LoadoutAnim19(kind);
		case 20: return HCE_LoadoutAnim20(kind);
		case 21: return HCE_LoadoutAnim21(kind);
		case 22: return HCE_LoadoutAnim22(kind);
		case 23: return HCE_LoadoutAnim23(kind);
		case 24: return HCE_LoadoutAnim24(kind);
		case 25: return HCE_LoadoutAnim25(kind);
		case 26: return HCE_LoadoutAnim26(kind);
		case 27: return HCE_LoadoutAnim27(kind);
		}
		return 'None';
	}
	Name HCE_LoadoutAnim0(int kind)
	{
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand rifle idle';
		case HCE_A_ALERT: return 'stand rifle idle';
		case HCE_A_MOVE_F: return 'stand rifle move-front';
		case HCE_A_MOVE_B: return 'stand rifle move-back';
		case HCE_A_MOVE_L: return 'stand rifle move-left';
		case HCE_A_MOVE_R: return 'stand rifle move-right';
		case HCE_A_CROUCH_IDLE: return 'crouch rifle idle';
		case HCE_A_CROUCH_MOVE: return 'crouch rifle move-front';
		case HCE_A_FLEE: return 'flee rifle move-front';
		case HCE_A_FIRE: return 'stand rifle ar fire-1 baked';
		case HCE_A_THROW: return 'stand rifle throw-grenade';
		case HCE_A_DIVE_L: return 'stand rifle dive-left';
		case HCE_A_DIVE_R: return 'stand rifle dive-right';
		case HCE_A_DIVE_F: return 'stand rifle dive-front';
		case HCE_A_EVADE_L: return 'stand rifle evade-left';
		case HCE_A_EVADE_R: return 'stand rifle evade-right';
		case HCE_A_BERSERK: return 'stand rifle berserk%3';
		case HCE_A_WARN: return 'stand rifle warn%1';
		case HCE_A_SIGNAL: return 'stand rifle signal-attack';
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%0 baked', 's-ping front gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-leg' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back chest', 'h-ping back gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 's-kill front chest', 's-kill front gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: { static const Name o[] = { 'h-kill front gut', 'h-kill front head' }; return o[random(0, 1)]; }
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: { static const Name o[] = { 'stand landing-dead', 'stand landing-dead%2' }; return o[random(0, 1)]; }
		case HCE_A_CELEBRATE: { static const Name o[] = { 'stand rifle celebrate%1', 'stand rifle celebrate%2', 'stand rifle celebrate%3' }; return o[random(0, 2)]; }
		case HCE_A_TURN_L: return 'stand rifle turn-left';
		case HCE_A_TURN_R: return 'stand rifle turn-right';
		case HCE_A_FLAME_IDLE: return 'flaming rifle idle';
		case HCE_A_FLAME_MOVE: return 'flaming rifle move-front';
		case HCE_A_RELOAD: return 'stand rifle reload-1';
		case HCE_A_VENT: return 'stand rifle overheat';
		case HCE_A_LOW_IDLE: return 'alert rifle idle%0';
		case HCE_A_LOW_MOVE: return 'alert rifle move-front%0';
		case HCE_A_COVER_L_ENTER: return 'stand rifle cover-left-enter';
		case HCE_A_COVER_L_IDLE: return 'stand rifle cover-left-idle';
		case HCE_A_COVER_L_PEEK: return 'stand rifle cover-left-peek';
		case HCE_A_COVER_L_OPEN: return 'stand rifle cover-left-open';
		case HCE_A_COVER_L_UNPEEK: return 'stand rifle cover-left-unpeek';
		case HCE_A_COVER_L_EXIT: return 'stand rifle cover-left-exit';
		case HCE_A_COVER_R_ENTER: return 'stand rifle cover-right-enter';
		case HCE_A_COVER_R_IDLE: return 'stand rifle cover-right-idle';
		case HCE_A_COVER_R_PEEK: return 'stand rifle cover-right-peek';
		case HCE_A_COVER_R_OPEN: return 'stand rifle cover-right-open';
		case HCE_A_COVER_R_UNPEEK: return 'stand rifle cover-right-unpeek';
		case HCE_A_COVER_R_EXIT: return 'stand rifle cover-right-exit';
		case HCE_A_HOIST: return 'stand rifle hoist';
		case HCE_A_VAULT: return 'stand rifle vault';
		}
		return 'None';
	}
