		case 'stand rifle hoist': return (40.6, -0.3, 34.9);
		case 'stand rifle vault': return (38.0, -3.3, -2.2);
		}
		return (0, 0, 0);
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show)
		{
			A_ChangeModel('None', 6, "models/hce/Marine", 'Marine_w_smg.iqm');
			A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_smg_0.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_m_smg_1.png', CMDL_USESURFACESKIN);
		}
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}
}

