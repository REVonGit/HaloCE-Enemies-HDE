	override vector3 HCE_AnimMove(Name anim)
	{
		switch(anim)
		{
		case 'stand rifle hoist': return (40.6, -0.3, 34.9);
		case 'stand rifle vault': return (38.0, -3.3, -2.2);
		}
		return (0, 0, 0);
	}
	// a whole body in place of Spiral's ODST: h2_odst_body (a Marine kit piece on the Marine's skeleton)
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		A_ChangeModel('None', 0, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 3, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "models/hce/MarineKit", "h2_odst_body.iqm", 1, "", 'None');
		HCE_ResumeAnim();
	}
	override void HCE_BloodHideClass()
	{
		A_ChangeModel('None', 7, "", 'None', 0, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 3, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 4, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show)
		{
			A_ChangeModel('None', 6, "models/hce/MarineODST", 'Marine_w_battle_rifle.iqm');
			A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_battle_rifle_0.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_m_battle_rifle_1.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 2, "models/hce/weapons", 'w_m_battle_rifle_2.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 3, "models/hce/weapons", 'w_m_battle_rifle_3.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 4, "models/hce/weapons", 'w_m_battle_rifle_4.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 5, "models/hce/weapons", 'w_m_battle_rifle_5.png', CMDL_USESURFACESKIN);
		}
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}
}

