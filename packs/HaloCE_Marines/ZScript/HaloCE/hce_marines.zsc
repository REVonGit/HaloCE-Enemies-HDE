		case HCE_A_SIGNAL: return 'stand rifle signal-attack';
		case HCE_A_AIRBORNE: return 'stand rifle airborne';
		case HCE_A_LAND: return 'stand rifle land-soft';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%0 baked', 's-ping front gut%1 baked' }; return o[random(0, 1)]; }
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front chest', 'h-ping front gut', 'h-ping front l-arm', 'h-ping front l-leg' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: { static const Name o[] = { 'h-ping back chest', 'h-ping back gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 's-kill front chest', 's-kill front gut' }; return o[random(0, 1)]; }
		case HCE_A_DIE_B: return 's-kill back gut';
		case HCE_A_DIE_L: return 's-kill left gut';
		case HCE_A_DIE_R: return 's-kill right gut';
		case HCE_A_DIE_HARD_F: { static const Name o[] = { 'h-kill front gut', 'h-kill front head' }; return o[random(0, 1)]; }
		case HCE_A_DIE_HARD_B: return 'h-kill back gut';
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: { static const Name o[] = { 'stand landing-dead', 'stand landing-dead%2' }; return o[random(0, 1)]; }
		case HCE_A_CELEBRATE: { static const Name o[] = { 'stand rifle celebrate%1', 'stand rifle celebrate%2', 'stand rifle celebrate%3' }; return o[random(0, 2)]; }
		case HCE_A_TURN_L: return 'stand rifle turn-left';
		case HCE_A_TURN_R: return 'stand rifle turn-right';
		case HCE_A_FLAME_IDLE: return 'flaming rifle idle';
		case HCE_A_FLAME_MOVE: return 'flaming rifle move-front';
		}
		return 'None';
	}

