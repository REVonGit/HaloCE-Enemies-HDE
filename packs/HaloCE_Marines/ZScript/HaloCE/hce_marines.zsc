	// the Stanchion: 24 tics of aiming (the glint and the targeting laser, the charge-up sound), then one rail
	// shot drawn with HDE's laser beam; it tears what it kills apart (HCE_StanchionRail, HCE_WeaponKind)
	const HCE_RAIL_AIM = 24;
	bool hce_cqc;
	void HCE_FireRail()
	{
		if(!target) return;
		vector3 ap = HCE_AimPoint();
		double gz = height * 0.5 + hce_gunOffset.z;
		vector3 from = Vec3Angle(hce_gunOffset.x, angle, gz);
		vector3 diff = level.Vec3Diff(from, ap);
		double ang = atan2(diff.y, diff.x);
		double pit = -atan2(diff.z, diff.xy.Length());
		FLineTraceData lt;
		LineTrace(ang, hce_maxRange, pit, TRF_THRUSPECIES, gz, hce_gunOffset.x, 0, lt);
		vector3 to = lt.HitType != TRACE_HitNone ? lt.HitLocation : from + (cos(ang) * cos(pit), sin(ang) * cos(pit), -sin(pit)) * hce_maxRange;
		if(hce_burstShot < HCE_RAIL_AIM)
		{
			if(hce_burstShot == 0 && hce_chargeSound.Length() > 0) A_StartSound(hce_chargeSound, CHAN_WEAPON, CHANF_OVERLAP, 0.9);
			HCE_SniperGlint(level.Vec3Diff(pos, from), hce_burstShot);
			if(level.Vec3Diff(from, to).Length() >= 1) HCE_AimLaser(from, to);
			hce_burstShot++;
			return;
		}
		HCE_EnemyLaser.Flash(from, to, Color(255, 255, 70, 20), 3.0, 0.08);
		HCE_EnemyLaser.Flash(from, to, Color(255, 255, 200, 120), 1.2, 0.12);
		for(int i = 0; i < 12; i++)
			A_SpawnParticle("FF9020", SPF_FULLBRIGHT, 14, 5, 0, to.x - pos.x, to.y - pos.y, to.z - pos.z, frandom(-2, 2), frandom(-2, 2), frandom(0, 3), 0, 0, -0.1, 1.0, -0.06);
		Actor hit = lt.HitActor;
		if(hit && hit != self && hit.bSHOOTABLE)
			hit.DamageMobj(self, self, max(1, int(round(150 * hce_damageMod * HCE_DamageScale()))), 'Railgun');
		HCE_PlayFireSound(false);
		if(hce_moveSpeed <= 0.1 && HCE_HasAnim(HCE_A_FIRE)) HCE_Play(HCE_A_FIRE, false, true, 2);
		hce_burstShot++;
	}
	override void HCE_FireShot(bool special)
	{
		if(hce_cqc) { super.HCE_FireShot(special); return; }
		HCE_FireRail();
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show) A_ChangeModel('None', 6, "models/hce/Marine", 'Marine_w_stanchion.iqm');
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}

	// Sergeant Johnson: always his own face and voice. The Stanchion at range; when an enemy gets within ~6 m he
	// switches to the Magnum (Halo 2's pistol stance) and back again once it's past ~9 m
	override int HCE_PickFace() { return HCE_JOHNSON_FACE; }
	override Name HCE_AnimName(int kind) { return hce_cqc ? HCE_AnimNameCQC(kind) : HCE_AnimNameLong(kind); }
	override int HCE_AnimTics(Name anim) { int t = HCE_AnimTicsLong(anim); return t != 30 ? t : HCE_AnimTicsCQC(anim); }
	Name hce_longProj; int hce_longShots[3]; double hce_longPause[2]; double hce_longErr, hce_longSpeed, hce_longRange[2];
	String hce_longSound[3];
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		hce_voice = 'Marine_Johnson';
		hce_longProj = hce_projectile; hce_longErr = hce_errorAngle; hce_longSpeed = hce_projSpeed;
		hce_longShots[0] = hce_patShotsMin; hce_longShots[1] = hce_patShotsMax; hce_longShots[2] = hce_patInterval;
		hce_longPause[0] = hce_patPauseMin; hce_longPause[1] = hce_patPauseMax;
		hce_longRange[0] = hce_rangeMin; hce_longRange[1] = hce_rangeMax;
		hce_longSound[0] = hce_fireSound; hce_longSound[1] = hce_fireSoundBass; hce_longSound[2] = hce_chargeSound;
	}
	override void Tick()
	{
		super.Tick();
		if(health <= 0 || !target || level.maptime % 6) return;
		double d = Distance3D(target);
		if(!hce_cqc && d < 192) HCE_CloseQuarters(true);
		else if(hce_cqc && d > 288) HCE_CloseQuarters(false);
	}
	void HCE_CloseQuarters(bool on)
	{
		hce_cqc = on;
		hce_burstShot = 0;
		if(on)
		{
		A_ChangeModel('None', 6, "models/hce/Marine", 'Marine_w_magnum.iqm');
		A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_pistol_0.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_pistol_0.png', CMDL_USESURFACESKIN);
			hce_projectile = 'HCE_PistolBullet'; hce_errorAngle = 1.5; hce_projSpeed = 933.3;
			hce_patShotsMin = 2; hce_patShotsMax = 3; hce_patInterval = 9; hce_patPauseMin = 0.9; hce_patPauseMax = 1.5;
			hce_rangeMin = 0; hce_rangeMax = 160;
			hce_fireSound = "Halo/Weapons/Mag_MD6/Fire"; hce_fireSoundBass = "Halo/Weapons/Mag_MD6/Fire/Bass"; hce_chargeSound = "";
		}
		else
		{
		A_ChangeModel('None', 6, "models/hce/Marine", 'Marine_w_stanchion.iqm');
		A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_stanchion_0.png', CMDL_USESURFACESKIN);
			hce_projectile = hce_longProj; hce_errorAngle = hce_longErr; hce_projSpeed = hce_longSpeed;
			hce_patShotsMin = hce_longShots[0]; hce_patShotsMax = hce_longShots[1]; hce_patInterval = hce_longShots[2];
			hce_patPauseMin = hce_longPause[0]; hce_patPauseMax = hce_longPause[1];
			hce_rangeMin = hce_longRange[0]; hce_rangeMax = hce_longRange[1];
			hce_fireSound = hce_longSound[0]; hce_fireSoundBass = hce_longSound[1]; hce_chargeSound = hce_longSound[2];
		}
		HCE_Play(target ? HCE_A_ALERT : HCE_A_IDLE);
	}
}

class HCE_MarineArmoredBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_HUMAN";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_HUMAN;
		Height 58;
		Radius 14;
		Mass 116;
		PainChance 0;
		Tag "MarineArmored";
		BloodColor "A0 10 10";
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
	}
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
	override void HCE_BloodModel(int stage)
	{
		switch(stage)
		{
		case 1: A_ChangeModel('None', 7, "models/hce/MarineArmored", 'MarineArmored_blood1.iqm'); break;
		case 2: A_ChangeModel('None', 7, "models/hce/MarineArmored", 'MarineArmored_blood2.iqm'); break;
		case 3: A_ChangeModel('None', 7, "models/hce/MarineArmored", 'MarineArmored_blood3.iqm'); break;
		}
	}
	// Halo CE's Marine cosmetics, rolled per Marine: face and headgear, sleeves, the damaged vest. Sergeant
	// Johnson's face (with his own voice and sleeves) is his alone: only HCE_SgtJohnson wears it
	const HCE_JOHNSON_FACE = 7;
	Array<int> hce_hideSurf;
	int hce_face;
	bool hce_johnsonArms;
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		HCE_DressMarine();
	}
	virtual int HCE_PickFace() { static const int F[] = { 0, 1, 2, 3, 4, 5, 6 }; return F[random(0, 6)]; }
	void HCE_DressMarine()
	{
		hce_hideSurf.Clear();
		hce_face = HCE_PickFace();
		hce_johnsonArms = hce_face == HCE_JOHNSON_FACE;
		switch(hce_face)
		{
		case 0: { static const int H[] = { 1, 4, 5, 6, 7, 8, 9, 10, 11, 11, 12, 12 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); break; }
		case 1: { static const int H[] = { 1, 3, 5, 6, 7, 8, 9, 10, 11, 11, 12, 12 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); break; }
		case 2: { static const int H[] = { 1, 3, 4, 6, 7, 8, 9, 10, 11, 11, 12, 12 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); break; }
		case 3: { static const int H[] = { 1, 2, 3, 4, 5, 8, 9, 10, 11, 11, 12, 12 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); break; }
		case 4: { static const int H[] = { 1, 3, 4, 5, 6, 7, 9, 10, 11, 11, 12, 12 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); break; }
		case 5: { static const int H[] = { 1, 3, 4, 5, 6, 7, 8, 10, 11, 11, 12, 12 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); break; }
		case 6: { static const int H[] = { 1, 3, 4, 5, 6, 7, 8, 9, 11, 11, 12, 12 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); break; }
		case 7: { static const int H[] = { 0, 2, 3, 4, 5, 6, 7, 8, 9, 10 }; for(int i = 0; i < H.Size(); i++) hce_hideSurf.Push(H[i]); hce_voice = 'Marine_Johnson'; break; }
		}
		for(int i = 0; i < hce_hideSurf.Size(); i++) A_ChangeModel('None', 0, "", 'None', hce_hideSurf[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		HCE_ResumeAnim();        // A_ChangeModel resets the animation the spawn started
	}
	override void HCE_BloodHideClass()
	{
		for(int i = 0; i < hce_hideSurf.Size(); i++) A_ChangeModel('None', 7, "", 'None', hce_hideSurf[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
}

