		case 'stand rifle move-back': return 23;
		case 'stand rifle move-front': return 23;
		case 'stand rifle move-left': return 23;
		case 'stand rifle move-right': return 23;
		case 'stand rifle signal-attack': return 55;
		case 'stand rifle throw-grenade': return 72;
		case 'stand rifle turn-left': return 16;
		case 'stand rifle turn-right': return 16;
		case 'stand rifle warn%1': return 51;
		}
		return 30;
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show) A_ChangeModel('None', 6, "models/hce/Marine", 'Marine_w_ma5b.iqm');
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}
}

