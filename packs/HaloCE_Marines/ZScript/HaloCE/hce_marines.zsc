	// another sealed helmet in place of the ODST's own: helmet_enclosed (a Marine kit piece on the Marine's skeleton)
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		A_ChangeModel('None', 0, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 0, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 1, "models/hce/MarineKit", "helmet_enclosed.iqm", 1, "", 'None');
		A_ChangeModel('None', 2, "models/hce/MarineKit", "launcher_tube.iqm", 1, "", 'None');
		HCE_ResumeAnim();
	}
	override void HCE_BloodHideClass()
	{
		A_ChangeModel('None', 7, "", 'None', 1, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
		A_ChangeModel('None', 7, "", 'None', 2, "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
	override void HCE_ShowGun(bool show)
	{
		super.HCE_ShowGun(show);
		if(show)
		{
			A_ChangeModel('None', 6, "models/hce/MarineODST", 'Marine_w_rocket_launcher.iqm');
			A_ChangeModel('None', 6, "", 'None', 0, "models/hce/weapons", 'w_m_rocket_launcher_0.png', CMDL_USESURFACESKIN);
			A_ChangeModel('None', 6, "", 'None', 1, "models/hce/weapons", 'w_m_rocket_launcher_1.png', CMDL_USESURFACESKIN);
