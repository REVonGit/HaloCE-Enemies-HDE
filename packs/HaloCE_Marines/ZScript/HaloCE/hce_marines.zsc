		case 9: HCE_ApplyLoadout9(); return;
		case 10: HCE_ApplyLoadout10(); return;
		case 11: HCE_ApplyLoadout11(); return;
		case 12: HCE_ApplyLoadout12(); return;
		case 13: HCE_ApplyLoadout13(); return;
