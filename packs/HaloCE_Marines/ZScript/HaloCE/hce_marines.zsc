			A_ChangeModel('None', 6, "", 'None', 4, "models/hce/weapons", 'w_m_rocket_launcher_4.png', CMDL_USESURFACESKIN);
		}
		else A_ChangeModel('None', 6, "", 'None', 0, "", 'None', CMDL_HIDEMODEL);
	}
}

