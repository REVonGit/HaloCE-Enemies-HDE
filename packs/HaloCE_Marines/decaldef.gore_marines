// Halo CE and Halo 2 blood decals for the marines (extract_halo_gore.py), used by hce_gore.zsc in the core pack
Fader HCEGoreFade
{
	DecayStart 60.0
	DecayTime 20.0
}

Decal HCEG_marines_ce_blood_splat_0
{
	Pic "graphics/hcegore/ce_blood_splat_0.png"
	Translucent 0.95
	X-Scale 0.90
	Y-Scale 0.90
	RandomFlipX
	RandomFlipY
	Animator HCEGoreFade
}

