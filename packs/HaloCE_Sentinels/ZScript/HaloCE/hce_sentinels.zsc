		+HaloDoom_EnemyBase.HCE_Flying
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand fixed idle%0';
		case HCE_A_ALERT: return 'alert fixed idle%0';
		case HCE_A_MOVE_F: return 'stand fixed idle%0';
		case HCE_A_CROUCH_IDLE: return 'crouch fixed idle%0';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%1 baked', 's-ping front gut%2 baked', 's-ping front gut%3 baked' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 'stand airborne-dead%1', 'stand airborne-dead%2', 'stand landing-dead' }; return o[random(0, 2)]; }
		case HCE_A_DIE_AIR: { static const Name o[] = { 'stand airborne-dead%1', 'stand airborne-dead%2' }; return o[random(0, 1)]; }
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert fixed idle%0': return 35;
		case 'crouch fixed idle%0': return 4;
		case 's-ping front gut%1 baked': return 26;
		case 's-ping front gut%2 baked': return 26;
		case 's-ping front gut%3 baked': return 26;
		case 'stand airborne-dead%1': return 112;
		case 'stand airborne-dead%2': return 85;
		case 'stand fixed idle%0': return 4;
		case 'stand landing-dead': return 4;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
}

// ---- SentinelScout: the body every SentinelScout variant below is drawn with (characters\sentinel\variants\scout\scout): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every SentinelScout; one variant's numbers are in its own class
class HCE_SentinelScoutBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_SENTINEL";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_SENTINEL;
		Height 24;
		Radius 12;
		Mass 25;
		PainChance 0;
		Tag "SentinelScout";
		+NOBLOOD
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Sound HCE_MeleeSound() { return "HCE/Sentinel/H2Melee"; }     // Halo 2's Sentinel melee
	// no death in the games but an explosion and debris (HCE_MachineBurst), its hull's pieces from its own model
	override int HCE_MachineSize() { return 1; }
	override String HCE_ModelPath() { return "models/hce/SentinelScout"; }
	override Name HCE_ModelFile() { return 'SentinelScout.iqm'; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
}

