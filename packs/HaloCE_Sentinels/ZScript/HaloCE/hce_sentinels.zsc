	{
		return (0, 0, 0);
	}
	override void HCE_DressShellVariant(Actor s)
	{
		static const int H[] = { 4, 6, 7 };
		for(int i = 0; i < H.Size(); i++) s.A_ChangeModel('None', 0, "", 'None', H[i], "models/hce/weapons", 'hce_hidden.png', CMDL_USESURFACESKIN);
	}
