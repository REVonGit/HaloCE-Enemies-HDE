	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand fixed idle';
		case HCE_A_ALERT: return 'alert fixed idle';
		case HCE_A_MOVE_F: return 'stand fixed idle';
		case HCE_A_CROUCH_IDLE: return 'crouch fixed idle';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%1 baked', 's-ping front gut%2 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_B: { static const Name o[] = { 's-ping back gut%1 baked', 's-ping back gut%2 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_L: { static const Name o[] = { 's-ping left gut%1 baked', 's-ping left gut%2 baked' }; return o[random(0, 1)]; }
		case HCE_A_PING_R: { static const Name o[] = { 's-ping right gut%1 baked', 's-ping right gut%2 baked' }; return o[random(0, 1)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 'stand airborne-dead', 'stand landing-dead' }; return o[random(0, 1)]; }
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert fixed idle': return 70;
		case 'crouch fixed idle': return 70;
		case 's-ping back gut%1 baked': return 30;
		case 's-ping back gut%2 baked': return 30;
		case 's-ping front gut%1 baked': return 29;
		case 's-ping front gut%2 baked': return 29;
		case 's-ping left gut%1 baked': return 29;
		case 's-ping left gut%2 baked': return 29;
		case 's-ping right gut%1 baked': return 29;
