		case HCE_A_CROUCH_IDLE: return 'crouch fixed idle%0';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%1 baked', 's-ping front gut%2 baked', 's-ping front gut%3 baked' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 'stand airborne-dead%1', 'stand airborne-dead%2', 'stand landing-dead' }; return o[random(0, 2)]; }
		case HCE_A_DIE_AIR: { static const Name o[] = { 'stand airborne-dead%1', 'stand airborne-dead%2' }; return o[random(0, 1)]; }
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert fixed idle%0': return 35;
		case 'crouch fixed idle%0': return 4;
		case 's-ping front gut%1 baked': return 26;
		case 's-ping front gut%2 baked': return 26;
		case 's-ping front gut%3 baked': return 26;
		case 'stand airborne-dead%1': return 112;
		case 'stand airborne-dead%2': return 85;
		case 'stand fixed idle%0': return 4;
		case 'stand landing-dead': return 4;
		}
		return 30;
	}
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
}

class HCE_SentinelKnightBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_SENTINEL";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_SENTINEL;
		Height 84;
		Radius 30;
		Mass 338;
		PainChance 0;
		Tag "SentinelKnight";
		+NOBLOOD
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, -1, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Name HCE_ShellClass() { return 'HCE_SentinelKnightShieldShell'; }
	// ---- Sentinel Knight: its core's colour, rolled once from its rank's palette (cold for the grey Knights, warm for
	// the gold commanders), and its phase: it sinks into the ground in a burst of hard light and rises out of it
	// somewhere else, around its target. It phases when its shield is down and it is under fire, or to close in on a
	// target far away; never more often than every 6-10 s
	bool hce_coreSet, hce_debugPhase;
	int hce_phase, hce_phaseTics, hce_phaseNext, hce_hurtAt, hce_phaseOff;

	override void HCE_OnDamaged(Actor inflictor, Actor source, int dealt, Name mod)
	{
		super.HCE_OnDamaged(inflictor, source, dealt, mod);
		hce_hurtAt = level.maptime;
	}

	virtual int HCE_KnightPalette() { return 0; }

	void HCE_KnightCore()
	{
		if(HCE_KnightPalette() == 1)
		{
			switch(random(0, 3))
			{
			case 0: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_orange.png', CMDL_USESURFACESKIN); break;
			case 1: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_amber.png', CMDL_USESURFACESKIN); break;
			case 2: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_red.png', CMDL_USESURFACESKIN); break;
			default: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_gold.png', CMDL_USESURFACESKIN); break;
			}
			return;
		}
		switch(random(0, 3))
		{
		case 0: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_cyan.png', CMDL_USESURFACESKIN); break;
		case 1: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_ice.png', CMDL_USESURFACESKIN); break;
		case 2: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_violet.png', CMDL_USESURFACESKIN); break;
		default: A_ChangeModel('None', 0, "", 'None', 3, "models/hce/SentinelKnight/skins", 'core_teal.png', CMDL_USESURFACESKIN); break;
		}
	}

	void HCE_PhaseBurst()
	{
		for(int i = 0; i < 24; i++)
			A_SpawnParticle("FFB040", SPF_FULLBRIGHT, 20, frandom(3, 6), 0, frandom(-radius, radius), frandom(-radius, radius), frandom(0, height),
				frandom(-1, 1), frandom(-1, 1), frandom(0.5, 2.5), 0, 0, 0, 1.0, -0.05);
		A_StartSound("Halo/Weapons/BinaryRifle/Zoom/IN", CHAN_7, CHANF_OVERLAP, 0.9);
	}

	// somewhere 160-400 units from the target, on the floor, in sight of it; false when no such place turns up
	bool HCE_PhaseSpot()
	{
		if(!target) return false;
		vector3 old = pos;
		for(int i = 0; i < 12; i++)
		{
			double a = frandom(0, 360), d = frandom(160, 400);
			vector2 p = target.pos.xy + AngleToVector(a, d);
			double fz = GetZAt(p.x, p.y, 0, GZF_ABSOLUTEPOS);
			SetOrigin((p.x, p.y, fz), false);
			if(TestMobjLocation() && CheckSight(target) && pos.z - fz < 1)
			{
				A_SetAngle(AngleTo(target));
				return true;
			}
		}
		SetOrigin(old, false);
		return false;
	}

	// ---- its voice (HCE/SentinelKnight/<line>, the Sentinels pack's sndinfo.knight): the generic events HCE_Say gets
	// become the Knight's lines for what it is looking at; the events it has no line for (pain, death...) stay silent
	bool hce_allyGreeted, hce_saidFirstFlood;
	int hce_carrierWarnAt;

	// what a Knight sees or kills, by class: 0 nothing it has a line for, 1 a Flood combat form, 2 an infection form,
	// 3 a carrier (or the Flood Grunt, which bursts the same way), 4 an Elite, 5 a Grunt, 6 a Jackal, 7 a Brute,
	// 8 other Covenant, 9 a Hunter, 10 a human, 11 a player, 12 a Doom monster, 13 a big one, 14 a Drinol (the Digsite's
	// war beasts)
	static int HCE_KnightKind(Actor a)
	{
		if(!a) return 0;
		if(a.player) return 11;
		String c = a.GetClassName(); c = c.MakeLower();
		if(c.IndexOf("drinol") >= 0) return 14;
		if(c.IndexOf("flood") >= 0)
			return c.IndexOf("carrier") >= 0 || c.IndexOf("floodgrunt") >= 0 ? 3 : c.IndexOf("infection") >= 0 ? 2 : 1;
		if(c.IndexOf("hunter") >= 0) return 9;
		if(c.IndexOf("elite") >= 0 || c.IndexOf("zealot") >= 0) return 4;
		if(c.IndexOf("grunt") >= 0) return 5;
		if(c.IndexOf("jackal") >= 0) return 6;
		if(c.IndexOf("brute") >= 0) return 7;
		if(c.IndexOf("drone") >= 0 || c.IndexOf("bugger") >= 0 || c.IndexOf("engineer") >= 0 || c.IndexOf("prophet") >= 0) return 8;
		if(HCE_TeamOf(a) == HCE_TEAM_HUMAN || c.IndexOf("marine") >= 0 || c.IndexOf("odst") >= 0 || c.IndexOf("zombie") >= 0
			|| c == "shotgunguy" || c == "chaingunguy" || c == "wolfensteinss") return 10;
		if(a.bISMONSTER) return a.SpawnHealth() >= 1000 ? 13 : 12;
		return 0;
	}

	// on the level the Flood first appears on (hce_floodlevel), the first Knight to meet it says so
	bool HCE_FirstFloodLine()
	{
		if(HCE_ReplaceHandler.LevelIndex() != HCE_ReplaceHandler.FloodLevel()) return false;
		let it = ThinkerIterator.Create('HCE_SentinelKnightBase');
		HCE_SentinelKnightBase k;
		while(k = HCE_SentinelKnightBase(it.Next())) if(k.hce_saidFirstFlood) return false;
		hce_saidFirstFlood = true;
		return true;
	}

	// the player by the Spartan class he plays (HaloDoom Evolved's HaloSpartan_II, _III and _IV; Doom's marine and
	// anything else: the plain lines)
	static Name HCE_SpartanLine(Actor a)
	{
		for(class<Object> c = a.GetClass(); c; c = c.GetParentClass())
		{
			Name n = c.GetClassName();
			if(n == 'HaloSpartan_II') return 'SpotSpartanII';
			if(n == 'HaloSpartan_III') return 'SpotSpartanIII';
			if(n == 'HaloSpartan_IV') return 'SpotSpartanIV';
		}
		return 'SpotPlayer';
	}

	Name HCE_SpotLine(Actor a)
	{
		switch(HCE_KnightKind(a))
		{
		case 11: return bFRIENDLY ? 'SpotPlayerAlly' : HCE_SpartanLine(a);
		case 1: case 2: return HCE_FirstFloodLine() ? 'FirstFlood' : 'SpotFlood';
		case 3: return Distance3D(a) < 400 ? 'CarrierBlow' : HCE_FirstFloodLine() ? 'FirstFlood' : 'SpotFlood';
		case 4: case 5: case 6: case 7: case 8: return 'SpotCovenant';
		case 9: return 'SpotHunter';
		case 10: return 'SpotHuman';
		case 14: return 'SpotDrinol';
		}
		return 'None';
	}

	Name HCE_KillLine(Actor a)
	{
		switch(HCE_KnightKind(a))
		{
		case 1: return random(0, 2) == 0 ? 'SanitizeFlood' : random(0, 1) ? 'KillCombatForm' : 'KillFlood';
		case 2: case 3: return random(0, 2) == 0 ? 'SanitizeFlood' : 'KillFlood';
		case 4: return 'KillElite';
		case 5: return 'KillGrunt';
		case 6: return 'KillJackal';
		case 7: return 'KillBrute';
		case 9: case 13: case 14: return 'KillHeavy';
		case 10: case 11: return 'KillHuman';
		}
		return 'None';
	}

	override void HCE_Say(Name ev, double chance, int cooldown, bool force)   // (an override takes no defaults: callers here pass all four)
	{
		Name line = 'None';
		switch(ev)
		{
		case 'Alert': case 'FoundFoe': case 'Sword': case 'Sniper': case 'UpThere': case 'DownThere':
			line = HCE_SpotLine(target); break;
		case 'KillPlayer': line = 'KillHuman'; break;
		case 'Taunt':                  // (said when its target falls, and as chatter between bursts: only the kills get a line)
			if(target && target.health <= 0) { line = HCE_KillLine(target); chance = max(chance, 0.6); }
			break;
		case 'EnemyGrenade': line = 'SpotGrenade'; break;
		case 'Stuck': line = 'PlasmaStuck'; break;
		case 'SearchStart': case 'SearchFail': case 'SearchClear': case 'Investigate': case 'HeardGunfire': case 'KeepWatch':
			line = 'Search'; break;
		case 'CarrierBlow': case 'SpotPlayerAlly': line = ev; break;
		}
		if(line == 'None') return;
		if(hce_debugPhase) Console.Printf("HCEVOICE %s %s -> %s (%s)", GetClassName(), ev, line, target ? target.GetClassName() : 'none');
		super.HCE_Say(line, chance, cooldown, force);
	}

	// a carrier form close by, or (a friendly Knight) the player
	void HCE_KnightWatch()
	{
		if(hce_phase != 0 || (level.maptime + hce_phaseOff) % 15) return;
		if(level.maptime >= hce_carrierWarnAt)
		{
			let it = BlockThingsIterator.Create(self, 260);
			while(it.Next())
			{
				Actor a = it.thing;
				if(a == self || a.health <= 0 || !a.bISMONSTER || Distance3D(a) > 260 || HCE_KnightKind(a) != 3 || !CheckSight(a)) continue;
				HCE_Say('CarrierBlow', 1.0, 35 * 3, false);
				hce_carrierWarnAt = level.maptime + 35 * 8;
				break;
			}
		}
		if(bFRIENDLY && !hce_allyGreeted)
			for(int i = 0; i < MAXPLAYERS; i++)
			{
				if(!playeringame[i] || !players[i].mo || Distance3D(players[i].mo) > 400 || !CheckSight(players[i].mo)) continue;
				hce_allyGreeted = true;
				HCE_Say('SpotPlayerAlly', 1.0, 35 * 3, true);
				break;
			}
	}

	override void Tick()
	{
		super.Tick();
		if(isFrozen()) return;
		if(!hce_coreSet && GetAge() >= 1)
		{
			hce_coreSet = true; HCE_KnightCore();
			hce_phaseOff = random(0, 14);
		}
		if(health <= 0) { hce_phase = 0; return; }
		HCE_KnightWatch();
		if(hce_phase == 0)
		{
			if(!target || level.maptime < hce_phaseNext || hce_dummy) return;      // (it phases out of a flinch too)
			double d = Distance2D(target);
			bool exposed = hce_shieldMax > 0 && !HCE_ShieldUp() && level.maptime - hce_hurtAt < 35;
			if(!(exposed && frandom(0, 1) < 0.08) && !(d > 900 && frandom(0, 1) < 0.01)) return;
			// phase out: sink into the ground, untouchable from halfway down
			hce_phase = 1; hce_phaseTics = 52;
			if(hce_debugPhase) Console.Printf("HCEPHASE out %s at %.0f %.0f", GetClassName(), pos.x, pos.y);
			HCE_ApplyAnim('knight phase-out', 3, false); hce_curAnim = 'knight phase-out'; hce_curAnimKind = -1;
			hce_animLock = 52 + 68 + 12;
			vel = (0, 0, 0);
			HCE_PhaseBurst();
			return;
		}
		vel.xy = (0, 0);
		if(--hce_phaseTics > 0)
		{
			if(hce_phase == 1 && hce_phaseTics == 52 / 2) { bSHOOTABLE = false; A_SetRenderStyle(0.5, STYLE_Translucent); }
			if(hce_phase == 2 && hce_phaseTics == 68 / 2) { bSHOOTABLE = true; A_SetRenderStyle(1.0, STYLE_Normal); }
			return;
		}
		if(hce_phase == 1)
		{
			// gone: a beat under the ground, then up again somewhere else (where it went down, if nowhere fits)
			hce_phase = 3; hce_phaseTics = 12;
			bINVISIBLE = true;
			HCE_PhaseSpot();
			return;
		}
		if(hce_phase == 3)
		{
			bINVISIBLE = false;
			hce_phase = 2; hce_phaseTics = 68;
			HCE_ApplyAnim('knight phase-in', 0, false); hce_curAnim = 'knight phase-in'; hce_curAnimKind = -1;
			HCE_PhaseBurst();
			return;
		}
		// risen
		if(hce_debugPhase) Console.Printf("HCEPHASE in %s at %.0f %.0f", GetClassName(), pos.x, pos.y);
		hce_phase = 0; bSHOOTABLE = true; bINVISIBLE = false; A_SetRenderStyle(1.0, STYLE_Normal);
		hce_animLock = 0;
		hce_phaseNext = level.maptime + 35 * random(6, 10);
	}
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
}

// objects\characters\sentinel_knight\sentinel_knight commander binary rifle
class HCE_SentinelKnightCommanderBinaryRifle : HCE_SentinelKnightBase
{
	//$Category "Halo CE/Sentinels/Sentinel Knight"
	//$Title "Sentinel Knight Commander (Binary Rifle)"
	Default
	{
		Health 400;
		Speed 7.0;
		HaloDoom_EnemyBase.HCE_Type 0;
		HaloDoom_EnemyBase.HCE_Variant "sentinel_knight commander binary rifle";
		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 160;
		HaloDoom_EnemyBase.HCE_Movement 4.55, 7.00, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 1.87;
		HaloDoom_EnemyBase.HCE_Weapon "HCE_BinaryRifleBolt", 1, 7.00, 1.00, 5120;
		HaloDoom_EnemyBase.HCE_ProjectileSpeed 1493.3;
		HaloDoom_EnemyBase.HCE_DamageModifier 0.50;
		HaloDoom_EnemyBase.HCE_CombatRange 640, 3200;
		HaloDoom_EnemyBase.HCE_Burst 0.75, 1.10, 0.30, 1.20, 0.00, 0.50;
		HaloDoom_EnemyBase.HCE_GunOffset (30.0, -0.0, -21.0);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 110, 45;
		HaloDoom_EnemyBase.HCE_Leap 0, 0, 0.00, 6.5;
		HaloDoom_EnemyBase.HCE_Grenades 0, 0, 0.00, 0.0, 0, 960, 26.0;
		HaloDoom_EnemyBase.HCE_Panic 0.00, 0.00, 0.0, 0.0;
		HaloDoom_EnemyBase.HCE_Berserk 0.50, 0.30, 0;
		HaloDoom_EnemyBase.HCE_Defensive 0.65, 0.75, 0.10, 0.30, 0.30;
		HaloDoom_EnemyBase.HCE_Feign 0.00, 0.0;
		HaloDoom_EnemyBase.HCE_Shield 150, 5.0, 6.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 0;
		HaloDoom_EnemyBase.HCE_FirePattern 1, 1, 1, 2.25, 3.15, 0;
		HaloDoom_EnemyBase.HCE_FireSounds "Halo/Weapons/BinaryRifle/Fire", "Halo/Weapons/BinaryRifle/Fire/Bass", "", "";
		HaloDoom_EnemyBase.HCE_Voices "SentinelKnight";
		HaloDoom_EnemyBase.HCE_Drops "Halo_BinaryRifle", "None";
		+HaloDoom_EnemyBase.HCE_Berserks
		+HaloDoom_EnemyBase.HCE_Evades
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand pistol idle';
		case HCE_A_ALERT: return 'stand pistol idle';
		case HCE_A_MOVE_F: return 'stand pistol move-front';
		case HCE_A_MOVE_B: return 'stand pistol move-back';
		case HCE_A_MOVE_L: return 'stand pistol move-left';
		case HCE_A_MOVE_R: return 'stand pistol move-right';
		case HCE_A_MELEE: { static const Name o[] = { 'stand pistol melee%0', 'stand pistol melee%1', 'stand pistol melee%2', 'stand pistol melee%3', 'stand pistol melee%4' }; return o[random(0, 4)]; }
		case HCE_A_DIVE_L: return 'stand pistol dive-left';
		case HCE_A_DIVE_R: return 'stand pistol dive-right';
		case HCE_A_EVADE_L: return 'stand pistol evade-left';
		case HCE_A_EVADE_R: return 'stand pistol evade-right';
		case HCE_A_BERSERK: return 'stand pistol berserk';
		case HCE_A_AIRBORNE: return 'stand pistol airborne';
		case HCE_A_LAND: return 'stand pistol land-soft';
		case HCE_A_LEAP_START: return 'stand pistol leap-start';
		case HCE_A_LEAP_AIR: return 'stand pistol leap-airborne';
		case HCE_A_LEAP_MELEE: return 'stand pistol leap-melee';
		case HCE_A_HPING_F: { static const Name o[] = { 'h-ping front gut', 'h-ping front head', 'h-ping front l-leg', 'h-ping front r-leg' }; return o[random(0, 3)]; }
		case HCE_A_HPING_B: return 'h-ping back gut';
		case HCE_A_DIE_F: { static const Name o[] = { 'stand airborne-dead', 'stand landing-dead' }; return o[random(0, 1)]; }
		case HCE_A_DIE_AIR: return 'stand airborne-dead';
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		case HCE_A_CELEBRATE: { static const Name o[] = { 'stand pistol celebrate%0', 'stand pistol celebrate%1' }; return o[random(0, 1)]; }
		case HCE_A_LOW_MOVE: return 'stand pistol low-move';
		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'h-ping back gut': return 41;
		case 'h-ping front gut': return 60;
		case 'h-ping front head': return 57;
		case 'h-ping front l-leg': return 65;
		case 'h-ping front r-leg': return 69;
		case 'stand airborne-dead': return 42;
		case 'stand landing-dead': return 105;
		case 'stand pistol airborne': return 93;
		case 'stand pistol berserk': return 70;
		case 'stand pistol celebrate%0': return 70;
		case 'stand pistol celebrate%1': return 61;
		case 'stand pistol dive-left': return 47;
		case 'stand pistol dive-right': return 47;
		case 'stand pistol evade-left': return 41;
		case 'stand pistol evade-right': return 41;
		case 'stand pistol idle': return 116;
		case 'stand pistol land-soft': return 52;
		case 'stand pistol leap-airborne': return 117;
		case 'stand pistol leap-melee': return 37;
		case 'stand pistol leap-start': return 10;
		case 'stand pistol low-move': return 46;
		case 'stand pistol melee%0': return 48;
		case 'stand pistol melee%1': return 37;
		case 'stand pistol melee%2': return 48;
		case 'stand pistol melee%3': return 47;
		case 'stand pistol melee%4': return 47;
		case 'stand pistol move-back': return 32;
		case 'stand pistol move-front': return 32;
		case 'stand pistol move-left': return 32;
		case 'stand pistol move-right': return 32;
		}
		return 30;
	}
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
	override int HCE_KnightPalette() { return 1; }    // warm core colours
}

// energy-shield flare for the SentinelKnights: the same model, every surface the glowing shield texture
class HCE_SentinelKnightShieldShell : HCE_ShieldShell {}

// objects\characters\sentinel_knight\sentinel_knight commander light rifle
class HCE_SentinelKnightCommanderLightRifle : HCE_SentinelKnightBase
{
	//$Category "Halo CE/Sentinels/Sentinel Knight"
