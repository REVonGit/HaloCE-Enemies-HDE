		case 'stand pistol melee%2': return 48;
		case 'stand pistol melee%3': return 47;
		case 'stand pistol melee%4': return 47;
		case 'stand pistol move-back': return 32;
		case 'stand pistol move-front': return 32;
		case 'stand pistol move-left': return 32;
		case 'stand pistol move-right': return 32;
		}
		return 30;
	}
