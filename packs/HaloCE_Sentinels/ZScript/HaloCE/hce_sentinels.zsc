		case 'stand airborne-dead': return 35;
		case 'stand fixed idle': return 70;
		case 'stand landing-dead': return 2;
		}
		return 30;
	}
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
	override bool HCE_HasBubble() { return true; }    // Halo 2's shield bubble
}

