	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert fixed idle': return 70;
		case 'crouch fixed idle': return 70;
		case 's-ping back gut%1 baked': return 30;
		case 's-ping back gut%2 baked': return 30;
		case 's-ping front gut%1 baked': return 29;
		case 's-ping front gut%2 baked': return 29;
		case 's-ping left gut%1 baked': return 29;
		case 's-ping left gut%2 baked': return 29;
		case 's-ping right gut%1 baked': return 29;
		case 's-ping right gut%2 baked': return 29;
		case 'stand airborne-dead': return 35;
		case 'stand fixed idle': return 70;
		case 'stand landing-dead': return 2;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch fixed idle': return (20.6, 0.0, -8.2);
		}
		return hce_gunOffset;
	}
}

