	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand fixed idle%0';
		case HCE_A_ALERT: return 'alert fixed idle%0';
		case HCE_A_MOVE_F: return 'stand fixed idle%0';
		case HCE_A_CROUCH_IDLE: return 'crouch fixed idle%0';
		case HCE_A_PING_F: { static const Name o[] = { 's-ping front gut%1 baked', 's-ping front gut%2 baked', 's-ping front gut%3 baked' }; return o[random(0, 2)]; }
		case HCE_A_DIE_F: { static const Name o[] = { 'stand airborne-dead%1', 'stand airborne-dead%2', 'stand landing-dead' }; return o[random(0, 2)]; }
		case HCE_A_DIE_AIR: { static const Name o[] = { 'stand airborne-dead%1', 'stand airborne-dead%2' }; return o[random(0, 1)]; }
		case HCE_A_DIE_LAND: return 'stand landing-dead';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert fixed idle%0': return 35;
		case 'crouch fixed idle%0': return 4;
		case 's-ping front gut%1 baked': return 26;
		case 's-ping front gut%2 baked': return 26;
		case 's-ping front gut%3 baked': return 26;
		case 'stand airborne-dead%1': return 112;
		case 'stand airborne-dead%2': return 85;
		case 'stand fixed idle%0': return 4;
		case 'stand landing-dead': return 4;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}

	// the Brute Sentinel's second trigger: an artillery shell lobbed now and then between its beam bursts
	int hce_mortarTics;
	override void Tick()
	{
		super.Tick();
		if(health <= 0 || IsFrozen() || !target || target.health <= 0 || !hce_canSee) return;
		if(--hce_mortarTics > 0) return;
		hce_mortarTics = random[HCEMortar](35 * 3, 35 * 5);
		if(Distance3D(target) < 256) return;                  // too close to be safe for itself
		class<Actor> pc = (class<Actor>)('HCE_SentinelMortar');
		if(!pc) return;
		let g = Spawn(pc, Vec3Angle(hce_gunOffset.x, angle, height * 0.5 + hce_gunOffset.z), ALLOW_REPLACE);
		if(!g) return;
		g.target = self;
		if(!HCE_LobAt(g, g.pos, 48)) { g.Destroy(); return; }     // no arc under this ceiling
		HCE_ScaleShot(g);
		A_StartSound("Halo/Weapons/FuelRod/Fire", CHAN_WEAPON, CHANF_OVERLAP);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'stand fixed idle%0': return (37.5, -4.4, 6.1);
		}
		return hce_gunOffset;
	}
}

