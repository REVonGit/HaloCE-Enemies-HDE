		HaloDoom_EnemyBase.HCE_Perception 3200, 140, 3200, 240;
		HaloDoom_EnemyBase.HCE_Movement 2.60, 4.00, 12;
		HaloDoom_EnemyBase.HCE_LowWalk 0.00;
		HaloDoom_EnemyBase.HCE_Weapon "HCE_EnforcerNeedle", 1, 3.00, 0.00, 2560;
