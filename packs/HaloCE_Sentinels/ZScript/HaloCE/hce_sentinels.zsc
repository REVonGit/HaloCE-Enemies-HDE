	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
		switch(kind)
		{
		case HCE_A_IDLE: return 'stand unarmed idle';
		case HCE_A_ALERT: return 'stand unarmed idle';
		case HCE_A_MOVE_F: return 'stand unarmed move-front';
		case HCE_A_CROUCH_IDLE: return 'crouch unarmed idle';
		case HCE_A_CROUCH_MOVE: return 'crouch unarmed move-front';
		case HCE_A_MELEE: return 'stand unarmed melee';
		case HCE_A_LEAP_MELEE: return 'stand unarmed melee';
		case HCE_A_DIE_F: return 'h-kill front gut';
		case HCE_A_DIE_HARD_F: return 'h-kill front gut';
		case HCE_A_TURN_L: return 'stand unarmed turn-left';
		case HCE_A_TURN_R: return 'stand unarmed turn-right';
		}
		return 'None';
	}

	// how long each clip plays, in tics (its Halo frame count at 30 fps, in Doom's 35 tics a second)
	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'crouch unarmed idle': return 117;
		case 'crouch unarmed move-front': return 23;
		case 'h-kill front gut': return 12;
		case 'stand unarmed idle': return 58;
		case 'stand unarmed melee': return 19;
		case 'stand unarmed move-front': return 6;
		case 'stand unarmed turn-left': return 6;
		case 'stand unarmed turn-right': return 6;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
}

