		case 'stand airborne-dead': return 10;
		case 'stand fixed idle': return 56;
		case 'stand landing-dead': return 2;
		}
		return 30;
	}
	// the ground each moving clip covers (none here: the AI moves the body itself)
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
	override vector3 HCE_MuzzleAt(Name anim)
	{
		switch(anim)
		{
		case 'crouch fixed idle': return (13.9, -0.0, 12.7);
		}
		return hce_gunOffset;
	}
}

// ---- SentinelCrawler: the body every SentinelCrawler variant below is drawn with (characters\custom\sentinel_crawler\sentinel_crawler): its size, blood and gore, the skins it
// rolls and its cosmetics. Changing a number here changes every SentinelCrawler; one variant's numbers are in its own class
class HCE_SentinelCrawlerBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_SENTINEL";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_SENTINEL;
		Height 24;
		Radius 24;
		Mass 25;
		PainChance 0;
		Tag "SentinelCrawler";
		+NOBLOOD
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override Sound HCE_MeleeSound() { return "HCE/Sentinel/H2Melee"; }     // Halo 2's Sentinel melee
	// no death in the games but an explosion and debris (HCE_MachineBurst), its hull's pieces from its own model
	override int HCE_MachineSize() { return 1; }
	override String HCE_ModelPath() { return "models/hce/SentinelCrawler"; }
	override Name HCE_ModelFile() { return 'SentinelCrawler.iqm'; }
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
}

