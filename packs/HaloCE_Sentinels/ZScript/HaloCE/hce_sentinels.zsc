		HaloDoom_EnemyBase.HCE_Shield 140, 3.0, 4.0;
		HaloDoom_EnemyBase.HCE_FlyHeight 48;
		HaloDoom_EnemyBase.HCE_FirePattern 20, 35, 1, 0.90, 1.62, 0;
		HaloDoom_EnemyBase.HCE_FireSounds "Halo/Weapons/SentinelBeam/Fire/Loop", "", "Halo/Weapons/SentinelBeam/Fire/End", "Halo/Weapons/SentinelBeam/Fire/Begin";
		HaloDoom_EnemyBase.HCE_FireLoop true;
		HaloDoom_EnemyBase.HCE_UnitSounds "HCE/Sentinel/Engine", "HCE/Sentinel/Hit", "HCE/Sentinel/Death";
		+HaloDoom_EnemyBase.HCE_Beam
		+HaloDoom_EnemyBase.HCE_Evades
		+HaloDoom_EnemyBase.HCE_Flying
		+HaloDoom_EnemyBase.HCE_Surprise
	}
	// the animation table: which IQM clip plays for each of the AI's animation kinds (HCE_A_IDLE, HCE_A_MOVE_F ...;
	// the list is in the enemy API). A kind with several clips rolls one each time. To swap a clip, change its name here
	override Name HCE_AnimName(int kind)
	{
		if(hce_hasLoadout) { Name ln = HCE_LoadoutAnim(hce_loadout, kind); if(ln != 'None') return ln; }   // a gun picked up
