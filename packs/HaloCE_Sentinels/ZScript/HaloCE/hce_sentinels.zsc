		HaloDoom_EnemyBase.HCE_GunOffset (31.8, -0.0, 27.3);
		HaloDoom_EnemyBase.HCE_SpecialFire 0, 0;
		HaloDoom_EnemyBase.HCE_Melee 36, 55;
		HaloDoom_EnemyBase.HCE_Leap 0, 0, 0.00, 6.5;
		HaloDoom_EnemyBase.HCE_Grenades 0, 0, 0.00, 0.5, 240, 1120, 26.0;
		HaloDoom_EnemyBase.HCE_Panic 0.00, 0.00, 0.0, 0.0;
