		}
		return 'None';
	}

	override int HCE_AnimTics(Name anim)
	{
		if(hce_hasLoadout) { int lt = HCE_LoadoutAnimTics(anim); if(lt > 0) return lt; }
		switch(anim)
		{
		case 'alert fixed idle%0': return 35;
		case 'crouch fixed idle%0': return 4;
		case 's-ping front gut%1 baked': return 26;
		case 's-ping front gut%2 baked': return 26;
		case 's-ping front gut%3 baked': return 26;
		case 'stand airborne-dead%1': return 112;
		case 'stand airborne-dead%2': return 85;
		case 'stand fixed idle%0': return 4;
		case 'stand landing-dead': return 4;
		}
		return 30;
	}
	override vector3 HCE_AnimMove(Name anim)
	{
		return (0, 0, 0);
	}
	override bool HCE_HasBubble() { return true; }    // Halo 2's shield bubble
	override void HCE_RollName() { String l = "ABCDEFGH"; hce_rankName = String.Format("Sentinel %d-%s%d", random(100, 999), l.Mid(random(0, 7), 1), random(1, 9)); }
	// Galap's gunner seats (sentinel beam gunner ally): beams of their own beside its weapon
	override void HCE_GunnerSetup()
	{
		HCE_AddGunner((48.8, 36.2, 96.7), 0.60, 0.30, 0.40, 0.75, 1.50, 1600);   // beam gun a
		HCE_AddGunner((48.8, -35.1, 96.7), 0.60, 0.30, 0.40, 0.75, 1.50, 1600);   // beam gun b
	}
}

