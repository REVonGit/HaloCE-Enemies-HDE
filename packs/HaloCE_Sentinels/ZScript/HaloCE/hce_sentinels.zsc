class HCE_SentinelBeamGunnerBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_SENTINEL";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_SENTINEL;
		Height 24;
		Radius 12;
		Mass 84;
		PainChance 0;
		Tag "SentinelBeamGunner";
		+NOBLOOD
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
}

class HCE_SentinelConstructorBase : HaloDoom_EnemyBase abstract
{
	Default
	{
		Monster;
		+DECOUPLEDANIMATIONS
		+FLOORCLIP
		+DONTHARMSPECIES
		+NOINFIGHTSPECIES
		Species "HCE_SENTINEL";
		HaloDoom_EnemyBase.HCE_Enabled true;
		HaloDoom_EnemyBase.HCE_Team HCE_TEAM_SENTINEL;
		Height 32;
		Radius 16;
		Mass 25;
		PainChance 0;
		Tag "SentinelConstructor";
		+NOBLOOD
	}
	States
	{
	Spawn:
		HCEM A 1 HCE_Look();
		Loop;
	See:
		HCEM A 1 HCE_Think();
		Loop;
	Death:
		HCEM A 1 HCE_Die();
		HCEM A 2 A_NoBlocking;
	Dead:
		HCEM A 1 HCE_CorpseTick();
		Loop;
	Raise:
		HCEM A 1;
		Goto See;
	Pain:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		Goto See;
	Pain.PlasmaStuck:
		HCEM A 0 A_JumpIf(health <= 0, "Dead");
		HCEM A 1 HCE_OnStuck();
		Goto See;
	}
	override void HCE_ApplyAnim(Name n, int blend, bool loop)
	{
		SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);
		if(hce_shellActor) hce_shellActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // the shield flare moves with it
		if(hce_holoActor) hce_holoActor.SetAnimation(n, -1, hce_applyFrame, -1, -1, blend, loop ? SAF_LOOP : 0);   // and a hologram companion
	}
	// ---- Halo 2's Constructor (extract_h2_sentinels.py), in the Lost Souls' place. It has no gun: every 2-4 s, with its
	// target in sight 96-640 units away, it darts at it for up to a second, homing, and rams it (3-24 damage, as a Lost
	// Soul's bite); in reach it welds it with a short arc of its cutting beam (6-16 damage)
	int hce_dartTics, hce_dartNext;

	override bool HCE_TryMelee()
	{
		if(hce_meleeTics > level.maptime || !target) return false;
		A_SetAngle(AngleTo(target));
		HCE_ConWeld();
		hce_meleeTics = level.maptime + 30;
		return true;
	}

	void HCE_ConWeld()
	{
		if(!target) return;
		vector3 a = pos + (0, 0, height * 0.5), b = target.pos + (0, 0, target.height * 0.5);
		vector3 d = level.Vec3Diff(a, b);
		int n = clamp(int(d.Length() / 6), 1, 24);
		for(int i = 0; i <= n; i++)
		{
			vector3 p = d * (double(i) / n);
			A_SpawnParticle("FFD870", SPF_FULLBRIGHT, 6, frandom(2, 4), 0, p.x, p.y, height * 0.5 + p.z,
				frandom(-0.4, 0.4), frandom(-0.4, 0.4), frandom(-0.4, 0.4));
		}
		A_StartSound("Halo/Weapons/LightRifle/Fire", CHAN_WEAPON, CHANF_OVERLAP, 0.5);
		if(Distance3D(target) < 112) target.DamageMobj(self, self, random(3, 8) * 2, 'Plasma');
	}

	override void Tick()
	{
		super.Tick();
		if(isFrozen() || health <= 0 || hce_dummy) { hce_dartTics = 0; return; }
		if(hce_dartTics > 0)
		{
			hce_dartTics--;
			if(!target) { hce_dartTics = 0; return; }
			vel = level.Vec3Diff(pos, target.pos + (0, 0, target.height * 0.5)).Unit() * 14;
			A_SetAngle(AngleTo(target));
			if(Distance3D(target) < radius + target.radius + 20)
			{
				target.DamageMobj(self, self, random(1, 8) * 3, 'Melee', 0, AngleTo(target));
				A_StartSound("HCE/Melee", CHAN_WEAPON, CHANF_OVERLAP);
				vel = -vel * 0.4; hce_dartTics = 0;
			}
			return;
		}
		if(!target || level.maptime < hce_dartNext || !CheckSight(target)) return;
		double dist = Distance3D(target);
		if(dist < 96 || dist > 640) return;
		hce_dartNext = level.maptime + 35 * random(2, 4);
		hce_dartTics = 40;
	}
	override void HCE_ResumeAnim()
	{
		if(hce_curAnim == 'None') return;
		int len = max(1, int(HCE_AnimTics(hce_curAnim) * 30.0 / 35.0));
		int f = int((level.maptime - hce_animStartTic) * 30.0 / 35.0);
		SetAnimation(hce_curAnim, -1, hce_curLoop ? f % len : min(f, len - 1), -1, -1, 0, hce_curLoop ? SAF_LOOP : 0);
	}
}

